{
  "version": 2,
  "builds": [
    {
      "src": "api/ping.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/tracking.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/bot-logs.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/ping",
      "dest": "/api/ping.js"
    },
    {
      "src": "/api/bot-logs",
      "dest": "/api/bot-logs.js"
    },
    {
      "src": "/v1/api/data/tracking/(.*)",
      "dest": "/api/tracking.js?id=$1"
    },
    {
      "src": "/api/tracking/(.*)",
      "dest": "/api/tracking.js?id=$1"
    },
    {
      "src": "/api/tracking",
      "dest": "/api/tracking.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
