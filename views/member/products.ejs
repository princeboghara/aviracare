<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Wellness Products Showcase - Avira Lifecare</title>
</head>
<body class="min-h-screen flex flex-col justify-between bg-mesh-emerald font-sans antialiased text-slate-800 relative w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <!-- Navigation -->
    <%- include('../partials/member_navbar') %>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-12 relative z-10 box-border">
        
        <!-- Top Title & Search Filter Bar -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-5 mb-8 sm:mb-10 pb-6 border-b border-slate-200/80">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-extrabold bg-emerald-50 text-emerald-800 border border-emerald-200 uppercase tracking-wider mb-2">
                    <i class="fa-solid fa-leaf text-emerald-500"></i> Pure & Certified Wellness
                </div>
                <h1 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-slate-900">
                    Product <span class="text-emerald-600">Showcase</span>
                </h1>
                <p class="text-slate-500 text-xs sm:text-sm mt-1 font-medium">
                    Explore high-grade herbal solutions with verified PV volume points and specialized benefits.
                </p>
            </div>
            
            <!-- Search Filter -->
            <div class="relative w-full md:max-w-xs">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 text-xs">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" id="productSearch" onkeyup="searchProducts()" placeholder="Search by product name..." 
                    class="w-full pl-9 pr-4 py-2.5 bg-white border border-slate-200 rounded-2xl text-xs font-semibold focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 transition-all shadow-xs placeholder:text-slate-400">
            </div>
        </div>
        
        <!-- Product Grid -->
        <div id="productGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6">
            <% if(!products || products.length === 0) { %>
                <div id="noProductsMsg" class="text-xs text-slate-400 col-span-full text-center py-20 font-bold glass-emerald-card rounded-3xl">
                    <div class="w-16 h-16 bg-emerald-50 text-emerald-500 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-3">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <span class="text-slate-700 font-black text-sm block">No active products published yet.</span>
                    <span class="text-slate-400 font-medium text-xs mt-1 block">Please check back shortly for updated inventory.</span>
                </div>
            <% } else { %>
                <div id="noProductsMsg" class="hidden text-xs text-slate-400 col-span-full text-center py-20 font-bold glass-emerald-card rounded-3xl">
                    <div class="w-16 h-16 bg-slate-50 text-slate-400 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-3">
                        <i class="fa-solid fa-magnifying-glass-minus"></i>
                    </div>
                    <span class="text-slate-700 font-black text-sm block">No matching products found!</span>
                    <span class="text-slate-400 font-medium text-xs mt-1 block">Try searching with a different keyword or spelling.</span>
                </div>
            <% } %>

            <% if(products && products.length > 0) { %>
                <% products.forEach(product => { %>
                    <a href="/products/<%= product.id %>" class="product-card glass-emerald-card p-3 sm:p-4 rounded-3xl flex flex-col justify-between group cursor-pointer" data-name="<%= String(product.name).toUpperCase() %>">
                        
                        <div class="w-full">
                            <!-- Image Container -->
                            <div class="w-full aspect-square bg-slate-50/80 rounded-2xl overflow-hidden mb-3 flex items-center justify-center relative border border-slate-100 p-2 group-hover:bg-emerald-50/30 transition-colors">
                                <img src="<%= product.image_url %>" alt="<%= product.name %>" class="object-contain w-full h-full group-hover:scale-105 transition-transform duration-300">
                                
                                <span class="absolute top-2 right-2 bg-emerald-500 text-slate-950 font-black px-2 py-0.5 rounded-lg text-[9px] shadow-xs tracking-wider uppercase">
                                    <%= product.pv %> PV
                                </span>
                            </div>
                            
                            <!-- Product Name -->
                            <h2 class="font-extrabold text-xs sm:text-sm text-slate-900 group-hover:text-emerald-600 transition-colors line-clamp-2 leading-snug min-h-[32px] sm:min-h-[36px]">
                                <%= product.name %>
                            </h2>
                        </div>
                        
                        <!-- Price & Action Indicator -->
                        <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between">
                            <div>
                                <span class="text-[9px] font-extrabold uppercase text-slate-400 tracking-wider block">Price</span>
                                <span class="text-sm sm:text-base font-black text-slate-950">₹<%= parseFloat(product.amount).toLocaleString('en-IN') %></span>
                            </div>
                            <span class="w-8 h-8 rounded-xl bg-slate-100 group-hover:bg-emerald-500 group-hover:text-white text-slate-700 flex items-center justify-center text-xs transition-all">
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </div>

                    </a>
                <% }) %>
            <% } %>
        </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/member_footer') %>

    <script>
        function searchProducts() {
            const rawInput = document.getElementById('productSearch').value;
            const input = sanitizeString(rawInput).toUpperCase().trim();
            const cards = document.getElementsByClassName('product-card');
            const noMsg = document.getElementById('noProductsMsg');
            let visibleCount = 0;

            for (let i = 0; i < cards.length; i++) {
                const productName = cards[i].getAttribute('data-name') || '';
                if (productName.includes(input)) {
                    cards[i].style.display = "";
                    visibleCount++;
                } else {
                    cards[i].style.display = "none";
                }
            }

            if (noMsg) {
                if (visibleCount === 0) noMsg.classList.remove('hidden');
                else noMsg.classList.add('hidden');
            }
        }

        function sanitizeString(str) {
            return str.replace(/[&<>"'/]/g, function (s) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;',
                    '/': '&#x2F;'
                }[s];
            });
        }
    </script>
</body>
</html>
