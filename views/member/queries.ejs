<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Member Query & Support Desk - Avira Lifecare</title>
</head>
<body class="min-h-screen flex flex-col justify-between bg-mesh-emerald font-sans antialiased text-slate-800 relative w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <!-- Navigation -->
    <%- include('../partials/member_navbar') %>

    <!-- Main Content -->
    <main class="flex-grow max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-14 space-y-8 relative z-10 box-border">
        
        <!-- Header / Title -->
        <div class="text-center space-y-3 max-w-xl mx-auto">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[10px] font-extrabold bg-emerald-50 text-emerald-800 border border-emerald-200 uppercase tracking-widest shadow-xs">
                <i class="fa-solid fa-headset text-emerald-600"></i> Official Helpdesk Portal
            </div>
            
            <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-slate-950 uppercase">
                Support & <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">Query Desk</span>
            </h1>
            
            <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed">
                Lodge inquiries regarding parcel dispatches, PV points verification, or payout inquiries with instant tracking.
            </p>
        </div>

        <!-- Navigation Tabs for Logger vs Tracker -->
        <div class="flex items-center justify-center gap-3 max-w-md mx-auto bg-slate-200/70 p-1.5 rounded-2xl border border-slate-200/90 shadow-inner">
            <button type="button" id="tabCreateBtn" onclick="switchTab('create')" class="w-1/2 py-2.5 rounded-xl font-black text-xs uppercase tracking-wider transition-all duration-200 bg-white text-slate-900 shadow-sm flex items-center justify-center gap-2">
                <i class="fa-solid fa-pen-to-square text-emerald-600"></i>
                <span>Submit Ticket</span>
            </button>
            <button type="button" id="tabHistoryBtn" onclick="switchTab('history')" class="w-1/2 py-2.5 rounded-xl font-black text-xs uppercase tracking-wider transition-all duration-200 text-slate-600 hover:text-slate-900 flex items-center justify-center gap-2">
                <i class="fa-solid fa-clock-rotate-left text-slate-400"></i>
                <span>Ticket History</span>
            </button>
        </div>

        <!-- Panel 1: Create Ticket Form -->
        <div id="createPanel" class="glass-emerald-card p-6 sm:p-8 rounded-3xl max-w-xl mx-auto shadow-md border-emerald-200/90">
            <form onsubmit="handleCreateTicket(event)" id="ticketForm" class="space-y-4">
                
                <!-- Member ID & Full Name -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="memberId" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center justify-between">
                            <span>Member ID *</span>
                            <span class="text-[9px] text-emerald-600 font-mono font-bold">AV + 5 Digits</span>
                        </label>
                        <input type="text" id="memberId" required placeholder="e.g. AV12345" maxlength="7"
                            oninput="formatMemberIdInput(this)"
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono font-bold text-slate-900 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 uppercase transition-all">
                    </div>
                    <div>
                        <label for="memberName" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5">
                            Full Name *
                        </label>
                        <input type="text" id="memberName" required placeholder="e.g. Ramesh Patel"
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-900 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 uppercase transition-all">
                    </div>
                </div>

                <!-- Contact Mobile Number -->
                <div>
                    <label for="contactNo" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center justify-between">
                        <span>WhatsApp / Contact Mobile No *</span>
                        <span class="text-[9px] text-slate-400 font-mono">10 Digits Only</span>
                    </label>
                    <input type="tel" id="contactNo" required placeholder="10-digit mobile number" maxlength="10" inputmode="numeric"
                        oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);"
                        class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono font-bold text-slate-900 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 transition-all">
                </div>

                <!-- Query Subject Category Selector -->
                <div>
                    <label class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-2">
                        Query Category *
                    </label>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="subjectPillsContainer">
                        <button type="button" onclick="selectSubject(this, 'Parcel Dispatch Inquiry')" data-subject="Parcel Dispatch Inquiry" class="subject-pill px-3 py-2.5 rounded-xl text-[11px] font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-emerald-500 text-left transition-all cursor-pointer">
                            📦 Parcel Dispatch
                        </button>
                        <button type="button" onclick="selectSubject(this, 'PV Points Verification')" data-subject="PV Points Verification" class="subject-pill px-3 py-2.5 rounded-xl text-[11px] font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-emerald-500 text-left transition-all cursor-pointer">
                            📊 PV Points
                        </button>
                        <button type="button" onclick="selectSubject(this, 'Damaged Item / Replacement')" data-subject="Damaged Item / Replacement" class="subject-pill px-3 py-2.5 rounded-xl text-[11px] font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-emerald-500 text-left transition-all cursor-pointer">
                            🔄 Replacement
                        </button>
                        <button type="button" onclick="selectSubject(this, 'Payout / Commission Query')" data-subject="Payout / Commission Query" class="subject-pill px-3 py-2.5 rounded-xl text-[11px] font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-emerald-500 text-left transition-all cursor-pointer">
                            💰 Payout Query
                        </button>
                        <button type="button" onclick="selectSubject(this, 'Product Information')" data-subject="Product Information" class="subject-pill px-3 py-2.5 rounded-xl text-[11px] font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-emerald-500 text-left transition-all cursor-pointer">
                            🌿 Product Info
                        </button>
                        <button type="button" onclick="selectSubject(this, 'Other Query')" data-subject="Other Query" class="subject-pill px-3 py-2.5 rounded-xl text-[11px] font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-emerald-500 text-left transition-all cursor-pointer">
                            💬 Other
                        </button>
                    </div>
                    <input type="hidden" id="ticketSubject" required value="Parcel Dispatch Inquiry">
                </div>

                <!-- Description -->
                <div>
                    <label for="ticketDesc" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5">
                        Detailed Description / Query Message *
                    </label>
                    <textarea id="ticketDesc" required rows="4" placeholder="Please write your detailed query or requirement here..."
                        class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-900 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 transition-all"></textarea>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="submitTicketBtn"
                    class="btn-emerald-3d w-full text-center font-black text-xs py-3.5 px-6 rounded-2xl uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer shadow-lg mt-2">
                    <i class="fa-solid fa-paper-plane text-xs"></i>
                    <span>Log Support Ticket</span>
                </button>
            </form>

            <div id="ticketSuccessBox" class="hidden mt-6 p-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-center space-y-3">
                <div class="w-12 h-12 bg-emerald-500 text-white rounded-xl flex items-center justify-center text-xl mx-auto shadow-md">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h4 class="text-sm font-black text-slate-900">Ticket Logged Successfully!</h4>
                <p class="text-xs text-slate-600 font-medium">Your request has been forwarded to our support representatives. We will resolve it promptly.</p>
                <button type="button" onclick="resetForm()" class="btn-dark-3d px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider inline-block">
                    Submit Another Query
                </button>
            </div>
        </div>

        <!-- Panel 2: Ticket History -->
        <div id="historyPanel" class="hidden glass-emerald-card p-6 sm:p-8 rounded-3xl max-w-2xl mx-auto shadow-md space-y-6">
            <div class="flex flex-col sm:flex-row items-center gap-3">
                <div class="relative w-full">
                    <input type="text" id="historyMemberId" placeholder="Enter Member ID (e.g. AV12345)..." maxlength="7"
                        oninput="formatMemberIdInput(this)"
                        class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono font-bold text-slate-900 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 uppercase">
                </div>
                <button type="button" onclick="fetchTicketHistory()" class="btn-emerald-3d w-full sm:w-auto px-6 py-3 rounded-xl font-bold text-xs uppercase tracking-wider whitespace-nowrap">
                    View History
                </button>
            </div>

            <div id="historyResults" class="space-y-4">
                <div class="text-center py-10 text-slate-400 text-xs font-bold">
                    <i class="fa-solid fa-ticket text-3xl mb-2 block text-slate-300"></i>
                    Enter your Member ID above to search past support tickets.
                </div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <%- include('../partials/member_footer') %>

    <script>
        function formatMemberIdInput(el) {
            let raw = el.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            if (!raw) {
                el.value = '';
                return;
            }
            if (raw === 'A' || raw === 'AV') {
                el.value = raw;
                return;
            }
            if (raw.startsWith('AV')) {
                let num = raw.slice(2).replace(/[^0-9]/g, '').slice(0, 5);
                el.value = 'AV' + num;
            } else {
                let num = raw.replace(/[^0-9]/g, '').slice(0, 5);
                if (num.length > 0) {
                    el.value = 'AV' + num;
                } else {
                    el.value = '';
                }
            }
        }

        function switchTab(tab) {
            const createBtn = document.getElementById('tabCreateBtn');
            const historyBtn = document.getElementById('tabHistoryBtn');
            const createPanel = document.getElementById('createPanel');
            const historyPanel = document.getElementById('historyPanel');

            if (tab === 'create') {
                createBtn.classList.add('bg-white', 'text-slate-900', 'shadow-sm');
                createBtn.classList.remove('text-slate-600');
                historyBtn.classList.remove('bg-white', 'text-slate-900', 'shadow-sm');
                historyBtn.classList.add('text-slate-600');
                createPanel.classList.remove('hidden');
                historyPanel.classList.add('hidden');
            } else {
                historyBtn.classList.add('bg-white', 'text-slate-900', 'shadow-sm');
                historyBtn.classList.remove('text-slate-600');
                createBtn.classList.remove('bg-white', 'text-slate-900', 'shadow-sm');
                createBtn.classList.add('text-slate-600');
                createPanel.classList.add('hidden');
                historyPanel.classList.remove('hidden');
            }
        }

        function selectSubject(target, subject) {
            document.getElementById('ticketSubject').value = subject;
            const pills = document.querySelectorAll('.subject-pill');
            pills.forEach(p => {
                const btnSub = p.getAttribute('data-subject') || '';
                if (p === target || btnSub === subject) {
                    p.className = 'subject-pill px-3 py-2.5 rounded-xl text-[11px] font-black border-2 border-emerald-500 bg-emerald-50 text-emerald-900 ring-2 ring-emerald-500/20 shadow-xs text-left transition-all cursor-pointer';
                } else {
                    p.className = 'subject-pill px-3 py-2.5 rounded-xl text-[11px] font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-emerald-500 text-left transition-all cursor-pointer';
                }
            });
        }

        async function handleCreateTicket(e) {
            e.preventDefault();
            const btn = document.getElementById('submitTicketBtn');
            const form = document.getElementById('ticketForm');
            const successBox = document.getElementById('ticketSuccessBox');

            const memberId = document.getElementById('memberId').value.trim().toUpperCase();
            const name = document.getElementById('memberName').value.trim();
            const contactNo = document.getElementById('contactNo').value.trim().replace(/[^0-9]/g, '');
            const subject = document.getElementById('ticketSubject').value.trim();
            const description = document.getElementById('ticketDesc').value.trim();

            if (!/^AV\d{5}$/.test(memberId)) {
                alert("Please enter a valid Member ID starting with AV followed by exactly 5 digits (e.g. AV12345).");
                document.getElementById('memberId').focus();
                return;
            }

            if (contactNo.length !== 10) {
                alert("Please enter a valid 10-digit mobile number.");
                document.getElementById('contactNo').focus();
                return;
            }

            const payload = { memberId, name, contactNo, subject, description };

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin text-xs"></i> <span>Logging Ticket...</span>`;

            try {
                const res = await fetch('/api/queries/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-paper-plane text-xs"></i> <span>Log Support Ticket</span>`;

                if (result.success) {
                    form.classList.add('hidden');
                    successBox.classList.remove('hidden');
                } else {
                    alert("Error: " + (result.msg || 'Unable to log ticket.'));
                }
            } catch (err) {
                console.error(err);
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-paper-plane text-xs"></i> <span>Log Support Ticket</span>`;
                alert("Network error: Could not submit ticket.");
            }
        }

        function resetForm() {
            document.getElementById('ticketForm').reset();
            selectSubject(null, 'Parcel Dispatch Inquiry');
            document.getElementById('ticketForm').classList.remove('hidden');
            document.getElementById('ticketSuccessBox').classList.add('hidden');
        }

        async function fetchTicketHistory() {
            const memberId = document.getElementById('historyMemberId').value.trim().toUpperCase();
            const container = document.getElementById('historyResults');

            if (!memberId) {
                alert("Please enter your Member ID.");
                return;
            }

            container.innerHTML = `
                <div class="text-center py-8 text-xs font-bold text-slate-500">
                    <i class="fa-solid fa-circle-notch fa-spin text-emerald-500 text-2xl mb-2 block"></i>
                    Fetching history for ${memberId}...
                </div>
            `;

            try {
                const res = await fetch(`/api/queries/history?memberId=${encodeURIComponent(memberId)}`);
                const data = await res.json();

                if (!data || data.length === 0) {
                    container.innerHTML = `
                        <div class="p-6 rounded-2xl bg-slate-50 text-center border border-slate-200 text-xs text-slate-500 font-bold">
                            No tickets found for Member ID <strong>${memberId}</strong>.
                        </div>
                    `;
                    return;
                }

                let html = '';
                data.forEach(t => {
                    const statusStr = (t.status || 'PENDING').toUpperCase();
                    let badgeClass = 'bg-amber-50 text-amber-700 border-amber-200';
                    if (statusStr === 'SOLVED') {
                        badgeClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                    } else if (statusStr === 'ACCEPTED') {
                        badgeClass = 'bg-blue-50 text-blue-700 border-blue-200';
                    }

                    let replySection = '';
                    if (t.admin_reply) {
                        replySection = `
                            <div class="mt-3 p-3.5 rounded-2xl bg-emerald-50/90 border border-emerald-200 shadow-xs space-y-1.5">
                                <div class="flex items-center justify-between gap-1 text-emerald-800 text-[10px] font-black uppercase tracking-wider flex-wrap">
                                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-headset text-emerald-600 text-xs"></i> Support Team Resolution / Reply:</span>
                                    ${t.formattedRepliedAt ? `<span class="text-[9px] font-semibold text-emerald-700/80 lowercase"><i class="fa-regular fa-clock text-[8px]"></i> ${t.formattedRepliedAt}</span>` : ''}
                                </div>
                                <p class="text-xs text-emerald-950 font-semibold leading-relaxed pl-1">${escapeHTML(t.admin_reply)}</p>
                            </div>
                        `;
                    } else {
                        replySection = `
                            <div class="mt-2.5 flex items-center gap-1.5 text-[10px] font-bold text-amber-600 bg-amber-50/60 border border-amber-100 p-2 rounded-xl">
                                <i class="fa-solid fa-clock"></i>
                                <span>Under Review: Support executive will post resolution shortly.</span>
                            </div>
                        `;
                    }

                    html += `
                        <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2.5 transition-all hover:border-emerald-200">
                            <div class="flex items-center justify-between gap-2 flex-wrap">
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] font-black text-slate-400 font-mono tracking-wider">TICKET #${t.id}</span>
                                    ${t.formattedCreatedAt ? `<span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md"><i class="fa-regular fa-calendar text-[9px] mr-1 text-emerald-600"></i>${t.formattedCreatedAt}</span>` : ''}
                                </div>
                                <span class="px-3 py-0.5 rounded-full text-[10px] font-extrabold uppercase border ${badgeClass}">
                                    ${statusStr}
                                </span>
                            </div>
                            <h4 class="text-xs sm:text-sm font-black text-slate-900">${escapeHTML(t.subject)}</h4>
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 space-y-1">
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Your Query:</span>
                                <p class="text-xs text-slate-700 font-medium leading-relaxed">${escapeHTML(t.description)}</p>
                            </div>
                            ${replySection}
                            <div class="text-[10px] font-bold text-slate-400 pt-1 flex items-center justify-between border-t border-slate-100">
                                <span><i class="fa-solid fa-user mr-1"></i> ${escapeHTML(t.name)} (${t.member_id})</span>
                                <span><i class="fa-solid fa-phone mr-1"></i> ${t.contact_no}</span>
                            </div>
                        </div>
                    `;
                });
                container.innerHTML = html;

            } catch (e) {
                container.innerHTML = `<div class="text-center text-rose-500 text-xs font-bold py-4">Error loading tickets. Please try again.</div>`;
            }
        }

        function escapeHTML(str) {
            return String(str || '').replace(/[&<>"']/g, function (s) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                }[s];
            });
        }

        // Initialize first subject pill active on load
        window.addEventListener('DOMContentLoaded', () => {
            selectSubject(null, 'Parcel Dispatch Inquiry');
        });
    </script>
</body>
</html>
