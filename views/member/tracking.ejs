<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Live Parcel Tracking | Avira Lifecare</title>
</head>
<body class="min-h-screen flex flex-col justify-between bg-mesh-emerald font-sans antialiased text-slate-800 relative w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <!-- Navigation -->
    <%- include('../partials/member_navbar') %>

    <!-- Main Content -->
    <main class="flex-grow max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-14 space-y-8 relative z-10 box-border">
        
        <!-- Header / Intro -->
        <div class="text-center space-y-3 max-w-2xl mx-auto">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[10px] font-black bg-emerald-50 text-emerald-800 border border-emerald-200 uppercase tracking-widest shadow-xs">
                <i class="fa-solid fa-truck-fast text-emerald-600"></i> Avira Lifecare Parcel Dispatch
            </div>
            
            <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-950 uppercase">
                Track <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">Parcel Status</span>
            </h1>
            
            <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed">
                Enter your <strong class="text-slate-900 font-bold">Avira Member ID</strong> below to view your order PV, amount, and parcel tracking details.
            </p>
        </div>

        <!-- Search Input Box Card (Member ID Search Only) -->
        <div class="glass-emerald-card p-5 sm:p-7 rounded-3xl max-w-xl mx-auto border-emerald-200/90 shadow-md space-y-4">
            
            <form onsubmit="handleTrack(event)" class="space-y-3.5">
                <div class="relative">
                    <label id="inputLabel" for="trackInput" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center justify-between">
                        <span>Member ID</span>
                        <span id="formatBadge" class="text-[10px] text-emerald-600 font-mono font-bold bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">AV + 5 or 6 Digits</span>
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
                            <i id="inputIcon" class="fa-solid fa-id-card text-emerald-600 text-sm"></i>
                        </span>
                        <input type="text" id="trackInput" placeholder="e.g. AV12345 or AV123456" required
                            maxlength="8"
                            oninput="handleInputChange(this)"
                            class="w-full pl-11 pr-4 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl text-sm font-mono font-bold text-slate-900 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 transition-all uppercase placeholder:normal-case placeholder:font-medium placeholder:text-slate-400">
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-2.5">
                    <button type="submit" id="trackBtn"
                        class="btn-emerald-3d flex-1 text-center font-black text-xs py-3.5 px-6 rounded-2xl uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer shadow-md">
                        <i class="fa-solid fa-magnifying-glass text-xs"></i>
                        <span>Track Status</span>
                    </button>
                    <button type="button" onclick="clearTrackSearch()" 
                        class="px-4 py-3 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold uppercase tracking-wider transition-all cursor-pointer">
                        Reset
                    </button>
                </div>
            </form>
        </div>

        <!-- Results Area -->
        <div id="resultsContainer" class="max-w-2xl mx-auto w-full space-y-4">
            <!-- Initial Tip Banner -->
            <div class="glass-emerald-card p-6 sm:p-8 rounded-3xl text-center space-y-3 border-slate-200/80 bg-white/70">
                <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-xl mx-auto border border-emerald-100">
                    <i class="fa-solid fa-box-check"></i>
                </div>
                <h3 class="text-sm font-black text-slate-900 uppercase">Live Member Parcel Lookup</h3>
                <p class="text-xs text-slate-500 max-w-md mx-auto leading-relaxed">
                    Enter your 5 or 6 digit Member ID (e.g. <strong>AV12345</strong> or <strong>AV123456</strong>) above to check your PV, Amount, and Tracking Number status.
                </p>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <%- include('../partials/member_footer') %>

    <script>
        function handleInputChange(el) {
            let raw = el.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            if (raw.startsWith('AV')) {
                let num = raw.slice(2).replace(/[^0-9]/g, '').slice(0, 6);
                el.value = 'AV' + num;
            } else if (/^\d+$/.test(raw)) {
                el.value = 'AV' + raw.slice(0, 6);
            } else {
                el.value = raw.slice(0, 8);
            }
        }

        function clearTrackSearch() {
            const input = document.getElementById('trackInput');
            input.value = '';
            input.focus();
            document.getElementById('resultsContainer').innerHTML = `
                <div class="glass-emerald-card p-6 sm:p-8 rounded-3xl text-center space-y-3 border-slate-200/80 bg-white/70">
                    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-xl mx-auto border border-emerald-100">
                        <i class="fa-solid fa-box-check"></i>
                    </div>
                    <h3 class="text-sm font-black text-slate-900 uppercase">Live Member Parcel Lookup</h3>
                    <p class="text-xs text-slate-500 max-w-md mx-auto leading-relaxed">
                        Enter your 5 or 6 digit Member ID (e.g. <strong>AV12345</strong> or <strong>AV123456</strong>) above to check your PV, Amount, and Tracking Number status.
                    </p>
                </div>
            `;
        }

        function copyBarcode(text) {
            if (!text || text === 'PENDING') return;
            navigator.clipboard.writeText(text).then(() => {
                alert("Tracking Number copied: " + text);
            }).catch(() => {
                prompt("Copy Tracking Number:", text);
            });
        }

        async function handleTrack(e) {
            e.preventDefault();
            const query = document.getElementById('trackInput').value.trim().toUpperCase();
            const btn = document.getElementById('trackBtn');
            const results = document.getElementById('resultsContainer');

            if (!query) return;

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin text-xs"></i> <span>Searching...</span>`;
            results.innerHTML = `
                <div class="glass-emerald-card p-10 rounded-3xl text-center space-y-3">
                    <i class="fa-solid fa-spinner fa-spin text-3xl text-emerald-500"></i>
                    <p class="text-xs font-bold text-slate-700 uppercase tracking-wide">Fetching Details for ${query}...</p>
                </div>
            `;

            try {
                const response = await fetch(`/api/track?query=${encodeURIComponent(query)}`);
                const data = await response.json();

                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-magnifying-glass text-xs"></i> <span>Track Status</span>`;

                if (!data || data.length === 0) {
                    results.innerHTML = `
                        <div class="glass-emerald-card p-10 rounded-3xl text-center space-y-3 border-amber-200 bg-amber-50/30">
                            <div class="w-14 h-14 bg-amber-100 text-amber-700 rounded-2xl flex items-center justify-center text-2xl mx-auto shadow-xs">
                                <i class="fa-solid fa-box-archive"></i>
                            </div>
                            <h3 class="text-base font-black text-slate-900 uppercase">No Record Found</h3>
                            <p class="text-xs text-slate-600 max-w-md mx-auto font-medium leading-relaxed">
                                We could not locate any order or dispatch record matching <strong class="text-slate-900">${query}</strong>. Please check your Member ID and try again.
                            </p>
                            <div class="pt-2">
                                <a href="/member/queries" class="inline-flex items-center gap-1.5 text-xs font-black text-emerald-700 hover:text-emerald-800 bg-white px-4 py-2 rounded-xl border border-emerald-200 shadow-xs">
                                    <i class="fa-solid fa-headset"></i> Contact Support Desk
                                </a>
                            </div>
                        </div>
                    `;
                    return;
                }

                let html = `
                    <div class="flex items-center justify-between px-2">
                        <span class="text-xs font-black text-slate-600 uppercase tracking-wider">Found ${data.length} Record(s)</span>
                        <span class="text-[10px] font-black text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200 uppercase tracking-wider">
                            <i class="fa-solid fa-circle-check mr-1 text-emerald-600"></i> Verified
                        </span>
                    </div>
                `;

                data.forEach(item => {
                    const trkClean = (item.tracking || '').trim().toUpperCase();
                    let trackingDisplay = '';

                    if (!trkClean) {
                        trackingDisplay = `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-amber-50 text-amber-700 border border-amber-200 font-bold text-xs"><span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse"></span> Pending Dispatch</span>`;
                    } else if (trkClean.includes('SHOP')) {
                        trackingDisplay = `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 font-mono font-black text-xs"><i class="fa-solid fa-shop text-[11px] text-emerald-600"></i> ${trkClean}</span>`;
                    } else {
                        trackingDisplay = `
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xl bg-blue-50 text-blue-700 border border-blue-200 font-mono font-bold text-xs">
                                <i class="fa-solid fa-barcode text-blue-600"></i>
                                <span>${trkClean}</span>
                                <button type="button" onclick="copyBarcode('${trkClean}')" class="ml-1 text-blue-600 hover:text-blue-900 cursor-pointer" title="Copy tracking number">
                                    <i class="fa-solid fa-copy text-xs"></i>
                                </button>
                            </div>
                        `;
                    }

                    html += `
                        <div class="glass-emerald-card p-6 sm:p-7 rounded-3xl space-y-5 border-emerald-200/90 shadow-md bg-white/95">
                            
                            <!-- Header: Member ID & Order Number -->
                            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-100">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg border border-emerald-100">
                                        <i class="fa-solid fa-id-card"></i>
                                    </div>
                                    <div>
                                        <span class="text-[10px] font-mono text-slate-400 font-bold uppercase block">Member ID</span>
                                        <span class="font-mono font-black text-base text-emerald-700">${item.memberId || '-'}</span>
                                    </div>
                                </div>

                                ${item.orderNo ? `
                                    <div class="text-right">
                                        <span class="text-[10px] font-mono text-slate-400 font-bold uppercase block">Order Number</span>
                                        <span class="font-mono font-black text-xs sm:text-sm text-slate-800 bg-slate-100 px-2.5 py-1 rounded-xl border border-slate-200">${item.orderNo}</span>
                                    </div>
                                ` : ''}
                            </div>

                            <!-- Customer Name -->
                            <div>
                                <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block mb-0.5">Customer Name</span>
                                <h2 class="text-base sm:text-lg font-black text-slate-900 uppercase tracking-wide">${item.name || '-'}</h2>
                            </div>

                            <!-- Data Grid: PV | Amount | Tracking Number -->
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                                <!-- PV -->
                                <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block mb-1">PV</span>
                                    <div class="font-mono font-black text-base text-emerald-600">${item.pv || '0'} PV</div>
                                </div>

                                <!-- Amount -->
                                <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block mb-1">Amount</span>
                                    <div class="font-mono font-black text-base text-slate-900">₹${item.amount || '0'}</div>
                                </div>

                                <!-- Tracking Number -->
                                <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 sm:col-span-1">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider block mb-1">Tracking Number</span>
                                    <div class="pt-0.5">${trackingDisplay}</div>
                                </div>
                            </div>

                        </div>
                    `;
                });

                results.innerHTML = html;

            } catch (err) {
                console.error(err);
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-magnifying-glass text-xs"></i> <span>Track Status</span>`;
                results.innerHTML = `
                    <div class="glass-emerald-card p-8 rounded-3xl text-center space-y-2 border-rose-200 bg-rose-50/20">
                        <i class="fa-solid fa-circle-xmark text-2xl text-rose-500"></i>
                        <h4 class="text-sm font-black text-slate-900">Communication Error</h4>
                        <p class="text-xs text-slate-500 font-medium">Unable to communicate with the tracking service. Please try again.</p>
                    </div>
                `;
            }
        }

        // Auto-trigger if URL has ?query= or ?memberId=
        window.addEventListener('DOMContentLoaded', () => {
            const params = new URLSearchParams(window.location.search);
            const queryParam = params.get('query') || params.get('memberId') || params.get('tracking');
            if (queryParam) {
                const input = document.getElementById('trackInput');
                if (input) {
                    input.value = queryParam.toUpperCase().trim();
                    handleTrack(new Event('submit'));
                }
            }
        });
    </script>
</body>
</html>
