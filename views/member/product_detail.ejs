<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title><%= product ? product.name : 'Product Detail' %> - Avira Lifecare</title>
    <style>
        /* GOOGLE TRANSLATE CLEANUP */
        .goog-te-banner-frame { display: none !important; }
        body { top: 0px !important; }
        .goog-te-gadget { font-size: 0px !important; display: none !important; }

        /* ULTRA SMOOTH ACCORDION */
        .accordion-wrapper {
            display: grid;
            grid-template-rows: 0fr;
            transition: grid-template-rows 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .accordion-content {
            overflow: hidden;
            opacity: 0;
            transform: translateY(-4px);
            transition: opacity 0.2s ease, transform 0.25s ease;
        }
        .accordion-open {
            border-color: rgba(16, 185, 129, 0.5) !important;
            background: #ffffff !important;
            box-shadow: 0 8px 25px -5px rgba(16, 185, 129, 0.12);
        }
        .accordion-open .accordion-wrapper {
            grid-template-rows: 1fr;
        }
        .accordion-open .accordion-content {
            opacity: 1;
            transform: translateY(0);
        }
        .accordion-open .chevron-icon {
            transform: rotate(180deg);
            color: #059669;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-mesh-emerald font-sans antialiased text-slate-800 relative w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <!-- Navigation Header -->
    <%- include('../partials/member_navbar') %>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-4xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-10 relative z-10 box-border">
        
        <% if(!product) { %>
            <div class="glass-emerald-card rounded-3xl p-12 text-center my-12 space-y-4">
                <div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-2xl flex items-center justify-center text-3xl mx-auto">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h2 class="text-xl font-black text-slate-900">Product Not Found</h2>
                <p class="text-xs text-slate-500 max-w-sm mx-auto">The requested product could not be located in the current catalog database.</p>
                <a href="/products" class="btn-emerald-3d inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider">
                    &larr; Back to Catalog
                </a>
            </div>
        <% } else { %>

            <!-- Top Action Row: Back & Language Switcher -->
            <div class="flex items-center justify-between gap-4 mb-6">
                <a href="/products" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white border border-slate-200/90 hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-xs transition-all">
                    <i class="fa-solid fa-arrow-left text-[10px]"></i> All Products
                </a>
                
                <!-- Multi-Language Switcher -->
                <div class="flex items-center gap-2 bg-white border border-slate-200/90 px-3 py-1.5 rounded-xl shadow-xs">
                    <span class="text-[10px] font-black uppercase text-slate-400 flex items-center gap-1">
                        <i class="fa-solid fa-language text-xs text-emerald-600"></i> Lang:
                    </span>
                    <select id="langSelect" onchange="changeLanguage(this.value)" class="bg-transparent text-xs font-bold text-slate-800 focus:outline-none cursor-pointer">
                        <option value="en">English</option>
                        <option value="gu">ગુજરાતી</option>
                        <option value="hi">हिन्दी</option>
                    </select>
                </div>
            </div>

            <!-- Product Card Showcase Grid -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                
                <!-- Left Column: Image Gallery (5 cols) -->
                <div class="md:col-span-5 space-y-4">
                    <div class="glass-emerald-card rounded-3xl p-4 sm:p-5 relative overflow-hidden">
                        <div class="w-full aspect-square bg-slate-50/80 rounded-2xl overflow-hidden flex items-center justify-center p-4 relative border border-slate-100">
                            <img id="mainDisplayImage" src="<%= product.image_url || '/images/logo.jpg' %>" alt="<%= product.name %>" class="object-contain w-full h-full transition-all duration-300">
                            
                            <span class="absolute top-3 right-3 bg-emerald-500 text-slate-950 font-black px-2.5 py-1 rounded-xl text-[10px] shadow-sm tracking-wider uppercase">
                                <%= product.pv %> PV
                            </span>
                        </div>

                        <!-- Thumbnail Gallery if multiple images exist -->
                        <% 
                            let parsedImages = [];
                            try {
                                if(product.all_images) {
                                    parsedImages = typeof product.all_images === 'string' ? JSON.parse(product.all_images) : product.all_images;
                                }
                            } catch(e) {}
                            if(!parsedImages || parsedImages.length === 0) {
                                parsedImages = [product.image_url || '/images/logo.jpg'];
                            }
                        %>
                        <% if(parsedImages.length > 1) { %>
                            <div class="flex items-center gap-2 mt-3 overflow-x-auto pb-1">
                                <% parsedImages.forEach((img, idx) => { %>
                                    <button type="button" onclick="setMainImage('<%= img %>')" class="w-12 h-12 rounded-xl bg-slate-50 border-2 <%= idx === 0 ? 'border-emerald-500' : 'border-slate-200' %> overflow-hidden flex-shrink-0 p-1 hover:border-emerald-500 transition-all focus:outline-none thumbnail-btn">
                                        <img src="<%= img %>" alt="Thumbnail" class="w-full h-full object-contain">
                                    </button>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Right Column: Product Info & Accordions (7 cols) -->
                <div class="md:col-span-7 space-y-4">
                    
                    <!-- Header Info Box -->
                    <div class="glass-emerald-card rounded-3xl p-6 space-y-3">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-extrabold uppercase tracking-wider">
                            <i class="fa-solid fa-certificate text-emerald-600"></i> Genuine Quality Certified
                        </div>
                        
                        <h1 class="text-xl sm:text-2xl font-black text-slate-900 leading-tight">
                            <%= product.name %>
                        </h1>

                        <!-- Price & PV Metrics -->
                        <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                            <div>
                                <span class="text-[10px] font-extrabold uppercase text-slate-400 tracking-wider block">MRP Price</span>
                                <span class="text-2xl font-black text-slate-950">₹<%= parseFloat(product.amount).toLocaleString('en-IN') %></span>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] font-extrabold uppercase text-slate-400 tracking-wider block">Volume Score</span>
                                <span class="text-lg font-black text-emerald-600"><%= product.pv %> PV Points</span>
                            </div>
                        </div>
                    </div>

                    <!-- Accordion 1: Description & Formulation -->
                    <div class="glass-emerald-card rounded-2xl p-4 border border-slate-200/90 transition-all accordion-item accordion-open" id="acc1">
                        <button type="button" onclick="toggleAccordion('acc1')" class="w-full flex items-center justify-between text-left focus:outline-none">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">
                                    <i class="fa-solid fa-circle-info"></i>
                                </div>
                                <span class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">Product Details & Info</span>
                            </div>
                            <i class="fa-solid fa-chevron-down text-xs text-slate-400 chevron-icon transition-transform duration-300"></i>
                        </button>
                        <div class="accordion-wrapper">
                            <div class="accordion-content pt-3 mt-3 border-t border-slate-100 text-xs text-slate-600 leading-relaxed font-medium">
                                <%= product.info || 'No specific description provided for this product formulation.' %>
                            </div>
                        </div>
                    </div>

                    <!-- Accordion 2: Key Benefits -->
                    <div class="glass-emerald-card rounded-2xl p-4 border border-slate-200/90 transition-all accordion-item accordion-open" id="acc2">
                        <button type="button" onclick="toggleAccordion('acc2')" class="w-full flex items-center justify-between text-left focus:outline-none">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xs font-bold">
                                    <i class="fa-solid fa-heart-pulse"></i>
                                </div>
                                <span class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">Key Health Benefits</span>
                            </div>
                            <i class="fa-solid fa-chevron-down text-xs text-slate-400 chevron-icon transition-transform duration-300"></i>
                        </button>
                        <div class="accordion-wrapper">
                            <div class="accordion-content pt-3 mt-3 border-t border-slate-100 text-xs text-slate-600 leading-relaxed font-medium">
                                <%= product.benefits || 'Formulated with authentic natural extracts to support physical stamina, vitality, and systemic wellness.' %>
                            </div>
                        </div>
                    </div>

                    <!-- Accordion 3: How to Use / Dosage -->
                    <div class="glass-emerald-card rounded-2xl p-4 border border-slate-200/90 transition-all accordion-item accordion-open" id="acc3">
                        <button type="button" onclick="toggleAccordion('acc3')" class="w-full flex items-center justify-between text-left focus:outline-none">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xs font-bold">
                                    <i class="fa-solid fa-prescription-bottle"></i>
                                </div>
                                <span class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">Directions & Usage</span>
                            </div>
                            <i class="fa-solid fa-chevron-down text-xs text-slate-400 chevron-icon transition-transform duration-300"></i>
                        </button>
                        <div class="accordion-wrapper">
                            <div class="accordion-content pt-3 mt-3 border-t border-slate-100 text-xs text-slate-600 leading-relaxed font-medium">
                                <%= product.how_to_use || 'Take as advised by your healthcare consultant or according to printed package label directions with warm water.' %>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        <% } %>

    </main>

    <!-- Hidden Google Translate Element -->
    <div id="google_translate_element" style="display:none;"></div>
    <script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'gu,hi,en',
                layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
                autoDisplay: false
            }, 'google_translate_element');
        }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <!-- Interactive Scripts -->
    <script>
        function toggleAccordion(id) {
            const item = document.getElementById(id);
            item.classList.toggle('accordion-open');
        }

        function setMainImage(src) {
            const img = document.getElementById('mainDisplayImage');
            if (img) {
                img.style.opacity = '0.4';
                setTimeout(() => {
                    img.src = src;
                    img.style.opacity = '1';
                }, 150);
            }
        }

        function changeLanguage(langCode) {
            const selectEl = document.querySelector('.goog-te-combo');
            if (selectEl) {
                selectEl.value = langCode;
                selectEl.dispatchEvent(new Event('change'));
            }
        }
    </script>

    <!-- Footer -->
    <%- include('../partials/member_footer') %>

</body>
</html>
