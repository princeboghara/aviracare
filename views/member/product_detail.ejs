<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title><%= product ? product.name : 'Product Detail' %> - Avira Lifecare</title>
    <style>
        /* GOOGLE TRANSLATE CLEANUP */
        .goog-te-banner-frame { display: none !important; }
        body { top: 0px !important; }
        .goog-te-gadget { font-size: 0px !important; display: none !important; }

        /* 💎 LUXURY ACCORDION ANIMATION */
        .accordion-wrapper {
            display: grid;
            grid-template-rows: 0fr;
            transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .accordion-content {
            overflow: hidden;
            opacity: 0;
            transform: translateY(-6px);
            transition: opacity 0.25s ease, transform 0.3s ease;
        }
        .accordion-open {
            border-color: rgba(16, 185, 129, 0.45) !important;
            background: #ffffff !important;
            box-shadow: 0 12px 30px -8px rgba(16, 185, 129, 0.14);
        }
        .accordion-open .accordion-wrapper {
            grid-template-rows: 1fr;
        }
        .accordion-open .accordion-content {
            opacity: 1;
            transform: translateY(0);
        }
        .accordion-open .chevron-icon {
            transform: rotate(180deg);
            color: #059669;
        }

        .glass-luxury-detail {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 20px 45px -15px rgba(15, 23, 42, 0.08);
        }

        .pv-gradient-glow {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-mesh-emerald font-sans antialiased text-slate-800 relative w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <!-- Navigation Header -->
    <%- include('../partials/member_navbar') %>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-5xl mx-auto w-full px-4 sm:px-6 py-6 sm:py-10 relative z-10 box-border">
        
        <% if(!product) { %>
            <div class="glass-luxury-detail rounded-3xl p-12 text-center my-12 space-y-4">
                <div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-3xl flex items-center justify-center text-3xl mx-auto shadow-inner">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h2 class="text-xl font-black text-slate-900 uppercase">Product Not Located</h2>
                <p class="text-xs text-slate-500 max-w-sm mx-auto">The requested product could not be found in the current inventory catalog.</p>
                <a href="/products" class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-black uppercase tracking-wider transition-all shadow-md">
                    &larr; Return to Product Showcase
                </a>
            </div>
        <% } else { %>

            <!-- Top Breadcrumb & Language Switcher Bar -->
            <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-200/80">
                <a href="/products" class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-white border border-slate-200/90 hover:bg-slate-50 text-slate-700 text-xs font-black shadow-xs transition-all">
                    <i class="fa-solid fa-arrow-left text-[11px] text-emerald-600"></i> All Products
                </a>
                
                <div class="flex items-center gap-3">
                    <!-- WhatsApp Share Button -->
                    <button type="button" onclick="shareProduct()" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-black hover:bg-emerald-100 transition-all shadow-xs cursor-pointer">
                        <i class="fa-brands fa-whatsapp text-emerald-600 text-sm"></i> Share
                    </button>

                    <!-- Multi-Language Switcher Dropdown (All Languages) -->
                    <div class="flex items-center gap-2 bg-white border border-slate-200/90 px-3.5 py-1.5 rounded-2xl shadow-xs">
                        <span class="text-[10px] font-black uppercase text-slate-400 flex items-center gap-1.5">
                            <i class="fa-solid fa-language text-base text-emerald-600"></i> Lang:
                        </span>
                        <select id="langSelect" onchange="changeLanguage(this.value)" class="bg-transparent text-xs font-black text-slate-900 focus:outline-none cursor-pointer max-w-[140px] sm:max-w-none">
                            <optgroup label="🇮🇳 ભારતીય ભાષાઓ (Indian Languages)">
                                <option value="en">English (Default)</option>
                                <option value="gu">ગુજરાતી (Gujarati)</option>
                                <option value="hi">हिन्दी (Hindi)</option>
                                <option value="mr">मराठी (Marathi)</option>
                                <option value="bn">বাংলা (Bengali)</option>
                                <option value="ta">தமிழ் (Tamil)</option>
                                <option value="te">తెలుగు (Telugu)</option>
                                <option value="kn">ಕನ್ನಡ (Kannada)</option>
                                <option value="ml">മലയാളം (Malayalam)</option>
                                <option value="pa">ਪੰਜਾਬੀ (Punjabi)</option>
                                <option value="ur">اردو (Urdu)</option>
                                <option value="or">ଓଡ଼ିଆ (Odia)</option>
                                <option value="as">অসমীয়া (Assamese)</option>
                                <option value="ne">नेपाली (Nepali)</option>
                                <option value="sa">संस्कृतम् (Sanskrit)</option>
                                <option value="sd">سنڌي (Sindhi)</option>
                            </optgroup>
                            <optgroup label="🌍 International Languages (વિશ્વ ભાષાઓ)">
                                <option value="es">Español (Spanish)</option>
                                <option value="fr">Français (French)</option>
                                <option value="de">Deutsch (German)</option>
                                <option value="ar">العربية (Arabic)</option>
                                <option value="ru">Русский (Russian)</option>
                                <option value="zh-CN">中文 (Chinese)</option>
                                <option value="ja">日本語 (Japanese)</option>
                                <option value="ko">한국어 (Korean)</option>
                                <option value="pt">Português (Portuguese)</option>
                                <option value="it">Italiano (Italian)</option>
                                <option value="tr">Türkçe (Turkish)</option>
                                <option value="id">Bahasa Indonesia</option>
                                <option value="th">ไทย (Thai)</option>
                                <option value="vi">Tiếng Việt (Vietnamese)</option>
                            </optgroup>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Product Master Showcase Grid -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 items-start">
                
                <!-- Left Column: Image Display & Thumbnails (5 cols) -->
                <div class="md:col-span-5 space-y-4">
                    <div class="glass-luxury-detail rounded-3xl p-4 sm:p-6 relative overflow-hidden">
                        <div class="w-full aspect-square bg-gradient-to-b from-slate-50/90 to-slate-100/50 rounded-2xl overflow-hidden flex items-center justify-center p-4 relative border border-slate-200/60 shadow-inner">
                            <img id="mainDisplayImage" src="<%= product.image_url || '/images/logo.jpg' %>" alt="<%= product.name %>" class="object-contain w-full h-full transition-all duration-300">
                            
                            <span class="absolute top-3 right-3 pv-gradient-glow text-white font-black px-3 py-1 rounded-xl text-[11px] uppercase tracking-wider flex items-center gap-1">
                                <i class="fa-solid fa-bolt text-[10px] text-amber-300"></i> <%= product.pv %> PV
                            </span>
                        </div>

                        <!-- Gallery Thumbnails -->
                        <% 
                            let parsedImages = [];
                            try {
                                if(product.all_images) {
                                    parsedImages = typeof product.all_images === 'string' ? JSON.parse(product.all_images) : product.all_images;
                                }
                            } catch(e) {}
                            if(!parsedImages || parsedImages.length === 0) {
                                parsedImages = [product.image_url || '/images/logo.jpg'];
                            }
                        %>
                        <% if(parsedImages.length > 1) { %>
                            <div class="flex items-center gap-2 mt-4 overflow-x-auto pb-1">
                                <% parsedImages.forEach((img, idx) => { %>
                                    <button type="button" onclick="setMainImage('<%= img %>')" class="w-14 h-14 rounded-2xl bg-white border-2 <%= idx === 0 ? 'border-emerald-500 shadow-sm' : 'border-slate-200' %> overflow-hidden flex-shrink-0 p-1.5 hover:border-emerald-500 transition-all focus:outline-none thumbnail-btn cursor-pointer">
                                        <img src="<%= img %>" alt="Thumbnail" class="w-full h-full object-contain">
                                    </button>
                                <% }) %>
                            </div>
                        <% } %>

                        <!-- Trust Seal Row -->
                        <div class="grid grid-cols-2 gap-2 mt-5 pt-4 border-t border-slate-100 text-center">
                            <div class="p-2.5 rounded-2xl bg-slate-50 border border-slate-100">
                                <i class="fa-solid fa-leaf text-emerald-500 text-base mb-1 block"></i>
                                <span class="text-[10px] font-black text-slate-800 uppercase block">100% Herbal</span>
                                <span class="text-[8px] font-bold text-slate-400">Pure Botanical Active</span>
                            </div>
                            <div class="p-2.5 rounded-2xl bg-slate-50 border border-slate-100">
                                <i class="fa-solid fa-certificate text-blue-500 text-base mb-1 block"></i>
                                <span class="text-[10px] font-black text-slate-800 uppercase block">GMP Certified</span>
                                <span class="text-[8px] font-bold text-slate-400">Premium Quality Standard</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Product Specs & Interactive Accordions (7 cols) -->
                <div class="md:col-span-7 space-y-4">
                    
                    <!-- Header Info Box -->
                    <div class="glass-luxury-detail rounded-3xl p-6 sm:p-7 space-y-4">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900 text-white text-[10px] font-black uppercase tracking-wider shadow-xs">
                                <i class="fa-solid fa-tag text-[9px] text-emerald-400"></i> <%= product.category || 'Health & Wellness' %>
                            </span>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-extrabold uppercase tracking-wider">
                                <i class="fa-solid fa-shield-check text-emerald-600"></i> Verified Authentic
                            </span>
                        </div>
                        
                        <h1 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-900 leading-tight">
                            <%= product.name %>
                        </h1>

                        <!-- Price & PV Metrics Bar -->
                        <div class="flex items-center justify-between p-4 rounded-2xl bg-gradient-to-r from-emerald-50/80 to-teal-50/50 border border-emerald-100">
                            <div>
                                <span class="text-[10px] font-black uppercase text-emerald-900 tracking-wider block">MRP Price (Incl. Taxes)</span>
                                <span class="text-2xl sm:text-3xl font-black text-slate-950">₹<%= parseFloat(product.amount).toLocaleString('en-IN') %></span>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] font-black uppercase text-emerald-900 tracking-wider block">Volume Rewards</span>
                                <span class="text-xl sm:text-2xl font-black text-emerald-700 flex items-center justify-end gap-1">
                                    <i class="fa-solid fa-award text-amber-500"></i> <%= product.pv %> PV
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Accordion 1: Description & Formulation -->
                    <div class="glass-luxury-detail rounded-3xl p-5 border border-slate-200/90 transition-all accordion-item accordion-open" id="acc1">
                        <button type="button" onclick="toggleAccordion('acc1')" class="w-full flex items-center justify-between text-left focus:outline-none cursor-pointer">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-2xl bg-emerald-100/80 text-emerald-700 flex items-center justify-center text-sm font-bold shadow-xs">
                                    <i class="fa-solid fa-circle-info"></i>
                                </div>
                                <span class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">Product Details & Formulation</span>
                            </div>
                            <i class="fa-solid fa-chevron-down text-xs text-slate-400 chevron-icon transition-transform duration-300"></i>
                        </button>
                        <div class="accordion-wrapper">
                            <div class="accordion-content pt-4 mt-3 border-t border-slate-100 text-xs sm:text-sm text-slate-700 leading-relaxed font-medium whitespace-pre-line">
                                <%= product.info || 'Formulated with certified botanical nutrients to promote complete physical wellness.' %>
                            </div>
                        </div>
                    </div>

                    <!-- Accordion 2: Key Benefits -->
                    <div class="glass-luxury-detail rounded-3xl p-5 border border-slate-200/90 transition-all accordion-item accordion-open" id="acc2">
                        <button type="button" onclick="toggleAccordion('acc2')" class="w-full flex items-center justify-between text-left focus:outline-none cursor-pointer">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-2xl bg-teal-100/80 text-teal-700 flex items-center justify-center text-sm font-bold shadow-xs">
                                    <i class="fa-solid fa-heart-pulse"></i>
                                </div>
                                <span class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">Key Health & Wellness Benefits</span>
                            </div>
                            <i class="fa-solid fa-chevron-down text-xs text-slate-400 chevron-icon transition-transform duration-300"></i>
                        </button>
                        <div class="accordion-wrapper">
                            <div class="accordion-content pt-4 mt-3 border-t border-slate-100 text-xs sm:text-sm text-slate-700 leading-relaxed font-medium whitespace-pre-line">
                                <%= product.benefits || 'Supports daily physical stamina, vitality, cellular rejuvenation, and natural systemic defense.' %>
                            </div>
                        </div>
                    </div>

                    <!-- Accordion 3: How to Use / Dosage -->
                    <div class="glass-luxury-detail rounded-3xl p-5 border border-slate-200/90 transition-all accordion-item accordion-open" id="acc3">
                        <button type="button" onclick="toggleAccordion('acc3')" class="w-full flex items-center justify-between text-left focus:outline-none cursor-pointer">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-2xl bg-blue-100/80 text-blue-700 flex items-center justify-center text-sm font-bold shadow-xs">
                                    <i class="fa-solid fa-prescription-bottle"></i>
                                </div>
                                <span class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">Directions & Usage Guide</span>
                            </div>
                            <i class="fa-solid fa-chevron-down text-xs text-slate-400 chevron-icon transition-transform duration-300"></i>
                        </button>
                        <div class="accordion-wrapper">
                            <div class="accordion-content pt-4 mt-3 border-t border-slate-100 text-xs sm:text-sm text-slate-700 leading-relaxed font-medium whitespace-pre-line">
                                <%= product.how_to_use || 'Take as advised by your healthcare consultant or according to printed package label directions with warm water.' %>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        <% } %>

    </main>

    <!-- Hidden Google Translate Element (styled offscreen to guarantee DOM initialization) -->
    <div id="google_translate_element" style="position:absolute; top:-9999px; left:-9999px; opacity:0; pointer-events:none;"></div>
    <script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
                autoDisplay: false
            }, 'google_translate_element');
        }
    </script>
    <script type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <!-- Interactive Scripts -->
    <script>
        function toggleAccordion(id) {
            const item = document.getElementById(id);
            if (item) item.classList.toggle('accordion-open');
        }

        function setMainImage(src) {
            const img = document.getElementById('mainDisplayImage');
            if (img) {
                img.style.opacity = '0.3';
                setTimeout(() => {
                    img.src = src;
                    img.style.opacity = '1';
                }, 150);
            }
        }

        function shareProduct() {
            const url = window.location.href;
            const text = "🌿 Check out <%= product ? product.name : 'Avira Product' %> on Avira Lifecare: " + url;
            if (navigator.share) {
                navigator.share({ title: '<%= product ? product.name : "Product" %>', text: text, url: url }).catch(() => {});
            } else {
                window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(text), '_blank');
            }
        }

        function changeLanguage(langCode) {
            const host = window.location.hostname;
            
            if (langCode === 'en') {
                // Reset to default original language
                document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
                if (host) {
                    document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; domain=${host}; path=/;`;
                    document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; domain=.${host}; path=/;`;
                }
            } else {
                document.cookie = `googtrans=/en/${langCode}; path=/;`;
                if (host) {
                    document.cookie = `googtrans=/en/${langCode}; domain=${host}; path=/;`;
                    document.cookie = `googtrans=/en/${langCode}; domain=.${host}; path=/;`;
                }
            }

            const selectEl = document.querySelector('.goog-te-combo');
            if (selectEl) {
                selectEl.value = langCode;
                selectEl.dispatchEvent(new Event('change'));
            } else {
                window.location.reload();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const match = document.cookie.match(/googtrans=\/en\/([a-zA-Z\-]+)/i);
            if (match && match[1]) {
                const langSelect = document.getElementById('langSelect');
                if (langSelect) langSelect.value = match[1];
            }
        });
    </script>

    <!-- Footer -->
    <%- include('../partials/member_footer') %>

</body>
</html>
