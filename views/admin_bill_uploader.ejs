<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bill Manager & Converter - Avira Control</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 min-h-screen font-sans text-slate-800">

    <%- include('partials/admin_navbar') %>

    <div class="w-full lg:pl-64 min-h-screen flex flex-col justify-between">
        
        <header class="bg-white/90 border-b border-slate-100 px-6 py-3.5 flex justify-between items-center sticky top-0 z-40 backdrop-blur-md">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wide">
                <i class="fa-solid fa-file-invoice-dollar text-emerald-500 mr-1.5"></i> Bill Manager / Smart Combo Converter
            </span>
            <a href="/admin/manage-combos" class="bg-slate-900 text-white text-xs font-bold px-4 py-2.5 rounded-xl hover:bg-slate-800 transition-all shadow-sm flex items-center gap-2">
                <i class="fa-solid fa-sliders text-emerald-400"></i> Manage Combo Presets
            </a>
        </header>

        <main class="flex-grow max-w-7xl w-full mx-auto p-6 space-y-6">

            <div class="bg-gradient-to-br from-slate-900 via-emerald-950 to-slate-900 p-6 sm:p-8 rounded-3xl text-white shadow-xl relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 relative z-10">
                    <div class="space-y-2 max-w-xl">
                        <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-widest inline-block">
                            <i class="fa-solid fa-bolt mr-1"></i> AI Vision Invoice Converter
                        </span>
                        <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight">Upload Bills For Automated Breakup</h2>
                        <p class="text-xs text-slate-300 leading-relaxed">
                            Upload original PDF or JPG tax invoices. Gemini AI will scan details and automatically replace <strong>'Offer Combos'</strong> with mapped individual items from your combo presets.
                        </p>
                    </div>

                    <form id="uploadBillsForm" class="w-full lg:w-auto flex flex-col sm:flex-row gap-3 items-center">
                        <div class="relative w-full sm:w-auto">
                            <input type="file" id="billFiles" multiple required class="hidden" onchange="updateFileCount(this)">
                            <label for="billFiles" class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white text-xs font-bold px-5 py-3 rounded-2xl cursor-pointer transition-all w-full text-center">
                                <i class="fa-solid fa-cloud-arrow-up text-emerald-400 text-sm"></i>
                                <span id="fileLabelText">Choose / Drop Invoice Files</span>
                            </label>
                        </div>
                        <button type="submit" id="btnUpload" class="w-full sm:w-auto bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs px-8 py-3 rounded-2xl uppercase tracking-wider transition-all shadow-lg shadow-emerald-500/20 cursor-pointer flex items-center justify-center gap-2">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                            <span id="btnText">Convert Bills</span>
                        </button>
                    </form>
                </div>
            </div>

            <div class="bg-white rounded-3xl border border-slate-200/80 shadow-md overflow-hidden">
                <div class="p-5 bg-slate-50/80 border-b border-slate-100 font-bold text-xs uppercase flex justify-between items-center">
                    <span class="flex items-center gap-2 text-slate-800">
                        <i class="fa-solid fa-folder-closed text-emerald-600"></i> Converted Bills Repository
                    </span>
                    <span class="bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full text-[11px] font-black">
                        <%= bills.length %> Records Saved
                    </span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs whitespace-nowrap">
                        <thead>
                            <tr class="bg-slate-100/60 text-slate-400 font-black uppercase text-[10px] tracking-wider border-b border-slate-100">
                                <th class="p-4 pl-6">Inv No</th>
                                <th class="p-4">Date</th>
                                <th class="p-4">Buyer Name (Billing)</th>
                                <th class="p-4">Consignee (Shipped To)</th>
                                <th class="p-4 text-center">PV</th>
                                <th class="p-4 text-right">Net Amount</th>
                                <th class="p-4 text-center pr-6">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if(bills.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="p-12 text-center text-slate-400">
                                        <i class="fa-solid fa-file-invoice text-3xl mb-3 block text-slate-300"></i>
                                        No bills converted yet. Upload bills above to convert automatically!
                                    </td>
                                </tr>
                            <% } else { %>
                                <% bills.forEach(item => { %>
                                    <tr class="hover:bg-slate-50/80 transition-all">
                                        <td class="p-4 pl-6 font-mono font-bold text-slate-900">
                                            <span class="bg-slate-100 text-slate-800 px-2.5 py-1 rounded-md border border-slate-200">
                                                #<%= item.invoice_no %>
                                            </span>
                                        </td>
                                        <td class="p-4 font-semibold text-slate-600"><%= item.invoice_date %></td>
                                        <td class="p-4 font-bold text-slate-900 uppercase">
                                            <%= item.buyer_name %>
                                            <% if(item.buyer_id) { %>
                                                <span class="text-[10px] text-slate-400 block font-normal">(ID: <%= item.buyer_id %>)</span>
                                            <% } %>
                                        </td>
                                        <td class="p-4 font-semibold text-slate-600 uppercase"><%= item.consignee_name || item.buyer_name %></td>
                                        <td class="p-4 text-center font-mono font-black text-emerald-600"><%= item.total_pv %></td>
                                        <td class="p-4 text-right font-mono font-black text-slate-900 text-sm">₹<%= item.total_amount %></td>
                                        <td class="p-4 text-center pr-6">
                                            <a href="/admin/api/print-bill/<%= item.id %>" target="_blank" class="inline-flex items-center gap-1.5 bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-3.5 py-2 rounded-xl text-[11px] uppercase transition-all shadow-sm">
                                                <i class="fa-solid fa-eye"></i> Preview / Download
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <script>
        // 📁 FILE SELECTION COUNTER
        function updateFileCount(input) {
            const label = document.getElementById('fileLabelText');
            if (input.files.length > 0) {
                label.innerHTML = `<span class="text-emerald-300 font-black">${input.files.length} File(s) Selected</span>`;
            } else {
                label.innerText = "Choose / Drop Invoice Files";
            }
        }

        // 🚀 SUBMIT FORM WITH ANIMATED PROGRESS
        document.getElementById('uploadBillsForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const files = document.getElementById('billFiles').files;
            if(files.length === 0) return;

            const btn = document.getElementById('btnUpload');
            const btnText = document.getElementById('btnText');
            
            btnText.innerText = "CONVERTING...";
            btn.disabled = true;
            btn.classList.add('opacity-75');

            const formData = new FormData();
            for(let i=0; i<files.length; i++) {
                formData.append('billFiles', files[i]);
            }

            try {
                const res = await fetch('/admin/api/process-bills', { method: 'POST', body: formData });
                const result = await res.json();
                if(result.success) { 
                    location.reload(); 
                } else { 
                    alert(result.msg); 
                }
            } catch(e) { 
                console.error(e); 
                alert("સર્વર જોડે કનેક્ટ કરવામાં ભૂલ થઈ!");
            } finally { 
                btnText.innerText = "Convert Bills"; 
                btn.disabled = false; 
                btn.classList.remove('opacity-75');
            }
        });
    </script>
</body>
</html>
