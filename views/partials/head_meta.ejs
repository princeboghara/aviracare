    .bg-mesh-emerald {
        background-color: #f8fafc !important;
        background-image: 
            radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.04) 0px, transparent 45%),
            radial-gradient(at 100% 0%, rgba(37, 99, 235, 0.04) 0px, transparent 45%),
            radial-gradient(at 50% 100%, rgba(148, 163, 184, 0.05) 0px, transparent 50%) !important;
        background-attachment: fixed;
    }

    /* 📦 3D Interactive Corporate Cards */
    .card-corporate-3d,
    .glass-emerald-card,
    .glass-apple-card,
    .premium-3d-card {
        background: #ffffff !important;
        border: 1px solid #e2e8f0 !important;
