        box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.08), 0 4px 10px -2px rgba(15, 23, 42, 0.03);
    }

    /* 💎 Sleek Glass Panel */
    .glass-panel {
        background: rgba(255, 255, 255, 0.92);
