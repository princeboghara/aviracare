<div id="sidebarOverlay" onclick="toggleMobileSidebar()" class="hidden fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-40 lg:hidden transition-opacity duration-300"></div>

<script>
    function toggleSidebarAccordion(element) {
        const currentItem = element.closest('.nav-accordion-item');
        
        document.querySelectorAll('.nav-accordion-item').forEach(item => {
            if(item !== currentItem) {
                item.classList.remove('nav-accordion-active');
            }
        });
        
        currentItem.classList.toggle('nav-accordion-active');
    }

    function toggleMobileSidebar() {
        const sidebar = document.getElementById('adminSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        
        if(sidebar.classList.contains('-translate-x-full')) {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
        } else {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
        }
    }

    // 🌗 TOGGLE DARK / LIGHT THEME WITH PERSISTENCE
    function toggleAdminTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('avira_admin_theme', isDark ? 'dark' : 'light');
    }

    // 🎯 SMART ACTIVE LINK HIGHLIGHTER
    document.addEventListener("DOMContentLoaded", function() {
        const currentPath = window.location.pathname;
        
        // Highlight Sub-menu Links
        const subLinks = document.querySelectorAll(".nav-sub-menu a");
        subLinks.forEach(link => {
            if(link.getAttribute("href") === currentPath) {
                link.classList.add("active-sub");
                const parentAccordion = link.closest(".nav-accordion-item");
                if(parentAccordion) {
                    parentAccordion.classList.add("nav-accordion-active");
                }
            }
        });

        // Highlight Main Menu Links
        const mainLinks = document.querySelectorAll("nav a.nav-item-link");
        mainLinks.forEach(link => {
            if(link.getAttribute("href") === currentPath) {
                link.classList.add("nav-active");
            }
        });
    });
</script>