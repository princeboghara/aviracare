<style>
    /* NEON GLASS SIDEBAR ENGINE */
    .neon-sidebar {
        background: rgba(255, 255, 255, 0.96) !important;
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border-right: 2px solid rgba(16, 185, 129, 0.4) !important;
        box-shadow: 8px 0 25px -5px rgba(16, 185, 129, 0.15), 0 0 15px -3px rgba(16, 185, 129, 0.2);
    }

    /* NEON HOVER & ACTIVE LINK EFFECTS */
    .cyber-link {
        position: relative;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        border: 1px solid transparent;
        color: #334155 !important;
    }
    .cyber-link:hover {
        background: rgba(16, 185, 129, 0.08) !important;
        border-color: rgba(16, 185, 129, 0.5) !important;
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.25), inset 0 0 6px rgba(16, 185, 129, 0.1);
        color: #059669 !important;
        transform: translateX(3px);
    }
    .cyber-link:hover i {
        color: #10b981 !important;
        transform: scale(1.15);
    }

    /* ACCORDION HYDRAULIC TRANSITION */
    .nav-sub-content {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transform: translateY(-4px);
        transition: max-height 0.35s cubic-bezier(0.25, 1, 0.5, 1), 
                    opacity 0.25s ease-out, 
                    transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    }
    .nav-item-open .nav-sub-content {
        max-height: 300px;
        opacity: 1;
        transform: translateY(0);
    }
    .nav-item-open > .cyber-link {
        background: rgba(16, 185, 129, 0.08) !important;
        border-color: rgba(16, 185, 129, 0.3) !important;
        color: #059669 !important;
    }
    .nav-item-open .nav-chevron {
        transform: rotate(180deg);
        color: #10b981;
    }

    /* EXIT BUTTON NEON SHADOW */
    .cyber-exit {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #64748b;
        transition: all 0.3s ease;
    }
    .cyber-exit:hover {
        background: linear-gradient(135deg, #f43f5e, #e11d48);
        border-color: #f43f5e;
        color: #ffffff !important;
        box-shadow: 0 0 15px rgba(244, 63, 94, 0.4);
    }

    /* Custom Scrollbar */
    .cyber-scroll::-webkit-scrollbar { width: 4px; }
    .cyber-scroll::-webkit-scrollbar-track { background: transparent; }
    .cyber-scroll::-webkit-scrollbar-thumb { background: rgba(16, 185, 129, 0.2); border-radius: 10px; }
</style>

