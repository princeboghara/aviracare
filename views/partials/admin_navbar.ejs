<style>
    /* =========================================================================
       🏢 PRYXON/AVIRA CORPORATE MINIMAL SIDEBAR (Exact Reference UI)
       ========================================================================= */
    .corporate-sidebar {
        background: #ffffff;
        border-right: 1px solid #e2e8f0;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Nav Item Link */
    .ref-nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 0.875rem;
        color: #475569;
        font-weight: 600;
        font-size: 0.8125rem;
        border-radius: 0.75rem;
        transition: all 0.18s ease;
    }
    .ref-nav-item:hover {
        background: #f8fafc;
        color: #0f172a;
    }
    .ref-nav-item.active-nav,
    .ref-nav-item.nav-active {
        background: #eff6ff !important;
        color: #2563eb !important;
        border: 1px solid #bfdbfe !important;
        font-weight: 700 !important;
    }

    /* Sub-menu styling */
    .ref-sub-menu {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: max-height 0.28s ease, opacity 0.2s ease;
    }
    .ref-accordion-open .ref-sub-menu {
        max-height: 250px;
        opacity: 1;
    }
    .ref-accordion-open .ref-chevron {
        transform: rotate(180deg);
    }

    .ref-sub-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 0.625rem;
        transition: all 0.15s ease;
    }
    .ref-sub-link:hover {
        color: #0f172a;
        background: #f1f5f9;
    }
    .ref-sub-link.active-sub {
        background: #eff6ff !important;
        color: #2563eb !important;
        border: 1px solid #bfdbfe !important;
        font-weight: 700 !important;
    }

    .sidebar-scroll::-webkit-scrollbar { width: 3px; }
    .sidebar-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
</style>

<!-- 📱 Mobile Top Navbar -->
<div class="lg:hidden bg-white border-b border-slate-200 px-4 py-3 flex justify-between items-center sticky top-0 z-50 w-full shadow-2xs">
    <div class="flex items-center gap-2.5">
        <div class="h-8 w-8 rounded-lg overflow-hidden border border-slate-200 p-0.5 flex items-center justify-center flex-shrink-0">
            <img src="/images/logo.jpg" alt="Avira Logo" class="h-full w-full object-cover rounded-[6px]">
        </div>
        <span class="text-xs font-black tracking-wider text-slate-900 uppercase">Avira <span class="text-blue-600 font-extrabold">Care</span></span>
    </div>
    <button type="button" onclick="toggleMobileSidebar()" class="text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 p-2 rounded-xl focus:outline-none transition-all cursor-pointer">
        <i class="fa-solid fa-bars text-sm"></i>
    </button>
</div>

<!-- 🖥️ Desktop Left Sidebar (Exact Reference UI Design) -->
<aside id="adminSidebar" class="corporate-sidebar fixed top-0 bottom-0 left-0 w-64 text-slate-700 z-50 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col justify-between">
    
    <div class="overflow-y-auto flex-grow p-4 space-y-4 sidebar-scroll">
        
        <!-- 🏷️ Brand Header (Pryxon Tech / Avira Care style) -->
        <div class="flex items-center justify-between pb-4 pt-1 border-b border-slate-100">
            <a href="/admin/home" class="flex items-center gap-2.5">
                <div class="h-8 w-8 rounded-xl bg-blue-50 border border-blue-200 p-1 flex items-center justify-center flex-shrink-0 shadow-2xs">
                    <img src="/images/logo.jpg" alt="Avira Logo" class="h-full w-full object-cover rounded-[6px]">
                </div>
                <div class="leading-none">
                    <span class="text-xs font-black tracking-wider text-slate-900 uppercase">AVIRA <span class="text-blue-600 font-extrabold">CARE</span></span>
                </div>
            </a>
            <% if (typeof dbInfo !== 'undefined' && dbInfo) { %>
            <span class="text-[8px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span> LIVE
            </span>
            <% } %>
        </div>

        <!-- 🧭 Nav Links -->
        <nav class="space-y-1">
            
            <!-- 1. Dashboard -->
            <a href="/admin/home" class="ref-nav-item">
                <i class="fa-solid fa-house text-sm w-4 text-center"></i>
                <span>Dashboard</span>
            </a>

            <!-- 2. Consignments (Single Direct Link, Submenu Removed) -->
            <a href="/admin/manual-entry" class="ref-nav-item">
                <i class="fa-solid fa-boxes-packing text-sm w-4 text-center"></i>
                <span>Consignments</span>
            </a>

            <!-- 3. Orders -->
            <a href="/admin/orders-master" class="ref-nav-item">
                <i class="fa-solid fa-receipt text-sm w-4 text-center"></i>
                <span>Orders</span>
            </a>

            <!-- 4. Customers / Members Directory -->
            <a href="/admin/customers" class="ref-nav-item">
                <i class="fa-solid fa-users text-sm w-4 text-center"></i>
                <span>Customers</span>
            </a>

            <!-- 5. Reports / Tracking -->
            <a href="/admin/live-tracking" class="ref-nav-item">
                <i class="fa-solid fa-chart-simple text-sm w-4 text-center"></i>
                <span>Reports</span>
            </a>

            <!-- 6. Master Database -->
            <a href="/admin/master-database" class="ref-nav-item">
                <i class="fa-solid fa-database text-sm w-4 text-center"></i>
                <span>Master DB</span>
            </a>


            <!-- 8. Log Monitor -->
            <a href="/admin/log-monitor" class="ref-nav-item">
                <i class="fa-solid fa-terminal text-sm w-4 text-center"></i>
                <span>Log Monitor</span>
            </a>

            <!-- 9. Settings -->
            <a href="/admin/settings" class="ref-nav-item">
                <i class="fa-solid fa-gear text-sm w-4 text-center"></i>
                <span>Settings</span>
            </a>

        </nav>
    </div>

    <!-- 🟢 Bottom Status: System Online v1.0.0 -->
    <div class="p-4 border-t border-slate-100 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
            <div class="leading-none">
                <p class="text-xs font-bold text-slate-700">System Online</p>
                <span class="text-[10px] text-slate-400 font-mono mt-0.5 block">v1.0.0</span>
            </div>
        </div>
        <a href="/admin/logout" title="Exit Panel" class="text-slate-400 hover:text-rose-600 p-1.5 rounded-lg hover:bg-rose-50 transition-all text-xs">
            <i class="fa-solid fa-power-off"></i>
        </a>
    </div>
</aside>

<div id="sidebarOverlay" onclick="toggleMobileSidebar()" class="hidden fixed inset-0 bg-slate-950/30 backdrop-blur-xs z-40 lg:hidden transition-opacity duration-300"></div>

<script>
    function toggleRefAccordion(btn) {
        const item = btn.closest('.ref-accordion-item');
        if (item) {
            item.classList.toggle('ref-accordion-open');
        }
    }

    function toggleMobileSidebar() {
        const sidebar = document.getElementById('adminSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        if (!sidebar) return;
        
        if (sidebar.classList.contains('-translate-x-full')) {
            sidebar.classList.remove('-translate-x-full');
            overlay?.classList.remove('hidden');
        } else {
            sidebar.classList.add('-translate-x-full');
            overlay?.classList.add('hidden');
        }
    }

    // Smart Active Link Highlighter
    document.addEventListener("DOMContentLoaded", function() {
        const path = window.location.pathname;
        document.querySelectorAll("aside a").forEach(link => {
            const href = link.getAttribute("href");
            if (href === path) {
                link.classList.add(link.classList.contains('ref-sub-link') ? 'active-sub' : 'active-nav');
                const parentAccordion = link.closest('.ref-accordion-item');
                if (parentAccordion) {
                    parentAccordion.classList.add('ref-accordion-open');
                }
            }
        });
    });
</script>