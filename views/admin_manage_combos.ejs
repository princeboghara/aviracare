<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Combo Presets - Avira Control</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 min-h-screen font-sans text-slate-800">

    <%- include('partials/admin_navbar') %>

    <div class="w-full lg:pl-64 min-h-screen flex flex-col justify-between">
        
        <header class="bg-white/90 border-b border-slate-100 px-6 py-3.5 flex justify-between items-center sticky top-0 z-40">
            <span class="text-xs font-bold text-slate-500 uppercase">Bill Manager / Manage Combos</span>
            <span class="text-xs font-bold text-emerald-600 uppercase"><%= combos.length %> Active Combos</span>
        </header>

        <main class="flex-grow max-w-7xl w-full mx-auto p-6 space-y-6">

            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-md space-y-4">
                <div class="flex justify-between items-center">
                    <h3 id="formHeading" class="text-sm font-black text-slate-900 uppercase flex items-center gap-2">
                        <i class="fa-solid fa-plus-circle text-emerald-500"></i> Add New Combo Breakup Preset
                    </h3>
                    <button type="button" id="btnCancelEdit" onclick="resetForm()" class="hidden bg-slate-200 text-slate-700 hover:bg-slate-300 text-xs font-bold px-3 py-1.5 rounded-lg uppercase transition-all">
                        <i class="fa-solid fa-xmark mr-1"></i> Cancel Edit
                    </button>
                </div>
                
                <form id="comboForm" class="space-y-4 text-xs">
                    <input type="hidden" id="comboId" value="">

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <div class="md:col-span-1">
                            <label class="block font-bold text-slate-700 mb-1 uppercase">Combo Title (Exact Name in Bill)</label>
                            <input type="text" id="comboName" required placeholder="e.g. Offer Combo 2200/-" class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-lg font-bold uppercase focus:outline-none focus:border-emerald-500">
                        </div>
                        <div>
                            <label class="block font-bold text-amber-600 mb-1 uppercase">Total Offer Discount (₹) [આખા કોમ્બોનું]</label>
                            <input type="number" step="0.01" id="totalOfferDiscount" placeholder="e.g. 95.00" class="w-full px-3.5 py-2 bg-amber-50 border border-amber-300 text-amber-900 rounded-lg font-black focus:outline-none">
                            <span class="text-[9px] text-slate-400 mt-0.5 block">*બધી પ્રોડક્ટ્સમાં સરખા ભાગે કટ થશે</span>
                        </div>
                        <div>
                            <label class="block font-bold text-purple-600 mb-1 uppercase">Target Total PV (જેમ કે 500 PV)</label>
                            <input type="number" id="totalOfferPv" placeholder="e.g. 500" class="w-full px-3.5 py-2 bg-purple-50 border border-purple-300 text-purple-900 rounded-lg font-black focus:outline-none">
                            <span class="text-[9px] text-slate-400 mt-0.5 block">*તફાવતના PV Offer PV માં ઉમેરાશે</span>
                        </div>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3">
                        <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                            <span class="font-bold uppercase text-slate-700">Mapped Products List (Breakup)</span>
                            <button type="button" onclick="addProductRow()" class="bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-black px-4 py-2 rounded-xl uppercase transition-all shadow-sm">
                                <i class="fa-solid fa-plus mr-1"></i> Add Product
                            </button>
                        </div>

                        <div id="productRowsContainer" class="space-y-3">
                            <div class="bg-white p-4 rounded-xl border border-slate-200 prod-row shadow-sm space-y-3">
                                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
                                    <div class="md:col-span-4">
                                        <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">Product Name</label>
                                        <input type="text" placeholder="Full Product Name" class="p-name w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold uppercase focus:bg-white focus:border-emerald-500 focus:outline-none" required>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">HSN Code</label>
                                        <input type="text" placeholder="e.g. 30045090" class="p-hsn w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono focus:bg-white focus:border-emerald-500 focus:outline-none" required>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">Qty</label>
                                        <input type="number" placeholder="1" class="p-qty w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold focus:bg-white focus:outline-none" value="1" required>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">PV (Normal)</label>
                                        <input type="number" placeholder="PV" class="p-pv w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold focus:bg-white focus:outline-none">
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block text-[10px] font-black text-purple-600 mb-1 uppercase">Offer PV (Auto Diff)</label>
                                        <input type="number" placeholder="Auto Offer PV" class="p-offer-pv w-full px-3 py-2 bg-purple-50 border border-purple-200 rounded-lg text-xs font-bold focus:outline-none" readonly>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end pt-1">
                                    <div class="md:col-span-3">
                                        <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">Normal Disc ₹ (Single)</label>
                                        <input type="number" step="0.01" placeholder="0.00" class="p-discount w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:bg-white focus:outline-none">
                                    </div>
                                    <div class="md:col-span-3">
                                        <label class="block text-[10px] font-black text-amber-600 mb-1 uppercase">Offer Disc ₹ (Auto Cut)</label>
                                        <input type="number" step="0.01" placeholder="Auto Offer Disc" class="p-offer-discount w-full px-3 py-2 bg-amber-50 border border-amber-200 rounded-lg text-xs font-bold focus:outline-none" readonly>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">GST %</label>
                                        <input type="number" step="0.01" placeholder="e.g. 18" class="p-gst-pct w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold focus:bg-white focus:outline-none">
                                    </div>
                                    <div class="md:col-span-3">
                                        <label class="block text-[10px] font-black text-emerald-600 mb-1 uppercase">Base Amount ₹ (Before Offer Cut)</label>
                                        <input type="number" step="0.01" placeholder="Base Amount ₹" class="p-net w-full px-3 py-2 bg-emerald-50 border border-emerald-300 rounded-lg text-xs font-black text-emerald-900 focus:outline-none" required>
                                    </div>
                                    <div class="md:col-span-1 flex justify-end">
                                        <button type="button" onclick="removeProductRow(this)" class="bg-rose-50 text-rose-600 border border-rose-200 hover:bg-rose-600 hover:text-white w-full py-2 rounded-lg font-bold transition-all" title="Delete Product">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="submit" id="btnSubmitCombo" class="bg-slate-900 hover:bg-slate-950 text-white font-black text-xs px-8 py-3.5 rounded-xl uppercase tracking-widest shadow-md transition-all">
                            Save Combo To System
                        </button>
                    </div>
                </form>
            </div>

            <div class="bg-white rounded-2xl border border-slate-100 shadow-md overflow-hidden">
                <div class="px-6 py-4 bg-slate-50 border-b border-slate-100 font-bold text-xs uppercase">
                    Stored Combo Presets
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-100/50 text-slate-400 font-bold uppercase">
                                <th class="p-4">Combo Name</th>
                                <th class="p-4">Mapped Items Count</th>
                                <th class="p-4 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            <% if(combos.length === 0) { %>
                                <tr><td colspan="3" class="p-8 text-center text-slate-400">No combos configured yet. Create one above!</td></tr>
                            <% } else { %>
                                <% combos.forEach(c => { %>
                                    <tr class="hover:bg-slate-50">
                                        <td class="p-4 font-bold text-slate-900 uppercase"><%= c.combo_name %></td>
                                        <td class="p-4 font-mono font-bold text-emerald-600">
                                            <%= Array.isArray(c.products) ? c.products.length : JSON.parse(c.products || '[]').length %> Items
                                        </td>
                                        <td class="p-4 text-center space-x-2">
                                            <button onclick='editCombo(<%- JSON.stringify(c) %>)' class="text-blue-600 font-bold hover:text-blue-800 uppercase text-[10px] border border-blue-200 bg-blue-50 px-3 py-1.5 rounded-lg hover:bg-blue-100 transition-all">
                                                <i class="fa-solid fa-pen-to-square mr-1"></i> View / Edit
                                            </button>
                                            <button onclick="deleteCombo('<%= c.id %>')" class="text-rose-500 font-bold hover:text-rose-700 uppercase text-[10px] border border-rose-200 px-3 py-1.5 rounded-lg hover:bg-rose-50 transition-all">
                                                <i class="fa-solid fa-trash mr-1"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

<script>
    // ➕ ADD NEW PRODUCT ROW
    function addProductRow(data = null) {
        const container = document.getElementById('productRowsContainer');
        const row = document.createElement('div');
        row.className = 'bg-white p-4 rounded-xl border border-slate-200 prod-row shadow-sm space-y-3';
        
        row.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
                <div class="md:col-span-4">
                    <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">Product Name</label>
                    <input type="text" placeholder="Full Product Name" class="p-name w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold uppercase focus:bg-white focus:border-emerald-500 focus:outline-none" value="${data ? data.product || '' : ''}" required>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">HSN Code</label>
                    <input type="text" placeholder="e.g. 30045090" class="p-hsn w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono focus:bg-white focus:border-emerald-500 focus:outline-none" value="${data ? data.hsn || '' : ''}" required>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">Qty</label>
                    <input type="number" placeholder="1" class="p-qty w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold focus:bg-white focus:outline-none" value="${data ? data.qty || 1 : 1}" required>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">PV (Normal)</label>
                    <input type="number" placeholder="PV" class="p-pv w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold focus:bg-white focus:outline-none" value="${data ? data.pv || '' : ''}">
                </div>
                <div class="md:col-span-2">
                    <label class="block text-[10px] font-black text-purple-600 mb-1 uppercase">Offer PV (Auto Diff)</label>
                    <input type="number" placeholder="Auto Offer PV" class="p-offer-pv w-full px-3 py-2 bg-purple-50 border border-purple-200 rounded-lg text-xs font-bold focus:outline-none" value="${data ? data.offer_pv || '' : ''}" readonly>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end pt-1">
                <div class="md:col-span-3">
                    <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">Normal Disc ₹ (Single)</label>
                    <input type="number" step="0.01" placeholder="0.00" class="p-discount w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:bg-white focus:outline-none" value="${data ? data.discount || '' : ''}">
                </div>
                <div class="md:col-span-3">
                    <label class="block text-[10px] font-black text-amber-600 mb-1 uppercase">Offer Disc ₹ (Auto Cut)</label>
                    <input type="number" step="0.01" placeholder="Auto Offer Disc" class="p-offer-discount w-full px-3 py-2 bg-amber-50 border border-amber-200 rounded-lg text-xs font-bold focus:outline-none" value="${data ? data.offer_discount || '' : ''}" readonly>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 mb-1 uppercase">GST %</label>
                    <input type="number" step="0.01" placeholder="e.g. 18" class="p-gst-pct w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold focus:bg-white focus:outline-none" value="${data ? data.gst_pct || '' : ''}">
                </div>
                <div class="md:col-span-3">
                    <label class="block text-[10px] font-black text-emerald-600 mb-1 uppercase">Base Amount ₹ (Before Offer Cut)</label>
                    <input type="number" step="0.01" placeholder="Base Amount ₹" class="p-net w-full px-3 py-2 bg-emerald-50 border border-emerald-300 rounded-lg text-xs font-black text-emerald-900 focus:outline-none" value="${data ? (data.net_amt + (data.offer_discount || 0) + (data.discount || 0)) : ''}" required>
                </div>
                <div class="md:col-span-1 flex justify-end">
                    <button type="button" onclick="removeProductRow(this)" class="bg-rose-50 text-rose-600 border border-rose-200 hover:bg-rose-600 hover:text-white w-full py-2 rounded-lg font-bold transition-all" title="Delete Product">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            </div>
        `;
        container.appendChild(row);
    }

    // ❌ REMOVE PRODUCT ROW
    function removeProductRow(btn) {
        const rows = document.querySelectorAll('.prod-row');
        if (rows.length > 1) {
            btn.closest('.prod-row').remove();
        } else {
            alert("ઓછામાં ઓછી એક પ્રોડક્ટ તો રાખવી પડશે!");
        }
    }

    // ✏️ EDIT & VIEW COMBO PRESET
    function editCombo(comboData) {
        document.getElementById('comboId').value = comboData.id;
        document.getElementById('comboName').value = comboData.combo_name;

        document.getElementById('formHeading').innerHTML = `<i class="fa-solid fa-pen-to-square text-blue-500"></i> Edit Combo Breakup Preset`;
        document.getElementById('btnSubmitCombo').innerText = "Update Combo In System";
        document.getElementById('btnCancelEdit').classList.remove('hidden');

        const container = document.getElementById('productRowsContainer');
        container.innerHTML = '';

        let products = typeof comboData.products === 'string' ? JSON.parse(comboData.products) : comboData.products;

        if (Array.isArray(products) && products.length > 0) {
            let totOfferDisc = 0;
            let totNormalPv = 0;
            let totOfferPv = 0;

            products.forEach(p => {
                totOfferDisc += parseFloat(p.offer_discount || 0);
                totNormalPv += (parseInt(p.pv || 0) * (parseInt(p.qty) || 1));
                totOfferPv += (parseInt(p.offer_pv || 0) * (parseInt(p.qty) || 1));
            });

            document.getElementById('totalOfferDiscount').value = totOfferDisc > 0 ? totOfferDisc : '';
            // Display total PV target (Normal PV + Offer PV)
            document.getElementById('totalOfferPv').value = (totNormalPv + totOfferPv) > 0 ? (totNormalPv + totOfferPv) : '';

            products.forEach(p => addProductRow(p));
        } else {
            addProductRow();
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 🔄 RESET FORM (CANCEL EDIT)
    function resetForm() {
        document.getElementById('comboId').value = '';
        document.getElementById('comboName').value = '';
        document.getElementById('totalOfferDiscount').value = '';
        document.getElementById('totalOfferPv').value = '';
        document.getElementById('formHeading').innerHTML = `<i class="fa-solid fa-plus-circle text-emerald-500"></i> Add New Combo Breakup Preset`;
        document.getElementById('btnSubmitCombo').innerText = "Save Combo To System";
        document.getElementById('btnCancelEdit').classList.add('hidden');

        const container = document.getElementById('productRowsContainer');
        container.innerHTML = '';
        addProductRow();
    }

    // 💾 SAVE / UPDATE COMBO FORM SUBMIT WITH SMART PV & OFFER DISCOUNT LOGIC
    document.getElementById('comboForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const comboId = document.getElementById('comboId').value;
        const comboName = document.getElementById('comboName').value;
        const totalOfferDiscountInput = parseFloat(document.getElementById('totalOfferDiscount').value) || 0;
        const targetTotalPvInput = parseInt(document.getElementById('totalOfferPv').value) || 0;

        const rows = document.querySelectorAll('.prod-row');
        const totalProductsCount = rows.length;

        // 🎯 1. Calculate sum of Normal PV across all items
        let sumNormalPv = 0;
        rows.forEach(r => {
            const pPv = parseInt(r.querySelector('.p-pv').value) || 0;
            const pQty = parseInt(r.querySelector('.p-qty').value) || 1;
            sumNormalPv += (pPv * pQty);
        });

        // 🎯 2. Calculate remaining extra PV difference (e.g., 500 - 402 = 98 PV)
        let extraPvTotal = 0;
        if (targetTotalPvInput > sumNormalPv) {
            extraPvTotal = targetTotalPvInput - sumNormalPv;
        } else {
            extraPvTotal = targetTotalPvInput;
        }

        // 🎯 3. Equal distribution across products
        const perProductOfferPv = totalProductsCount > 0 ? Math.floor(extraPvTotal / totalProductsCount) : 0;
        const perProductOfferDiscount = totalProductsCount > 0 ? parseFloat((totalOfferDiscountInput / totalProductsCount).toFixed(2)) : 0;

        let products = [];

        rows.forEach((r, idx) => {
            const baseAmount = parseFloat(r.querySelector('.p-net').value) || 0;
            const gstPct = parseFloat(r.querySelector('.p-gst-pct').value) || 18;
            const discount = parseFloat(r.querySelector('.p-discount').value) || 0;
            const qty = parseInt(r.querySelector('.p-qty').value) || 1;
            const normalPv = parseInt(r.querySelector('.p-pv').value) || 0;

            // Set visual value in readonly fields
            r.querySelector('.p-offer-discount').value = perProductOfferDiscount;
            r.querySelector('.p-offer-pv').value = perProductOfferPv;

            // 🎯 GST ON BASE AMOUNT
            const taxableVal = parseFloat((baseAmount / (1 + (gstPct / 100))).toFixed(2));
            const gstAmt = parseFloat((baseAmount - taxableVal).toFixed(2));
            const rate = parseFloat((taxableVal / qty).toFixed(2));

            // 🎯 FINAL NET AMOUNT CUTS BOTH NORMAL DISCOUNT AND PER-PRODUCT OFFER DISCOUNT
            const finalNetAmt = parseFloat((baseAmount - discount - perProductOfferDiscount).toFixed(2));

            products.push({
                sr: idx + 1,
                product: r.querySelector('.p-name').value.toUpperCase().trim(),
                hsn: r.querySelector('.p-hsn').value.trim(),
                qty: qty,
                rate: rate,
                pv: normalPv,
                offer_pv: perProductOfferPv,                   // 🎯 DIFFERENCE OFFER PV
                discount: discount,
                offer_discount: perProductOfferDiscount,       // 🎯 OFFER DISCOUNT CUT
                taxable_val: taxableVal,
                gst_pct: gstPct,
                gst_amt: gstAmt,
                net_amt: finalNetAmt                           // 🎯 FINAL CUT AMOUNT
            });
        });

        const payload = {
            id: comboId || null,
            combo_name: comboName,
            products: products
        };

        try {
            const res = await fetch('/admin/api/save-combo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if(data.success) { 
                alert(comboId ? "કોમ્બો સફળતાપૂર્વક અપડેટ થઈ ગયો છે! 🎉" : "કોમ્બો સફળતાપૂર્વક સેટ થઈ ગયો છે! 🎉");
                location.reload(); 
            } else { 
                alert(data.msg); 
            }
        } catch(e) { 
            console.error(e); 
        }
    });

    // 🗑️ DELETE STORED COMBO PRESET
    async function deleteCombo(id) {
        if(confirm("શું તમે ખરેખર આ કોમ્બો પ્રેસેટ ડીલીટ કરવા માંગો છો?")) {
            try {
                const res = await fetch(`/admin/api/delete-combo/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if(data.success) { location.reload(); } else { alert(data.msg); }
            } catch(e) { console.error(e); }
        }
    }
</script>
</body>
</html>
