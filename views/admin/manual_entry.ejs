<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Manual Entry Workspace - Avira Control Center</title>
    <style>
        /* 3D Dropdown Popover Menu Styles */
        .custom-preset-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(0.97);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .custom-preset-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        /* 📦 Quick Preset Chips Styling */
        .preset-chip {
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .preset-chip:hover {
            transform: translateY(-1px);
        }
        .preset-chip.active {
            background: linear-gradient(135deg, #059669 0%, #10b981 100%) !important;
            color: #ffffff !important;
            border-color: #059669 !important;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35) !important;
        }
        .preset-chip.active .preset-dim {
            color: #d1fae5 !important;
        }
        .preset-chip.active .preset-badge {
            background-color: rgba(255, 255, 255, 0.25) !important;
            color: #ffffff !important;
        }

        /* 🌟 HIGHLIGHT ENGINE FOR QUICK VERIFICATION */
        .field-highlight {
            border-color: #10b981 !important;
            background-color: #f0fdf4 !important;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2) !important;
            font-weight: 800 !important;
            transition: all 0.3s ease;
        }

        .ai-scanned-glow {
            animation: highlightGlow 1.5s ease-in-out 2 alternate;
        }

        @keyframes highlightGlow {
            0% {
                background-color: #fef3c7;
                border-color: #f59e0b;
                box-shadow: 0 0 10px rgba(245, 158, 11, 0.4);
            }
            100% {
                background-color: #ecfdf5;
                border-color: #10b981;
                box-shadow: 0 0 8px rgba(16, 185, 129, 0.3);
            }
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-800 w-full overflow-x-hidden">

    <%- include('../partials/admin_navbar') %>

    <div class="lg:pl-64 flex flex-col min-h-screen w-full min-w-0">
        
        <header class="bg-white/90 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3 flex justify-between items-center sticky top-0 z-30 shadow-sm w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-keyboard text-emerald-500 flex-shrink-0"></i>
                <span class="text-xs sm:text-sm font-bold text-slate-700 uppercase tracking-wider truncate">Manual Entry</span>
            </div>
            
            <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-bold text-slate-800">Avira Admin</p>
                    <p class="text-[9px] font-bold text-emerald-500 uppercase tracking-widest">Active Workspace</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-500 border border-emerald-100 font-bold text-xs shadow-sm">A</div>
            </div>
        </header>

        <main class="flex-grow w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-4 sm:space-y-6 box-border">
            
            <div class="bg-gradient-to-r from-emerald-600 to-teal-700 p-4 sm:p-5 rounded-2xl shadow-md text-white flex flex-col sm:flex-row justify-between items-center gap-4 w-full box-border">
                <div class="flex items-center gap-3 min-w-0 w-full sm:w-auto">
                    <div class="h-10 w-10 sm:h-12 sm:w-12 rounded-xl bg-white/10 backdrop-blur-md flex items-center justify-center text-lg sm:text-xl flex-shrink-0 border border-white/20">
                        <i class="fa-solid fa-bolt text-amber-300"></i>
                    </div>
                    <div class="min-w-0">
                        <h2 class="text-xs sm:text-base font-black uppercase tracking-wide truncate">AI Smart Label Scanner</h2>
                        <p class="text-[10px] sm:text-[11px] text-emerald-100 mt-0.5 truncate sm:whitespace-normal">Scan parcel labels to auto-fill Tracking ID, Name, Mobile, and Pincode instantly.</p>
                    </div>
                </div>
                <div class="w-full sm:w-auto flex-shrink-0">
                    <input type="file" id="cameraInput" accept="image/*" capture="environment" class="hidden">
                    <button type="button" onclick="document.getElementById('cameraInput').click()" class="w-full sm:w-auto bg-white hover:bg-slate-100 text-slate-950 font-black text-xs px-4 py-2.5 rounded-xl shadow transition-all uppercase tracking-wider cursor-pointer flex items-center justify-center gap-2 flex-shrink-0 whitespace-nowrap">
                        <i class="fa-solid fa-expand text-emerald-600"></i> Scan with Camera
                    </button>
                </div>
            </div>

            <div id="ocrStatusBox" class="hidden bg-slate-900 text-white p-3 rounded-xl text-xs font-bold flex items-center justify-between shadow-md">
                <span id="ocrStatusText" class="flex items-center gap-2"><i class="fa-solid fa-bolt animate-bounce text-amber-400"></i> AI Scanning Label...</span>
                <span id="ocrProgress" class="font-mono text-emerald-400 text-[10px]"><i class="fa-solid fa-microchip mr-1"></i> Gemini Vision AI</span>
            </div>

            <div class="bg-white p-4 sm:p-6 lg:p-8 rounded-2xl border border-slate-100 shadow-md w-full">
                <div class="border-b border-slate-100 pb-2.5 mb-4 flex justify-between items-center">
                    <h2 class="text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-plus text-emerald-500"></i> Add New Dispatch
                    </h2>
                    <span id="highlightNotice" class="hidden text-[10px] font-black text-emerald-600 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg">
                        <i class="fa-solid fa-eye mr-1"></i> Details Highlighted for Verification
                    </span>
                </div>

                <form id="manualEntryForm" class="space-y-4 text-xs w-full">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                        <div>
                            <label class="block font-bold text-slate-600 mb-1 flex items-center justify-between">
                                Tracking Number
                                <span class="text-[9px] text-slate-400 font-normal uppercase">Required</span>
                            </label>
                            <input type="text" id="mTracking" required class="manual-field w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 uppercase font-mono font-bold focus:outline-none focus:border-emerald-500 transition-all">
                        </div>
                        <div>
                            <label class="block font-bold text-slate-600 mb-1 flex items-center justify-between">
                                Receiver Name / Order Link
                                <span class="text-[9px] text-slate-400 font-normal uppercase">Required</span>
                            </label>
                            <input type="text" id="mReceiverName" required class="manual-field w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 uppercase font-semibold focus:outline-none focus:border-emerald-500 transition-all">
                        </div>
                        <div>
                            <label class="block font-bold text-slate-600 mb-1 flex items-center justify-between">
                                Receiver Mobile Number
                                <span class="text-[9px] text-slate-400 font-normal uppercase">10 Digits</span>
                            </label>
                            <input type="text" id="mMobile" required maxlength="10" placeholder="10 Digits Only"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').substring(0, 10);" 
                                   class="manual-field w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 font-mono font-bold focus:outline-none focus:border-emerald-500 transition-all">
                        </div>
                        <div>
                            <label class="block font-bold text-slate-600 mb-1 flex items-center justify-between">
                                Receiver Pincode
                                <span class="text-[9px] text-slate-400 font-normal uppercase">6 Digits</span>
                            </label>
                            <input type="text" id="mPincode" maxlength="6" required oninput="this.value = this.value.replace(/[^0-9]/g, '');"
                                   class="manual-field w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 font-mono font-bold focus:outline-none focus:border-emerald-500 transition-all">
                        </div>
                    </div>

                    <div class="bg-slate-50/80 p-3.5 rounded-xl border border-slate-100 space-y-3">
                        <div class="flex flex-wrap justify-between items-center gap-2 border-b border-slate-200/60 pb-2">
                            <div class="flex flex-wrap items-center gap-2">
                                <label class="font-bold text-slate-700 flex items-center gap-1.5 text-xs">
                                    <i class="fa-solid fa-boxes-packing text-emerald-500"></i> Box Dimensions & Presets
                                </label>
                                <label class="inline-flex items-center gap-1.5 cursor-pointer text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200 hover:bg-emerald-100/70 transition-all select-none" title="Keeps the selected box dimensions pre-filled for consecutive parcel entries">
                                    <input type="checkbox" id="chkKeepPreset" checked class="accent-emerald-600 rounded cursor-pointer h-3.5 w-3.5">
                                    <span><i class="fa-solid fa-thumbtack text-emerald-600 text-[9px]"></i> Keep Box for Next Entry</span>
                                </label>
                            </div>
                            
                            <div class="flex items-center gap-2">
                                <a href="/admin/settings" target="_blank" class="text-[10px] font-bold text-slate-400 hover:text-emerald-600 flex items-center gap-1 transition-all">
                                    <i class="fa-solid fa-gear"></i> Manage
                                </a>
                                <div class="relative w-40 sm:w-52">
                                    <button type="button" id="presetBtn" class="w-full bg-white border border-slate-200 rounded-lg px-2.5 py-1 text-[11px] font-bold text-slate-700 hover:border-emerald-400 focus:outline-none shadow-xs flex justify-between items-center cursor-pointer transition-all">
                                        <span id="selectedPresetLabel" class="flex items-center gap-1.5 truncate">
                                            <i class="fa-solid fa-bolt text-amber-400 text-[10px]"></i> More Presets...
                                        </span>
                                        <i id="presetChevron" class="fa-solid fa-chevron-down text-[9px] text-slate-400 transition-transform duration-300"></i>
                                    </button>

                                    <div id="presetMenu" class="custom-preset-menu absolute right-0 top-full mt-1 w-64 bg-white border border-slate-200 rounded-xl shadow-xl z-50 p-1.5 space-y-1">
                                        <p class="p-2 text-center text-[10px] text-slate-400 font-semibold">Loading Presets...</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ⚡ 1-Click Quick Preset Chips Container -->
                        <div id="presetChipsContainer" class="flex flex-wrap items-center gap-2">
                            <span class="text-[10px] font-bold uppercase text-slate-400 flex items-center gap-1">
                                <i class="fa-solid fa-hand-pointer text-emerald-500"></i> 1-Click Box:
                            </span>
                            <div id="presetChipsList" class="flex flex-wrap items-center gap-1.5">
                                <span class="text-[10px] text-slate-400 font-semibold">Loading quick boxes...</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 pt-1">
                            <div>
                                <label class="block font-semibold text-slate-400 mb-1 text-xs">Weight (Grams / g)</label>
                                <input type="number" id="mWeight" placeholder="e.g. 500" required class="manual-field w-full px-2.5 py-1.5 bg-white rounded-lg border border-slate-200 focus:outline-none focus:border-emerald-500 font-bold text-xs transition-all">
                            </div>
                            <div>
                                <label class="block font-semibold text-slate-400 mb-1 text-xs">Length (cm)</label>
                                <input type="number" id="mLength" required class="manual-field w-full px-2.5 py-1.5 bg-white rounded-lg border border-slate-200 focus:outline-none focus:border-emerald-500 font-bold text-xs transition-all">
                            </div>
                            <div>
                                <label class="block font-semibold text-slate-400 mb-1 text-xs">Breadth (cm)</label>
                                <input type="number" id="mBreadth" required class="manual-field w-full px-2.5 py-1.5 bg-white rounded-lg border border-slate-200 focus:outline-none focus:border-emerald-500 font-bold text-xs transition-all">
                            </div>
                            <div>
                                <label class="block font-semibold text-slate-400 mb-1 text-xs">Height (cm)</label>
                                <input type="number" id="mHeight" required class="manual-field w-full px-2.5 py-1.5 bg-white rounded-lg border border-slate-200 focus:outline-none focus:border-emerald-500 font-bold text-xs transition-all">
                            </div>
                        </div>
                    </div>

                    <div class="bg-emerald-50/40 p-3.5 rounded-xl border border-emerald-100/70 grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-[10px] font-bold text-emerald-800 mb-1">City</label>
                            <input type="text" id="txtCity" placeholder="MANUAL / AUTO" class="manual-field w-full px-3 py-1.5 bg-white border border-emerald-200/80 rounded-lg text-[11px] font-extrabold uppercase focus:outline-none focus:border-emerald-500 transition-all">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-emerald-800 mb-1">State</label>
                            <input type="text" id="txtState" placeholder="MANUAL / AUTO" class="manual-field w-full px-3 py-1.5 bg-white border border-emerald-200/80 rounded-lg text-[11px] font-extrabold uppercase focus:outline-none focus:border-emerald-500 transition-all">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-emerald-800 mb-1">Area / Address Line</label>
                            <input type="text" id="txtAddress" placeholder="MANUAL / AUTO" class="manual-field w-full px-3 py-1.5 bg-white border border-emerald-200/80 rounded-lg text-[11px] font-extrabold uppercase focus:outline-none focus:border-emerald-500 transition-all">
                        </div>
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="submit" class="w-full sm:w-auto bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-black px-6 py-3 rounded-xl transition-all shadow-md cursor-pointer uppercase tracking-wider flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-circle-check text-sm"></i> SAVE ENTRY
                        </button>
                    </div>
                </form>
            </div>

            <div class="bg-white rounded-2xl border border-slate-100 shadow-md overflow-hidden w-full">
                <div class="px-4 py-3 bg-slate-50 border-b border-slate-100 flex justify-between items-center flex-wrap gap-2">
                    <div class="flex items-center gap-3">
                        <h2 class="text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-2">
                            <i class="fa-solid fa-list-check text-slate-400"></i> Current Session Entries
                        </h2>
                        <span id="entryCounter" class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">
                            Total Entries: 0
                        </span>
                    </div>
                    
                    <button id="exportExcelBtn" class="bg-slate-900 hover:bg-slate-950 text-white font-black text-[11px] px-3.5 py-2 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer shadow-sm">
                        <i class="fa-solid fa-file-excel text-emerald-400"></i> EXPORT EXCEL
                    </button>
                </div>
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[650px]">
                        <thead>
                            <tr class="bg-slate-100/70 border-b border-slate-100 text-slate-400 font-bold uppercase select-none">
                                <th class="py-3 px-3 w-12 cursor-pointer hover:text-emerald-600 transition-colors" onclick="toggleSortOrder()">
                                    SR <i class="fa-solid fa-sort text-[10px] ml-0.5" id="sortIcon"></i>
                                </th>
                                <th class="py-3 px-4">Tracking No</th>
                                <th class="py-3 px-4">Receiver Name</th>
                                <th class="py-3 px-4">Mobile</th>
                                <th class="py-3 px-4">Pincode & Location</th>
                                <th class="py-3 px-4">Weight & Dimensions</th>
                                <th class="py-3 px-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="sessionTableBody" class="divide-y divide-slate-50 font-medium text-slate-700">
                            <tr>
                                <td colspan="7" class="py-8 text-center text-slate-400 font-normal">No entries added in this session yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>

        <footer class="bg-white border-t border-slate-100 py-3 text-center text-xs font-medium text-slate-400 mt-6 w-full">
            &copy; 2026 Avira LifeCare. All rights reserved.
        </footer>
    </div>

    <script>
        let localEntries = JSON.parse('<%- JSON.stringify(entries || []) %>');
        let isNewestFirst = true;

        window.onload = () => { 
            document.getElementById('mTracking').focus(); 
            renderTable(); 
            loadPresetsFromDB();
            setupInputHighlightListeners();
        };

        function setupInputHighlightListeners() {
            const inputs = document.querySelectorAll('.manual-field');
            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.classList.add('field-highlight');
                    } else {
                        this.classList.remove('field-highlight');
                    }
                });
            });
        }

        function triggerFieldHighlight(elementId) {
            const el = document.getElementById(elementId);
            if (el && el.value.trim() !== '') {
                el.classList.add('field-highlight', 'ai-scanned-glow');
            }
        }

        function toggleSortOrder() {
            isNewestFirst = !isNewestFirst;
            const sortIcon = document.getElementById('sortIcon');
            if (isNewestFirst) {
                sortIcon.className = "fa-solid fa-sort-down text-emerald-600 ml-0.5";
            } else {
                sortIcon.className = "fa-solid fa-sort-up text-emerald-600 ml-0.5";
            }
            renderTable();
        }

        let currentSelectedPreset = null;
        let activeBoxPresets = [];

        async function loadPresetsFromDB() {
            const chipsList = document.getElementById('presetChipsList');
            const menu = document.getElementById('presetMenu');
            try {
                const res = await fetch('/admin/api/get-box-presets');
                const data = await res.json();
                
                let presets = (data.success && data.presets && data.presets.length > 0) ? data.presets : [
                    { id: 1, name: 'SHAMPOO box', length: '21', breadth: '8', height: '8' },
                    { id: 2, name: '2 SHAMPOO BOX', length: '21', breadth: '13', height: '7' },
                    { id: 3, name: 'CHOCO SINGLE BOX', length: '15', breadth: '10', height: '10' },
                    { id: 4, name: 'TWO CHOCO BOX', length: '21', breadth: '13', height: '10' },
                    { id: 5, name: 'OFFER SMALL BOX', length: '21', breadth: '21', height: '10' },
                    { id: 6, name: 'OFFER BIG', length: '23', breadth: '21', height: '21' }
                ];

                activeBoxPresets = presets;
                chipsList.innerHTML = '';
                menu.innerHTML = '';

                presets.forEach((p, idx) => {
                    const shortcutNum = idx + 1;
                    const chipId = `preset-chip-${p.id || idx}`;
                    const safeName = (p.name || `Box ${shortcutNum}`).replace(/'/g, "\\'");
                    
                    // ⚡ 1-Click Quick Chip Button
                    chipsList.innerHTML += `
                        <button type="button" id="${chipId}" onclick="selectBoxPreset(${p.length}, ${p.breadth}, ${p.height}, '${safeName}', '${chipId}')"
                            class="preset-chip group flex items-center gap-1.5 px-2.5 py-1 bg-white hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 border border-slate-200 hover:border-emerald-300 rounded-lg text-xs font-bold transition-all shadow-xs cursor-pointer select-none"
                            title="Shortcut: Alt+${shortcutNum} | Size: ${p.length}x${p.breadth}x${p.height} cm">
                            <span class="preset-badge inline-flex items-center justify-center w-4 h-4 rounded bg-slate-100 text-slate-500 group-hover:bg-emerald-200 group-hover:text-emerald-800 text-[9px] font-mono font-black">${shortcutNum}</span>
                            <span class="truncate max-w-[120px] sm:max-w-[150px] uppercase">${p.name}</span>
                            <span class="preset-dim text-[10px] text-slate-400 font-mono font-normal">(${p.length}x${p.breadth}x${p.height})</span>
                        </button>
                    `;

                    // Dropdown Menu Item
                    const firstChar = p.name ? p.name.charAt(0).toUpperCase() : 'B';
                    menu.innerHTML += `
                        <div onclick="selectBoxPreset(${p.length}, ${p.breadth}, ${p.height}, '${safeName}', '${chipId}')" 
                             class="flex items-center justify-between p-2 rounded-lg hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 cursor-pointer transition-all">
                            <div class="flex items-center gap-2 truncate">
                                <div class="h-6 w-6 rounded-md bg-emerald-100 flex items-center justify-center text-emerald-600 font-bold text-[10px] flex-shrink-0">${firstChar}</div>
                                <div class="truncate">
                                    <p class="text-xs font-bold uppercase truncate">${p.name}</p>
                                    <p class="text-[9px] text-slate-400 font-medium">${p.length} x ${p.breadth} x ${p.height} cm</p>
                                </div>
                            </div>
                            <span class="text-[9px] font-mono text-slate-400 font-bold bg-slate-100 px-1.5 py-0.5 rounded flex-shrink-0">Alt+${shortcutNum}</span>
                        </div>
                    `;
                });

            } catch (err) {
                console.error("Fetch Presets Error:", err);
            }
        }

        const presetBtn = document.getElementById('presetBtn');
        const presetMenu = document.getElementById('presetMenu');
        const presetChevron = document.getElementById('presetChevron');

        presetBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const isActive = presetMenu.classList.contains('active');
            if (isActive) {
                closePresetDropdown();
            } else {
                presetMenu.classList.add('active');
                presetChevron.classList.add('rotate-180');
            }
        });

        document.addEventListener('click', function(e) {
            if (!presetBtn.contains(e.target) && !presetMenu.contains(e.target)) {
                closePresetDropdown();
            }
        });

        function closePresetDropdown() {
            presetMenu.classList.remove('active');
            presetChevron.classList.remove('rotate-180');
        }

        // 📦 Direct 1-Click Box Preset Selection
        function selectBoxPreset(l, b, h, label, chipId) {
            currentSelectedPreset = { length: l, breadth: b, height: h, label: label, chipId: chipId };

            document.getElementById('mLength').value = l;
            document.getElementById('mBreadth').value = b;
            document.getElementById('mHeight').value = h;
            
            triggerFieldHighlight('mLength');
            triggerFieldHighlight('mBreadth');
            triggerFieldHighlight('mHeight');

            document.getElementById('selectedPresetLabel').innerHTML = `<i class="fa-solid fa-check text-emerald-500 text-[10px]"></i> <span class="truncate">${label}</span>`;

            // Active visual toggle on chips
            document.querySelectorAll('.preset-chip').forEach(c => c.classList.remove('active'));
            if (chipId) {
                const activeChip = document.getElementById(chipId);
                if (activeChip) activeChip.classList.add('active');
            }

            closePresetDropdown();

            // Auto-focus weight if empty
            const weightInput = document.getElementById('mWeight');
            if (!weightInput.value) {
                weightInput.focus();
            }
        }

        // ⌨️ Fast Keyboard Shortcuts: Alt + 1, Alt + 2 ... Alt + 9 for Instant Preset Selection
        document.addEventListener('keydown', function(e) {
            if (e.altKey && e.key >= '1' && e.key <= '9') {
                const idx = parseInt(e.key) - 1;
                if (activeBoxPresets && activeBoxPresets[idx]) {
                    e.preventDefault();
                    const p = activeBoxPresets[idx];
                    selectBoxPreset(p.length, p.breadth, p.height, p.name, `preset-chip-${p.id || idx}`);
                }
            }
        });

        document.getElementById('cameraInput').addEventListener('change', async function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const statusBox = document.getElementById('ocrStatusBox');
            const statusText = document.getElementById('ocrStatusText');
            
            statusBox.classList.remove('hidden');
            statusText.innerHTML = `<i class="fa-solid fa-bolt animate-bounce text-amber-400"></i> Compressing & AI Scanning...`;

            try {
                const compressedBlob = await compressImage(file);
                const formData = new FormData();
                formData.append('labelImage', compressedBlob, 'label.jpg');

                const res = await fetch('/admin/api/scan-ai-label', {
                    method: 'POST',
                    body: formData
                });
                const result = await res.json();
                statusBox.classList.add('hidden');

                if (result.success && result.data) {
                    const { tracking, name, mobile, pincode } = result.data;

                    if (tracking) {
                        document.getElementById('mTracking').value = tracking.toUpperCase().trim();
                        triggerFieldHighlight('mTracking');
                    }
                    if (name) {
                        document.getElementById('mReceiverName').value = name.toUpperCase().trim();
                        triggerFieldHighlight('mReceiverName');
                    }
                    if (mobile) {
                        document.getElementById('mMobile').value = mobile.trim();
                        triggerFieldHighlight('mMobile');
                    }
                    if (pincode) {
                        const cleanPin = pincode.toString().trim();
                        document.getElementById('mPincode').value = cleanPin;
                        triggerFieldHighlight('mPincode');
                        await fetchPincodeDetails(cleanPin);
                    }

                    document.getElementById('highlightNotice').classList.remove('hidden');
                    document.getElementById('mWeight').focus();
                } else {
                    alert(result.msg || "AI could not read the label image clearly. Please try again.");
                }
            } catch (err) {
                console.error("AI Scan Error:", err);
                statusText.innerText = "Scanning error! Please try again.";
                setTimeout(() => statusBox.classList.add('hidden'), 3000);
            }

            this.value = '';
        });

        function compressImage(file) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const maxWidth = 800; 
                        let width = img.width;
                        let height = img.height;

                        if (width > maxWidth) {
                            height = Math.round((height * maxWidth) / width);
                            width = maxWidth;
                        }

                        canvas.width = width;
                        canvas.height = height;

                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        canvas.toBlob((blob) => {
                            resolve(blob);
                        }, 'image/jpeg', 0.55);
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        async function fetchPincodeDetails(pincode) {
            try {
                const res = await fetch(`/admin/api/fetch-details?pincode=${pincode}`);
                const data = await res.json();
                if (data.success && (data.city || data.state || data.address)) {
                    document.getElementById('txtCity').value = data.city || '';
                    document.getElementById('txtState').value = data.state || '';
                    document.getElementById('txtAddress').value = data.address || '';

                    triggerFieldHighlight('txtCity');
                    triggerFieldHighlight('txtState');
                    triggerFieldHighlight('txtAddress');
                }
            } catch(err) {
                console.error("Auto-fetch address error:", err);
            }
        }

        document.getElementById('mPincode').addEventListener('input', async function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
            const pincode = this.value.trim();
            
            if (pincode.length === 6) {
                await fetchPincodeDetails(pincode);
            } else {
                document.getElementById('txtCity').value = '';
                document.getElementById('txtState').value = '';
                document.getElementById('txtAddress').value = '';
            }
        });

        document.getElementById('manualEntryForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const weightGrams = parseFloat(document.getElementById('mWeight').value || 0);

            const payload = {
                tracking: document.getElementById('mTracking').value.toUpperCase().trim(),
                name: document.getElementById('mReceiverName').value.toUpperCase().trim(),
                mobile: document.getElementById('mMobile').value.trim(),
                pincode: document.getElementById('mPincode').value.trim(),
                weight: weightGrams,
                rawGrams: weightGrams,
                length: document.getElementById('mLength').value,
                breadth: document.getElementById('mBreadth').value,
                height: document.getElementById('mHeight').value,
                city: document.getElementById('txtCity').value.toUpperCase().trim() || 'N/A',
                state: document.getElementById('txtState').value.toUpperCase().trim() || 'N/A',
                address: document.getElementById('txtAddress').value.toUpperCase().trim() || 'N/A'
            };

            try {
                const res = await fetch('/admin/api/save-manual', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                
                if(result.success) {
                    localEntries = result.entries;
                    renderTable();
                    
                    const keepPreset = document.getElementById('chkKeepPreset')?.checked;

                    document.getElementById('manualEntryForm').reset();
                    document.querySelectorAll('.manual-field').forEach(field => {
                        field.classList.remove('field-highlight', 'ai-scanned-glow');
                    });
                    document.getElementById('highlightNotice').classList.add('hidden');
                    
                    document.getElementById('txtCity').value = '';
                    document.getElementById('txtState').value = '';
                    document.getElementById('txtAddress').value = '';

                    // 📌 Sticky Preset: If enabled, retain last selected box dimensions
                    if (keepPreset && currentSelectedPreset) {
                        document.getElementById('mLength').value = currentSelectedPreset.length;
                        document.getElementById('mBreadth').value = currentSelectedPreset.breadth;
                        document.getElementById('mHeight').value = currentSelectedPreset.height;
                        document.getElementById('selectedPresetLabel').innerHTML = `<i class="fa-solid fa-check text-emerald-500 text-[10px]"></i> <span class="truncate">${currentSelectedPreset.label}</span>`;
                        if (currentSelectedPreset.chipId) {
                            const chip = document.getElementById(currentSelectedPreset.chipId);
                            if (chip) chip.classList.add('active');
                        }
                    } else {
                        currentSelectedPreset = null;
                        document.querySelectorAll('.preset-chip').forEach(c => c.classList.remove('active'));
                        document.getElementById('selectedPresetLabel').innerHTML = `<i class="fa-solid fa-bolt text-amber-400 text-[10px]"></i> More Presets...`;
                    }
                    
                    document.getElementById('mTracking').focus();
                }
            } catch(err) { console.error(err); }
        });

        function renderTable() {
            const tbody = document.getElementById('sessionTableBody');
            const counter = document.getElementById('entryCounter');
            
            if (!localEntries) localEntries = [];
            counter.innerText = `Total Entries: ${localEntries.length}`;

            if (localEntries.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-400 font-normal">No entries added in this session yet.</td></tr>`;
                return;
            }

            let sortedList = localEntries.map((item, idx) => ({ ...item, originalIndex: idx + 1 }));

            if (isNewestFirst) {
                sortedList.reverse();
            }

            tbody.innerHTML = '';
            sortedList.forEach((item) => {
                const cityStateText = (item.city || item.state) ? `${item.city || ''}, ${item.state || ''}` : '';
                const dimText = (item.length && item.breadth && item.height) ? `${item.length}x${item.breadth}x${item.height} cm` : 'N/A';
                
                let weightDisplay = 'N/A';
                if (item.weight !== undefined && item.weight !== null && item.weight !== '') {
                    weightDisplay = `${item.weight} g`;
                } else if (item.rawGrams) {
                    weightDisplay = `${item.rawGrams} g`;
                }

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/50">
                        <td class="py-3 px-3 font-mono font-bold text-slate-400">${item.originalIndex}</td>
                        <td class="py-3 px-4 font-mono font-bold text-slate-900">${item.tracking || 'N/A'}</td>
                        <td class="py-3 px-4 uppercase font-bold text-emerald-700">${item.name || 'N/A'}</td>
                        <td class="py-3 px-4 font-mono font-semibold">${item.mobile || 'N/A'}</td>
                        <td class="py-3 px-4">
                            <div class="font-mono font-bold text-emerald-600">${item.pincode || 'N/A'}</div>
                            <div class="text-[10px] uppercase font-bold text-slate-400">${cityStateText}</div>
                        </td>
                        <td class="py-3 px-4">
                            <div class="font-bold text-slate-800">${weightDisplay}</div>
                            <div class="font-mono text-[10px] text-slate-400 font-medium">${dimText}</div>
                        </td>
                        <td class="py-3 px-4 text-center">
                            <button type="button" onclick="deleteItem(${item.id})" class="text-rose-500 hover:text-rose-600 font-bold cursor-pointer"><i class="fa-solid fa-trash"></i> Delete</button>
                        </td>
                    </tr>
                `;
            });
        }

        async function deleteItem(id) {
            if(!id) {
                alert("Invalid entry ID!");
                return;
            }
            if(confirm("Are you sure you want to delete this entry?")) {
                try {
                    const res = await fetch(`/admin/api/delete-entry/${id}`, { method: 'DELETE' });
                    const result = await res.json();
                    if(result.success) {
                        localEntries = result.entries;
                        renderTable();
                    } else {
                        alert("Error: " + (result.msg || "Failed to delete"));
                    }
                } catch(err) { console.error(err); }
            }
        }

        document.getElementById('exportExcelBtn').addEventListener('click', function() {
            if(localEntries.length === 0) {
                alert("Please add at least one entry before exporting.");
                return;
            }
            let customName = prompt("Enter file name for Excel export:", "avira_india_post_dispatch");
            if (customName === null) return;
            if (customName.trim() === "") customName = "avira_india_post_dispatch";

            window.location.href = `/admin/api/export-excel?filename=${encodeURIComponent(customName)}`;
        });
    </script>
</body>
</html>
