<%
    const safeConsignments = (typeof consignments !== 'undefined' && Array.isArray(consignments)) ? consignments : [];
    const safeActiveConsignment = (typeof activeConsignment !== 'undefined' && activeConsignment) ? activeConsignment : null;
    const safeActiveParcels = (typeof activeParcels !== 'undefined' && Array.isArray(activeParcels)) ? activeParcels : [];
%>
<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Consignments & Manual Entry - Avira Control Center</title>
    <style>
        body {
            background-color: #f8fafc;
            color: #0f172a;
        }

        .ref-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .ref-card:hover {
            border-color: #cbd5e1;
        }

        /* 🛡️ Strict Non-Overlapping Input System */
        .ref-input {
            width: 100%;
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 0.75rem;
            padding-top: 0.65rem;
            padding-bottom: 0.65rem;
            padding-left: 0.875rem;
            padding-right: 0.875rem;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #0f172a;
            transition: all 0.15s ease;
            box-sizing: border-box !important;
        }
        .ref-input::placeholder {
            color: #94a3b8;
            font-weight: 500;
        }
        .ref-input:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        /* Absolute clearance for icons so placeholder/text never collides */
        .ref-input-icon-left {
            padding-left: 2.75rem !important; /* 44px */
        }
        .ref-input-icon-right {
            padding-right: 2.75rem !important; /* 44px */
        }
        .ref-input-icon-both {
            padding-left: 2.75rem !important;  /* 44px */
            padding-right: 4.75rem !important; /* 76px */
        }

        /* 3D Dropdown Popover Menu Styles */
        .custom-preset-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(0.97);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .custom-preset-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        /* 📦 Quick Preset Chips Styling (Small, Compact, Sleek) */
        .preset-chip {
            transition: all 0.15s ease;
        }
        .preset-chip:hover {
            border-color: #2563eb;
            background-color: #eff6ff;
            color: #2563eb;
        }
        .preset-chip.active {
            background-color: #eff6ff !important;
            border-color: #2563eb !important;
            color: #2563eb !important;
        }
        .preset-chip.active .preset-dim {
            color: #3b82f6 !important;
        }
        .preset-chip.active .preset-badge {
            background-color: #2563eb !important;
            color: #ffffff !important;
        }

        /* 🌟 Highlight field on input */
        .field-highlight {
            border-color: #2563eb !important;
            background-color: #f8faff !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
        }

        /* Teal Save Button */
        .btn-teal-save {
            background-color: #0d9488;
            color: #ffffff;
            transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 2px 6px rgba(13, 148, 136, 0.25);
        }
        .btn-teal-save:hover {
            background-color: #0f766e;
            box-shadow: 0 4px 12px rgba(13, 148, 136, 0.35);
            transform: translateY(-1px);
        }
        .btn-teal-save:active {
            transform: translateY(1px);
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-800 w-full overflow-x-hidden">

    <%- include('../partials/admin_navbar') %>

    <div class="lg:pl-64 flex flex-col min-h-screen w-full min-w-0">
        
        <!-- 🧭 Top Navigation Header -->
        <header class="bg-white border-b border-slate-200 px-4 sm:px-8 py-3 flex justify-between items-center sticky top-0 z-30 w-full">
            <div class="flex items-center gap-3">
                <button type="button" onclick="toggleMobileSidebar()" class="text-slate-500 hover:text-slate-800 p-1.5 rounded-lg lg:hidden cursor-pointer">
                    <i class="fa-solid fa-bars text-sm"></i>
                </button>
                <button type="button" onclick="toggleMobileSidebar()" class="text-slate-400 hover:text-slate-700 hidden lg:inline-flex cursor-pointer p-1">
                    <i class="fa-solid fa-bars-staggered text-sm"></i>
                </button>
            </div>

            <!-- Global Search Pill -->
            <div class="relative w-full max-w-sm sm:max-w-md mx-4">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                <input type="text" placeholder="Search consignments, tracking number, order..." 
                       class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 placeholder:text-slate-400 placeholder:font-normal focus:outline-none focus:border-blue-500 focus:bg-white transition-all">
            </div>

            <!-- Right Profile & Notification Controls -->
            <div class="flex items-center gap-3.5 flex-shrink-0">
                <button type="button" class="relative p-2 rounded-xl text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-all cursor-pointer" title="Notifications">
                    <i class="fa-regular fa-bell text-sm"></i>
                    <span class="absolute top-1.5 right-1.5 h-2 w-2 rounded-full bg-rose-500 ring-2 ring-white"></span>
                </button>
                
                <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
                    <div class="h-8 w-8 rounded-full bg-[#1e293b] text-white flex items-center justify-center font-bold text-xs shadow-xs">
                        A
                    </div>
                    <span class="text-xs font-bold text-slate-800 hidden sm:inline">Admin</span>
                    <i class="fa-solid fa-chevron-down text-[9px] text-slate-400 hidden sm:inline"></i>
                </div>
            </div>
        </header>

        <main class="flex-grow w-full px-4 sm:px-6 lg:px-8 xl:px-10 py-5 space-y-5 box-border">

            <!-- ============================================================== -->
            <!-- 📦 VIEW 1: CONSIGNMENTS HUB (CREATE & PAST CONSIGNMENTS) -->
            <!-- (SHOWN FIRST ON PAGE LOAD UNTIL USER OPENS A CONSIGNMENT) -->
            <!-- ============================================================== -->
            <div id="consignmentsHubView" class="<%= safeActiveConsignment ? 'hidden' : '' %> space-y-5">
                
                <!-- Hub Header -->
                <div class="flex items-center justify-between flex-wrap gap-3">
                    <div>
                        <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                            <i class="fa-solid fa-boxes-packing text-blue-600"></i> Consignments Management
                        </h1>
                        <p class="text-xs text-slate-500 font-medium mt-0.5">Create a new dispatch batch or open an existing consignment to input parcels.</p>
                    </div>
                    <div>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-700 text-xs font-bold font-mono">
                            <i class="fa-solid fa-layer-group text-slate-500"></i>
                            Total Batches: <span id="hubBatchCount"><%= safeConsignments.length %></span>
                        </span>
                    </div>
                </div>

                <!-- ➕ CREATE NEW CONSIGNMENT CARD (Consignment No field removed; auto-generated) -->
                <div class="ref-card p-5 sm:p-6 space-y-4">
                    <div class="flex items-center justify-between flex-wrap gap-2 border-b border-slate-100 pb-3">
                        <div class="flex items-center gap-2.5">
                            <div class="h-9 w-9 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center text-sm shadow-2xs">
                                <i class="fa-solid fa-folder-plus"></i>
                            </div>
                            <div>
                                <h2 class="text-sm font-extrabold text-slate-900 uppercase tracking-wide">Create New Consignment</h2>
                                <p class="text-[11px] text-slate-400 font-medium">Consignment number is automatically generated with a unique sequence.</p>
                            </div>
                        </div>
                    </div>

                    <form id="createConsignmentForm" class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
                        <div>
                            <label class="block font-bold text-slate-700 text-xs mb-1.5">
                                Dispatch Title <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <i class="fa-solid fa-tag absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                <input type="text" id="newConsignmentTitle" required placeholder="e.g. Morning Dispatch" 
                                       class="ref-input ref-input-icon-left font-semibold">
                            </div>
                        </div>

                        <div>
                            <label class="block font-bold text-slate-700 text-xs mb-1.5">
                                Dispatch Date <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <i class="fa-regular fa-calendar absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                <input type="text" id="newConsignmentDate" required placeholder="e.g. 28 Oct 2026" 
                                       class="ref-input ref-input-icon-left font-semibold">
                            </div>
                        </div>

                        <div>
                            <button type="submit" id="btnCreateConsignment" 
                                    class="w-full bg-blue-600 hover:bg-blue-700 text-white font-black text-xs py-2.5 px-4 rounded-xl transition-all shadow-xs uppercase tracking-wider cursor-pointer flex items-center justify-center gap-2">
                                <i class="fa-solid fa-plus text-xs"></i>
                                <span>CREATE & OPEN CONSIGNMENT</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- 📋 EXISTING CONSIGNMENTS HISTORY TABLE -->
                <div class="ref-card overflow-hidden">
                    <div class="px-5 py-4 bg-slate-50/80 border-b border-slate-200 flex justify-between items-center flex-wrap gap-2">
                        <div class="flex items-center gap-2.5">
                            <i class="fa-solid fa-clock-rotate-left text-slate-600 text-sm"></i>
                            <h2 class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">
                                Existing Consignments History
                            </h2>
                        </div>
                        <div class="relative">
                            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                            <input type="text" id="searchConsignmentsInput" placeholder="Filter consignments..." 
                                   class="ref-input ref-input-icon-left text-xs py-1.5 w-52 font-medium">
                        </div>
                    </div>

                    <div class="overflow-x-auto w-full">
                        <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[700px]">
                            <thead>
                                <tr class="bg-slate-100/70 border-b border-slate-200 text-slate-500 font-extrabold uppercase select-none text-[11px]">
                                    <th class="py-3 px-4 w-12 text-center">#</th>
                                    <th class="py-3 px-4">Consignment No</th>
                                    <th class="py-3 px-4">Title</th>
                                    <th class="py-3 px-4">Dispatch Date</th>
                                    <th class="py-3 px-4 text-center">Total Parcels</th>
                                    <th class="py-3 px-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="consignmentsTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                                <% if (safeConsignments && safeConsignments.length > 0) { %>
                                    <% for (let idx = 0; idx < safeConsignments.length; idx++) { let c = safeConsignments[idx]; %>
                                        <tr class="hover:bg-slate-50 transition-colors consignment-row">
                                            <td class="py-3 px-4 text-center text-slate-400 font-mono text-[11px]"><%= idx + 1 %></td>
                                            <td class="py-3 px-4">
                                                <span class="font-mono font-black text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-0.5 rounded-lg">
                                                    <%= c.consignment_no %>
                                                </span>
                                            </td>
                                            <td class="py-3 px-4 font-bold text-slate-900"><%= c.title || '-' %></td>
                                            <td class="py-3 px-4 text-slate-500 font-mono"><%= c.dispatch_date || '-' %></td>
                                            <td class="py-3 px-4 text-center">
                                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black font-mono bg-slate-100 text-slate-800 border border-slate-200">
                                                    <%= c.total_parcels || 0 %> parcels
                                                </span>
                                            </td>
                                            <td class="py-3 px-4 text-right">
                                                <div class="inline-flex items-center gap-1.5 justify-end">
                                                    <button type="button" data-id="<%= c.id %>" 
                                                            class="btn-open-consignment px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs cursor-pointer shadow-2xs transition-all flex items-center gap-1">
                                                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> Open
                                                    </button>
                                                    <button type="button" onclick="exportConsignmentWithCustomName('<%= c.id %>', '<%= c.consignment_no %>')" 
                                                       class="px-2.5 py-1.5 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-2xs transition-all cursor-pointer"
                                                       title="Export Excel (Custom Name)">
                                                        <i class="fa-solid fa-file-excel text-emerald-600"></i>
                                                    </button>
                                                    <button type="button" data-id="<%= c.id %>" data-no="<%= c.consignment_no %>" 
                                                            class="btn-delete-consignment text-rose-500 hover:text-rose-700 p-1.5 rounded-lg hover:bg-rose-50 transition-all cursor-pointer"
                                                            title="Delete Consignment">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                <% } else { %>
                                    <tr id="emptyConsignmentsRow">
                                        <td colspan="6" class="py-10 text-center text-slate-400 font-normal">
                                            <i class="fa-solid fa-folder-open text-2xl mb-1 text-slate-300 block"></i>
                                            No consignments created yet. Use the form above to create your first consignment!
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>


            <!-- ============================================================== -->
            <!-- ✍️ VIEW 2: MANUAL ENTRY WORKSPACE -->
            <!-- (OPENS WHEN USER CLICKS OPEN ON A CONSIGNMENT OR CREATES ONE) -->
            <!-- ============================================================== -->
            <div id="manualEntryWorkspaceView" class="<%= safeActiveConsignment ? '' : 'hidden' %> space-y-5">
                
                <!-- Main Page Header: Back Button + Active Consignment Badge -->
                <div class="flex items-center justify-between flex-wrap gap-3">
                    <div class="flex items-center gap-3">
                        <button type="button" onclick="backToConsignmentsList()" 
                                class="text-slate-800 hover:text-blue-600 p-2 rounded-xl bg-white border border-slate-200 hover:border-blue-300 text-sm font-bold transition-all cursor-pointer shadow-2xs flex items-center gap-1.5" 
                                title="Back to Consignments Hub">
                            <i class="fa-solid fa-arrow-left"></i>
                            <span class="text-xs">Consignments List</span>
                        </button>
                        <div>
                            <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">Manual Parcel Entry</h1>
                            <p class="text-xs text-slate-400 font-medium">Scan barcode or enter parcel details to add to current consignment.</p>
                        </div>
                    </div>

                    <!-- Active Consignment Status Badge & Switch Action -->
                    <div class="flex items-center gap-2 flex-wrap">
                        <span id="activeConsignmentBadge" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold font-mono">
                            <i class="fa-solid fa-barcode text-blue-600"></i>
                            <span id="activeConsignmentNoDisplay"><%= safeActiveConsignment ? safeActiveConsignment.consignment_no : '' %></span>
                        </span>

                        <button type="button" onclick="backToConsignmentsList()" 
                                class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-2xs transition-all cursor-pointer flex items-center gap-1.5">
                            <i class="fa-solid fa-arrow-right-arrow-left text-slate-400"></i>
                            <span>Switch Consignment</span>
                        </button>
                    </div>
                </div>

                <!-- ============================================================== -->
                <!-- 📦 FORM CONTAINER -->
                <!-- ============================================================== -->
                <form id="manualEntryForm" class="space-y-5 text-xs">
                    <input type="hidden" id="activeConsignmentId" value="<%= safeActiveConsignment ? safeActiveConsignment.id : '' %>">
                    <input type="hidden" id="mOrderNo" value="">

                    <!-- ============================================================== -->
                    <!-- 📦 SECTION 1: RECEIVER & ORDER DETAILS CARD -->
                    <!-- ============================================================== -->
                    <div class="ref-card p-5 sm:p-6 space-y-4">
                        
                        <!-- Row 1: Order Number / Receiver Name (FIRST), Tracking Number (SECOND), Mobile, Pincode -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                            
                            <!-- 1. Order Number / Receiver Name (Scan Gun, Order Search & Live Autocomplete) -->
                            <div class="relative">
                                <label class="flex items-center justify-between font-bold text-slate-800 text-xs mb-1.5">
                                    <span>Order No / Receiver Name <span class="text-rose-500">*</span></span>
                                    <span class="text-blue-600 text-[10px] font-semibold flex items-center gap-1">
                                        <i class="fa-solid fa-magnifying-glass text-[9px]"></i> Search or Type
                                    </span>
                                </label>
                                <div class="relative">
                                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-blue-500 text-xs pointer-events-none"></i>
                                    <input type="text" id="mReceiverName" required autocomplete="off"
                                           placeholder="Scan gun or type order/name..." 
                                           class="ref-input ref-input-icon-both uppercase font-semibold">
                                    
                                    <div class="absolute right-3.5 top-1/2 -translate-y-1/2 flex items-center gap-1.5">
                                        <span id="orderSearchSpinner" class="hidden text-blue-600 animate-spin text-xs">
                                            <i class="fa-solid fa-circle-notch"></i>
                                        </span>
                                        <button type="button" id="btnClearOrderSearch" class="hidden text-slate-400 hover:text-slate-600 p-0.5 text-xs cursor-pointer" title="Clear">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                        <i class="fa-solid fa-barcode text-slate-400 text-sm"></i>
                                    </div>
                                </div>

                                <!-- Autocomplete Dropdown List Directly Underneath -->
                                <div id="orderSearchResultsDropdown" class="hidden absolute left-0 right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 max-h-80 overflow-y-auto divide-y divide-slate-100"></div>
                            </div>

                            <!-- 2. Tracking Number (Optional) -->
                            <div>
                                <label class="flex items-center justify-between font-bold text-slate-800 text-xs mb-1.5">
                                    <span>Tracking Number</span>
                                    <span class="bg-slate-100 text-slate-500 border border-slate-200 text-[9px] font-bold px-1.5 py-0.2 rounded uppercase tracking-wider">
                                        OPTIONAL
                                    </span>
                                </label>
                                <div class="relative">
                                    <input type="text" id="mTracking" placeholder="Enter or scan tracking..." 
                                           class="ref-input ref-input-icon-right uppercase font-mono font-bold">
                                    <i class="fa-solid fa-barcode absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                </div>
                            </div>

                            <!-- 3. Receiver Mobile Number -->
                            <div>
                                <label class="block font-bold text-slate-800 text-xs mb-1.5">
                                    Receiver Mobile Number
                                </label>
                                <div class="relative">
                                    <input type="text" id="mMobile" maxlength="10" placeholder="9876543210" 
                                           oninput="this.value = this.value.replace(/[^0-9]/g, '').substring(0, 10);"
                                           class="ref-input ref-input-icon-right font-mono font-bold">
                                    <i class="fa-solid fa-phone absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                </div>
                            </div>

                            <!-- 4. Receiver Pincode (Auto-lookup on 6 digits; auto-clears on backspace) -->
                            <div>
                                <label class="flex items-center justify-between font-bold text-slate-800 text-xs mb-1.5">
                                    <span>Receiver Pincode <span class="text-rose-500">*</span></span>
                                    <span class="bg-teal-50 text-teal-700 border border-teal-200 text-[9px] font-extrabold px-1.5 py-0.2 rounded tracking-wider flex items-center gap-1">
                                        <i class="fa-solid fa-location-dot text-[8px]"></i> 6-digit PIN
                                    </span>
                                </label>
                                <div class="relative">
                                    <input type="text" id="mPincode" required maxlength="6" placeholder="Enter 6-digit PIN" 
                                           class="ref-input ref-input-icon-right font-mono font-bold">
                                    <i class="fa-solid fa-location-dot absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                </div>
                            </div>

                        </div>

                        <!-- Row 2: Location Fields Directly Under Pincode (City, State, Area) -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-1">
                            
                            <!-- City -->
                            <div>
                                <label class="block font-bold text-slate-700 text-xs mb-1.5">
                                    City <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative">
                                    <i class="fa-solid fa-city absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                    <input type="text" id="txtCity" required placeholder="City name" 
                                           class="ref-input ref-input-icon-left uppercase font-semibold">
                                </div>
                            </div>

                            <!-- State -->
                            <div>
                                <label class="block font-bold text-slate-700 text-xs mb-1.5">
                                    State <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative">
                                    <i class="fa-solid fa-map absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                    <input type="text" id="txtState" required placeholder="State name" 
                                           class="ref-input ref-input-icon-left uppercase font-semibold">
                                </div>
                            </div>

                            <!-- Area / Locality -->
                            <div>
                                <label class="block font-bold text-slate-700 text-xs mb-1.5">
                                    Area / Locality <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative">
                                    <i class="fa-solid fa-location-arrow absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                    <input type="text" id="txtAddress" required placeholder="Area or Locality" 
                                           class="ref-input ref-input-icon-left uppercase font-semibold">
                                </div>
                            </div>

                        </div>

                        <!-- Row 3: Order Master & Member Directory Details (MEMBER ID WITH SEARCH & SCAN, ORDER DATE, PV, AMOUNT) -->
                        <div class="pt-2 border-t border-slate-100">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-[11px] font-extrabold uppercase text-slate-500 tracking-wider flex items-center gap-1.5">
                                    <i class="fa-solid fa-link text-blue-600"></i> Member & Order Details (Auto-Fetched)
                                </span>
                                <span id="linkedOrderBadge" class="hidden text-[10px] font-mono font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-lg">
                                    Linked: <span id="linkedOrderNoText"></span>
                                </span>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                
                                <!-- 1. Member ID (LIVE SEARCH & BARCODE SCAN READY) -->
                                <div class="relative">
                                    <label class="flex items-center justify-between font-bold text-slate-700 text-xs mb-1">
                                        <span>Member ID</span>
                                        <span class="text-[10px] text-blue-600 font-semibold flex items-center gap-1">
                                            <i class="fa-solid fa-magnifying-glass text-[8px]"></i> Search ID
                                        </span>
                                    </label>
                                    <div class="relative">
                                        <i class="fa-solid fa-id-badge absolute left-3.5 top-1/2 -translate-y-1/2 text-blue-600 text-xs pointer-events-none"></i>
                                        <input type="text" id="mMemberId" autocomplete="off" placeholder="Scan or type ID..." 
                                               class="ref-input ref-input-icon-both font-mono font-bold text-blue-700">
                                        
                                        <div class="absolute right-3.5 top-1/2 -translate-y-1/2 flex items-center gap-1.5">
                                            <span id="memberSearchSpinner" class="hidden text-blue-600 animate-spin text-xs">
                                                <i class="fa-solid fa-circle-notch"></i>
                                            </span>
                                            <button type="button" id="btnClearMemberSearch" class="hidden text-slate-400 hover:text-slate-600 p-0.5 text-xs cursor-pointer" title="Clear">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                            <i class="fa-solid fa-barcode text-slate-400 text-sm"></i>
                                        </div>
                                    </div>

                                    <!-- Member Autocomplete Dropdown List -->
                                    <div id="memberSearchResultsDropdown" class="hidden absolute left-0 right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 max-h-80 overflow-y-auto divide-y divide-slate-100"></div>
                                </div>

                                <!-- 2. Order Date -->
                                <div>
                                    <label class="block font-bold text-slate-700 text-xs mb-1">Order Date</label>
                                    <div class="relative">
                                        <i class="fa-regular fa-calendar-days absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                        <input type="text" id="mOrderDate" placeholder="e.g. 28-10-2026" 
                                               class="ref-input ref-input-icon-left font-mono font-semibold">
                                    </div>
                                </div>

                                <!-- 3. PV -->
                                <div>
                                    <label class="block font-bold text-slate-700 text-xs mb-1">PV</label>
                                    <div class="relative">
                                        <i class="fa-solid fa-star absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                        <input type="text" id="mPv" placeholder="e.g. 50" 
                                               class="ref-input ref-input-icon-left font-mono font-bold text-teal-700">
                                    </div>
                                </div>

                                <!-- 4. Amount -->
                                <div>
                                    <label class="block font-bold text-slate-700 text-xs mb-1">Amount (₹)</label>
                                    <div class="relative">
                                        <i class="fa-solid fa-indian-rupee-sign absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                        <input type="text" id="mAmount" placeholder="e.g. 1450" 
                                               class="ref-input ref-input-icon-left font-mono font-bold text-amber-700">
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>


                    <!-- ============================================================== -->
                    <!-- 📦 SECTION 2: BOX DIMENSIONS & QUICK PRESETS CARD -->
                    <!-- ============================================================== -->
                    <div class="ref-card p-5 sm:p-6 space-y-4">
                        
                        <!-- Header Row: Title + Lock Checkbox + Preset Menu Dropdown -->
                        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3">
                            <div class="flex items-center gap-2.5">
                                <i class="fa-solid fa-box-open text-slate-800 text-base"></i>
                                <h2 class="text-xs sm:text-sm font-extrabold text-slate-900 tracking-wide">Box Dimensions & Presets</h2>
                            </div>

                            <div class="flex items-center gap-2">
                                <!-- + Preset Sizes Dropdown Button -->
                                <div class="relative">
                                    <button type="button" id="presetBtn" 
                                            class="px-2.5 py-1 rounded-lg border border-blue-600 bg-white hover:bg-blue-50 text-blue-600 font-bold text-[11px] flex items-center gap-1.5 transition-all cursor-pointer shadow-2xs">
                                        <i class="fa-solid fa-plus text-[10px]"></i>
                                        <span id="selectedPresetLabel">Preset Sizes</span>
                                        <i id="presetChevron" class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200 ml-0.5"></i>
                                    </button>

                                    <div id="presetMenu" class="custom-preset-menu absolute right-0 top-full mt-1.5 w-64 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 p-2 space-y-1">
                                        <p class="p-2 text-center text-[10px] text-slate-400 font-semibold">Loading Presets...</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 📦 QUICK BOXES (SMALL, COMPACT, EASY TO USE) -->
                        <div id="presetChipsContainer" class="flex flex-wrap items-center gap-1.5 pt-1">
                            <span class="text-[10px] font-extrabold uppercase text-slate-500 flex items-center gap-1 mr-1">
                                <i class="fa-solid fa-bolt text-amber-500"></i> Quick Boxes:
                            </span>
                            <div id="presetChipsList" class="flex flex-wrap items-center gap-1.5">
                                <span class="text-[10px] text-slate-400">Loading shortcuts...</span>
                            </div>
                        </div>

                        <!-- 4-Column Dimensions Input Row: Weight, Length, Breadth, Height -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
                            
                            <!-- Weight (Grams) -->
                            <div>
                                <label class="block font-bold text-slate-700 text-xs mb-1.5">
                                    Weight (gm) <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative">
                                    <i class="fa-solid fa-scale-balanced absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                    <input type="number" step="any" id="mWeight" required placeholder="e.g. 500" 
                                           class="ref-input ref-input-icon-left font-bold font-mono">
                                </div>
                            </div>

                            <!-- Length -->
                            <div>
                                <label class="block font-bold text-slate-700 text-xs mb-1.5">
                                    Length (cm) <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative">
                                    <i class="fa-solid fa-arrows-left-right absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                    <input type="number" id="mLength" required placeholder="e.g. 20" 
                                           class="ref-input ref-input-icon-left font-bold">
                                </div>
                            </div>

                            <!-- Breadth -->
                            <div>
                                <label class="block font-bold text-slate-700 text-xs mb-1.5">
                                    Breadth (cm) <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative">
                                    <i class="fa-solid fa-arrows-left-right absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                    <input type="number" id="mBreadth" required placeholder="e.g. 15" 
                                           class="ref-input ref-input-icon-left font-bold">
                                </div>
                            </div>

                            <!-- Height -->
                            <div>
                                <label class="block font-bold text-slate-700 text-xs mb-1.5">
                                    Height (cm) <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative">
                                    <i class="fa-solid fa-arrows-up-down absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                    <input type="number" id="mHeight" required placeholder="e.g. 10" 
                                           class="ref-input ref-input-icon-left font-bold">
                                </div>
                            </div>

                        </div>

                        <!-- Action Bar: SAVE PARCEL ENTRY Button (With Double-Click Lock & Protection) -->
                        <div class="flex justify-end pt-2 border-t border-slate-100">
                            <button type="submit" id="btnSaveParcel" 
                                    class="btn-teal-save w-full sm:w-auto font-black text-xs px-8 py-3 rounded-xl uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer transition-all">
                                <i class="fa-solid fa-paper-plane text-xs" id="saveIcon"></i>
                                <span id="saveBtnText">SAVE PARCEL ENTRY</span>
                            </button>
                        </div>

                    </div>

                </form>


                <!-- ============================================================== -->
                <!-- 📋 PARCELS IN ACTIVE CONSIGNMENT TABLE -->
                <!-- ============================================================== -->
                <div class="ref-card overflow-hidden w-full">
                    <div class="px-5 py-4 bg-slate-50/80 border-b border-slate-200 flex justify-between items-center flex-wrap gap-2">
                        <div class="flex items-center gap-3">
                            <h2 class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide flex items-center gap-2">
                                <i class="fa-solid fa-boxes-packing text-blue-600"></i> Parcels in this Consignment
                            </h2>
                            <span id="parcelsCountBadge" class="bg-blue-50 text-blue-800 border border-blue-200 text-[10px] font-black px-2.5 py-0.5 rounded-full font-mono">
                                Total: <%= safeActiveParcels.length %>
                            </span>
                        </div>
                        
                        <button type="button" id="btnExportActiveExcel" onclick="exportActiveConsignmentWithCustomName()"
                           class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex items-center gap-1.5 shadow-2xs transition-all cursor-pointer">
                            <i class="fa-solid fa-file-excel text-emerald-600"></i> Export Excel
                        </button>
                    </div>

                    <div class="overflow-x-auto w-full">
                        <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[700px]">
                            <thead>
                                <tr class="bg-slate-100/70 border-b border-slate-200 text-slate-500 font-extrabold uppercase select-none text-[11px]">
                                    <th class="py-3 px-3 w-12 text-center">SR</th>
                                    <th class="py-3 px-4">Tracking No</th>
                                    <th class="py-3 px-4">Receiver & Order Info</th>
                                    <th class="py-3 px-4">Mobile</th>
                                    <th class="py-3 px-4">Pincode & Location</th>
                                    <th class="py-3 px-4">Weight & Dimensions</th>
                                    <th class="py-3 px-4 text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="parcelsTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                                <% if (safeActiveParcels && safeActiveParcels.length !== 0) { %>
                                    <% for (let idx = 0; idx < safeActiveParcels.length; idx++) { let p = safeActiveParcels[idx]; %>
                                        <tr class="hover:bg-slate-50 transition-colors">
                                            <td class="py-3 px-3 text-center font-mono text-[11px] text-slate-400"><%= idx + 1 %></td>
                                            <td class="py-3 px-4">
                                                <% if (p.tracking && p.tracking.trim() && !p.tracking.toUpperCase().includes('SHOP')) { %>
                                                    <span class="font-mono font-black text-slate-900 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                                                        <%= p.tracking %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-xs inline-flex items-center gap-1">
                                                        <i class="fa-solid fa-shop text-[10px]"></i> <%= (p.tracking && p.tracking.trim()) ? p.tracking : 'Shop Pickup' %>
                                                    </span>
                                                <% } %>
                                            </td>
                                            <td class="py-3 px-4">
                                                <div class="font-bold text-slate-900"><%= p.name || '-' %></div>
                                                <% if (p.member_id || p.order_no || p.pv || p.amount) { %>
                                                    <div class="text-[10px] text-blue-700 font-mono font-bold flex items-center gap-1.5 mt-0.5">
                                                        <% if (p.order_no) { %><span class="bg-slate-100 text-slate-700 px-1.5 py-0.2 rounded border border-slate-200"><%= p.order_no %></span><% } %>
                                                        <% if (p.member_id) { %><span>ID: <%= p.member_id %></span><% } %>
                                                        <% if (p.order_date) { %><span class="text-slate-500">| <%= p.order_date %></span><% } %>
                                                        <% if (p.pv) { %><span class="text-teal-700">• <%= p.pv %> PV</span><% } %>
                                                        <% if (p.amount) { %><span class="text-amber-700">• ₹<%= p.amount %></span><% } %>
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td class="py-3 px-4 font-mono"><%= p.mobile || '-' %></td>
                                            <td class="py-3 px-4">
                                                <span class="font-bold text-blue-700 font-mono"><%= p.pincode || '-' %></span>
                                                <% if (p.city || p.state || p.address) { %>
                                                    <span class="text-slate-400 text-[10px]"> • <%= [p.address, p.city, p.state].filter(Boolean).join(', ') %></span>
                                                <% } %>
                                            </td>
                                            <td class="py-3 px-4 font-mono text-[11px]">
                                                <span class="font-black text-slate-800"><%= p.weight || '0' %>g</span>
                                                <span class="text-slate-400">(<%= p.length || '0' %>x<%= p.breadth || '0' %>x<%= p.height || '0' %>)</span>
                                            </td>
                                            <td class="py-3 px-4 text-center">
                                                <button type="button" data-id="<%= p.id %>"
                                                        class="btn-delete-parcel text-rose-500 hover:text-rose-700 p-1.5 rounded-lg hover:bg-rose-50 transition-all cursor-pointer"
                                                        title="Remove Parcel">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    <% } %>
                                <% } else { %>
                                    <tr id="emptyParcelsRow">
                                        <td colspan="7" class="py-10 text-center text-slate-400 font-normal">
                                            <i class="fa-solid fa-box-open text-2xl mb-1 text-slate-300 block"></i>
                                            No parcels added to this consignment yet. Use the form above to add your first entry!
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </main>
        
        <footer class="bg-white border-t border-slate-200 py-3 text-center text-xs font-semibold text-slate-400 mt-6 w-full">
            &copy; 2026 Avira Care. Encrypted Logistics Administration System.
        </footer>
    </div>

    <!-- Data Carriers for Client Script -->
    <div id="consignmentsDataCarrier" class="hidden" style="display:none;"><%- JSON.stringify(safeConsignments) %></div>
    <div id="activeConsignmentDataCarrier" class="hidden" style="display:none;"><%- JSON.stringify(safeActiveConsignment) %></div>
    <div id="activeParcelsDataCarrier" class="hidden" style="display:none;"><%- JSON.stringify(safeActiveParcels) %></div>

    <script>
        // State Management
        let consignmentsList = [];
        let currentActiveConsignment = null;
        let currentParcelsList = [];
        let isSavingParcel = false; // Double-click & duplicate submit prevention lock

        try {
            consignmentsList = JSON.parse(document.getElementById('consignmentsDataCarrier').textContent || '[]');
            currentActiveConsignment = JSON.parse(document.getElementById('activeConsignmentDataCarrier').textContent || 'null');
            currentParcelsList = JSON.parse(document.getElementById('activeParcelsDataCarrier').textContent || '[]');
        } catch (e) {
            console.error('Error parsing initial state data:', e);
        }

        window.onload = () => {
            initConsignmentDateDefaults();
            loadPresetsFromDB();
            setupInputHighlightListeners();

            if (currentActiveConsignment) {
                showManualEntryWorkspace();
            } else {
                showConsignmentsHub();
            }
        };

        // Navigation Between Views
        function showConsignmentsHub() {
            document.getElementById('manualEntryWorkspaceView')?.classList.add('hidden');
            document.getElementById('consignmentsHubView')?.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function showManualEntryWorkspace() {
            document.getElementById('consignmentsHubView')?.classList.add('hidden');
            document.getElementById('manualEntryWorkspaceView')?.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
            setTimeout(() => {
                document.getElementById('mReceiverName')?.focus();
            }, 150);
        }

        function backToConsignmentsList() {
            window.history.pushState({}, '', '/admin/manual-entry');
            showConsignmentsHub();
        }

        function initConsignmentDateDefaults() {
            const now = new Date();
            const d = String(now.getDate());
            const m = String(now.getMonth() + 1);
            const y = String(now.getFullYear()).slice(-2);
            
            const titleInput = document.getElementById('newConsignmentTitle');
            const dateInput = document.getElementById('newConsignmentDate');

            if (titleInput && !titleInput.value) {
                titleInput.value = `${d}-${m}-${y} Dispatch`;
            }
            if (dateInput && !dateInput.value) {
                dateInput.value = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
            }
        }

        // Open Consignment Workspace
        async function openConsignmentWorkspace(consignmentId) {
            try {
                const res = await fetch(`/admin/api/consignment-details/${consignmentId}`);
                if (res.status === 401) {
                    window.location.href = '/admin/login';
                    return;
                }
                const data = await res.json();
                if (!data.success) {
                    alert('Error: ' + (data.msg || 'Consignment not found'));
                    return;
                }

                currentActiveConsignment = data.consignment;
                currentParcelsList = data.parcels || [];

                document.getElementById('activeConsignmentId').value = currentActiveConsignment.id;
                document.getElementById('activeConsignmentNoDisplay').innerText = currentActiveConsignment.consignment_no;
                document.getElementById('parcelsCountBadge').innerText = `Total: ${currentParcelsList.length}`;

                const excelUrl = `/admin/api/export-consignment-excel/${currentActiveConsignment.id}`;
                const btnExcel = document.getElementById('btnExportActiveExcel');
                if (btnExcel) btnExcel.href = excelUrl;

                renderParcelsTable();
                showManualEntryWorkspace();

                window.history.pushState({}, '', `/admin/manual-entry?consignmentId=${currentActiveConsignment.id}`);

            } catch (err) {
                console.error("Open Consignment Error:", err);
            }
        }

        // Custom Excel File Name Export
        function exportConsignmentWithCustomName(consignmentId, defaultNo) {
            if (!consignmentId) return;
            const defName = `${defaultNo || 'Consignment'}_IndiaPost_Dispatch`;
            const customName = prompt("Enter custom filename for Excel export:", defName);
            if (customName !== null) {
                const clean = encodeURIComponent(customName.trim() || defName);
                window.location.href = `/admin/api/export-consignment-excel/${consignmentId}?filename=${clean}`;
            }
        }

        function exportActiveConsignmentWithCustomName() {
            const id = document.getElementById('activeConsignmentId')?.value || (currentActiveConsignment ? currentActiveConsignment.id : '');
            const no = document.getElementById('activeConsignmentNoDisplay')?.innerText || (currentActiveConsignment ? currentActiveConsignment.consignment_no : '');
            if (!id) {
                alert("Please select or open a consignment first.");
                return;
            }
            exportConsignmentWithCustomName(id, no);
        }

        // Create Consignment Submit (Consignment No is auto-generated by server)
        document.getElementById('createConsignmentForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('btnCreateConsignment');
            const orig = btn.innerHTML;
            btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i>`;
            btn.disabled = true;

            const payload = {
                title: document.getElementById('newConsignmentTitle').value.trim(),
                dispatch_date: document.getElementById('newConsignmentDate').value.trim()
            };

            try {
                const res = await fetch('/admin/api/create-consignment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (!data.success) {
                    alert('Error: ' + (data.msg || 'Unable to create consignment'));
                    return;
                }

                consignmentsList.unshift(data.consignment);
                document.getElementById('hubBatchCount').innerText = consignmentsList.length;
                await openConsignmentWorkspace(data.consignment.id);
            } catch (err) {
                console.error("Create error:", err);
                alert("Error connecting to server. Please try again.");
            } finally {
                btn.innerHTML = orig;
                btn.disabled = false;
            }
        });

        // 🛡️ Save Parcel Entry Submit with Double-Click Prevention Lock
        document.getElementById('manualEntryForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            if (isSavingParcel) return; // Locked against double submit!

            isSavingParcel = true;
            const btn = document.getElementById('btnSaveParcel');
            const saveIcon = document.getElementById('saveIcon');
            const saveText = document.getElementById('saveBtnText');

            btn.disabled = true;
            btn.classList.add('opacity-70', 'cursor-not-allowed');
            saveIcon.className = "fa-solid fa-spinner animate-spin text-xs";
            saveText.innerText = "SAVING PARCEL...";

            let consignmentId = document.getElementById('activeConsignmentId')?.value || '';
            
            // If no active consignment yet, auto-create one first
            if (!consignmentId) {
                try {
                    const createRes = await fetch('/admin/api/create-consignment', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ title: 'Quick Dispatch', dispatch_date: new Date().toLocaleDateString('en-GB') })
                    });
                    const createData = await createRes.json();
                    if (createData.success && createData.consignment) {
                        consignmentId = createData.consignment.id;
                        document.getElementById('activeConsignmentId').value = consignmentId;
                        currentActiveConsignment = createData.consignment;
                        document.getElementById('activeConsignmentNoDisplay').innerText = createData.consignment.consignment_no;
                    }
                } catch(e) {}
            }

            const areaLoc = document.getElementById('txtAddress')?.value.trim() || '';
            const city = document.getElementById('txtCity')?.value.trim().toUpperCase() || '';
            const state = document.getElementById('txtState')?.value.trim().toUpperCase() || '';

            // Accepts custom receiver name even if not in Order Master!
            const customName = document.getElementById('mReceiverName').value.trim().toUpperCase();

            // Store ONLY Area / Locality in address (State and City have their own columns)
            const payload = {
                consignment_id: consignmentId,
                tracking: document.getElementById('mTracking').value.trim().toUpperCase(),
                name: customName,
                mobile: document.getElementById('mMobile').value.trim(),
                pincode: document.getElementById('mPincode').value.trim(),
                weight: document.getElementById('mWeight').value.trim(),
                length: document.getElementById('mLength').value.trim(),
                breadth: document.getElementById('mBreadth').value.trim(),
                height: document.getElementById('mHeight').value.trim(),
                city: city,
                state: state,
                address: areaLoc.toUpperCase(),
                order_no: document.getElementById('mOrderNo')?.value || '',
                member_id: document.getElementById('mMemberId')?.value || '',
                order_date: document.getElementById('mOrderDate')?.value || '',
                pv: document.getElementById('mPv')?.value || '',
                amount: document.getElementById('mAmount')?.value || ''
            };

            try {
                const res = await fetch('/admin/api/save-manual', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (res.status === 401) {
                    window.location.href = '/admin/login';
                    return;
                }
                const data = await res.json();
                if (!data.success) {
                    alert('Error: ' + (data.msg || 'Unable to save parcel'));
                    return;
                }

                if (data.parcels) {
                    currentParcelsList = data.parcels;
                } else if (data.parcel) {
                    currentParcelsList.unshift(data.parcel);
                }
                renderParcelsTable();

                // Clear input fields (keep box dimensions if locked)
                document.getElementById('mTracking').value = '';
                document.getElementById('mReceiverName').value = '';
                document.getElementById('mMobile').value = '';
                document.getElementById('mPincode').value = '';
                document.getElementById('txtCity').value = '';
                document.getElementById('txtState').value = '';
                document.getElementById('txtAddress').value = '';
                document.getElementById('mMemberId').value = '';
                document.getElementById('mOrderDate').value = '';
                document.getElementById('mPv').value = '';
                document.getElementById('mAmount').value = '';
                document.getElementById('mOrderNo').value = '';

                document.getElementById('linkedOrderBadge')?.classList.add('hidden');
                document.getElementById('btnClearOrderSearch')?.classList.add('hidden');
                document.getElementById('btnClearMemberSearch')?.classList.add('hidden');

                // Cleanly reset dimension inputs and highlights for next entry
                document.getElementById('mWeight').value = '';
                document.getElementById('mLength').value = '';
                document.getElementById('mBreadth').value = '';
                document.getElementById('mHeight').value = '';
                document.querySelectorAll('.preset-chip').forEach(c => c.classList.remove('active'));
                document.getElementById('selectedPresetLabel').innerText = 'Preset Sizes';

                document.querySelectorAll('.ref-input').forEach(f => {
                    f.classList.remove('field-highlight');
                });

                document.getElementById('mReceiverName')?.focus();

            } catch (err) {
                console.error("Save parcel error:", err);
                alert("Server error while saving. Please try again.");
            } finally {
                // Unlock with 1s cooldown to prevent double taps
                setTimeout(() => {
                    isSavingParcel = false;
                    btn.disabled = false;
                    btn.classList.remove('opacity-70', 'cursor-not-allowed');
                    saveIcon.className = "fa-solid fa-paper-plane text-xs";
                    saveText.innerText = "SAVE PARCEL ENTRY";
                }, 800);
            }
        });

        // Render Parcels Table
        function renderParcelsTable() {
            const tbody = document.getElementById('parcelsTableBody');
            const badge = document.getElementById('parcelsCountBadge');
            if (badge) badge.innerText = `Total: ${currentParcelsList.length}`;

            if (!currentParcelsList || currentParcelsList.length === 0) {
                tbody.innerHTML = `
                    <tr id="emptyParcelsRow">
                        <td colspan="7" class="py-10 text-center text-slate-400 font-normal">
                            <i class="fa-solid fa-box-open text-2xl mb-1 text-slate-300 block"></i>
                            No parcels added to this consignment yet. Use the form above to add your first entry!
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = currentParcelsList.map((p, idx) => `
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="py-3 px-3 text-center font-mono text-[11px] text-slate-400">${idx + 1}</td>
                    <td class="py-3 px-4">
                        ${(p.tracking && p.tracking.trim() && !p.tracking.toUpperCase().includes('SHOP')) 
                            ? `<span class="font-mono font-black text-slate-900 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">${p.tracking}</span>`
                            : `<span class="font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-xs inline-flex items-center gap-1"><i class="fa-solid fa-shop text-[10px]"></i> ${(p.tracking && p.tracking.trim()) ? p.tracking : 'Shop Pickup'}</span>`}
                    </td>
                    <td class="py-3 px-4">
                        <div class="font-bold text-slate-900">${p.name || '-'}</div>
                        ${(p.member_id || p.order_no || p.pv || p.amount) ? `
                            <div class="text-[10px] text-blue-700 font-mono font-bold flex items-center gap-1.5 mt-0.5">
                                ${p.order_no ? `<span class="bg-slate-100 text-slate-700 px-1.5 py-0.2 rounded border border-slate-200">${p.order_no}</span>` : ''}
                                ${p.member_id ? `<span>ID: ${p.member_id}</span>` : ''}
                                ${p.order_date ? `<span class="text-slate-500">| ${p.order_date}</span>` : ''}
                                ${p.pv ? `<span class="text-teal-700">• ${p.pv} PV</span>` : ''}
                                ${p.amount ? `<span class="text-amber-700">• ₹${p.amount}</span>` : ''}
                            </div>
                        ` : ''}
                    </td>
                    <td class="py-3 px-4 font-mono">${p.mobile || '-'}</td>
                    <td class="py-3 px-4">
                        <span class="font-bold text-blue-700 font-mono">${p.pincode || '-' }</span>
                        ${(p.city || p.state || p.address) ? `<span class="text-slate-400 text-[10px]"> • ${[p.address, p.city, p.state].filter(Boolean).join(', ')}</span>` : ''}
                    </td>
                    <td class="py-3 px-4 font-mono text-[11px]">
                        <span class="font-black text-slate-800">${p.weight || '0'}g</span>
                        <span class="text-slate-400">(${p.length || '0'}x${p.breadth || '0'}x${p.height || '0'})</span>
                    </td>
                    <td class="py-3 px-4 text-center">
                        <button type="button" data-id="${p.id}"
                                class="btn-delete-parcel text-rose-500 hover:text-rose-700 p-1.5 rounded-lg hover:bg-rose-50 transition-all cursor-pointer"
                                title="Remove Parcel">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        // ==============================================================
        // 🔍 ORDER MASTER SCAN & LIVE SEARCH AUTOCOMPLETE (IN RECEIVER NAME)
        // ==============================================================
        let orderSearchTimer = null;
        let activeOrderSearchResults = [];
        let selectedOrderResultIndex = -1;

        const receiverNameInput = document.getElementById('mReceiverName');
        const orderResultsDropdown = document.getElementById('orderSearchResultsDropdown');
        const orderSpinner = document.getElementById('orderSearchSpinner');
        const btnClearOrderSearch = document.getElementById('btnClearOrderSearch');

        if (receiverNameInput) {
            receiverNameInput.addEventListener('input', function() {
                const q = this.value.trim();
                if (q.length > 0) {
                    btnClearOrderSearch?.classList.remove('hidden');
                } else {
                    btnClearOrderSearch?.classList.add('hidden');
                    closeOrderSearchResultsDropdown();
                    clearLinkedOrderFields();
                    return;
                }

                clearTimeout(orderSearchTimer);
                orderSpinner?.classList.remove('hidden');

                orderSearchTimer = setTimeout(() => {
                    executeOrderMasterSearch(q);
                }, 100);
            });

            receiverNameInput.addEventListener('keydown', function(e) {
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    navigateOrderDropdown(1);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    navigateOrderDropdown(-1);
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (selectedOrderResultIndex >= 0 && activeOrderSearchResults[selectedOrderResultIndex]) {
                        selectOrderMasterItem(activeOrderSearchResults[selectedOrderResultIndex]);
                    } else {
                        const q = this.value.trim();
                        if (q) executeImmediateBarcodeScan(q);
                    }
                } else if (e.key === 'Escape') {
                    closeOrderSearchResultsDropdown();
                }
            });
        }

        btnClearOrderSearch?.addEventListener('click', function() {
            if (receiverNameInput) {
                receiverNameInput.value = '';
                receiverNameInput.classList.remove('field-highlight');
                this.classList.add('hidden');
                closeOrderSearchResultsDropdown();
                clearLinkedOrderFields();
                receiverNameInput.focus();
            }
        });

        document.addEventListener('click', function(e) {
            if (!e.target.closest('#mReceiverName') && !e.target.closest('#orderSearchResultsDropdown')) {
                closeOrderSearchResultsDropdown();
            }
            if (!e.target.closest('#mMemberId') && !e.target.closest('#memberSearchResultsDropdown')) {
                closeMemberSearchResultsDropdown();
            }
        });

        function closeOrderSearchResultsDropdown() {
            if (orderResultsDropdown) {
                orderResultsDropdown.classList.add('hidden');
                orderResultsDropdown.innerHTML = '';
            }
            selectedOrderResultIndex = -1;
        }

        async function executeOrderMasterSearch(query) {
            try {
                const res = await fetch(`/admin/api/search-orders?q=${encodeURIComponent(query)}`);
                if (res.status === 401) {
                    window.location.href = '/admin/login';
                    return;
                }
                const data = await res.json();
                orderSpinner?.classList.add('hidden');

                if (data.success) {
                    activeOrderSearchResults = data.orders || [];
                    selectedOrderResultIndex = -1;

                    if (data.exactMatch && data.order) {
                        selectOrderMasterItem(data.order);
                        return;
                    }
                    renderOrderSearchResults(query, activeOrderSearchResults);
                }
            } catch (err) {
                console.error("Order search error:", err);
                orderSpinner?.classList.add('hidden');
            }
        }

        async function executeImmediateBarcodeScan(query) {
            orderSpinner?.classList.remove('hidden');
            try {
                const res = await fetch(`/admin/api/search-orders?q=${encodeURIComponent(query)}`);
                const data = await res.json();
                orderSpinner?.classList.add('hidden');

                if (data.success) {
                    if (data.order) {
                        selectOrderMasterItem(data.order);
                    } else if (data.orders && data.orders.length > 0) {
                        selectOrderMasterItem(data.orders[0]);
                    }
                    // Note: If not found in Order Master, custom receiver name is accepted quietly without blocking!
                }
            } catch (err) {
                console.error("Barcode scan error:", err);
                orderSpinner?.classList.add('hidden');
            }
        }

        function renderOrderSearchResults(query, orders) {
            if (!orderResultsDropdown) return;

            if (orders.length === 0) {
                // Allows custom name without forcing order selection
                orderResultsDropdown.innerHTML = `
                    <div class="p-3 text-center text-slate-400">
                        <i class="fa-regular fa-user text-base mb-1 text-slate-300 block"></i>
                        <p class="font-bold text-xs text-slate-600">Custom Receiver: "${query}"</p>
                        <p class="text-[10px] text-slate-400">Not found in Order Master. You can proceed with this custom name.</p>
                    </div>
                `;
                orderResultsDropdown.classList.remove('hidden');
                return;
            }

            const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');

            orderResultsDropdown.innerHTML = orders.map((o, idx) => {
                const highlightedName = (o.name || '-').replace(regex, `<span class="bg-blue-100 text-blue-900 font-black px-0.5 rounded">$1</span>`);
                return `
                    <div class="order-result-item p-2.5 hover:bg-blue-50/80 cursor-pointer transition-colors flex items-center justify-between gap-3 text-xs"
                         data-index="${idx}">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <div class="h-7 w-7 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs flex-shrink-0">
                                <i class="fa-solid fa-user-check text-[10px]"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="font-black text-slate-900 uppercase truncate">${highlightedName}</div>
                                <div class="flex items-center gap-2 text-[10px] text-slate-500 font-mono mt-0.5">
                                    <span class="bg-slate-100 text-slate-700 px-1 py-0.2 rounded font-bold">${o.order_no || '-'}</span>
                                    <span class="text-blue-700 font-bold">${o.member_id || '-'}</span>
                                    ${o.mobile ? `<span class="text-slate-600">• ${o.mobile}</span>` : ''}
                                    <span>${o.order_date || ''}</span>
                                </div>
                            </div>
                        </div>

                        <div class="text-right flex-shrink-0">
                            <span class="inline-flex items-center gap-1 font-mono font-black text-teal-800 bg-teal-50 px-1.5 py-0.5 rounded text-[10px]">
                                ${o.pv ? o.pv + ' PV' : '-'}
                            </span>
                            <div class="font-mono font-black text-amber-700 text-[11px] mt-0.5">
                                ${o.amount ? '₹' + o.amount : '-'}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            orderResultsDropdown.classList.remove('hidden');
        }

        orderResultsDropdown?.addEventListener('click', function(e) {
            const item = e.target.closest('.order-result-item');
            if (item) {
                const idx = parseInt(item.getAttribute('data-index'), 10);
                if (!isNaN(idx) && activeOrderSearchResults[idx]) {
                    selectOrderMasterItem(activeOrderSearchResults[idx]);
                }
            }
        });

        function navigateOrderDropdown(direction) {
            if (!activeOrderSearchResults.length || orderResultsDropdown.classList.contains('hidden')) return;
            const items = orderResultsDropdown.querySelectorAll('.order-result-item');
            if (!items.length) return;

            if (selectedOrderResultIndex >= 0 && items[selectedOrderResultIndex]) {
                items[selectedOrderResultIndex].classList.remove('bg-blue-100');
            }

            selectedOrderResultIndex += direction;
            if (selectedOrderResultIndex < 0) selectedOrderResultIndex = items.length - 1;
            if (selectedOrderResultIndex >= items.length) selectedOrderResultIndex = 0;

            items[selectedOrderResultIndex].classList.add('bg-blue-100');
            items[selectedOrderResultIndex].scrollIntoView({ block: 'nearest' });
        }

        function selectOrderMasterItem(order) {
            if (!order) return;

            if (receiverNameInput) {
                receiverNameInput.value = (order.name || '').toUpperCase();
                triggerFieldHighlight('mReceiverName');
            }

            const mOrderNo = document.getElementById('mOrderNo');
            const mMemberId = document.getElementById('mMemberId');
            const mOrderDate = document.getElementById('mOrderDate');
            const mPv = document.getElementById('mPv');
            const mAmount = document.getElementById('mAmount');
            const mMobile = document.getElementById('mMobile');

            if (mOrderNo) mOrderNo.value = order.order_no || '';
            if (mMemberId) {
                mMemberId.value = order.member_id || '';
                triggerFieldHighlight('mMemberId');
            }
            if (mOrderDate) {
                mOrderDate.value = order.order_date || '';
                triggerFieldHighlight('mOrderDate');
            }
            if (mPv) {
                mPv.value = order.pv || '';
                triggerFieldHighlight('mPv');
            }
            if (mAmount) {
                mAmount.value = order.amount || '';
                triggerFieldHighlight('mAmount');
            }

            // Auto-fetch and fill mobile number from customer record if attached!
            if (mMobile && order.mobile) {
                mMobile.value = order.mobile;
                triggerFieldHighlight('mMobile');
            }

            const linkedBadge = document.getElementById('linkedOrderBadge');
            const linkedText = document.getElementById('linkedOrderNoText');
            if (linkedBadge && linkedText) {
                linkedText.innerText = order.order_no || 'LINKED';
                linkedBadge.classList.remove('hidden');
            }

            closeOrderSearchResultsDropdown();
            btnClearOrderSearch?.classList.remove('hidden');

            document.getElementById('mTracking')?.focus();
        }

        function clearLinkedOrderFields() {
            document.getElementById('mOrderNo').value = '';
            document.getElementById('mMemberId').value = '';
            document.getElementById('mOrderDate').value = '';
            document.getElementById('mPv').value = '';
            document.getElementById('mAmount').value = '';
            document.getElementById('linkedOrderBadge')?.classList.add('hidden');
            document.getElementById('mMemberId')?.classList.remove('field-highlight');
            document.getElementById('mOrderDate')?.classList.remove('field-highlight');
            document.getElementById('mPv')?.classList.remove('field-highlight');
            document.getElementById('mAmount')?.classList.remove('field-highlight');
        }

        // ==============================================================
        // 👥 MEMBER ID LIVE SEARCH & AUTOCOMPLETE ENGINE
        // (AUTO-FILLS NAME, MOBILE FROM CUSTOMERS, AND PV/AMOUNT FROM ORDERS)
        // ==============================================================
        let memberSearchTimer = null;
        let activeMemberSearchResults = [];
        let selectedMemberResultIndex = -1;

        const memberIdInput = document.getElementById('mMemberId');
        const memberResultsDropdown = document.getElementById('memberSearchResultsDropdown');
        const memberSpinner = document.getElementById('memberSearchSpinner');
        const btnClearMemberSearch = document.getElementById('btnClearMemberSearch');

        if (memberIdInput) {
            memberIdInput.addEventListener('input', function() {
                const q = this.value.trim();
                if (q.length > 0) {
                    btnClearMemberSearch?.classList.remove('hidden');
                } else {
                    btnClearMemberSearch?.classList.add('hidden');
                    closeMemberSearchResultsDropdown();
                    return;
                }

                clearTimeout(memberSearchTimer);
                memberSpinner?.classList.remove('hidden');

                memberSearchTimer = setTimeout(() => {
                    executeMemberMasterSearch(q);
                }, 100);
            });

            memberIdInput.addEventListener('keydown', function(e) {
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    navigateMemberDropdown(1);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    navigateMemberDropdown(-1);
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (selectedMemberResultIndex >= 0 && activeMemberSearchResults[selectedMemberResultIndex]) {
                        selectMemberMasterItem(activeMemberSearchResults[selectedMemberResultIndex]);
                    } else {
                        const q = this.value.trim();
                        if (q) executeImmediateMemberScan(q);
                    }
                } else if (e.key === 'Escape') {
                    closeMemberSearchResultsDropdown();
                }
            });
        }

        btnClearMemberSearch?.addEventListener('click', function() {
            if (memberIdInput) {
                memberIdInput.value = '';
                memberIdInput.classList.remove('field-highlight');
                this.classList.add('hidden');
                closeMemberSearchResultsDropdown();
                memberIdInput.focus();
            }
        });

        function closeMemberSearchResultsDropdown() {
            if (memberResultsDropdown) {
                memberResultsDropdown.classList.add('hidden');
                memberResultsDropdown.innerHTML = '';
            }
            selectedMemberResultIndex = -1;
        }

        async function executeMemberMasterSearch(query) {
            try {
                const res = await fetch(`/admin/api/search-members?q=${encodeURIComponent(query)}`);
                if (res.status === 401) {
                    window.location.href = '/admin/login';
                    return;
                }
                const data = await res.json();
                memberSpinner?.classList.add('hidden');

                if (data.success) {
                    activeMemberSearchResults = data.members || [];
                    selectedMemberResultIndex = -1;

                    if (data.exactMatch && data.member) {
                        selectMemberMasterItem(data.member);
                        return;
                    }
                    renderMemberSearchResults(query, activeMemberSearchResults);
                }
            } catch (err) {
                console.error("Member search error:", err);
                memberSpinner?.classList.add('hidden');
            }
        }

        async function executeImmediateMemberScan(query) {
            memberSpinner?.classList.remove('hidden');
            try {
                const res = await fetch(`/admin/api/search-members?q=${encodeURIComponent(query)}`);
                const data = await res.json();
                memberSpinner?.classList.add('hidden');

                if (data.success) {
                    if (data.member) {
                        selectMemberMasterItem(data.member);
                    } else if (data.members && data.members.length > 0) {
                        selectMemberMasterItem(data.members[0]);
                    }
                }
            } catch (err) {
                console.error("Member scan error:", err);
                memberSpinner?.classList.add('hidden');
            }
        }

        function renderMemberSearchResults(query, members) {
            if (!memberResultsDropdown) return;

            if (members.length === 0) {
                memberResultsDropdown.innerHTML = `
                    <div class="p-3 text-center text-slate-400">
                        <i class="fa-solid fa-users-slash text-base mb-1 text-slate-300 block"></i>
                        <p class="font-bold text-xs text-slate-600">No member found matching "${query}"</p>
                    </div>
                `;
                memberResultsDropdown.classList.remove('hidden');
                return;
            }

            const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');

            memberResultsDropdown.innerHTML = members.map((m, idx) => {
                const highlightedMid = (m.member_id || '').replace(regex, `<span class="bg-blue-100 text-blue-900 font-black px-0.5 rounded">$1</span>`);
                const highlightedName = (m.name || '').replace(regex, `<span class="bg-blue-100 text-blue-900 font-black px-0.5 rounded">$1</span>`);

                return `
                    <div class="member-result-item p-2.5 hover:bg-blue-50/80 cursor-pointer transition-colors flex items-center justify-between gap-3 text-xs"
                         data-index="${idx}">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <div class="h-7 w-7 rounded-lg bg-teal-100 text-teal-800 flex items-center justify-center font-bold text-xs flex-shrink-0">
                                <i class="fa-solid fa-id-card text-[10px]"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="font-black text-slate-900 uppercase truncate">${highlightedName}</div>
                                <div class="flex items-center gap-2 text-[10px] text-slate-500 font-mono mt-0.5">
                                    <span class="text-blue-700 font-bold">${highlightedMid}</span>
                                    ${m.mobile ? `<span class="text-slate-600 font-bold">• ${m.mobile}</span>` : ''}
                                    ${m.order_no ? `<span class="bg-slate-100 text-slate-700 px-1 py-0.2 rounded">${m.order_no}</span>` : ''}
                                </div>
                            </div>
                        </div>

                        <div class="text-right flex-shrink-0">
                            ${m.pv ? `<span class="inline-flex items-center gap-1 font-mono font-black text-teal-800 bg-teal-50 px-1.5 py-0.5 rounded text-[10px]">${m.pv} PV</span>` : ''}
                            ${m.amount ? `<div class="font-mono font-black text-amber-700 text-[11px] mt-0.5">₹${m.amount}</div>` : ''}
                        </div>
                    </div>
                `;
            }).join('');

            memberResultsDropdown.classList.remove('hidden');
        }

        memberResultsDropdown?.addEventListener('click', function(e) {
            const item = e.target.closest('.member-result-item');
            if (item) {
                const idx = parseInt(item.getAttribute('data-index'), 10);
                if (!isNaN(idx) && activeMemberSearchResults[idx]) {
                    selectMemberMasterItem(activeMemberSearchResults[idx]);
                }
            }
        });

        function navigateMemberDropdown(direction) {
            if (!activeMemberSearchResults.length || memberResultsDropdown.classList.contains('hidden')) return;
            const items = memberResultsDropdown.querySelectorAll('.member-result-item');
            if (!items.length) return;

            if (selectedMemberResultIndex >= 0 && items[selectedMemberResultIndex]) {
                items[selectedMemberResultIndex].classList.remove('bg-blue-100');
            }

            selectedMemberResultIndex += direction;
            if (selectedMemberResultIndex < 0) selectedMemberResultIndex = items.length - 1;
            if (selectedMemberResultIndex >= items.length) selectedMemberResultIndex = 0;

            items[selectedMemberResultIndex].classList.add('bg-blue-100');
            items[selectedMemberResultIndex].scrollIntoView({ block: 'nearest' });
        }

        function selectMemberMasterItem(member) {
            if (!member) return;

            if (memberIdInput) {
                memberIdInput.value = (member.member_id || '').toUpperCase();
                triggerFieldHighlight('mMemberId');
            }

            // Auto-fill Receiver Name if blank or user wants it linked
            const nameInput = document.getElementById('mReceiverName');
            if (nameInput && (!nameInput.value || member.name)) {
                nameInput.value = (member.name || '').toUpperCase();
                triggerFieldHighlight('mReceiverName');
            }

            // Auto-fill Mobile Number from Customers Directory!
            const mobileInput = document.getElementById('mMobile');
            if (mobileInput && member.mobile) {
                mobileInput.value = member.mobile;
                triggerFieldHighlight('mMobile');
            }

            // Auto-fill Latest Order Info if available for this member
            const mOrderNo = document.getElementById('mOrderNo');
            const mOrderDate = document.getElementById('mOrderDate');
            const mPv = document.getElementById('mPv');
            const mAmount = document.getElementById('mAmount');

            if (mOrderNo && member.order_no) mOrderNo.value = member.order_no;
            if (mOrderDate && member.order_date) {
                mOrderDate.value = member.order_date;
                triggerFieldHighlight('mOrderDate');
            }
            if (mPv && member.pv) {
                mPv.value = member.pv;
                triggerFieldHighlight('mPv');
            }
            if (mAmount && member.amount) {
                mAmount.value = member.amount;
                triggerFieldHighlight('mAmount');
            }

            closeMemberSearchResultsDropdown();
            btnClearMemberSearch?.classList.remove('hidden');

            document.getElementById('mTracking')?.focus();
        }

        // 🔫 Barcode scanner gun interception on Tracking field
        document.getElementById('mTracking')?.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                const val = this.value.trim().toUpperCase();
                if (val.startsWith('ORD-') || (val.length >= 7 && /^\d+$/.test(val) === false && val.includes('ORD'))) {
                    e.preventDefault();
                    this.value = '';
                    executeImmediateBarcodeScan(val);
                } else if (val.startsWith('AV') && val.length >= 6) {
                    e.preventDefault();
                    this.value = '';
                    executeImmediateMemberScan(val);
                }
            }
        });

        // ==============================================================
        // 🔍 PINCODE & LOCATION AUTO-LOOKUP ENGINE
        // ==============================================================
        let pincodeLookupTimer = null;
        let lastFetchedPincode = '';

        function clearPincodeAutoFill() {
            clearTimeout(pincodeLookupTimer);
            lastFetchedPincode = '';
            const cityEl = document.getElementById('txtCity');
            const stateEl = document.getElementById('txtState');
            const addressEl = document.getElementById('txtAddress');

            if (cityEl) {
                cityEl.value = '';
                cityEl.classList.remove('field-highlight');
            }
            if (stateEl) {
                stateEl.value = '';
                stateEl.classList.remove('field-highlight');
            }
            if (addressEl) {
                addressEl.value = '';
                addressEl.classList.remove('field-highlight');
            }
        }

        const pincodeInput = document.getElementById('mPincode');
        if (pincodeInput) {
            function handlePincodeAction() {
                const raw = pincodeInput.value;
                const clean = raw.replace(/[^0-9]/g, '');
                if (clean !== raw) pincodeInput.value = clean;

                if (clean.length < 6) {
                    clearPincodeAutoFill();
                    return;
                }

                if (clean.length === 6 && clean !== lastFetchedPincode) {
                    clearTimeout(pincodeLookupTimer);
                    pincodeLookupTimer = setTimeout(() => {
                        fetchLocationByPincode(clean);
                    }, 120);
                }
            }

            pincodeInput.addEventListener('input', handlePincodeAction);
            pincodeInput.addEventListener('keyup', handlePincodeAction);
            pincodeInput.addEventListener('change', handlePincodeAction);
            pincodeInput.addEventListener('paste', () => setTimeout(handlePincodeAction, 10));

            pincodeInput.addEventListener('keydown', function(e) {
                if (e.key === 'Backspace' || e.key === 'Delete') {
                    clearPincodeAutoFill();
                }
            });
        }

        async function fetchLocationByPincode(pincode) {
            try {
                const res = await fetch(`/admin/api/fetch-details?pincode=${encodeURIComponent(pincode)}`);
                const data = await res.json();
                if (data.success) {
                    const currentPin = (document.getElementById('mPincode')?.value || '').trim();
                    if (currentPin !== pincode) {
                        clearPincodeAutoFill();
                        return;
                    }

                    lastFetchedPincode = pincode;

                    if (data.city) {
                        const cityEl = document.getElementById('txtCity');
                        if (cityEl) {
                            cityEl.value = data.city;
                            triggerFieldHighlight('txtCity');
                        }
                    }
                    if (data.state) {
                        const stateEl = document.getElementById('txtState');
                        if (stateEl) {
                            stateEl.value = data.state;
                            triggerFieldHighlight('txtState');
                        }
                    }
                    if (data.address) {
                        const addressEl = document.getElementById('txtAddress');
                        if (addressEl) {
                            addressEl.value = data.address;
                            triggerFieldHighlight('txtAddress');
                        }
                    }
                }
            } catch (err) {
                console.error("Pincode lookup error:", err);
            }
        }

        // ==============================================================
        // 📦 BOX PRESETS ENGINE (COMPACT QUICK BOXES)
        // ==============================================================
        let activeBoxPresets = [];

        async function loadPresetsFromDB() {
            const chipsList = document.getElementById('presetChipsList');
            const menu = document.getElementById('presetMenu');
            if (!chipsList || !menu) return;

            try {
                const res = await fetch('/admin/api/get-box-presets');
                const data = await res.json();
                
                let presets = (data.success && data.presets && data.presets.length > 0) ? data.presets : [
                    { id: 1, name: 'SHAMPOO box', length: '21', breadth: '8', height: '8' },
                    { id: 2, name: '2 SHAMPOO BOX', length: '21', breadth: '13', height: '7' },
                    { id: 3, name: 'CHOCO SINGLE BOX', length: '15', breadth: '10', height: '10' },
                    { id: 4, name: 'TWO CHOCO BOX', length: '21', breadth: '13', height: '10' },
                    { id: 5, name: 'OFFER SMALL BOX', length: '21', breadth: '21', height: '10' },
                    { id: 6, name: 'OFFER BIG', length: '23', breadth: '21', height: '21' }
                ];

                activeBoxPresets = presets;
                chipsList.innerHTML = '';
                menu.innerHTML = '';

                presets.forEach((p, idx) => {
                    const shortcutNum = idx + 1;
                    const chipId = `preset-chip-${p.id || idx}`;
                    const safeName = (p.name || `Box ${shortcutNum}`).replace(/'/g, "\\'");
                    
                    // Compact Chip
                    chipsList.innerHTML += `
                        <button type="button" id="${chipId}" onclick="selectBoxPreset(${p.length}, ${p.breadth}, ${p.height}, '${safeName}', '${chipId}')"
                            class="preset-chip group flex items-center gap-1 px-2 py-0.5 bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200 hover:border-blue-300 rounded-lg text-[11px] font-bold transition-all shadow-2xs cursor-pointer select-none"
                            title="Shortcut: Alt+${shortcutNum} | Size: ${p.length}x${p.breadth}x${p.height} cm">
                            <span class="preset-badge inline-flex items-center justify-center w-3.5 h-3.5 rounded bg-slate-100 text-slate-600 text-[9px] font-mono font-black">${shortcutNum}</span>
                            <span class="truncate max-w-[110px] uppercase">${p.name}</span>
                            <span class="preset-dim text-[10px] text-slate-400 font-mono font-normal">(${p.length}x${p.breadth}x${p.height})</span>
                        </button>
                    `;

                    // Dropdown Item
                    menu.innerHTML += `
                        <div onclick="selectBoxPreset(${p.length}, ${p.breadth}, ${p.height}, '${safeName}', '${chipId}')" 
                             class="flex items-center justify-between p-2 rounded-lg hover:bg-blue-50 text-slate-700 hover:text-blue-700 cursor-pointer transition-all">
                            <div class="truncate">
                                <p class="text-xs font-bold uppercase truncate">${p.name}</p>
                                <p class="text-[9px] text-slate-400">${p.length} x ${p.breadth} x ${p.height} cm</p>
                            </div>
                            <span class="text-[9px] font-mono text-slate-400 font-bold bg-slate-100 px-1.5 py-0.5 rounded">Alt+${shortcutNum}</span>
                        </div>
                    `;
                });

            } catch (err) {
                console.error("Fetch Presets Error:", err);
            }
        }

        const presetBtn = document.getElementById('presetBtn');
        const presetMenu = document.getElementById('presetMenu');
        const presetChevron = document.getElementById('presetChevron');

        if (presetBtn && presetMenu) {
            presetBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                const isActive = presetMenu.classList.contains('active');
                if (isActive) {
                    closePresetDropdown();
                } else {
                    presetMenu.classList.add('active');
                    presetChevron?.classList.add('rotate-180');
                }
            });

            document.addEventListener('click', function(e) {
                if (!presetBtn.contains(e.target) && !presetMenu.contains(e.target)) {
                    closePresetDropdown();
                }
            });
        }

        function closePresetDropdown() {
            presetMenu?.classList.remove('active');
            presetChevron?.classList.remove('rotate-180');
        }

        function selectBoxPreset(l, b, h, label, chipId) {
            const lenEl = document.getElementById('mLength');
            const brdEl = document.getElementById('mBreadth');
            const hgtEl = document.getElementById('mHeight');
            if (lenEl) lenEl.value = l;
            if (brdEl) brdEl.value = b;
            if (hgtEl) hgtEl.value = h;
            
            triggerFieldHighlight('mLength');
            triggerFieldHighlight('mBreadth');
            triggerFieldHighlight('mHeight');

            const labelEl = document.getElementById('selectedPresetLabel');
            if (labelEl) labelEl.innerText = label;

            document.querySelectorAll('.preset-chip').forEach(c => c.classList.remove('active'));
            if (chipId) document.getElementById(chipId)?.classList.add('active');

            closePresetDropdown();
            document.getElementById('mWeight')?.focus();
        }

        function setupInputHighlightListeners() {
            document.querySelectorAll('.ref-input').forEach(input => {
                input.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.classList.add('field-highlight');
                    } else {
                        this.classList.remove('field-highlight');
                    }
                });
            });
        }

        function triggerFieldHighlight(elementId) {
            const el = document.getElementById(elementId);
            if (el && el.value.trim() !== '') {
                el.classList.add('field-highlight');
            }
        }

        // Delegated clicks for table actions & filtering
        document.addEventListener('click', async function(e) {
            const openBtn = e.target.closest('.btn-open-consignment');
            if (openBtn) {
                const id = openBtn.getAttribute('data-id');
                if (id) openConsignmentWorkspace(id);
                return;
            }

            const delConsignmentBtn = e.target.closest('.btn-delete-consignment');
            if (delConsignmentBtn) {
                const id = delConsignmentBtn.getAttribute('data-id');
                const no = delConsignmentBtn.getAttribute('data-no');
                if (id && confirm(`Delete consignment "${no}"?`)) {
                    await fetch(`/admin/api/delete-consignment/${id}`, { method: 'DELETE' });
                    consignmentsList = consignmentsList.filter(c => c.id !== parseInt(id, 10));
                    document.getElementById('hubBatchCount').innerText = consignmentsList.length;
                    delConsignmentBtn.closest('tr')?.remove();
                }
                return;
            }

            const delParcelBtn = e.target.closest('.btn-delete-parcel');
            if (delParcelBtn) {
                const id = delParcelBtn.getAttribute('data-id');
                if (id && confirm('Remove this parcel from consignment?')) {
                    await fetch(`/admin/api/delete-consignment-parcel/${id}`, { method: 'DELETE' });
                    currentParcelsList = currentParcelsList.filter(p => p.id !== id);
                    renderParcelsTable();
                }
                return;
            }
        });

        // Filter consignments in Hub table
        document.getElementById('searchConsignmentsInput')?.addEventListener('input', function() {
            const query = this.value.toLowerCase().trim();
            document.querySelectorAll('.consignment-row').forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });

        // Alt + 1..6 Shortcuts
        window.addEventListener('keydown', function(e) {
            if (e.altKey && !isNaN(e.key) && parseInt(e.key) >= 1 && parseInt(e.key) <= 6) {
                const idx = parseInt(e.key) - 1;
                if (activeBoxPresets && activeBoxPresets[idx]) {
                    e.preventDefault();
                    const p = activeBoxPresets[idx];
                    selectBoxPreset(p.length, p.breadth, p.height, p.name, `preset-chip-${p.id || idx}`);
                }
            }
        });
    </script>
</body>
</html>
