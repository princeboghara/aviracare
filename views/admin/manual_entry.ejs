<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Manual Entry Workspace - Avira Control Center</title>
    <style>
        /* 3D Dropdown Popover Menu Styles */
        .custom-preset-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(0.97);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .custom-preset-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        /* 🌟 HIGHLIGHT ENGINE FOR QUICK VERIFICATION */
        .field-highlight {
            border-color: #10b981 !important;
            background-color: #f0fdf4 !important;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2) !important;
            font-weight: 800 !important;
            transition: all 0.3s ease;
        }

        html.dark .field-highlight {
            background-color: rgba(16, 185, 129, 0.15) !important;
            border-color: #10b981 !important;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.3) !important;
            color: #ffffff !important;
        }

        .ai-scanned-glow {
            animation: highlightGlow 1.5s ease-in-out 2 alternate;
        }

        @keyframes highlightGlow {
            0% {
                background-color: #fef3c7;
                border-color: #f59e0b;
                box-shadow: 0 0 10px rgba(245, 158, 11, 0.4);
            }
            100% {
                background-color: #ecfdf5;
                border-color: #10b981;
                box-shadow: 0 0 8px rgba(16, 185, 129, 0.3);
            }
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-800 w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <%- include('../partials/admin_navbar') %>

    <div class="lg:pl-64 flex flex-col min-h-screen w-full min-w-0">
        
        <header class="glass-panel-header px-4 sm:px-8 py-3 flex justify-between items-center sticky top-0 z-30 shadow-xs w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-keyboard text-emerald-500 flex-shrink-0 text-sm"></i>
                <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider truncate">Tracking / Manual Entry Workspace</span>
            </div>
            
            <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-black text-slate-800 dark:text-slate-200">Avira Root</p>
                    <p class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest font-mono-code">Dispatch Terminal</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 dark:bg-emerald-950/60 rounded-xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800 font-black text-xs shadow-xs">
                    <i class="fa-solid fa-truck-ramp-box text-xs"></i>
                </div>
            </div>
        </header>

        <main class="flex-grow w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-4 sm:space-y-6 box-border">
            
            <!-- AI Camera Label Scanner Banner -->
            <div class="bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 p-4 sm:p-5 rounded-3xl shadow-lg text-white flex flex-col sm:flex-row justify-between items-center gap-4 w-full box-border relative overflow-hidden">
                <div class="absolute -right-8 -top-8 w-40 h-40 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
                
                <div class="flex items-center gap-3.5 min-w-0 w-full sm:w-auto relative z-10">
                    <div class="h-10 w-10 sm:h-12 sm:w-12 rounded-2xl bg-white/15 backdrop-blur-md flex items-center justify-center text-lg sm:text-xl flex-shrink-0 border border-white/25 shadow-inner">
                        <i class="fa-solid fa-bolt text-amber-300"></i>
                    </div>
                    <div class="min-w-0">
                        <h2 class="text-xs sm:text-base font-black uppercase tracking-wide truncate font-outfit">AI Smart Label Scanner</h2>
                        <p class="text-[10px] sm:text-[11px] text-emerald-100 mt-0.5 truncate sm:whitespace-normal font-medium">Scan parcel labels with mobile camera to auto-fill Tracking ID, Name, Mobile, and Pincode instantly.</p>
                    </div>
                </div>
                <div class="w-full sm:w-auto flex-shrink-0 relative z-10">
                    <input type="file" id="cameraInput" accept="image/*" capture="environment" class="hidden">
                    <button type="button" onclick="document.getElementById('cameraInput').click()" class="w-full sm:w-auto bg-white hover:bg-slate-100 text-slate-950 font-black text-xs px-5 py-2.5 rounded-xl shadow-md transition-all uppercase tracking-wider cursor-pointer flex items-center justify-center gap-2 flex-shrink-0 whitespace-nowrap font-outfit">
                        <i class="fa-solid fa-expand text-emerald-600"></i> <span>Scan Label</span>
                    </button>
                </div>
            </div>

            <!-- AI OCR Live Status Box -->
            <div id="ocrStatusBox" class="hidden bg-slate-900 dark:bg-slate-950 text-white p-3 rounded-2xl text-xs font-bold flex items-center justify-between shadow-md border border-slate-800">
                <span id="ocrStatusText" class="flex items-center gap-2"><i class="fa-solid fa-bolt animate-bounce text-amber-400"></i> AI Scanning Label...</span>
                <span id="ocrProgress" class="font-mono-code text-emerald-400 text-[10px]"><i class="fa-solid fa-microchip mr-1"></i> Gemini Vision AI</span>
            </div>

            <!-- Manual Entry Form Card -->
            <div class="bg-white dark:bg-[#111827] p-4 sm:p-6 lg:p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm w-full space-y-4">
                <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex justify-between items-center">
                    <h2 class="text-xs sm:text-sm font-black text-slate-900 dark:text-white uppercase font-outfit tracking-wide flex items-center gap-2">
                        <i class="fa-solid fa-plus text-emerald-500"></i> Add New Dispatch Entry
                    </h2>
                    <span id="highlightNotice" class="hidden text-[10px] font-black text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-200 dark:border-emerald-800 px-2.5 py-1 rounded-lg">
                        <i class="fa-solid fa-eye mr-1"></i> Details Highlighted for Verification
                    </span>
                </div>

                <form id="manualEntryForm" class="space-y-4 text-xs w-full">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                        <div>
                            <label class="block font-black uppercase text-[10px] text-slate-500 dark:text-slate-400 mb-1 tracking-wider flex items-center justify-between">
                                Tracking Number
                                <span class="text-[9px] text-slate-400 font-normal">Required</span>
                            </label>
                            <input type="text" id="mTracking" required class="manual-field w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900/90 rounded-xl border border-slate-200 dark:border-slate-700 uppercase font-mono-code font-bold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                        <div>
                            <label class="block font-black uppercase text-[10px] text-slate-500 dark:text-slate-400 mb-1 tracking-wider flex items-center justify-between">
                                Receiver Name / Link
                                <span class="text-[9px] text-slate-400 font-normal">Required</span>
                            </label>
                            <input type="text" id="mReceiverName" required class="manual-field w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900/90 rounded-xl border border-slate-200 dark:border-slate-700 uppercase font-semibold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                        <div>
                            <label class="block font-black uppercase text-[10px] text-slate-500 dark:text-slate-400 mb-1 tracking-wider flex items-center justify-between">
                                Receiver Mobile
                                <span class="text-[9px] text-slate-400 font-normal">10 Digits</span>
                            </label>
                            <input type="text" id="mMobile" required maxlength="10" placeholder="10 Digits Only"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').substring(0, 10);" 
                                   class="manual-field w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900/90 rounded-xl border border-slate-200 dark:border-slate-700 font-mono-code font-bold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                        <div>
                            <label class="block font-black uppercase text-[10px] text-slate-500 dark:text-slate-400 mb-1 tracking-wider flex items-center justify-between">
                                Receiver Pincode
                                <span class="text-[9px] text-slate-400 font-normal">6 Digits</span>
                            </label>
                            <input type="text" id="mPincode" maxlength="6" required oninput="this.value = this.value.replace(/[^0-9]/g, '');"
                                   class="manual-field w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900/90 rounded-xl border border-slate-200 dark:border-slate-700 font-mono-code font-bold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                    </div>

                    <!-- Box Dimensions & Presets Section -->
                    <div class="bg-slate-50/90 dark:bg-slate-900/70 p-3.5 sm:p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 space-y-3">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-slate-200/60 dark:border-slate-800 pb-2.5">
                            <label class="font-black uppercase text-[10px] text-slate-700 dark:text-slate-300 flex items-center gap-1.5 tracking-wider">
                                <i class="fa-solid fa-boxes-packing text-emerald-500 text-xs"></i> Box Dimensions
                            </label>
                            
                            <div class="relative w-full sm:w-72">
                                <button type="button" id="presetBtn" class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-xs font-bold text-slate-700 dark:text-slate-200 hover:border-emerald-400 focus:outline-none shadow-xs flex justify-between items-center cursor-pointer transition-all">
                                    <span id="selectedPresetLabel" class="flex items-center gap-1.5 truncate">
                                        <i class="fa-solid fa-bolt text-amber-400"></i> Select Box Preset...
                                    </span>
                                    <i id="presetChevron" class="fa-solid fa-chevron-down text-[10px] text-slate-400 transition-transform duration-300"></i>
                                </button>

                                <div id="presetMenu" class="custom-preset-menu absolute right-0 left-0 sm:left-auto sm:w-72 top-full mt-1 bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl z-50 p-2 space-y-1">
                                    <p class="p-2 text-center text-[10px] text-slate-400 font-semibold">Loading Presets...</p>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
                            <div>
                                <label class="block font-black uppercase text-[10px] text-slate-400 dark:text-slate-500 mb-1 tracking-wider">Weight (Grams / g)</label>
                                <input type="number" id="mWeight" placeholder="e.g. 500" required class="manual-field w-full px-2.5 py-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-emerald-500 font-bold text-xs text-slate-800 dark:text-slate-100 transition-all font-mono-code">
                            </div>
                            <div>
                                <label class="block font-black uppercase text-[10px] text-slate-400 dark:text-slate-500 mb-1 tracking-wider">Length (cm)</label>
                                <input type="number" id="mLength" required class="manual-field w-full px-2.5 py-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-emerald-500 font-bold text-xs text-slate-800 dark:text-slate-100 transition-all font-mono-code">
                            </div>
                            <div>
                                <label class="block font-black uppercase text-[10px] text-slate-400 dark:text-slate-500 mb-1 tracking-wider">Breadth (cm)</label>
                                <input type="number" id="mBreadth" required class="manual-field w-full px-2.5 py-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-emerald-500 font-bold text-xs text-slate-800 dark:text-slate-100 transition-all font-mono-code">
                            </div>
                            <div>
                                <label class="block font-black uppercase text-[10px] text-slate-400 dark:text-slate-500 mb-1 tracking-wider">Height (cm)</label>
                                <input type="number" id="mHeight" required class="manual-field w-full px-2.5 py-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-emerald-500 font-bold text-xs text-slate-800 dark:text-slate-100 transition-all font-mono-code">
                            </div>
                        </div>
                    </div>

                    <!-- Auto-Fetched Location Section -->
                    <div class="bg-emerald-50/40 dark:bg-emerald-950/20 p-3.5 sm:p-4 rounded-2xl border border-emerald-100/70 dark:border-emerald-900/50 grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-[10px] font-black uppercase text-emerald-800 dark:text-emerald-400 mb-1 tracking-wider">City</label>
                            <input type="text" id="txtCity" placeholder="MANUAL / AUTO" class="manual-field w-full px-3 py-2 bg-white dark:bg-slate-900 border border-emerald-200/80 dark:border-emerald-800/80 rounded-xl text-[11px] font-extrabold uppercase focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                        <div>
                            <label class="block text-[10px] font-black uppercase text-emerald-800 dark:text-emerald-400 mb-1 tracking-wider">State</label>
                            <input type="text" id="txtState" placeholder="MANUAL / AUTO" class="manual-field w-full px-3 py-2 bg-white dark:bg-slate-900 border border-emerald-200/80 dark:border-emerald-800/80 rounded-xl text-[11px] font-extrabold uppercase focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                        <div>
                            <label class="block text-[10px] font-black uppercase text-emerald-800 dark:text-emerald-400 mb-1 tracking-wider">Area / Address Line</label>
                            <input type="text" id="txtAddress" placeholder="MANUAL / AUTO" class="manual-field w-full px-3 py-2 bg-white dark:bg-slate-900 border border-emerald-200/80 dark:border-emerald-800/80 rounded-xl text-[11px] font-extrabold uppercase focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="submit" class="w-full sm:w-auto btn-emerald-3d text-white text-xs font-black px-6 py-3 rounded-xl transition-all shadow-md cursor-pointer uppercase tracking-wider flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-circle-check text-sm"></i> <span>Save Entry</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Current Session Entries Table Card -->
            <div class="bg-white dark:bg-[#111827] rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden w-full">
                <div class="px-4 py-3.5 bg-slate-50 dark:bg-[#0d1322] border-b border-slate-100 dark:border-slate-800 flex justify-between items-center flex-wrap gap-2">
                    <div class="flex items-center gap-3">
                        <h2 class="text-xs sm:text-sm font-black text-slate-900 dark:text-white uppercase font-outfit tracking-wide flex items-center gap-2">
                            <i class="fa-solid fa-list-check text-emerald-500"></i> Current Session Entries
                        </h2>
                        <span id="entryCounter" class="bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 text-[10px] font-black px-2.5 py-0.5 rounded-full font-mono-code">
                            Total Entries: 0
                        </span>
                    </div>
                    
                    <button id="exportExcelBtn" class="bg-slate-900 hover:bg-slate-950 text-white font-black text-[11px] px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer shadow-sm uppercase tracking-wider">
                        <i class="fa-solid fa-file-excel text-emerald-400"></i> <span>Export Excel</span>
                    </button>
                </div>
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[650px]">
                        <thead>
                            <tr class="bg-slate-100/70 dark:bg-slate-900/60 border-b border-slate-100 dark:border-slate-800 text-slate-400 dark:text-slate-500 font-black uppercase text-[10px] tracking-wider select-none">
                                <th class="py-3 px-3 w-12 text-center cursor-pointer hover:text-emerald-600 transition-colors" onclick="toggleSortOrder()">
                                    SR <i class="fa-solid fa-sort text-[10px] ml-0.5" id="sortIcon"></i>
                                </th>
                                <th class="py-3 px-4">Tracking No</th>
                                <th class="py-3 px-4">Receiver Name</th>
                                <th class="py-3 px-4">Mobile</th>
                                <th class="py-3 px-4">Pincode & Location</th>
                                <th class="py-3 px-4">Weight & Dimensions</th>
                                <th class="py-3 px-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="sessionTableBody" class="divide-y divide-slate-100 dark:divide-slate-800 font-semibold text-slate-700 dark:text-slate-300">
                            <tr>
                                <td colspan="7" class="py-12 text-center text-slate-400 dark:text-slate-500 font-normal">
                                    <i class="fa-solid fa-inbox text-3xl block mb-2 text-slate-300 dark:text-slate-700"></i>
                                    No entries added in this session yet.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>

        <footer class="bg-white dark:bg-[#0d1322] border-t border-slate-200/80 dark:border-slate-800 py-3.5 text-center text-xs font-medium text-slate-400 dark:text-slate-500 mt-6 w-full overflow-hidden">
            &copy; 2026 Avira LifeCare System. All rights reserved.
        </footer>
    </div>

    <script>
        let localEntries = JSON.parse('<%- JSON.stringify(entries || []) %>');
        let isNewestFirst = true;

        window.onload = () => { 
            document.getElementById('mTracking').focus(); 
            renderTable(); 
            loadPresetsFromDB();
            setupInputHighlightListeners();
        };

        function setupInputHighlightListeners() {
            const inputs = document.querySelectorAll('.manual-field');
            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.classList.add('field-highlight');
                    } else {
                        this.classList.remove('field-highlight');
                    }
                });
            });
        }

        function triggerFieldHighlight(elementId) {
            const el = document.getElementById(elementId);
            if (el && el.value.trim() !== '') {
                el.classList.add('field-highlight', 'ai-scanned-glow');
            }
        }

        function toggleSortOrder() {
            isNewestFirst = !isNewestFirst;
            const sortIcon = document.getElementById('sortIcon');
            if (isNewestFirst) {
                sortIcon.className = "fa-solid fa-sort-down text-emerald-600 ml-0.5";
            } else {
                sortIcon.className = "fa-solid fa-sort-up text-emerald-600 ml-0.5";
            }
            renderTable();
        }

        async function loadPresetsFromDB() {
            const menu = document.getElementById('presetMenu');
            try {
                const res = await fetch('/admin/api/get-box-presets');
                const data = await res.json();
                
                if (data.success && data.presets && data.presets.length > 0) {
                    menu.innerHTML = '';
                    data.presets.forEach(p => {
                        const firstChar = p.name ? p.name.charAt(0).toUpperCase() : 'B';
                        menu.innerHTML += `
                            <div onclick="applyBoxPreset(${p.length}, ${p.breadth}, ${p.height}, '${p.name}')" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-emerald-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-400 cursor-pointer transition-all">
                                <div class="h-7 w-7 rounded-lg bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-black text-xs flex-shrink-0">${firstChar}</div>
                                <div>
                                    <p class="text-xs font-black uppercase font-outfit">${p.name}</p>
                                    <p class="text-[9px] text-slate-400 font-mono-code">${p.length} x ${p.breadth} x ${p.height} cm</p>
                                </div>
                            </div>
                        `;
                    });
                } else {
                    menu.innerHTML = `
                        <div onclick="applyBoxPreset(15, 10, 5, 'Small Box (15x10x5 cm)')" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-emerald-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-400 cursor-pointer transition-all">
                            <div class="h-7 w-7 rounded-lg bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-black text-xs flex-shrink-0">S</div>
                            <div>
                                <p class="text-xs font-black font-outfit">Small Box</p>
                                <p class="text-[9px] text-slate-400 font-mono-code">15 x 10 x 5 cm</p>
                            </div>
                        </div>
                        <div onclick="applyBoxPreset(20, 15, 10, 'Medium Box (20x15x10 cm)')" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-emerald-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-400 cursor-pointer transition-all">
                            <div class="h-7 w-7 rounded-lg bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-black text-xs flex-shrink-0">M</div>
                            <div>
                                <p class="text-xs font-black font-outfit">Medium Box</p>
                                <p class="text-[9px] text-slate-400 font-mono-code">20 x 15 x 10 cm</p>
                            </div>
                        </div>
                        <div onclick="applyBoxPreset(30, 20, 15, 'Large Box (30x20x15 cm)')" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-emerald-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-400 cursor-pointer transition-all">
                            <div class="h-7 w-7 rounded-lg bg-amber-100 dark:bg-amber-950 text-amber-600 dark:text-amber-400 flex items-center justify-center font-black text-xs flex-shrink-0">L</div>
                            <div>
                                <p class="text-xs font-black font-outfit">Large Box</p>
                                <p class="text-[9px] text-slate-400 font-mono-code">30 x 20 x 15 cm</p>
                            </div>
                        </div>
                    `;
                }
            } catch (err) {
                console.error("Fetch Presets Error:", err);
            }
        }

        const presetBtn = document.getElementById('presetBtn');
        const presetMenu = document.getElementById('presetMenu');
        const presetChevron = document.getElementById('presetChevron');

        presetBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const isActive = presetMenu.classList.contains('active');
            if (isActive) {
                closePresetDropdown();
            } else {
                presetMenu.classList.add('active');
                presetChevron.classList.add('rotate-180');
            }
        });

        document.addEventListener('click', function(e) {
            if (!presetBtn.contains(e.target) && !presetMenu.contains(e.target)) {
                closePresetDropdown();
            }
        });

        function closePresetDropdown() {
            presetMenu.classList.remove('active');
            presetChevron.classList.remove('rotate-180');
        }

        function applyBoxPreset(l, b, h, label) {
            document.getElementById('mLength').value = l;
            document.getElementById('mBreadth').value = b;
            document.getElementById('mHeight').value = h;
            
            triggerFieldHighlight('mLength');
            triggerFieldHighlight('mBreadth');
            triggerFieldHighlight('mHeight');

            document.getElementById('selectedPresetLabel').innerHTML = `<i class="fa-solid fa-check text-emerald-500"></i> ${label}`;
            closePresetDropdown();
        }

        document.getElementById('cameraInput').addEventListener('change', async function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const statusBox = document.getElementById('ocrStatusBox');
            const statusText = document.getElementById('ocrStatusText');
            
            statusBox.classList.remove('hidden');
            statusText.innerHTML = `<i class="fa-solid fa-bolt animate-bounce text-amber-400"></i> Compressing & AI Scanning...`;

            try {
                const compressedBlob = await compressImage(file);
                const formData = new FormData();
                formData.append('labelImage', compressedBlob, 'label.jpg');

                const res = await fetch('/admin/api/scan-ai-label', {
                    method: 'POST',
                    body: formData
                });
                const result = await res.json();
                statusBox.classList.add('hidden');

                if (result.success && result.data) {
                    const { tracking, name, mobile, pincode } = result.data;

                    if (tracking) {
                        document.getElementById('mTracking').value = tracking.toUpperCase().trim();
                        triggerFieldHighlight('mTracking');
                    }
                    if (name) {
                        document.getElementById('mReceiverName').value = name.toUpperCase().trim();
                        triggerFieldHighlight('mReceiverName');
                    }
                    if (mobile) {
                        document.getElementById('mMobile').value = mobile.trim();
                        triggerFieldHighlight('mMobile');
                    }
                    if (pincode) {
                        const cleanPin = pincode.toString().trim();
                        document.getElementById('mPincode').value = cleanPin;
                        triggerFieldHighlight('mPincode');
                        await fetchPincodeDetails(cleanPin);
                    }

                    document.getElementById('highlightNotice').classList.remove('hidden');
                    document.getElementById('mWeight').focus();
                } else {
                    alert(result.msg || "AI could not read the label image clearly. Please try again.");
                }
            } catch (err) {
                console.error("AI Scan Error:", err);
                statusText.innerText = "Scanning error! Please try again.";
                setTimeout(() => statusBox.classList.add('hidden'), 3000);
            }

            this.value = '';
        });

        function compressImage(file) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const maxWidth = 800; 
                        let width = img.width;
                        let height = img.height;

                        if (width > maxWidth) {
                            height = Math.round((height * maxWidth) / width);
                            width = maxWidth;
                        }

                        canvas.width = width;
                        canvas.height = height;

                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        canvas.toBlob((blob) => {
                            resolve(blob);
                        }, 'image/jpeg', 0.55);
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        async function fetchPincodeDetails(pincode) {
            try {
                const res = await fetch(`/admin/api/fetch-details?pincode=${pincode}`);
                const data = await res.json();
                if (data.success && (data.city || data.state || data.address)) {
                    document.getElementById('txtCity').value = data.city || '';
                    document.getElementById('txtState').value = data.state || '';
                    document.getElementById('txtAddress').value = data.address || '';

                    triggerFieldHighlight('txtCity');
                    triggerFieldHighlight('txtState');
                    triggerFieldHighlight('txtAddress');
                }
            } catch(err) {
                console.error("Auto-fetch address error:", err);
            }
        }

        document.getElementById('mPincode').addEventListener('input', async function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
            const pincode = this.value.trim();
            
            if (pincode.length === 6) {
                await fetchPincodeDetails(pincode);
            } else {
                document.getElementById('txtCity').value = '';
                document.getElementById('txtState').value = '';
                document.getElementById('txtAddress').value = '';
            }
        });

        document.getElementById('manualEntryForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const weightGrams = parseFloat(document.getElementById('mWeight').value || 0);
            const weightInKg = (weightGrams >= 10) ? (weightGrams / 1000) : weightGrams;

            const payload = {
                tracking: document.getElementById('mTracking').value.toUpperCase().trim(),
                name: document.getElementById('mReceiverName').value.toUpperCase().trim(),
                mobile: document.getElementById('mMobile').value.trim(),
                pincode: document.getElementById('mPincode').value.trim(),
                weight: weightInKg,
                rawGrams: weightGrams,
                length: document.getElementById('mLength').value,
                breadth: document.getElementById('mBreadth').value,
                height: document.getElementById('mHeight').value,
                city: document.getElementById('txtCity').value.toUpperCase().trim() || 'N/A',
                state: document.getElementById('txtState').value.toUpperCase().trim() || 'N/A',
                address: document.getElementById('txtAddress').value.toUpperCase().trim() || 'N/A'
            };

            try {
                const res = await fetch('/admin/api/save-manual', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                
                if(result.success) {
                    localEntries = result.entries;
                    renderTable();
                    
                    document.getElementById('manualEntryForm').reset();
                    document.querySelectorAll('.manual-field').forEach(field => {
                        field.classList.remove('field-highlight', 'ai-scanned-glow');
                    });
                    document.getElementById('highlightNotice').classList.add('hidden');
                    
                    document.getElementById('txtCity').value = '';
                    document.getElementById('txtState').value = '';
                    document.getElementById('txtAddress').value = '';
                    document.getElementById('selectedPresetLabel').innerHTML = `<i class="fa-solid fa-bolt text-amber-400"></i> Select Box Preset...`;
                    
                    document.getElementById('mTracking').focus();
                }
            } catch(err) { console.error(err); }
        });

        function renderTable() {
            const tbody = document.getElementById('sessionTableBody');
            const counter = document.getElementById('entryCounter');
            
            if (!localEntries) localEntries = [];
            counter.innerText = `Total Entries: ${localEntries.length}`;

            if (localEntries.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-12 text-center text-slate-400 dark:text-slate-500 font-normal"><i class="fa-solid fa-inbox text-3xl block mb-2 text-slate-300 dark:text-slate-700"></i>No entries added in this session yet.</td></tr>`;
                return;
            }

            let sortedList = localEntries.map((item, idx) => ({ ...item, originalIndex: idx + 1 }));

            if (isNewestFirst) {
                sortedList.reverse();
            }

            tbody.innerHTML = '';
            sortedList.forEach((item) => {
                const cityStateText = (item.city || item.state) ? `${item.city || ''}, ${item.state || ''}` : '';
                const dimText = (item.length && item.breadth && item.height) ? `${item.length}x${item.breadth}x${item.height} cm` : 'N/A';
                
                let weightDisplay = 'N/A';
                if (item.rawGrams) {
                    weightDisplay = `${item.rawGrams} g`;
                } else if (item.weight) {
                    const numW = parseFloat(item.weight);
                    weightDisplay = (numW < 5) ? `${numW * 1000} g` : `${numW} kg`;
                }

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                        <td class="py-3 px-3 font-mono-code font-bold text-slate-400 text-center">${item.originalIndex}</td>
                        <td class="py-3 px-4 font-mono-code font-black text-slate-900 dark:text-white">${item.tracking || 'N/A'}</td>
                        <td class="py-3 px-4 uppercase font-bold text-emerald-700 dark:text-emerald-400">${item.name || 'N/A'}</td>
                        <td class="py-3 px-4 font-mono-code font-semibold text-slate-700 dark:text-slate-300">${item.mobile || 'N/A'}</td>
                        <td class="py-3 px-4">
                            <div class="font-mono-code font-black text-emerald-600 dark:text-emerald-400">${item.pincode || 'N/A'}</div>
                            <div class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500">${cityStateText}</div>
                        </td>
                        <td class="py-3 px-4">
                            <div class="font-bold text-slate-800 dark:text-slate-200">${weightDisplay}</div>
                            <div class="font-mono-code text-[10px] text-slate-400 dark:text-slate-500 font-medium">${dimText}</div>
                        </td>
                        <td class="py-3 px-4 text-center">
                            <button type="button" onclick="deleteItem(${item.id})" class="text-rose-500 hover:text-rose-600 dark:text-rose-400 font-black cursor-pointer inline-flex items-center gap-1">
                                <i class="fa-solid fa-trash text-xs"></i> Delete
                            </button>
                        </td>
                    </tr>
                `;
            });
        }

        async function deleteItem(id) {
            if(!id) {
                alert("Invalid entry ID!");
                return;
            }
            if(confirm("Are you sure you want to delete this entry?")) {
                try {
                    const res = await fetch(`/admin/api/delete-entry/${id}`, { method: 'DELETE' });
                    const result = await res.json();
                    if(result.success) {
                        localEntries = result.entries;
                        renderTable();
                    } else {
                        alert("Error: " + (result.msg || "Failed to delete"));
                    }
                } catch(err) { console.error(err); }
            }
        }

        document.getElementById('exportExcelBtn').addEventListener('click', function() {
            if(localEntries.length === 0) {
                alert("Please add at least one entry before exporting.");
                return;
            }
            let customName = prompt("Enter file name for Excel export:", "avira_india_post_dispatch");
            if (customName === null) return;
            if (customName.trim() === "") customName = "avira_india_post_dispatch";

            window.location.href = `/admin/api/export-excel?filename=${encodeURIComponent(customName)}`;
        });
    </script>
</body>
</html>
