<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <%- include('../partials/head_meta') %>
    <title>Executive Control Hub - AviraCare Systems</title>
    <!-- Chart.js Engine (Lightweight Performance Build) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <style>
        /* ⚡ Zero-Lag Hardware Accelerated Styling */
        body {
            background-color: #f8fafc !important;
            background-attachment: scroll !important; /* Eradicate scroll lag on all devices */
        }

        .corp-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.04);
            transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s ease, border-color 0.18s ease;
            will-change: transform;
        }
        @media (hover: hover) and (pointer: fine) {
            .corp-card:hover {
                transform: translateY(-2px);
                border-color: #cbd5e1;
                box-shadow: 0 8px 20px -3px rgba(15, 23, 42, 0.06);
            }
        }

        /* Interactive Action Link */
        .hub-link-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.65rem 0.8rem;
            border-radius: 0.75rem;
            background: #f8fafc;
            border: 1px solid #f1f5f9;
            color: #334155;
            font-size: 0.8125rem;
            font-weight: 600;
            transition: all 0.15s ease;
        }
        @media (hover: hover) and (pointer: fine) {
            .hub-link-item:hover {
                background: #eff6ff;
                border-color: #bfdbfe;
                color: #1d4ed8;
                transform: translateX(2px);
            }
        }

        /* High-Impact Responsive KPI Card */
        .kpi-card-fast {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            padding: 1rem;
            transition: all 0.18s ease;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03);
        }
        @media (min-width: 640px) {
            .kpi-card-fast {
                padding: 1.25rem;
            }
        }
        @media (hover: hover) and (pointer: fine) {
            .kpi-card-fast:hover {
                border-color: #93c5fd;
                box-shadow: 0 8px 16px -2px rgba(37, 99, 235, 0.06);
            }
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-800 w-full overflow-x-hidden block">
    <% 
        const aData = (typeof analytics !== 'undefined' && analytics) ? analytics : null;
        const sData = (typeof stats !== 'undefined' && stats) ? stats : {};
    %>

    <%- include('../partials/admin_navbar') %>

    <div class="w-full lg:pl-64 min-h-screen flex flex-col justify-between box-border min-w-0">

        <!-- 🧭 Top Navigation Header -->
        <header class="bg-white border-b border-slate-200 px-4 sm:px-8 py-3.5 flex justify-between items-center sticky top-0 z-40 w-full">
            <div class="flex items-center gap-2 min-w-0">
                <button type="button" onclick="toggleSidebar()" class="p-1.5 rounded-xl text-slate-500 hover:text-blue-600 hover:bg-blue-50 border border-slate-200 transition-all flex items-center justify-center cursor-pointer mr-1" title="Toggle Sidebar">
                    <i class="fa-solid fa-bars text-sm"></i>
                </button>
                <i class="fa-solid fa-house text-blue-600 flex-shrink-0 text-sm"></i>
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider truncate">Avira Admin / Executive Control Hub</span>
            </div>
            <div class="flex items-center gap-2.5 sm:gap-4 flex-shrink-0 ml-2">
                <!-- Live Clock -->
                <div class="hidden md:flex flex-col text-right">
                    <span id="liveClock" class="text-xs font-mono font-bold text-slate-700 leading-none">--:--:--</span>
                    <span id="liveDate" class="text-[9px] font-semibold text-slate-400 mt-1 uppercase tracking-wider">IST Date</span>
                </div>
                <!-- User Profile pill -->
                <div class="flex items-center gap-2 pl-2 sm:pl-3 border-l border-slate-200">
                    <div class="text-right hidden sm:block">
                        <p class="text-xs font-bold text-slate-800"><%= (typeof user !== 'undefined' && user && user.name) ? user.name : 'Administrator' %></p>
                        <p class="text-[9px] font-bold text-emerald-600 uppercase tracking-widest">Active Workspace</p>
                    </div>
                    <div class="h-8 w-8 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600 border border-blue-200 font-bold text-xs shadow-2xs">A</div>
                </div>
            </div>
        </header>

        <!-- 🌐 Main Executive Dashboard Body -->
        <main class="flex-grow w-full px-4 sm:px-6 lg:px-8 xl:px-10 py-4 sm:py-6 space-y-4 sm:space-y-6 box-border">

        <!-- 🌟 Corporate Command Hero Banner -->
        <div class="rounded-2xl sm:rounded-3xl bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 p-4 sm:p-6 lg:p-7 text-white shadow-md border border-slate-800 relative overflow-hidden">
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-4 sm:gap-6">
                <!-- Welcome Title & Subtitle -->
                <div class="space-y-1 sm:space-y-1.5 max-w-2xl">
                    <h1 id="greetingMessage" class="text-xl sm:text-2xl lg:text-3xl font-black tracking-tight text-white leading-tight">
                        Welcome Back, Administrator
                    </h1>
                    <p class="text-slate-300 text-xs sm:text-sm font-medium leading-relaxed">
                        Parcel dispatches, live tracking synchronization, customer master database, and automation engines.
                    </p>
                </div>

                <!-- Primary Action Quick Buttons (Touch-friendly & Responsive) -->
                <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 sm:gap-2.5 flex-shrink-0">
                    <a href="/admin/manual-entry" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold uppercase tracking-wider shadow-sm transition-all text-center">
                        <i class="fa-solid fa-plus-circle text-xs"></i>
                        <span>Dispatch</span>
                    </a>
                    <a href="/admin/orders-master" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase tracking-wider border border-white/20 transition-all text-center">
                        <i class="fa-solid fa-receipt text-blue-300 text-xs"></i>
                        <span>Orders</span>
                    </a>
                    <a href="/admin/live-tracking" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase tracking-wider border border-white/20 transition-all text-center">
                        <i class="fa-solid fa-satellite-dish text-emerald-400 text-xs"></i>
                        <span>Tracking</span>
                    </a>
                    <a href="/admin/log-monitor" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase tracking-wider border border-white/20 transition-all text-center">
                        <i class="fa-solid fa-terminal text-cyan-300 text-xs"></i>
                        <span>Logs</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- 📊 4 Real-Time Executive KPI Telemetry Tiles -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-5 w-full">
            
            <!-- KPI 1: Today's Dispatched Orders -->
            <div class="kpi-card-fast flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2 sm:mb-3">
                    <span class="text-[10px] sm:text-[11px] font-black text-slate-500 uppercase tracking-wider">Today's Dispatch</span>
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center text-xs sm:text-sm">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline gap-1.5 sm:gap-2">
                        <span id="kpiTodayCount" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= (aData && aData.today) ? aData.today.count : 0 %></span>
                        <span class="text-[11px] sm:text-xs font-bold text-indigo-600">orders</span>
                    </div>
                    <div class="mt-1.5 sm:mt-2 flex items-center gap-1 text-[9px] sm:text-[10px] font-bold text-slate-500 truncate">
                        <i class="fa-regular fa-calendar-check text-emerald-500"></i>
                        <span id="kpiTodayDate" class="truncate"><%= (aData && aData.today && aData.today.dateStr) ? aData.today.dateStr : 'Today' %></span>
                    </div>
                </div>
            </div>

            <!-- KPI 2: Yesterday's Dispatched Orders -->
            <div class="kpi-card-fast flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2 sm:mb-3">
                    <span class="text-[10px] sm:text-[11px] font-black text-slate-500 uppercase tracking-wider">Yesterday</span>
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center text-xs sm:text-sm">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline gap-1.5 sm:gap-2">
                        <span id="kpiYesterdayCount" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= (aData && aData.yesterday) ? aData.yesterday.count : 0 %></span>
                        <span class="text-[11px] sm:text-xs font-bold text-blue-600">orders</span>
                    </div>
                    <div class="mt-1.5 sm:mt-2 flex items-center gap-1 text-[9px] sm:text-[10px] font-bold text-slate-500 truncate">
                        <i class="fa-regular fa-calendar text-slate-400"></i>
                        <span id="kpiYesterdayDate" class="truncate"><%= (aData && aData.yesterday && aData.yesterday.dateStr) ? aData.yesterday.dateStr : 'Yesterday' %></span>
                    </div>
                </div>
            </div>

            <!-- KPI 3: Total Dispatched Parcels -->
            <div class="kpi-card-fast flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2 sm:mb-3">
                    <span class="text-[10px] sm:text-[11px] font-black text-slate-500 uppercase tracking-wider">Total Dispatched</span>
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center text-xs sm:text-sm">
                        <i class="fa-solid fa-boxes-packing"></i>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline gap-1.5 sm:gap-2">
                        <span id="kpiTotalDispatched" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= (aData && aData.totals) ? aData.totals.totalDispatched : 0 %></span>
                        <span class="text-[11px] sm:text-xs font-bold text-emerald-600">parcels</span>
                    </div>
                    <div class="mt-1.5 sm:mt-2 flex items-center gap-1 text-[9px] sm:text-[10px] font-bold text-slate-500 truncate">
                        <i class="fa-solid fa-layer-group text-emerald-500"></i>
                        <span><strong id="kpiTotalConsignments"><%= (aData && aData.totals) ? aData.totals.totalConsignments : 0 %></strong> Batches</span>
                    </div>
                </div>
            </div>

            <!-- KPI 4: States Covered (Pan-India) -->
            <div class="kpi-card-fast flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2 sm:mb-3">
                    <span class="text-[10px] sm:text-[11px] font-black text-slate-500 uppercase tracking-wider">States Covered</span>
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center text-xs sm:text-sm">
                        <i class="fa-solid fa-map-location-dot"></i>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline gap-1.5 sm:gap-2">
                        <span id="kpiStatesCount" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= (aData && aData.totals) ? aData.totals.totalStates : 0 %></span>
                        <span class="text-[11px] sm:text-xs font-bold text-purple-600">States</span>
                    </div>
                    <div class="mt-1.5 sm:mt-2 flex items-center gap-1 text-[9px] sm:text-[10px] font-bold text-slate-500 truncate">
                        <i class="fa-solid fa-route text-purple-500"></i>
                        <span>Pan-India Logistics</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- 📈 Interactive Graphics & Analytical Intelligence Section -->
        <section class="space-y-4" id="dispatchAnalyticsSection">
            <!-- Analytics Header & Command Status -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-1">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-600 via-indigo-700 to-purple-600 text-white flex items-center justify-center text-xs font-black shadow-xs">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <h2 class="text-sm sm:text-base font-black text-slate-900 tracking-tight">Dispatch Trends & Geographic Distribution</h2>
                    </div>
                    <p class="text-[11px] text-slate-400 font-medium sm:pl-10">Daily dispatch volume timeline, velocity dynamics & pan-India state breakdown</p>
                </div>

                <div class="flex items-center gap-3 self-end sm:self-auto">
                    <span id="analyticsLastUpdated" class="text-[10px] font-medium text-slate-400 hidden sm:inline-block">
                        Synced with cloud
                    </span>
                    <button type="button" id="btnRefreshAnalytics" onclick="refreshAnalytics(true)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition-all cursor-pointer">
                        <i class="fa-solid fa-arrows-rotate text-[11px]" id="refreshAnalyticsIcon"></i>
                        <span>Refresh Data</span>
                    </button>
                </div>
            </div>

            <!-- ⚡ Quick Telemetry Insights Strip (Micro-Cards) -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-3.5">
                <!-- Insight 1: Peak Dispatch Day -->
                <div class="p-3 rounded-2xl bg-white border border-slate-200/80 shadow-2xs flex items-center justify-between">
                    <div>
                        <span class="text-[9px] sm:text-[10px] font-black text-slate-400 uppercase tracking-wider block">Peak Dispatch Day</span>
                        <span id="metricPeakDay" class="text-xs sm:text-sm font-black text-slate-900 tracking-tight block">--</span>
                    </div>
                    <div class="w-8 h-8 rounded-xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center text-xs flex-shrink-0">
                        <i class="fa-solid fa-bolt-lightning"></i>
                    </div>
                </div>

                <!-- Insight 2: Top Delivery State -->
                <div class="p-3 rounded-2xl bg-white border border-slate-200/80 shadow-2xs flex items-center justify-between">
                    <div>
                        <span class="text-[9px] sm:text-[10px] font-black text-slate-400 uppercase tracking-wider block">Top State Hub</span>
                        <span id="metricTopState" class="text-xs sm:text-sm font-black text-slate-900 tracking-tight truncate max-w-[100px] sm:max-w-[130px] block">--</span>
                    </div>
                    <div class="w-8 h-8 rounded-xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center text-xs flex-shrink-0">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                </div>

                <!-- Insight 3: Average Parcels per Batch -->
                <div class="p-3 rounded-2xl bg-white border border-slate-200/80 shadow-2xs flex items-center justify-between">
                    <div>
                        <span class="text-[9px] sm:text-[10px] font-black text-slate-400 uppercase tracking-wider block">Avg Batch Size</span>
                        <span id="metricAvgBatch" class="text-xs sm:text-sm font-black text-slate-900 tracking-tight block">--</span>
                    </div>
                    <div class="w-8 h-8 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center text-xs flex-shrink-0">
                        <i class="fa-solid fa-boxes-packing"></i>
                    </div>
                </div>

                <!-- Insight 4: Active Regions -->
                <div class="p-3 rounded-2xl bg-white border border-slate-200/80 shadow-2xs flex items-center justify-between">
                    <div>
                        <span class="text-[9px] sm:text-[10px] font-black text-slate-400 uppercase tracking-wider block">Pan-India Reach</span>
                        <span id="metricActiveStates" class="text-xs sm:text-sm font-black text-slate-900 tracking-tight block">--</span>
                    </div>
                    <div class="w-8 h-8 rounded-xl bg-sky-50 border border-sky-100 text-sky-600 flex items-center justify-center text-xs flex-shrink-0">
                        <i class="fa-solid fa-globe"></i>
                    </div>
                </div>
            </div>

            <!-- Three Interactive Multi-View Analytics Cards (Responsive 1-Col Mobile, 2-Col Tablet, 3-Col Desktop) -->
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5 lg:gap-6 w-full">
                
                <!-- Chart 1: Daily Dispatch Timeline & Velocity Dynamics -->
                <div class="corp-card p-4 sm:p-5 flex flex-col justify-between">
                    <div>
                        <!-- Header with Mode Switcher -->
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-3 pb-2.5 border-b border-slate-100">
                            <div class="flex items-center gap-2">
                                <span class="h-2.5 w-2.5 rounded-full bg-indigo-600 ring-4 ring-indigo-50"></span>
                                <div>
                                    <h3 class="text-xs sm:text-sm font-black text-slate-900 leading-none">Daily Dispatch Velocity</h3>
                                    <span class="text-[10px] text-slate-400 font-medium">Timeline of orders shipped</span>
                                </div>
                            </div>

                            <!-- Interactive Mode Switcher Pill -->
                            <div class="inline-flex items-center p-0.5 rounded-lg bg-slate-100 border border-slate-200 text-[10px] font-bold">
                                <button type="button" id="btnTrendWave" onclick="switchTrendView('wave')" class="px-2.5 py-1 rounded-md transition-all font-black bg-white text-indigo-600 shadow-2xs cursor-pointer">
                                    Wave
                                </button>
                                <button type="button" id="btnTrendBar" onclick="switchTrendView('bar')" class="px-2.5 py-1 rounded-md transition-all text-slate-500 hover:text-slate-800 cursor-pointer">
                                    Bars
                                </button>
                            </div>
                        </div>

                        <!-- Canvas Container -->
                        <div class="relative w-full h-56 sm:h-64">
                            <canvas id="dailyDispatchChart"></canvas>
                        </div>
                    </div>

                    <!-- Mini Telemetry Strip under Chart -->
                    <div class="pt-3 mt-2 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-[10px] sm:text-[11px] text-slate-500 font-medium">
                        <div class="flex items-center gap-3">
                            <span class="flex items-center gap-1.5 font-bold text-slate-700">
                                <span class="h-2 w-2 rounded-full bg-indigo-600 inline-block"></span> Past Batches
                            </span>
                            <span class="flex items-center gap-1.5 font-bold text-emerald-700">
                                <span class="h-2 w-2 rounded-full bg-emerald-500 inline-block"></span> Today
                            </span>
                        </div>
                        <div id="trendHighlightBadge" class="text-[10px] font-semibold text-slate-500">
                            Calculating...
                        </div>
                    </div>
                </div>

                <!-- Chart 2: State Breakdown & Regional Matrix -->
                <div class="corp-card p-4 sm:p-5 flex flex-col justify-between">
                    <div>
                        <!-- Header with Mode Switcher -->
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-3 pb-2.5 border-b border-slate-100">
                            <div class="flex items-center gap-2">
                                <span class="h-2.5 w-2.5 rounded-full bg-purple-600 ring-4 ring-purple-50"></span>
                                <div>
                                    <h3 class="text-xs sm:text-sm font-black text-slate-900 leading-none">State Destinations</h3>
                                    <span class="text-[10px] text-slate-400 font-medium">Regional parcel breakdown</span>
                                </div>
                            </div>

                            <!-- Interactive Mode Switcher Pill -->
                            <div class="inline-flex items-center p-0.5 rounded-lg bg-slate-100 border border-slate-200 text-[10px] font-bold">
                                <button type="button" id="btnGeoLeaderboard" onclick="switchGeoView('leaderboard')" class="px-2.5 py-1 rounded-md transition-all font-black bg-white text-purple-600 shadow-2xs cursor-pointer">
                                    List
                                </button>
                                <button type="button" id="btnGeoDonut" onclick="switchGeoView('donut')" class="px-2.5 py-1 rounded-md transition-all text-slate-500 hover:text-slate-800 cursor-pointer">
                                    Donut
                                </button>
                            </div>
                        </div>

                        <!-- View 1: Leaderboard View (Rankings + Gradient Progress Bars) -->
                        <div id="geoLeaderboardView" class="space-y-2 h-56 sm:h-64 overflow-y-auto pr-1">
                            <!-- Populated dynamically via renderStateLeaderboard() -->
                        </div>

                        <!-- View 2: Donut Radial View (Toggled via JS) -->
                        <div id="geoDonutView" class="hidden relative w-full h-56 sm:h-64 flex items-center justify-center">
                            <canvas id="stateDonutChart"></canvas>
                            <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none pb-4">
                                <span id="donutCenterTotal" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-none">0</span>
                                <span class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400 mt-1">Total Parcels</span>
                            </div>
                        </div>
                    </div>

                    <!-- Mini Telemetry Strip under State Card -->
                    <div class="pt-3 mt-2 border-t border-slate-100 flex items-center justify-between text-[10px] sm:text-[11px] text-slate-500 font-medium">
                        <span class="flex items-center gap-1.5 truncate">
                            <i class="fa-solid fa-truck-ramp-box text-purple-600"></i>
                            <span id="geoTopShareText" class="truncate">Top states volume</span>
                        </span>
                        <span class="text-[10px] font-semibold text-purple-700 flex-shrink-0">
                            Pan-India
                        </span>
                    </div>
                </div>

                <!-- Chart 3: Order Fulfillment Pipeline (NEW Dedicated Circular Doughnut Chart) -->
                <div class="corp-card p-4 sm:p-5 flex flex-col justify-between">
                    <div>
                        <!-- Header -->
                        <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-slate-100">
                            <div class="flex items-center gap-2">
                                <span class="h-2.5 w-2.5 rounded-full bg-emerald-500 ring-4 ring-emerald-50"></span>
                                <div>
                                    <h3 class="text-xs sm:text-sm font-black text-slate-900 leading-none">Order Fulfillment Status</h3>
                                    <span class="text-[10px] text-slate-400 font-medium">Channel share & pending queue</span>
                                </div>
                            </div>
                            <a href="/admin/orders-master" class="text-[10px] font-bold text-blue-600 hover:text-blue-800 transition-colors flex items-center gap-1">
                                Orders <i class="fa-solid fa-arrow-right text-[8px]"></i>
                            </a>
                        </div>

                        <!-- Circular Donut Canvas Container -->
                        <div class="relative w-full h-40 sm:h-44 flex items-center justify-center">
                            <canvas id="fulfillmentDonutChart"></canvas>
                            <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none pb-1">
                                <span id="fulfillmentCenterTotal" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-none">0</span>
                                <span class="text-[8px] font-extrabold uppercase tracking-wider text-slate-400 mt-0.5">Total Pipeline</span>
                            </div>
                        </div>

                        <!-- 3 Breakdown Metric Rows -->
                        <div class="space-y-1.5 mt-2 pt-2 border-t border-slate-100">
                            <!-- Dispatched via Post -->
                            <div class="flex items-center justify-between text-[11px]">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
                                    <span class="font-semibold text-slate-700 truncate">India Post Dispatched</span>
                                </div>
                                <div class="flex items-center gap-1.5 flex-shrink-0">
                                    <span id="fulfillmentDispatchedCount" class="font-black text-slate-900">0</span>
                                    <span id="fulfillmentDispatchedPct" class="text-[10px] text-slate-400 font-mono">(0%)</span>
                                </div>
                            </div>
                            <!-- Store / Counter Pickups -->
                            <div class="flex items-center justify-between text-[11px]">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="w-2 h-2 rounded-full bg-blue-500 flex-shrink-0"></span>
                                    <span class="font-semibold text-slate-700 truncate">Counter / Shop Pickup</span>
                                </div>
                                <div class="flex items-center gap-1.5 flex-shrink-0">
                                    <span id="fulfillmentPickupCount" class="font-black text-slate-900">0</span>
                                    <span id="fulfillmentPickupPct" class="text-[10px] text-slate-400 font-mono">(0%)</span>
                                </div>
                            </div>
                            <!-- Processing / In Queue -->
                            <div class="flex items-center justify-between text-[11px]">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="w-2 h-2 rounded-full bg-indigo-500 flex-shrink-0"></span>
                                    <span class="font-semibold text-slate-700 truncate">Processing in Queue</span>
                                </div>
                                <div class="flex items-center gap-1.5 flex-shrink-0">
                                    <span id="fulfillmentPendingCount" class="font-black text-slate-900">0</span>
                                    <span id="fulfillmentPendingPct" class="text-[10px] text-slate-400 font-mono">(0%)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Mini Telemetry Strip under Fulfillment Card -->
                    <div class="pt-2.5 mt-2 border-t border-slate-100 flex items-center justify-between text-[10px] sm:text-[11px] text-slate-500 font-medium">
                        <span class="flex items-center gap-1.5 truncate">
                            <i class="fa-solid fa-gauge-high text-emerald-600"></i>
                            <span id="fulfillmentVelocityText" class="truncate">Calculating...</span>
                        </span>
                        <span class="text-[10px] font-semibold text-emerald-700 flex-shrink-0">
                            Active
                        </span>
                    </div>
                </div>

            </div>
        </section>

    </main>

    <!-- 📋 Executive Footer -->
    <footer class="bg-white border-t border-slate-200 py-3.5 px-4 sm:px-8 text-center text-xs font-medium text-slate-400 w-full">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-1.5 sm:gap-2 text-[10px] sm:text-[11px]">
            <span>&copy; 2026 AviraCare Systems. All rights reserved. Enterprise Administration Hub.</span>
            <span class="font-mono text-slate-400">Node <%= process.version %> &bull; TLS 1.3 &bull; PostgreSQL Active</span>
        </div>
    </footer>

</div>

    <!-- 📊 Analytics JSON Data Carrier -->
    <script id="rawAnalyticsData" type="application/json"><%- JSON.stringify(aData || {}) %></script>

    <script>
        // 📊 Fast Chart Instances & View State
        let dailyDispatchChart = null;
        let stateDonutChart = null;
        let currentTrendView = 'wave'; // 'wave' | 'bar'
        let currentGeoView = 'leaderboard'; // 'leaderboard' | 'donut'
        let currentAnalytics = {};

        try {
            const dataElem = document.getElementById('rawAnalyticsData');
            currentAnalytics = dataElem ? JSON.parse(dataElem.textContent || '{}') : {};
        } catch (e) {
            console.error('Error parsing analytics JSON:', e);
            currentAnalytics = {};
        }

        // Initialize immediately with next animation frame for zero lag
        document.addEventListener('DOMContentLoaded', () => {
            requestAnimationFrame(() => {
                renderDashboardAnalytics(currentAnalytics);
            });
        });

        // 🔀 Switch Daily Trend View (Wave vs Bars)
        function switchTrendView(mode) {
            if (currentTrendView === mode) return;
            currentTrendView = mode;
            const btnWave = document.getElementById('btnTrendWave');
            const btnBar = document.getElementById('btnTrendBar');

            if (mode === 'wave') {
                if (btnWave) btnWave.className = 'px-2.5 py-1 rounded-md transition-all font-black bg-white text-indigo-600 shadow-2xs cursor-pointer';
                if (btnBar) btnBar.className = 'px-2.5 py-1 rounded-md transition-all text-slate-500 hover:text-slate-800 cursor-pointer';
            } else {
                if (btnBar) btnBar.className = 'px-2.5 py-1 rounded-md transition-all font-black bg-white text-indigo-600 shadow-2xs cursor-pointer';
                if (btnWave) btnWave.className = 'px-2.5 py-1 rounded-md transition-all text-slate-500 hover:text-slate-800 cursor-pointer';
            }

            renderDailyDispatchChart(
                currentAnalytics.dailyTrend || [],
                currentAnalytics.today ? currentAnalytics.today.dateStr : '',
                currentTrendView
            );
        }

        // 🔀 Switch Geographic View (Leaderboard vs Donut)
        function switchGeoView(mode) {
            if (currentGeoView === mode) return;
            currentGeoView = mode;
            const btnLead = document.getElementById('btnGeoLeaderboard');
            const btnDonut = document.getElementById('btnGeoDonut');
            const leadView = document.getElementById('geoLeaderboardView');
            const donutView = document.getElementById('geoDonutView');

            if (mode === 'leaderboard') {
                if (btnLead) btnLead.className = 'px-2.5 py-1 rounded-md transition-all font-black bg-white text-purple-600 shadow-2xs cursor-pointer';
                if (btnDonut) btnDonut.className = 'px-2.5 py-1 rounded-md transition-all text-slate-500 hover:text-slate-800 cursor-pointer';
                if (leadView) leadView.classList.remove('hidden');
                if (donutView) donutView.classList.add('hidden');
            } else {
                if (btnDonut) btnDonut.className = 'px-2.5 py-1 rounded-md transition-all font-black bg-white text-purple-600 shadow-2xs cursor-pointer';
                if (btnLead) btnLead.className = 'px-2.5 py-1 rounded-md transition-all text-slate-500 hover:text-slate-800 cursor-pointer';
                if (leadView) leadView.classList.add('hidden');
                if (donutView) donutView.classList.remove('hidden');

                // Render donut chart on toggle
                const total = (currentAnalytics.totals && currentAnalytics.totals.totalDispatched) ? currentAnalytics.totals.totalDispatched : 0;
                renderStateDonutChart(currentAnalytics.stateDistribution || [], total);
            }
        }

        // 🎨 Render / Re-render all Analytics Components
        function renderDashboardAnalytics(data) {
            if (!data) return;

            // 1. Update KPI Values
            updateKPICards(data);

            // 2. Update Telemetry Micro-Cards
            updateTelemetryInsights(data);

            // 3. Render Daily Dispatch Chart (Wave or Bars)
            renderDailyDispatchChart(
                data.dailyTrend || [],
                data.today ? data.today.dateStr : '',
                currentTrendView
            );

            // 4. Render State Leaderboard & Donut Chart
            renderStateLeaderboard(data.stateDistribution || []);
            if (currentGeoView === 'donut') {
                const total = (data.totals && data.totals.totalDispatched) ? data.totals.totalDispatched : 0;
                renderStateDonutChart(data.stateDistribution || [], total);
            }

            // 5. Render Fulfillment & Pipeline Donut Chart (Circular Chart)
            renderFulfillmentDonutChart(data.totals || {});
        }

        // 🔢 Update KPI Cards in Real-Time
        function updateKPICards(data) {
            if (data.today) {
                const el = document.getElementById('kpiTodayCount');
                if (el) el.innerText = data.today.count || 0;
                const dt = document.getElementById('kpiTodayDate');
                if (dt && data.today.dateStr) dt.innerText = data.today.dateStr;
            }
            if (data.yesterday) {
                const el = document.getElementById('kpiYesterdayCount');
                if (el) el.innerText = data.yesterday.count || 0;
                const dt = document.getElementById('kpiYesterdayDate');
                if (dt && data.yesterday.dateStr) dt.innerText = data.yesterday.dateStr;
            }
            if (data.totals) {
                const sEl = document.getElementById('kpiStatesCount');
                if (sEl) sEl.innerText = data.totals.totalStates || 0;
                const dEl = document.getElementById('kpiTotalDispatched');
                if (dEl) dEl.innerText = data.totals.totalDispatched || 0;
                const cEl = document.getElementById('kpiTotalConsignments');
                if (cEl) cEl.innerText = data.totals.totalConsignments || 0;
            }
        }

        // ⚡ Update Telemetry Insight Micro-Cards
        function updateTelemetryInsights(data) {
            const trend = data.dailyTrend || [];
            const states = data.stateDistribution || [];
            const totals = data.totals || {};

            // 1. Peak Day
            let peakDayStr = 'No data';
            if (trend.length > 0) {
                let maxItem = trend[0];
                trend.forEach(item => {
                    if (item.count > maxItem.count) maxItem = item;
                });
                peakDayStr = `${maxItem.date} (${maxItem.count})`;
            }
            const peakEl = document.getElementById('metricPeakDay');
            if (peakEl) peakEl.innerText = peakDayStr;

            // 2. Top State Hub
            let topStateStr = 'Pan-India';
            if (states.length > 0) {
                const top1 = states[0];
                topStateStr = `${top1.state} (${top1.percentage}%)`;
            }
            const topEl = document.getElementById('metricTopState');
            if (topEl) {
                topEl.innerText = topStateStr;
                topEl.title = topStateStr;
            }

            // 3. Avg Batch Size
            let avgBatch = 0;
            if (totals.totalDispatched && totals.totalConsignments) {
                avgBatch = (totals.totalDispatched / totals.totalConsignments).toFixed(1);
            }
            const avgEl = document.getElementById('metricAvgBatch');
            if (avgEl) avgEl.innerText = `${avgBatch} parcels`;

            // 4. Pan-India Reach
            const activeStatesCount = states.length || totals.totalStates || 0;
            const reachEl = document.getElementById('metricActiveStates');
            if (reachEl) reachEl.innerText = `${activeStatesCount} States Active`;

            // 5. Highlight Badges
            const badgeEl = document.getElementById('trendHighlightBadge');
            if (badgeEl) badgeEl.innerText = `${trend.length} Batches Logged`;

            // 6. Top 3 States Share Text
            if (states.length >= 2) {
                const topShare = states.slice(0, 3).reduce((acc, s) => acc + (s.percentage || 0), 0).toFixed(1);
                const shareEl = document.getElementById('geoTopShareText');
                if (shareEl) shareEl.innerText = `Top 3 States account for ${topShare}% volume`;
            }

            // 7. Last Updated Time
            const timeEl = document.getElementById('analyticsLastUpdated');
            if (timeEl) {
                const timeNow = new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
                timeEl.innerText = `Synced at ${timeNow}`;
            }
        }

        // 📈 Render Daily Dispatch Chart (Interactive Wave vs Bars)
        function renderDailyDispatchChart(trendData, todayDateStr, mode = 'wave') {
            const canvas = document.getElementById('dailyDispatchChart');
            if (!canvas) return;

            const labels = (trendData || []).map(d => d.date);
            const counts = (trendData || []).map(d => d.count);
            const consignments = (trendData || []).map(d => (d.consignments || []).join(', '));

            if (dailyDispatchChart) {
                dailyDispatchChart.destroy();
                dailyDispatchChart = null;
            }

            const ctx = canvas.getContext('2d');
            const hasData = labels.length > 0;

            if (mode === 'wave') {
                // 〰 Smooth Spline Area Chart with Translucent Gradient
                const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height || 260);
                gradient.addColorStop(0, 'rgba(99, 102, 241, 0.45)');
                gradient.addColorStop(1, 'rgba(99, 102, 241, 0.01)');

                const pointBackgrounds = labels.map(lbl => {
                    if (todayDateStr && lbl.toLowerCase() === todayDateStr.toLowerCase()) {
                        return '#10b981'; // Emerald for Today
                    }
                    return '#4f46e5'; // Indigo
                });

                const pointRadii = labels.map(lbl => {
                    if (todayDateStr && lbl.toLowerCase() === todayDateStr.toLowerCase()) {
                        return 6;
                    }
                    return 4;
                });

                dailyDispatchChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: hasData ? labels : ['No Dispatches Yet'],
                        datasets: [{
                            label: 'Orders Dispatched',
                            data: hasData ? counts : [0],
                            borderColor: '#4f46e5',
                            borderWidth: 2.5,
                            backgroundColor: gradient,
                            fill: true,
                            tension: 0.38,
                            pointBackgroundColor: pointBackgrounds,
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: pointRadii,
                            pointHoverRadius: 7
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 320, easing: 'easeOutQuart' },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                titleColor: '#ffffff',
                                bodyColor: '#e2e8f0',
                                padding: 8,
                                cornerRadius: 6,
                                callbacks: {
                                    label: function(context) {
                                        const idx = context.dataIndex;
                                        const cnt = context.parsed.y;
                                        const cStr = consignments[idx] ? ` (Batch: ${consignments[idx]})` : '';
                                        return ` ${cnt} Orders${cStr}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0,
                                    font: { family: 'Plus Jakarta Sans', weight: '600', size: 10 },
                                    color: '#64748b'
                                },
                                grid: { color: '#f1f5f9' }
                            },
                            x: {
                                ticks: {
                                    font: { family: 'Plus Jakarta Sans', weight: '700', size: 10 },
                                    color: '#475569',
                                    maxRotation: 45,
                                    minRotation: 0
                                },
                                grid: { display: false }
                            }
                        }
                    }
                });
            } else {
                // ❚❚ Modern Rounded Capsule Bars
                const bgColors = labels.map(lbl => {
                    if (todayDateStr && lbl.toLowerCase() === todayDateStr.toLowerCase()) {
                        return 'rgba(16, 185, 129, 0.9)'; // Emerald for Today
                    }
                    return 'rgba(79, 70, 229, 0.9)'; // Indigo
                });

                dailyDispatchChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: hasData ? labels : ['No Dispatches Yet'],
                        datasets: [{
                            label: 'Orders Dispatched',
                            data: hasData ? counts : [0],
                            backgroundColor: bgColors.length ? bgColors : ['rgba(79, 70, 229, 0.85)'],
                            borderRadius: 6,
                            borderSkipped: false,
                            maxBarThickness: 34
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 320, easing: 'easeOutQuart' },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                titleColor: '#ffffff',
                                bodyColor: '#e2e8f0',
                                padding: 8,
                                cornerRadius: 6,
                                callbacks: {
                                    label: function(context) {
                                        const idx = context.dataIndex;
                                        const cnt = context.parsed.y;
                                        const cStr = consignments[idx] ? ` (Batch: ${consignments[idx]})` : '';
                                        return ` ${cnt} Orders${cStr}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0,
                                    font: { family: 'Plus Jakarta Sans', weight: '600', size: 10 },
                                    color: '#64748b'
                                },
                                grid: { color: '#f1f5f9' }
                            },
                            x: {
                                ticks: {
                                    font: { family: 'Plus Jakarta Sans', weight: '700', size: 10 },
                                    color: '#475569',
                                    maxRotation: 45,
                                    minRotation: 0
                                },
                                grid: { display: false }
                            }
                        }
                    }
                });
            }
        }

        // 🗺️ Render State Destination Leaderboard (Minimal Clean Typography + Progress Meters)
        function renderStateLeaderboard(states) {
            const container = document.getElementById('geoLeaderboardView');
            if (!container) return;

            if (!states || states.length === 0) {
                container.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-center p-6 text-slate-400">
                        <i class="fa-solid fa-map-location-dot text-2xl mb-2 text-slate-300"></i>
                        <span class="text-xs font-semibold">No geographic destination records available yet.</span>
                    </div>
                `;
                return;
            }

            container.innerHTML = states.map((st, i) => {
                const widthPct = Math.min(100, Math.max(5, st.percentage || 0));

                return `
                    <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50/70 hover:bg-slate-100/90 border border-slate-200/60 transition-all flex flex-col justify-between gap-1.5 group">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="text-xs font-bold text-slate-400 w-4 flex-shrink-0">${i + 1}.</span>
                                <span class="text-xs font-black text-slate-800 tracking-tight truncate group-hover:text-purple-700 transition-colors" title="${st.state}">
                                    ${st.state}
                                </span>
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                <span class="text-xs font-black text-slate-900">${st.count} <span class="text-[9px] font-semibold text-slate-400">parcels</span></span>
                                <span class="text-[11px] font-bold text-purple-700 font-mono">
                                    ${st.percentage}%
                                </span>
                            </div>
                        </div>
                        <div class="w-full bg-slate-200/80 h-1.5 rounded-full overflow-hidden">
                            <div class="h-full rounded-full bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 transition-all duration-500" style="width: ${widthPct}%"></div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // 🍩 Render State Destination Donut Chart (Interactive Radial View)
        function renderStateDonutChart(states, totalDispatched) {
            const canvas = document.getElementById('stateDonutChart');
            if (!canvas) return;

            const centerTotalEl = document.getElementById('donutCenterTotal');
            if (centerTotalEl) {
                centerTotalEl.innerText = totalDispatched || 0;
            }

            const topList = (states || []).slice(0, 6);
            let labels = topList.map(s => s.state);
            let counts = topList.map(s => s.count);

            // Aggregate remaining states into "Others"
            if (states.length > 6) {
                const otherSum = states.slice(6).reduce((acc, s) => acc + s.count, 0);
                if (otherSum > 0) {
                    labels.push('OTHER REGIONS');
                    counts.push(otherSum);
                }
            }

            if (stateDonutChart) {
                stateDonutChart.destroy();
                stateDonutChart = null;
            }

            const palette = [
                '#6366f1', // Indigo
                '#8b5cf6', // Violet
                '#a855f7', // Purple
                '#3b82f6', // Blue
                '#0ea5e9', // Sky
                '#10b981', // Emerald
                '#94a3b8'  // Slate (Other)
            ];

            const ctx = canvas.getContext('2d');
            stateDonutChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels.length ? labels : ['No Regional Data'],
                    datasets: [{
                        data: counts.length ? counts : [1],
                        backgroundColor: palette.slice(0, labels.length),
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    animation: { duration: 320, easing: 'easeOutQuart' },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 8,
                                boxHeight: 8,
                                usePointStyle: true,
                                font: { family: 'Plus Jakarta Sans', weight: '700', size: 9 },
                                color: '#475569',
                                padding: 8
                            }
                        },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#ffffff',
                            bodyColor: '#e2e8f0',
                            padding: 8,
                            cornerRadius: 6,
                            callbacks: {
                                label: function(context) {
                                    const val = context.parsed;
                                    const pct = totalDispatched > 0 ? ((val / totalDispatched) * 100).toFixed(1) : 0;
                                    return ` ${val} Parcels (${pct}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // 🍩 Render Order Fulfillment Pipeline Circular Doughnut Chart (NEW)
        let fulfillmentDonutChart = null;

        function renderFulfillmentDonutChart(totals) {
            const canvas = document.getElementById('fulfillmentDonutChart');
            if (!canvas) return;

            const totalOrders = parseInt(totals.totalOrders || 0, 10);
            const totalDispatched = parseInt(totals.totalDispatched || 0, 10);
            const totalPickup = parseInt(totals.totalShopPickup || 0, 10);
            const pendingOrders = Math.max(0, totalOrders - totalDispatched - totalPickup);

            // Update center total
            const centerTotalEl = document.getElementById('fulfillmentCenterTotal');
            if (centerTotalEl) {
                centerTotalEl.innerText = totalOrders;
            }

            // Update counts & percentages
            const dispEl = document.getElementById('fulfillmentDispatchedCount');
            const dispPctEl = document.getElementById('fulfillmentDispatchedPct');
            if (dispEl) dispEl.innerText = totalDispatched;
            if (dispPctEl) dispPctEl.innerText = totalOrders > 0 ? `(${((totalDispatched / totalOrders) * 100).toFixed(1)}%)` : '(0%)';

            const pickEl = document.getElementById('fulfillmentPickupCount');
            const pickPctEl = document.getElementById('fulfillmentPickupPct');
            if (pickEl) pickEl.innerText = totalPickup;
            if (pickPctEl) pickPctEl.innerText = totalOrders > 0 ? `(${((totalPickup / totalOrders) * 100).toFixed(1)}%)` : '(0%)';

            const pendEl = document.getElementById('fulfillmentPendingCount');
            const pendPctEl = document.getElementById('fulfillmentPendingPct');
            if (pendEl) pendEl.innerText = pendingOrders;
            if (pendPctEl) pendPctEl.innerText = totalOrders > 0 ? `(${((pendingOrders / totalOrders) * 100).toFixed(1)}%)` : '(0%)';

            // Velocity text
            const velEl = document.getElementById('fulfillmentVelocityText');
            if (velEl) {
                const fulfilledRate = totalOrders > 0 ? (((totalDispatched + totalPickup) / totalOrders) * 100).toFixed(1) : 0;
                velEl.innerText = `${fulfilledRate}% Orders Fulfilled`;
            }

            if (fulfillmentDonutChart) {
                fulfillmentDonutChart.destroy();
                fulfillmentDonutChart = null;
            }

            const ctx = canvas.getContext('2d');
            fulfillmentDonutChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['India Post Dispatched', 'Counter / Shop Pickup', 'In Processing Queue'],
                    datasets: [{
                        data: [totalDispatched, totalPickup, pendingOrders],
                        backgroundColor: ['#10b981', '#3b82f6', '#6366f1'],
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    animation: { duration: 320, easing: 'easeOutQuart' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#ffffff',
                            bodyColor: '#e2e8f0',
                            padding: 8,
                            cornerRadius: 6,
                            callbacks: {
                                label: function(context) {
                                    const val = context.parsed;
                                    const pct = totalOrders > 0 ? ((val / totalOrders) * 100).toFixed(1) : 0;
                                    return ` ${context.label}: ${val} (${pct}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // 🔄 Fast Refresh Trigger
        async function refreshAnalytics(force = true) {
            const icon = document.getElementById('refreshAnalyticsIcon');
            if (icon) icon.classList.add('fa-spin');

            try {
                const res = await fetch(`/admin/api/dashboard-analytics?refresh=${force ? 'true' : 'false'}`);
                const data = await res.json();
                if (data && data.success) {
                    currentAnalytics = data;
                    renderDashboardAnalytics(data);
                }
            } catch (err) {
                console.error('Error refreshing analytics metrics:', err);
            } finally {
                if (icon) {
                    setTimeout(() => icon.classList.remove('fa-spin'), 300);
                }
            }
        }

        // ⏱️ Lightweight Clock & Dynamic Greeting
        (function() {
            function updateClock() {
                const now = new Date();
                const clockEl = document.getElementById('liveClock');
                const dateEl = document.getElementById('liveDate');
                if (clockEl) {
                    clockEl.textContent = now.toLocaleTimeString('en-IN', { hour12: false });
                }
                if (dateEl) {
                    dateEl.textContent = now.toLocaleDateString('en-IN', { 
                        weekday: 'short', 
                        day: 'numeric', 
                        month: 'short' 
                    });
                }
            }
            updateClock();
            setInterval(updateClock, 1000);

            // Dynamic Greeting
            const greetingEl = document.getElementById('greetingMessage');
            if (greetingEl) {
                const hour = new Date().getHours();
                let timeGreeting = 'Good evening';
                if (hour < 12) timeGreeting = 'Good morning';
                else if (hour < 17) timeGreeting = 'Good afternoon';
                greetingEl.textContent = `${timeGreeting}, Administrator`;
            }
        })();
    </script>
</body>
</html>
