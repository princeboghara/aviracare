<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Admin Dashboard - Avira Control Center</title>
</head>
<body class="bg-mesh-corporate min-h-screen flex flex-col justify-between font-sans antialiased text-slate-800 relative w-full overflow-x-hidden">

    <!-- Ambient Subtle Glows -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute -top-20 -left-20 w-96 h-96 rounded-full bg-indigo-500/5 blur-[120px]"></div>
        <div class="absolute -bottom-20 -right-20 w-96 h-96 rounded-full bg-blue-500/5 blur-[120px]"></div>
    </div>

    <!-- 🧭 Executive Header -->
    <header class="bg-white/90 backdrop-blur-md sticky top-0 z-50 px-4 sm:px-8 py-3.5 flex justify-between items-center shadow-xs border-b border-slate-200/80 w-full">
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
            <div class="h-9 w-9 sm:h-10 sm:w-10 rounded-xl overflow-hidden bg-white flex items-center justify-center shadow-xs border border-slate-200 flex-shrink-0 p-1">
                <img src="/images/logo.jpg" alt="Avira Logo" class="h-full w-full object-cover rounded-[8px]">
            </div>
            <div>
                <span class="text-base sm:text-lg font-black tracking-tight text-slate-900 block leading-tight">Avira <span class="text-indigo-600 font-extrabold">Control Hub</span></span>
                <span class="text-[9px] font-bold text-slate-400 tracking-wider uppercase block">Executive Administration Portal</span>
            </div>
        </div>
        
        <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0 ml-2">
            <div class="hidden sm:flex flex-col text-right">
                <p class="text-xs font-black text-slate-900">Administrator</p>
                <span class="text-[9px] font-bold text-emerald-600 uppercase tracking-widest flex items-center justify-end gap-1">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 inline-block animate-pulse"></span> Active Session
                </span>
            </div>
            <a href="/admin/logout" class="btn-corporate-3d text-[11px] font-bold uppercase tracking-wider px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl flex items-center gap-1.5 shadow-xs">
                <i class="fa-solid fa-power-off text-rose-400 text-xs"></i> Exit Panel
            </a>
        </div>
    </header>

    <main class="flex-grow flex flex-col items-center justify-center w-full px-4 sm:px-6 lg:px-8 xl:px-10 py-6 sm:py-10 relative z-10 box-border space-y-6 sm:space-y-8">
        
        <!-- 🌟 Welcome Hero Banner (Corporate Slate/Indigo Gradient) -->
        <div class="w-full bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 rounded-3xl p-6 sm:p-8 text-white shadow-xl border border-slate-800/80 relative overflow-hidden">
            <div class="absolute -right-16 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative z-10">
                <div class="space-y-2 max-w-2xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-[10px] font-extrabold uppercase tracking-wider text-indigo-200">
                        <i class="fa-solid fa-shield-check text-indigo-300"></i> Secure Admin Workspace
                    </div>
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-white leading-tight">
                        Welcome Back, Chief Administrator
                    </h1>
                    <p class="text-slate-300 text-xs sm:text-sm font-medium leading-relaxed">
                        Manage parcel dispatches, live tracking synchronization, product inventory, and member requests with 3D precision.
                    </p>
                </div>

                <div class="flex flex-row md:flex-col items-end gap-2.5 flex-shrink-0 w-full md:w-auto justify-between md:justify-center border-t md:border-t-0 border-white/10 pt-4 md:pt-0">
                    <a href="/admin/manual-entry" class="btn-indigo-3d text-xs font-black px-5 py-2.5 rounded-xl uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-keyboard"></i> Open Manual Entry
                    </a>
                    <a href="/admin/orders-master" class="btn-white-3d text-xs font-bold px-4 py-2 rounded-xl uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-boxes-stacked text-indigo-600"></i> Orders Master
                    </a>
                </div>
            </div>
        </div>

        <!-- 🧩 Interactive 3D Module Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 w-full">
            
            <!-- 1. Dispatch & Consignment Hub -->
            <div class="card-corporate-3d p-5 sm:p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3.5 mb-4">
                        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-blue-100 shadow-2xs">
                            <i class="fa-solid fa-truck-fast"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-base font-black text-slate-900">1. Dispatch & Logistics</h2>
                                <span class="badge-3d bg-blue-50 text-blue-700 border-blue-200 text-[8px]">CORE</span>
                            </div>
                            <p class="text-slate-400 text-[11px] font-semibold">Consignments & Parcel Labelling</p>
                        </div>
                    </div>
                    <p class="text-slate-500 text-xs mb-4 leading-relaxed font-medium">
                        Create unique consignment batches, barcode scanner integration, auto-calculate weights, and manage manual entries.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 space-y-1.5">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Direct Quick Links:</span>
                    <div class="grid grid-cols-2 gap-1.5">
                        <a href="/admin/manual-entry" class="p-2 rounded-xl bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 font-bold text-[11px] transition-all border border-slate-100 flex items-center gap-1.5">
                            <i class="fa-solid fa-keyboard text-blue-500"></i> Manual Entry
                        </a>
                        <a href="/admin/orders-master" class="p-2 rounded-xl bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 font-bold text-[11px] transition-all border border-slate-100 flex items-center gap-1.5">
                            <i class="fa-solid fa-file-invoice text-blue-500"></i> Orders Master
                        </a>
                        <a href="/admin/customers" class="p-2 rounded-xl bg-slate-50 hover:bg-purple-50 text-slate-700 hover:text-purple-700 font-bold text-[11px] transition-all border border-slate-100 flex items-center gap-1.5">
                            <i class="fa-solid fa-users text-purple-500"></i> Customers
                        </a>
                        <a href="/admin/master-database" class="p-2 rounded-xl bg-slate-50 hover:bg-teal-50 text-slate-700 hover:text-teal-700 font-bold text-[11px] transition-all border border-slate-100 flex items-center gap-1.5">
                            <i class="fa-solid fa-database text-teal-500"></i> Master DB
                        </a>
                        <a href="/admin/live-tracking" class="p-2 col-span-2 rounded-xl bg-blue-50/80 hover:bg-blue-100/80 text-blue-800 font-extrabold text-[11px] transition-all border border-blue-200 flex items-center justify-between">
                            <span class="flex items-center gap-1.5"><i class="fa-solid fa-satellite-dish text-blue-600"></i> India Post Live Tracking</span>
                            <span class="text-[8px] bg-blue-600 text-white px-1.5 py-0.5 rounded font-black tracking-wider">LIVE SYNC</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- 2. Product Catalog & Inventory -->
            <div class="card-corporate-3d p-5 sm:p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3.5 mb-4">
                        <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-purple-100 shadow-2xs">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-black text-slate-900">2. Product Catalog</h2>
                            <p class="text-slate-400 text-[11px] font-semibold">Inventory & Product Assets</p>
                        </div>
                    </div>
                    <p class="text-slate-500 text-xs mb-4 leading-relaxed font-medium">
                        Publish new items, upload product gallery images, configure Point Values (PV), and monitor inventory.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 space-y-1.5">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Direct Quick Links:</span>
                    <div class="grid grid-cols-2 gap-1.5">
                        <a href="/admin/add-product" class="p-2.5 rounded-xl bg-slate-50 hover:bg-purple-50 text-slate-700 hover:text-purple-700 font-bold text-[11px] transition-all border border-slate-100 flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-plus-circle text-purple-600"></i> Add Product
                        </a>
                        <a href="/admin/view-products" class="p-2.5 rounded-xl bg-slate-50 hover:bg-purple-50 text-slate-700 hover:text-purple-700 font-bold text-[11px] transition-all border border-slate-100 flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-list-check text-purple-600"></i> View Catalog
                        </a>
                    </div>
                </div>
            </div>

            <!-- 3. Content & PDF Manager -->
            <div class="card-corporate-3d p-5 sm:p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3.5 mb-4">
                        <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-rose-100 shadow-2xs">
                            <i class="fa-solid fa-file-pdf"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-black text-slate-900">3. Content Manager</h2>
                            <p class="text-slate-400 text-[11px] font-semibold">PDF Flyers & Catalogues</p>
                        </div>
                    </div>
                    <p class="text-slate-500 text-xs mb-4 leading-relaxed font-medium">
                        Upload, update, and manage downloadable Business Plan PDFs and Product Catalog files for members.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 space-y-2">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Direct Quick Links:</span>
                    <a href="/admin/content-manager" class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 hover:bg-rose-50 text-slate-700 hover:text-rose-700 font-bold text-xs transition-all border border-slate-100">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-folder-open text-rose-500"></i> Manage PDF Documents</span>
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </a>
                </div>
            </div>

            <!-- 4. Query & Support Manager -->
            <div class="card-corporate-3d p-5 sm:p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3.5 mb-4">
                        <div class="w-12 h-12 bg-orange-50 text-orange-600 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-orange-100 shadow-2xs">
                            <i class="fa-solid fa-headset"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-black text-slate-900">4. Support Helpdesk</h2>
                            <p class="text-slate-400 text-[11px] font-semibold">Customer Tickets & Inquiries</p>
                        </div>
                    </div>
                    <p class="text-slate-500 text-xs mb-4 leading-relaxed font-medium">
                        Review customer support tickets, address change requests, and member inquiries in real-time.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 space-y-2">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Direct Quick Links:</span>
                    <a href="/admin/queries" class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 hover:bg-orange-50 text-slate-700 hover:text-orange-700 font-bold text-xs transition-all border border-slate-100">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-ticket text-orange-500"></i> View Support Inquiries</span>
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </a>
                </div>
            </div>

            <!-- 5. Courier Box Dimensions & Presets -->
            <div class="card-corporate-3d p-5 sm:p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3.5 mb-4">
                        <div class="w-12 h-12 bg-slate-100 text-slate-700 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-slate-200 shadow-2xs">
                            <i class="fa-solid fa-sliders"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-black text-slate-900">5. Box Presets & Config</h2>
                            <p class="text-slate-400 text-[11px] font-semibold">Courier Dimension Presets</p>
                        </div>
                    </div>
                    <p class="text-slate-500 text-xs mb-4 leading-relaxed font-medium">
                        Configure courier box dimension shortcuts (Length, Breadth, Height) for fast manual shipping entries.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 space-y-2">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Direct Quick Links:</span>
                    <a href="/admin/settings" class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 hover:bg-slate-200 text-slate-800 font-bold text-xs transition-all border border-slate-100">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-boxes-packing text-slate-600"></i> Configure Box Dimensions</span>
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </a>
                </div>
            </div>

            <!-- 6. Bill Converter & Combos -->
            <div class="card-corporate-3d p-5 sm:p-6 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3.5 mb-4">
                        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-amber-100 shadow-2xs">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-black text-slate-900">6. Billing & Combos</h2>
                            <p class="text-slate-400 text-[11px] font-semibold">Tax Invoices & Special Packs</p>
                        </div>
                    </div>
                    <p class="text-slate-500 text-xs mb-4 leading-relaxed font-medium">
                        Convert bulk PDF bills into parsed invoice structures and manage combo pack offerings.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 space-y-1.5">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Direct Quick Links:</span>
                    <div class="grid grid-cols-2 gap-1.5">
                        <a href="/admin/bill-uploader" class="p-2.5 rounded-xl bg-slate-50 hover:bg-amber-50 text-slate-700 hover:text-amber-700 font-bold text-[11px] transition-all border border-slate-100 flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-file-invoice-dollar text-amber-600"></i> Bill Converter
                        </a>
                        <a href="/admin/manage-combos" class="p-2.5 rounded-xl bg-slate-50 hover:bg-purple-50 text-slate-700 hover:text-purple-700 font-bold text-[11px] transition-all border border-slate-100 flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-layer-group text-purple-600"></i> Manage Combos
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </main>
    
    <footer class="bg-white/80 backdrop-blur-sm border-t border-slate-200/80 py-4 text-center text-[10px] sm:text-[11px] font-bold text-slate-400 shadow-2xs w-full overflow-hidden">
        &copy; 2026 Avira Control Center. Encrypted TLS 1.3 Administrator System.
    </footer>

</body>
</html>
