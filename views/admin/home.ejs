<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Admin Dashboard - Avira Control Center</title>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('avira_admin_theme');
            if (savedTheme === 'dark' || (!savedTheme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    <style>
        .glass-panel {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }

        .premium-3d-card {
            background: #ffffff;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            border: 1px solid rgba(226, 232, 240, 0.85);
            box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
        }

        .premium-3d-card:hover {
            transform: translateY(-5px);
            border-color: rgba(16, 185, 129, 0.4);
            box-shadow: 0 20px 40px -10px rgba(16, 185, 129, 0.12), 0 0 15px rgba(16, 185, 129, 0.05);
        }

        html.dark .glass-panel {
            background: rgba(13, 19, 34, 0.9) !important;
            border-color: #1e293b !important;
        }

        html.dark .premium-3d-card {
            background: #111827 !important;
            border-color: #1f293d !important;
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.5) !important;
        }

        html.dark .premium-3d-card:hover {
            border-color: rgba(16, 185, 129, 0.4) !important;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.7), 0 0 15px rgba(16, 185, 129, 0.15) !important;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col justify-between font-sans antialiased text-slate-800 relative w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute -top-16 -left-16 w-80 h-80 sm:w-96 sm:h-96 rounded-full bg-emerald-400/10 blur-[100px]"></div>
        <div class="absolute -bottom-16 -right-16 w-80 h-80 sm:w-96 sm:h-96 rounded-full bg-teal-400/10 blur-[100px]"></div>
    </div>

    <!-- Top Executive Header Bar -->
    <header class="glass-panel sticky top-0 z-50 px-4 sm:px-8 py-3 flex justify-between items-center shadow-xs border-b border-slate-200/80 w-full">
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
            <div class="h-9 w-9 sm:h-10 sm:w-10 rounded-xl overflow-hidden bg-white flex items-center justify-center shadow border border-slate-200 dark:border-slate-700 flex-shrink-0 p-0.5">
                <img src="/images/logo.jpg" alt="Avira Logo" class="h-full w-full object-cover rounded-lg">
            </div>
            <div class="leading-none truncate">
                <span class="text-sm sm:text-base font-black tracking-tight text-slate-900 dark:text-slate-100 font-outfit uppercase">Avira <span class="text-emerald-500 font-bold">Control Hub</span></span>
                <span class="hidden sm:inline-block text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-2 font-mono-code">v2.6 Enterprise</span>
            </div>
        </div>
        
        <div class="flex items-center gap-2.5 sm:gap-4 flex-shrink-0 ml-2">
            <!-- Theme Toggle Button -->
            <button type="button" onclick="toggleAdminTheme()" class="pro-theme-toggle" title="Toggle Theme">
                <i class="fa-solid fa-moon dark:hidden text-slate-700 text-xs"></i>
                <i class="fa-solid fa-sun hidden dark:inline text-amber-400 text-xs"></i>
                <span class="dark:hidden text-[10px] font-black uppercase">Dark</span>
                <span class="hidden dark:inline text-[10px] font-black text-amber-300 uppercase">Light</span>
            </button>

            <div class="hidden sm:flex flex-col text-right">
                <p class="text-xs font-black text-slate-800 dark:text-slate-200">Root Master</p>
                <span class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest flex items-center justify-end gap-1 font-mono-code">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 inline-block animate-ping"></span> Live Session
                </span>
            </div>
            
            <a href="/admin/logout" class="text-[10px] sm:text-xs font-black uppercase tracking-wider bg-slate-900 dark:bg-rose-600 text-white hover:bg-rose-600 dark:hover:bg-rose-700 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl transition-all shadow-sm cursor-pointer flex items-center gap-1.5">
                <i class="fa-solid fa-power-off text-xs"></i> <span>Exit</span>
            </a>
        </div>
    </header>

    <main class="flex-grow flex flex-col items-center justify-center max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-10 relative z-10 box-border">
        
        <div class="text-center max-w-2xl mb-8 sm:mb-12 space-y-2.5">
            <span class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-400 text-[10px] sm:text-[11px] font-black px-4 py-1.5 rounded-full uppercase tracking-widest shadow-xs inline-flex items-center gap-1.5 font-mono-code">
                <i class="fa-solid fa-shield-halved text-emerald-600"></i> Secure Administrator Workspace
            </span>
            <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white leading-tight font-outfit">
                Welcome Back, Chief Administrator
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm max-w-lg mx-auto font-medium leading-relaxed">
                Select any operational module or quick shortcut below to manage dispatch workflows, database, products, and support tickets.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 w-full">
            
            <!-- 1. Content Manager -->
            <div class="premium-3d-card p-5 sm:p-6 rounded-3xl flex flex-col justify-between shadow-xs relative overflow-hidden">
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-12 h-12 bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-blue-100 dark:border-blue-900 shadow-xs">
                            <i class="fa-solid fa-file-pdf"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-black text-slate-900 dark:text-white font-outfit">1. Content Manager</h2>
                            <p class="text-slate-400 dark:text-slate-500 text-[11px] font-semibold">PDF Flyers & Catalogues</p>
                        </div>
                    </div>
                    <p class="text-slate-500 dark:text-slate-400 text-xs mb-4 leading-relaxed font-medium">
                        Upload, update, and manage downloadable Business Plan PDFs and Product Catalog files for members in real-time.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-2">
                    <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">Direct Quick Links:</span>
                    <a href="/admin/content-manager" class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/80 hover:bg-blue-50 dark:hover:bg-blue-950/40 text-slate-700 dark:text-slate-300 hover:text-blue-700 dark:hover:text-blue-400 font-bold text-xs transition-all border border-slate-100 dark:border-slate-800">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-folder-open text-blue-500"></i> Manage PDF Documents</span>
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </a>
                </div>
            </div>

            <!-- 2. Tracking Manager -->
            <div class="premium-3d-card p-5 sm:p-6 rounded-3xl flex flex-col justify-between shadow-xs relative overflow-hidden">
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-12 h-12 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-emerald-100 dark:border-emerald-900 shadow-xs">
                            <i class="fa-solid fa-truck-fast"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-black text-slate-900 dark:text-white font-outfit">2. Tracking Manager</h2>
                            <p class="text-slate-400 dark:text-slate-500 text-[11px] font-semibold">Logistics & Dispatch</p>
                        </div>
                    </div>
                    <p class="text-slate-500 dark:text-slate-400 text-xs mb-4 leading-relaxed font-medium">
                        Core shipping pipeline. Process parcel labels, manual entries, member confirmations, and master DB records.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-1.5">
                    <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">Direct Quick Links:</span>
                    <div class="grid grid-cols-2 gap-1.5">
                        <a href="/admin/manual-entry" class="p-2 rounded-xl bg-slate-50 dark:bg-slate-900/80 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-400 font-bold text-[11px] transition-all border border-slate-100 dark:border-slate-800 flex items-center gap-1.5">
                            <i class="fa-solid fa-keyboard text-emerald-500"></i> Manual Entry
                        </a>
                        <a href="/admin/confirm-member" class="p-2 rounded-xl bg-slate-50 dark:bg-slate-900/80 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-400 font-bold text-[11px] transition-all border border-slate-100 dark:border-slate-800 flex items-center gap-1.5">
                            <i class="fa-solid fa-user-check text-emerald-500"></i> Confirm Member
                        </a>
                        <a href="/admin/master-database" class="p-2 rounded-xl bg-slate-50 dark:bg-slate-900/80 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-400 font-bold text-[11px] transition-all border border-slate-100 dark:border-slate-800 flex items-center gap-1.5">
                            <i class="fa-solid fa-database text-emerald-500"></i> Master Database
                        </a>
                        <a href="/admin/orders-master" class="p-2 rounded-xl bg-slate-50 dark:bg-slate-900/80 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-400 font-bold text-[11px] transition-all border border-slate-100 dark:border-slate-800 flex items-center gap-1.5">
                            <i class="fa-solid fa-box text-emerald-500"></i> Orders Master
                        </a>
                    </div>
                </div>
            </div>

            <!-- 3. Query Manager -->
            <div class="premium-3d-card p-5 sm:p-6 rounded-3xl flex flex-col justify-between shadow-xs relative overflow-hidden">
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-12 h-12 bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-amber-100 dark:border-amber-900 shadow-xs">
                            <i class="fa-solid fa-headset"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-black text-slate-900 dark:text-white font-outfit">3. Query Manager</h2>
                            <p class="text-slate-400 dark:text-slate-500 text-[11px] font-semibold">Customer Helpdesk</p>
                        </div>
                    </div>
                    <p class="text-slate-500 dark:text-slate-400 text-xs mb-4 leading-relaxed font-medium">
                        Review customer support tickets, address change requests, and send solution replies directly to member portals.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-2">
                    <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">Direct Quick Links:</span>
                    <a href="/admin/queries" class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/80 hover:bg-amber-50 dark:hover:bg-amber-950/40 text-slate-700 dark:text-slate-300 hover:text-amber-700 dark:hover:text-amber-400 font-bold text-xs transition-all border border-slate-100 dark:border-slate-800">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-ticket text-amber-500"></i> View All Support Tickets</span>
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </a>
                </div>
            </div>

            <!-- 4. Product Manager -->
            <div class="premium-3d-card p-5 sm:p-6 rounded-3xl flex flex-col justify-between shadow-xs relative overflow-hidden">
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-12 h-12 bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-purple-100 dark:border-purple-900 shadow-xs">
                            <i class="fa-solid fa-basket-shopping"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-black text-slate-900 dark:text-white font-outfit">4. Product Manager</h2>
                            <p class="text-slate-400 dark:text-slate-500 text-[11px] font-semibold">Inventory & Catalog</p>
                        </div>
                    </div>
                    <p class="text-slate-500 dark:text-slate-400 text-xs mb-4 leading-relaxed font-medium">
                        Publish new items, upload multiple gallery images, configure PV values, and edit active inventory specs.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-1.5">
                    <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">Direct Quick Links:</span>
                    <div class="grid grid-cols-2 gap-1.5">
                        <a href="/admin/add-product" class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/80 hover:bg-purple-50 dark:hover:bg-purple-950/40 text-slate-700 dark:text-slate-300 hover:text-purple-700 dark:hover:text-purple-400 font-bold text-[11px] transition-all border border-slate-100 dark:border-slate-800 flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-plus text-purple-500"></i> Add Product
                        </a>
                        <a href="/admin/view-products" class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/80 hover:bg-purple-50 dark:hover:bg-purple-950/40 text-slate-700 dark:text-slate-300 hover:text-purple-700 dark:hover:text-purple-400 font-bold text-[11px] transition-all border border-slate-100 dark:border-slate-800 flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-list text-purple-500"></i> View All Items
                        </a>
                    </div>
                </div>
            </div>

            <!-- 5. System Settings -->
            <div class="premium-3d-card p-5 sm:p-6 rounded-3xl flex flex-col justify-between shadow-xs relative overflow-hidden">
                <div>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-12 h-12 bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 rounded-2xl flex items-center justify-center text-xl font-bold flex-shrink-0 border border-slate-200 dark:border-slate-700 shadow-xs">
                            <i class="fa-solid fa-gear"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-black text-slate-900 dark:text-white font-outfit">5. System Settings</h2>
                            <p class="text-slate-400 dark:text-slate-500 text-[11px] font-semibold">Box Presets & Config</p>
                        </div>
                    </div>
                    <p class="text-slate-500 dark:text-slate-400 text-xs mb-4 leading-relaxed font-medium">
                        Configure courier box dimension presets (Length, Breadth, Height) for fast automated dispatch shipping entries.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-2">
                    <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">Direct Quick Links:</span>
                    <a href="/admin/settings" class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/80 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-bold text-xs transition-all border border-slate-100 dark:border-slate-800">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-boxes-packing text-slate-600 dark:text-slate-400"></i> Box Dimensions & Settings</span>
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </a>
                </div>
            </div>

        </div>
    </main>
    
    <footer class="glass-panel border-t border-slate-200/80 dark:border-slate-800 py-4 text-center text-[10px] sm:text-[11px] font-semibold text-slate-400 dark:text-slate-500 shadow-inner w-full overflow-hidden">
        &copy; 2026 Avira Control Center. Encrypted TLS 1.3 Administrator System.
    </footer>

    <script>
        function toggleAdminTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('avira_admin_theme', isDark ? 'dark' : 'light');
        }
    </script>
</body>
</html>
