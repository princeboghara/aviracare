<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <%- include('../partials/head_meta') %>
    <title>Executive Control Hub - AviraCare Systems</title>
    <!-- Chart.js Engine (Lightweight Performance Build) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <style>
        /* ⚡ Zero-Lag Hardware Accelerated Styling */
        body {
            background-color: #f8fafc !important;
            background-attachment: scroll !important; /* Eradicate scroll lag on all devices */
        }

        .corp-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.04);
            transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s ease, border-color 0.18s ease;
            will-change: transform;
        }
        @media (hover: hover) and (pointer: fine) {
            .corp-card:hover {
                transform: translateY(-2px);
                border-color: #cbd5e1;
                box-shadow: 0 8px 20px -3px rgba(15, 23, 42, 0.06);
            }
        }

        /* Interactive Action Link */
        .hub-link-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.65rem 0.8rem;
            border-radius: 0.75rem;
            background: #f8fafc;
            border: 1px solid #f1f5f9;
            color: #334155;
            font-size: 0.8125rem;
            font-weight: 600;
            transition: all 0.15s ease;
        }
        @media (hover: hover) and (pointer: fine) {
            .hub-link-item:hover {
                background: #eff6ff;
                border-color: #bfdbfe;
                color: #1d4ed8;
                transform: translateX(2px);
            }
        }

        /* High-Impact Responsive KPI Card */
        .kpi-card-fast {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            padding: 1rem;
            transition: all 0.18s ease;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03);
        }
        @media (min-width: 640px) {
            .kpi-card-fast {
                padding: 1.25rem;
            }
        }
        @media (hover: hover) and (pointer: fine) {
            .kpi-card-fast:hover {
                border-color: #93c5fd;
                box-shadow: 0 8px 16px -2px rgba(37, 99, 235, 0.06);
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between font-sans antialiased text-slate-800 bg-slate-50 overflow-x-hidden">

    <!-- 🧭 Executive Sticky Header Navigation -->
    <header class="bg-white/95 backdrop-blur-md sticky top-0 z-40 px-3.5 sm:px-6 lg:px-8 py-2.5 sm:py-3 flex justify-between items-center shadow-2xs border-b border-slate-200 w-full">
        <!-- Logo & Brand Title -->
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
            <div class="h-9 w-9 sm:h-10 sm:w-10 rounded-xl overflow-hidden bg-white flex items-center justify-center shadow-xs border border-slate-200 flex-shrink-0 p-1">
                <img src="/images/logo.jpg" alt="Avira Logo" class="h-full w-full object-cover rounded-[7px]">
            </div>
            <div class="min-w-0">
                <div class="flex items-center gap-1.5 sm:gap-2">
                    <span class="text-sm sm:text-base lg:text-lg font-black tracking-tight text-slate-900 leading-tight">AVIRA <span class="text-blue-600">CARE</span></span>
                    <span class="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-black uppercase tracking-wider bg-slate-100 text-slate-700 border border-slate-200">
                        Admin Hub
                    </span>
                </div>
                <span class="text-[9px] sm:text-[10px] font-bold text-slate-400 tracking-wider uppercase truncate block">Control Center</span>
            </div>
        </div>

        <!-- Telemetry, Clock & Session Actions -->
        <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0">
            <!-- Live Clock (Tablet & Desktop) -->
            <div class="hidden md:flex flex-col text-right">
                <span id="liveClock" class="text-xs font-mono font-bold text-slate-700 leading-none">--:--:--</span>
                <span id="liveDate" class="text-[9px] font-semibold text-slate-400 mt-1 uppercase tracking-wider">IST Date</span>
            </div>

            <!-- Online Pulse Pill -->
            <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-[10px] font-extrabold">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>LIVE</span>
            </div>

            <!-- Logout Button -->
            <a href="/admin/logout" title="Sign Out of Session" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-xl bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-600 border border-slate-200 hover:border-rose-200 text-xs font-bold transition-all">
                <i class="fa-solid fa-power-off text-[11px]"></i>
                <span class="hidden sm:inline">Logout</span>
            </a>
        </div>
    </header>

    <!-- 🌐 Main Executive Dashboard Body -->
    <main class="flex-grow w-full max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 space-y-4 sm:space-y-6">

        <!-- 🌟 Corporate Command Hero Banner -->
        <div class="rounded-2xl sm:rounded-3xl bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 p-4 sm:p-6 lg:p-7 text-white shadow-md border border-slate-800 relative overflow-hidden">
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-4 sm:gap-6">
                <!-- Welcome Title & Subtitle -->
                <div class="space-y-1.5 sm:space-y-2 max-w-2xl">
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/10 border border-white/15 text-[10px] font-black uppercase tracking-wider text-blue-200">
                        <i class="fa-solid fa-shield-halved text-blue-400 text-[9px]"></i> Corporate Executive Suite
                    </div>
                    <h1 id="greetingMessage" class="text-xl sm:text-2xl lg:text-3xl font-black tracking-tight text-white leading-tight">
                        Welcome Back, Administrator
                    </h1>
                    <p class="text-slate-300 text-xs sm:text-sm font-medium leading-relaxed">
                        Parcel dispatches, live tracking synchronization, customer master database, and automation engines.
                    </p>
                </div>

                <!-- Primary Action Quick Buttons (Touch-friendly & Responsive) -->
                <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 sm:gap-2.5 flex-shrink-0">
                    <a href="/admin/manual-entry" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold uppercase tracking-wider shadow-sm transition-all text-center">
                        <i class="fa-solid fa-plus-circle text-xs"></i>
                        <span>Dispatch</span>
                    </a>
                    <a href="/admin/orders-master" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase tracking-wider border border-white/20 transition-all text-center">
                        <i class="fa-solid fa-receipt text-blue-300 text-xs"></i>
                        <span>Orders</span>
                    </a>
                    <a href="/admin/live-tracking" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase tracking-wider border border-white/20 transition-all text-center">
                        <i class="fa-solid fa-satellite-dish text-emerald-400 text-xs"></i>
                        <span>Tracking</span>
                    </a>
                    <a href="/admin/log-monitor" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase tracking-wider border border-white/20 transition-all text-center">
                        <i class="fa-solid fa-terminal text-cyan-300 text-xs"></i>
                        <span>Logs</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- 📊 4 Real-Time Executive KPI Telemetry Tiles -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-5 w-full">
            
            <!-- KPI 1: Today's Dispatched Orders -->
            <div class="kpi-card-fast flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2 sm:mb-3">
                    <span class="text-[10px] sm:text-[11px] font-black text-slate-500 uppercase tracking-wider">Today's Dispatch</span>
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center text-xs sm:text-sm">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline gap-1.5 sm:gap-2">
                        <span id="kpiTodayCount" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= (analytics && analytics.today) ? analytics.today.count : 0 %></span>
                        <span class="text-[11px] sm:text-xs font-bold text-indigo-600">orders</span>
                    </div>
                    <div class="mt-1.5 sm:mt-2 flex items-center gap-1 text-[9px] sm:text-[10px] font-bold text-slate-500 truncate">
                        <i class="fa-regular fa-calendar-check text-emerald-500"></i>
                        <span id="kpiTodayDate" class="truncate"><%= (analytics && analytics.today && analytics.today.dateStr) ? analytics.today.dateStr : 'Today' %></span>
                    </div>
                </div>
            </div>

            <!-- KPI 2: Yesterday's Dispatched Orders -->
            <div class="kpi-card-fast flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2 sm:mb-3">
                    <span class="text-[10px] sm:text-[11px] font-black text-slate-500 uppercase tracking-wider">Yesterday</span>
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center text-xs sm:text-sm">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline gap-1.5 sm:gap-2">
                        <span id="kpiYesterdayCount" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= (analytics && analytics.yesterday) ? analytics.yesterday.count : 0 %></span>
                        <span class="text-[11px] sm:text-xs font-bold text-blue-600">orders</span>
                    </div>
                    <div class="mt-1.5 sm:mt-2 flex items-center gap-1 text-[9px] sm:text-[10px] font-bold text-slate-500 truncate">
                        <i class="fa-regular fa-calendar text-slate-400"></i>
                        <span id="kpiYesterdayDate" class="truncate"><%= (analytics && analytics.yesterday && analytics.yesterday.dateStr) ? analytics.yesterday.dateStr : 'Yesterday' %></span>
                    </div>
                </div>
            </div>

            <!-- KPI 3: Total Dispatched Parcels -->
            <div class="kpi-card-fast flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2 sm:mb-3">
                    <span class="text-[10px] sm:text-[11px] font-black text-slate-500 uppercase tracking-wider">Total Dispatched</span>
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center text-xs sm:text-sm">
                        <i class="fa-solid fa-boxes-packing"></i>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline gap-1.5 sm:gap-2">
                        <span id="kpiTotalDispatched" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= (analytics && analytics.totals) ? analytics.totals.totalDispatched : 0 %></span>
                        <span class="text-[11px] sm:text-xs font-bold text-emerald-600">parcels</span>
                    </div>
                    <div class="mt-1.5 sm:mt-2 flex items-center gap-1 text-[9px] sm:text-[10px] font-bold text-slate-500 truncate">
                        <i class="fa-solid fa-layer-group text-emerald-500"></i>
                        <span><strong id="kpiTotalConsignments"><%= (analytics && analytics.totals) ? analytics.totals.totalConsignments : 0 %></strong> Batches</span>
                    </div>
                </div>
            </div>

            <!-- KPI 4: States Covered (Pan-India) -->
            <div class="kpi-card-fast flex flex-col justify-between">
                <div class="flex items-center justify-between mb-2 sm:mb-3">
                    <span class="text-[10px] sm:text-[11px] font-black text-slate-500 uppercase tracking-wider">States Covered</span>
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center text-xs sm:text-sm">
                        <i class="fa-solid fa-map-location-dot"></i>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline gap-1.5 sm:gap-2">
                        <span id="kpiStatesCount" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight"><%= (analytics && analytics.totals) ? analytics.totals.totalStates : 0 %></span>
                        <span class="text-[11px] sm:text-xs font-bold text-purple-600">States</span>
                    </div>
                    <div class="mt-1.5 sm:mt-2 flex items-center gap-1 text-[9px] sm:text-[10px] font-bold text-slate-500 truncate">
                        <i class="fa-solid fa-route text-purple-500"></i>
                        <span>Pan-India Logistics</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- 📈 Interactive Graphics & Analytical Intelligence Section -->
        <section class="space-y-4" id="dispatchAnalyticsSection">
            <!-- Analytics Header & Refresh Trigger -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-1">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-600 flex items-center justify-center text-xs font-black">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div>
                        <h2 class="text-sm sm:text-base font-black text-slate-900 tracking-tight">Dispatch Trends & Geographic Distribution</h2>
                        <p class="text-[10px] sm:text-[11px] text-slate-400 font-medium">Daily dispatch volume timeline & state breakdown</p>
                    </div>
                </div>

                <button type="button" id="btnRefreshAnalytics" onclick="refreshAnalytics(true)" class="self-end sm:self-auto inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-bold border border-slate-200 shadow-2xs transition-all cursor-pointer">
                    <i class="fa-solid fa-arrows-rotate text-[11px]" id="refreshAnalyticsIcon"></i>
                    <span>Refresh Data</span>
                </button>
            </div>

            <!-- Two Interactive Charts (Responsive 1-Col Mobile, 2-Col Desktop) -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5 lg:gap-6 w-full">
                
                <!-- Chart 1: Daily Dispatch Timeline -->
                <div class="corp-card p-4 sm:p-5 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-slate-100">
                            <div class="flex items-center gap-2">
                                <span class="h-2 w-2 rounded-full bg-indigo-600"></span>
                                <h3 class="text-xs sm:text-sm font-black text-slate-900">Daily Dispatch Volume</h3>
                            </div>
                            <span class="text-[9px] sm:text-[10px] font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded-md">
                                Day-by-Day
                            </span>
                        </div>

                        <!-- Canvas Container -->
                        <div class="relative w-full h-56 sm:h-64 lg:h-72">
                            <canvas id="dailyDispatchChart"></canvas>
                        </div>
                    </div>

                    <div class="pt-2.5 mt-2 border-t border-slate-100 flex items-center justify-between text-[10px] sm:text-[11px] text-slate-500 font-medium">
                        <span class="flex items-center gap-1.5">
                            <span class="h-2 w-2 rounded-full bg-indigo-600 inline-block"></span> Standard Consignment
                        </span>
                        <span class="flex items-center gap-1.5">
                            <span class="h-2 w-2 rounded-full bg-emerald-500 inline-block"></span> Today's Batch
                        </span>
                    </div>
                </div>

                <!-- Chart 2: State-wise Distribution -->
                <div class="corp-card p-4 sm:p-5 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-slate-100">
                            <div class="flex items-center gap-2">
                                <span class="h-2 w-2 rounded-full bg-purple-600"></span>
                                <h3 class="text-xs sm:text-sm font-black text-slate-900">State Destination Breakdown</h3>
                            </div>
                            <span class="text-[9px] sm:text-[10px] font-bold text-purple-700 bg-purple-50 border border-purple-200 px-2 py-0.5 rounded-md">
                                Top Destinations
                            </span>
                        </div>

                        <!-- Canvas Container -->
                        <div class="relative w-full h-56 sm:h-64 lg:h-72">
                            <canvas id="stateDistChart"></canvas>
                        </div>
                    </div>

                    <!-- Top States Mini Badges -->
                    <div class="pt-2.5 mt-2 border-t border-slate-100">
                        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 mb-1.5">
                            <span>Top Delivery States:</span>
                            <span class="text-purple-600 uppercase">Parcels by State</span>
                        </div>
                        <div id="topStatesList" class="grid grid-cols-2 sm:grid-cols-3 gap-1.5 sm:gap-2">
                            <!-- Populated dynamically via renderTopStatesList() -->
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- 🏢 Executive Modular Operational Grid (1 col mobile, 2 col md, 3 col xl) -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5 lg:gap-6">

            <!-- MODULE 1: Logistics & Parcel Dispatch -->
            <div class="corp-card p-4 sm:p-5 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-base font-bold flex-shrink-0 border border-blue-100">
                            <i class="fa-solid fa-truck-fast"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-1.5">
                                <h2 class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">1. Dispatch & Logistics</h2>
                                <span class="text-[8px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200">CORE</span>
                            </div>
                            <p class="text-slate-400 text-[10px] sm:text-[11px] font-semibold">Consignments & Shipping</p>
                        </div>
                    </div>
                    <p class="text-slate-500 text-xs mb-3.5 leading-relaxed font-medium">
                        Barcode scanner entry, automated parcel weights, consignment batches, and live dispatch tracking.
                    </p>
                </div>
                
                <div class="pt-3 border-t border-slate-100 space-y-1.5">
                    <a href="/admin/manual-entry" class="hub-link-item">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-keyboard text-blue-600 text-xs"></i>
                            <span>Manual Entry Hub</span>
                        </span>
                        <i class="fa-solid fa-arrow-right text-[10px] text-slate-300"></i>
                    </a>
                    <a href="/admin/orders-master" class="hub-link-item">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-receipt text-blue-600 text-xs"></i>
                            <span>Orders Master Table</span>
                        </span>
                        <i class="fa-solid fa-arrow-right text-[10px] text-slate-300"></i>
                    </a>
                    <a href="/admin/live-tracking" class="hub-link-item">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-satellite-dish text-blue-600 text-xs"></i>
                            <span>India Post Live Tracking</span>
                        </span>
                        <span class="text-[8px] font-bold text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">SYNC</span>
                    </a>
                    <a href="/admin/master-database" class="hub-link-item">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-database text-teal-600 text-xs"></i>
                            <span>Master Database Records</span>
                        </span>
                        <i class="fa-solid fa-arrow-right text-[10px] text-slate-300"></i>
                    </a>
                </div>
            </div>

            <!-- MODULE 2: Member & Customer Directory -->
            <div class="corp-card p-4 sm:p-5 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-base font-bold flex-shrink-0 border border-emerald-100">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-1.5">
                                <h2 class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">2. Members & Customers</h2>
                                <span class="text-[8px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">DIRECTORY</span>
                            </div>
                            <p class="text-slate-400 text-[10px] sm:text-[11px] font-semibold">Customer Accounts & History</p>
                        </div>
                    </div>
                    <p class="text-slate-500 text-xs mb-3.5 leading-relaxed font-medium">
                        Search customer addresses, review lifetime orders, manage member IDs, and inspect contact records.
                    </p>
                </div>
                
                <div class="pt-3 border-t border-slate-100 space-y-1.5">
                    <a href="/admin/customers" class="hub-link-item">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-address-book text-emerald-600 text-xs"></i>
                            <span>Customer Directory</span>
                        </span>
                        <i class="fa-solid fa-arrow-right text-[10px] text-slate-300"></i>
                    </a>
                    <a href="/admin/queries" class="hub-link-item">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-headset text-emerald-600 text-xs"></i>
                            <span>Support Helpdesk & Tickets</span>
                        </span>
                        <% if (typeof stats !== 'undefined' && stats.openQueries > 0) { %>
                        <span class="text-[8px] font-bold text-rose-600 bg-rose-50 px-1.5 py-0.5 rounded"><%= stats.openQueries %> OPEN</span>
                        <% } else { %>
                        <i class="fa-solid fa-arrow-right text-[10px] text-slate-300"></i>
                        <% } %>
                    </a>
                </div>
            </div>

            <!-- MODULE 3: Inventory & Product Catalog -->
            <div class="corp-card p-4 sm:p-5 flex flex-col justify-between">
                <div>
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-base font-bold flex-shrink-0 border border-purple-100">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-1.5">
                                <h2 class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">3. Inventory & Catalog</h2>
