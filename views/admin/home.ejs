    <!-- 📊 Analytics Data Carrier -->
    <script id="rawAnalyticsData" type="application/json"><%- JSON.stringify(analytics || {}) %></script>

    <script>
        // 📊 Chart Instances
        let dailyDispatchChart = null;
        let stateDistChart = null;
        let currentAnalytics = {};

        try {
            const dataElem = document.getElementById('rawAnalyticsData');
            currentAnalytics = dataElem ? JSON.parse(dataElem.textContent || '{}') : {};
        } catch (e) {
            console.error('Error parsing analytics JSON:', e);
            currentAnalytics = {};
        }

        // Initialize on DOM ready
        document.addEventListener('DOMContentLoaded', () => {
            renderDashboardAnalytics(currentAnalytics);
        });

        // 🎨 Render / Re-render all Analytics Components
        function renderDashboardAnalytics(data) {
            if (!data) return;

            // 1. Update KPI Values
            updateKPICards(data);

            // 2. Render Top States Badges
            renderTopStatesList(data.stateDistribution || []);

            // 3. Render Daily Dispatch Chart
            renderDailyDispatchChart(data.dailyTrend || [], data.today ? data.today.dateStr : '');

            // 4. Render State Distribution Chart
            renderStateDistChart(data.stateDistribution || []);
        }

        // 🔢 Update KPI Cards in Real-Time
        function updateKPICards(data) {
            if (data.today) {
                const el = document.getElementById('kpiTodayCount');
                if (el) el.innerText = data.today.count || 0;
                const dt = document.getElementById('kpiTodayDate');
                if (dt && data.today.dateStr) dt.innerText = data.today.dateStr;
            }
            if (data.yesterday) {
                const el = document.getElementById('kpiYesterdayCount');
                if (el) el.innerText = data.yesterday.count || 0;
                const dt = document.getElementById('kpiYesterdayDate');
                if (dt && data.yesterday.dateStr) dt.innerText = data.yesterday.dateStr;
            }
            if (data.totals) {
                const sEl = document.getElementById('kpiStatesCount');
                if (sEl) sEl.innerText = data.totals.totalStates || 0;
                const dEl = document.getElementById('kpiTotalDispatched');
                if (dEl) dEl.innerText = data.totals.totalDispatched || 0;
                const cEl = document.getElementById('kpiTotalConsignments');
                if (cEl) cEl.innerText = data.totals.totalConsignments || 0;
            }
        }

        // 🗺️ Render Top States Ranking Pills
        function renderTopStatesList(states) {
            const container = document.getElementById('topStatesList');
            if (!container) return;

            if (!states || states.length === 0) {
                container.innerHTML = `<span class="col-span-full text-slate-400 text-xs italic">No destination state data available yet.</span>`;
                return;
            }

            const topList = states.slice(0, 6);
            container.innerHTML = topList.map((st, i) => {
                return `
                    <div class="p-2 rounded-xl bg-slate-50 border border-slate-100 flex flex-col justify-between">
                        <div class="flex items-center justify-between text-[10px] font-bold text-slate-700 mb-1">
                            <span class="truncate" title="${st.state}">#${i + 1} ${st.state}</span>
                            <span class="font-mono text-purple-700 bg-purple-50 px-1.5 py-0.2 rounded border border-purple-200">${st.count}</span>
                        </div>
                        <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden">
                            <div class="bg-gradient-to-r from-purple-500 to-indigo-500 h-full rounded-full" style="width: ${Math.min(100, Math.max(8, st.percentage))}%"></div>
                        </div>
                        <span class="text-[9px] text-slate-400 font-semibold text-right mt-0.5">${st.percentage}%</span>
                    </div>
                `;
            }).join('');
        }

        // 📈 Daily Dispatch Bar/Line Chart with Chart.js
        function renderDailyDispatchChart(trendData, todayDateStr) {
            const canvas = document.getElementById('dailyDispatchChart');
            if (!canvas) return;

            const labels = (trendData || []).map(d => d.date);
            const counts = (trendData || []).map(d => d.count);
            const consignments = (trendData || []).map(d => (d.consignments || []).join(', '));

            // Background colors: highlight today's bar
            const bgColors = labels.map(lbl => {
                if (todayDateStr && lbl.toLowerCase() === todayDateStr.toLowerCase()) {
                    return 'rgba(16, 185, 129, 0.85)'; // Emerald for Today
                }
                return 'rgba(79, 70, 229, 0.85)'; // Indigo for other dates
            });

            const borderColors = labels.map(lbl => {
                if (todayDateStr && lbl.toLowerCase() === todayDateStr.toLowerCase()) {
                    return '#059669';
                }
                return '#4338ca';
            });

            if (dailyDispatchChart) {
                dailyDispatchChart.destroy();
            }

            const ctx = canvas.getContext('2d');
            dailyDispatchChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels.length ? labels : ['No Dispatches Yet'],
                    datasets: [{
                        label: 'Orders Dispatched',
                        data: counts.length ? counts : [0],
                        backgroundColor: bgColors.length ? bgColors : ['rgba(79, 70, 229, 0.8)'],
                        borderColor: borderColors.length ? borderColors : ['#4338ca'],
                        borderWidth: 1.5,
                        borderRadius: 8,
                        borderSkipped: false,
                        maxBarThickness: 42
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#ffffff',
                            bodyColor: '#e2e8f0',
                            padding: 10,
                            cornerRadius: 8,
                            callbacks: {
                                label: function(context) {
                                    const idx = context.dataIndex;
                                    const cnt = context.parsed.y;
                                    const cStr = consignments[idx] ? ` (Consignment: ${consignments[idx]})` : '';
                                    return ` ${cnt} Orders Dispatched${cStr}`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                font: { family: 'Plus Jakarta Sans', weight: '600', size: 10 },
                                color: '#64748b'
                            },
                            grid: {
                                color: '#f1f5f9'
                            }
                        },
                        x: {
                            ticks: {
                                font: { family: 'Plus Jakarta Sans', weight: '700', size: 10 },
                                color: '#475569'
                            },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // 🗺️ State Distribution Horizontal Bar Chart with Chart.js
        function renderStateDistChart(stateData) {
            const canvas = document.getElementById('stateDistChart');
            if (!canvas) return;

            const topStates = (stateData || []).slice(0, 8);
            const labels = topStates.map(s => s.state);
            const counts = topStates.map(s => s.count);
            const pcts = topStates.map(s => s.percentage);

            const palette = [
                'rgba(124, 58, 237, 0.85)',
                'rgba(99, 102, 241, 0.85)',
                'rgba(59, 130, 246, 0.85)',
                'rgba(14, 165, 233, 0.85)',
                'rgba(20, 184, 166, 0.85)',
                'rgba(16, 185, 129, 0.85)',
                'rgba(245, 158, 11, 0.85)',
                'rgba(244, 63, 94, 0.85)'
            ];

            if (stateDistChart) {
                stateDistChart.destroy();
            }

            const ctx = canvas.getContext('2d');
            stateDistChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels.length ? labels : ['No State Data'],
                    datasets: [{
                        label: 'Parcels Dispatched',
                        data: counts.length ? counts : [0],
                        backgroundColor: palette.slice(0, labels.length),
                        borderWidth: 0,
                        borderRadius: 6,
                        borderSkipped: false,
                        maxBarThickness: 24
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#ffffff',
                            bodyColor: '#e2e8f0',
                            padding: 10,
                            cornerRadius: 8,
                            callbacks: {
                                label: function(context) {
                                    const idx = context.dataIndex;
                                    const cnt = context.parsed.x;
                                    const pct = pcts[idx] ? ` (${pcts[idx]}%)` : '';
                                    return ` ${cnt} Dispatched Parcels${pct}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                font: { family: 'Plus Jakarta Sans', weight: '600', size: 10 },
                                color: '#64748b'
                            },
                            grid: {
                                color: '#f1f5f9'
                            }
                        },
                        y: {
                            ticks: {
                                font: { family: 'Plus Jakarta Sans', weight: '700', size: 10 },
                                color: '#334155'
                            },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // 🔄 Live Refresh Metrics Function
        async function refreshAnalytics() {
            const icon = document.getElementById('refreshAnalyticsIcon');
            if (icon) icon.classList.add('fa-spin');

            try {
                const res = await fetch('/admin/api/dashboard-analytics');
                const data = await res.json();
                if (data && data.success) {
                    currentAnalytics = data;
                    renderDashboardAnalytics(data);
                }
            } catch (err) {
                console.error('Error refreshing analytics metrics:', err);
            } finally {
                if (icon) {
                    setTimeout(() => icon.classList.remove('fa-spin'), 400);
                }
            }
        }
    </script>

    <!-- Interactive Clock & Greeting Script -->
    <script>
        (function() {
            function updateClock() {
                const now = new Date();
                const clockEl = document.getElementById('liveClock');
                const dateEl = document.getElementById('liveDate');
                if (clockEl) {
                    clockEl.textContent = now.toLocaleTimeString('en-IN', { hour12: false });
                }
                if (dateEl) {
                    dateEl.textContent = now.toLocaleDateString('en-IN', { 
                        weekday: 'short', 
                        day: 'numeric', 
                        month: 'short', 
                        year: 'numeric' 
                    });
                }
            }
            updateClock();
            setInterval(updateClock, 1000);

            // Dynamic Greeting
            const greetingEl = document.getElementById('greetingMessage');
            if (greetingEl) {
                const hour = new Date().getHours();
                let timeGreeting = 'Good evening';
                if (hour < 12) timeGreeting = 'Good morning';
                else if (hour < 17) timeGreeting = 'Good afternoon';
                greetingEl.textContent = `${timeGreeting}, Executive Administrator`;
            }
        })();
    </script>
