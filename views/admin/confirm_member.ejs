<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Confirm Member Workspace - Avira Control</title>
    <style>
        .confirm-input {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 4px 8px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 700;
        }
        .confirm-input:focus {
            outline: none;
            border-color: #10b981;
            background: #ffffff;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 to-amber-50/30 min-h-screen flex flex-col font-sans antialiased text-slate-800 w-full overflow-x-hidden">

    <%- include('../partials/admin_navbar') %>

    <div class="lg:pl-64 flex-grow flex flex-col justify-between min-h-screen w-full box-border">
        
        <header class="bg-white/80 backdrop-blur-md border-b border-slate-100 px-3 sm:px-6 py-2.5 flex justify-between items-center sticky top-0 z-40 shadow-sm w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-user-check text-emerald-500 flex-shrink-0"></i>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider truncate">Tracking Manager / Confirm Members</span>
            </div>
            
            <button id="btnRunMatches" type="button" class="bg-emerald-600 hover:bg-emerald-700 text-white font-black text-[11px] px-4 py-2 rounded-xl transition-all shadow-md cursor-pointer uppercase tracking-wider flex items-center gap-1.5 flex-shrink-0">
                <i class="fa-solid fa-bolt text-amber-300"></i> Run Matches
            </button>
        </header>

        <main class="flex-grow w-full px-2 sm:px-4 py-3 space-y-3 box-border">
            <div class="bg-white rounded-xl border border-slate-100 shadow-md overflow-hidden w-full">
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap">
                        <thead>
                            <tr class="bg-slate-100/80 border-b border-slate-100 text-slate-500 font-bold uppercase text-[10px] tracking-tight">
                                <th class="py-2 px-2.5">Tracking / Name</th>
                                <th class="py-2 px-2">Pincode & Place</th>
                                <th class="py-2 px-1">Member ID</th>
                                <th class="py-2 px-1">Order Date</th>
                                <th class="py-2 px-1">PV</th>
                                <th class="py-2 px-1">Amount</th>
                                <th class="py-2 px-2 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="confirmTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                            <% if(entries.length === 0) { %>
                                <tr id="empty-row">
                                    <td colspan="7" class="py-12 text-center text-slate-400 font-normal">All entries verified!</td>
                                </tr>
                            <% } else { %>
                                <% entries.forEach((item, index) => { %>
                                    <tr class="hover:bg-slate-50/60 transition-colors" id="row-<%= index %>">
                                        <td class="py-1.5 px-2.5">
                                            <div class="font-mono font-bold text-slate-900 tracking-number-text text-[11px]"><%= item.tracking %></div>
                                            <div class="text-[9px] text-slate-400 uppercase font-semibold name-text truncate max-w-[140px]"><%= item.name %></div>
                                        </td>
                                        <td class="py-1.5 px-2">
                                            <div class="font-mono font-bold text-emerald-600 text-[11px]"><%= item.pincode %></div>
                                            <div class="text-[9px] text-slate-400 uppercase truncate max-w-[120px]"><%= item.city %>, <%= item.state %></div>
                                        </td>
                                        <td class="py-1.5 px-1">
                                            <input type="text" id="member-<%= index %>" data-idx="<%= index %>" value="<%= item.member_id || '' %>" placeholder="MEMBER ID" class="confirm-input font-mono uppercase text-slate-700 w-[100px]">
                                        </td>
                                        <td class="py-1.5 px-1">
                                            <input type="date" id="date-<%= index %>" data-idx="<%= index %>" data-saved-date="<%= item.order_date %>" class="confirm-input date-picker-field text-slate-700 font-semibold w-[115px]">
                                            <input type="hidden" id="formatted-date-<%= index %>" value="<%= item.order_date %>">
                                        </td>
                                        <td class="py-1.5 px-1">
                                            <input type="number" id="pv-<%= index %>" data-idx="<%= index %>" value="<%= item.pv || '' %>" placeholder="PV" class="confirm-input font-mono text-emerald-600 w-[50px]">
                                        </td>
                                        <td class="py-1.5 px-1">
                                            <input type="number" id="amount-<%= index %>" data-idx="<%= index %>" value="<%= item.amount || '' %>" placeholder="AMOUNT" class="confirm-input font-mono font-bold text-slate-900 w-[65px]">
                                        </td>
                                        <td class="py-1.5 px-2 text-center">
                                            <div class="flex items-center justify-center gap-1.5">
                                                <button type="button" data-idx="<%= index %>" class="approve-btn bg-emerald-500 hover:bg-emerald-600 text-white font-black px-2.5 py-1 rounded transition-all text-[10px] tracking-wider uppercase cursor-pointer shadow-sm">OK</button>
                                                <button type="button" onclick="deletePendingMember('<%= item.id %>', '<%= index %>')" class="bg-rose-500 hover:bg-rose-600 text-white font-black px-2 py-1 rounded transition-all text-[10px] tracking-wider uppercase cursor-pointer shadow-sm" title="Delete Entry">
                                                    <i class="fa-solid fa-trash text-[9px]"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <footer class="bg-white border-t border-slate-100 py-2.5 text-center text-[10px] font-medium text-slate-400 mt-2 w-full overflow-hidden">
            &copy; 2026 Avira Control Center. All rights reserved.
        </footer>
    </div>

    <script>
        window.onload = () => {
            document.querySelectorAll('.date-picker-field').forEach(picker => { convertAndSetInputDate(picker); });
        };

        function convertAndSetInputDate(picker) {
            const savedDateStr = picker.getAttribute('data-saved-date'); 
            if (savedDateStr) {
                const cleanStr = savedDateStr.replace(/(\d+)(st|nd|rd|th)/i, "$1");
                const dateObj = new Date(cleanStr);
                if (!isNaN(dateObj.getTime())) {
                    const yyyy = dateObj.getFullYear();
                    const mm = String(dateObj.getMonth() + 1).padStart(2, '0');
                    const dd = String(dateObj.getDate()).padStart(2, '0');
                    picker.value = `${yyyy}-${mm}-${dd}`; 
                }
            }
        }

        function formatCustomDate(dateString) {
            if (!dateString) return '';
            const cleanStr = dateString.replace(/(\d+)(st|nd|rd|th)/i, "$1");
            const date = new Date(cleanStr);
            if (isNaN(date.getTime())) return dateString;
            const day = date.getDate();
            let suffix = 'th';
            if (day === 1 || day === 21 || day === 31) suffix = 'st';
            else if (day === 2 || day === 22) suffix = 'nd';
            else if (day === 3 || day === 23) suffix = 'rd';
            const realMonths = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            return `${day}${suffix} ${realMonths[date.getMonth()]} ${date.getFullYear()}`;
        }

        function getStrictCleanKey(str) {
            if (!str) return '';
            return str.toString().toUpperCase().replace(/[^A-Z0-9]/g, '');
        }

        document.querySelectorAll('.approve-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                const index = this.getAttribute('data-idx');
                const row = document.getElementById(`row-${index}`);
                
                const memberId = document.getElementById(`member-${index}`).value.trim();
                const rawDate = document.getElementById(`date-${index}`).value;
                const pv = document.getElementById(`pv-${index}`).value.trim();
                const amount = document.getElementById(`amount-${index}`).value.trim();
                const tracking = row.querySelector('.tracking-number-text').innerText.trim();

                if(!memberId || !rawDate || !pv || !amount) {
                    alert("Please fill in all four required fields: Member ID, Date, PV, and Amount.");
                    return;
                }

                this.innerText = "SAVING...";
                this.disabled = true;

                const formattedDate = formatCustomDate(rawDate);

                try {
                    const res = await fetch('/admin/api/approve-entry-by-tracking', { 
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            tracking,
                            memberId,
                            orderDate: formattedDate,
                            pv,
                            amount
                        }) 
                    });
                    const data = await res.json();

                    if(data.success) { 
                        row.remove(); 
                        checkEmptyTableState();
                    } else {
                        alert("Error: " + data.msg);
                        this.innerText = "OK";
                        this.disabled = false;
                    }
                } catch(err) { 
                    console.error(err); 
                    alert("Server sync error occurred!");
                    this.innerText = "OK";
                    this.disabled = false;
                }
            });
        });

        async function deletePendingMember(id, index) {
            if (!id) {
                alert("Invalid entry ID!");
                return;
            }
            if (confirm("Are you sure you want to delete this pending dispatch entry?")) {
                try {
                    const res = await fetch(`/admin/api/delete-entry/${id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        const row = document.getElementById(`row-${index}`);
                        if (row) row.remove();
                        checkEmptyTableState();
                    } else {
                        alert("Error: " + (data.msg || "Failed to delete"));
                    }
                } catch (err) {
                    console.error(err);
                    alert("Server communication error while deleting.");
                }
            }
        }

        function checkEmptyTableState() {
            const remainingRows = document.querySelectorAll('#confirmTableBody tr:not(#empty-row)');
            if (remainingRows.length === 0) {
                document.getElementById('confirmTableBody').innerHTML = `
                    <tr id="empty-row">
                        <td colspan="7" class="py-12 text-center text-slate-400 font-normal">All entries verified!</td>
                    </tr>
                `;
            }
        }

        document.getElementById('btnRunMatches').addEventListener('click', async function() {
            this.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> MATCHING...`;
            this.disabled = true;

            try {
                const response = await fetch('/admin/api/match-confirm-db');
                const result = await response.json();

                if (result.success && result.dbData) {
                    const dbMap = result.dbData;
                    const rows = document.querySelectorAll('#confirmTableBody tr:not(#empty-row)');
                    let matchCount = 0;

                    for (let row of rows) {
                        const index = row.id.replace('row-', '');
                        const rawNameInTable = row.querySelector('.name-text').innerText;
                        const cleanTableKey = getStrictCleanKey(rawNameInTable);

                        const matchedData = dbMap[cleanTableKey] || dbMap[rawNameInTable.toUpperCase().trim()];

                        if (matchedData) {
                            document.getElementById(`member-${index}`).value = matchedData.memberId || '';
                            document.getElementById(`pv-${index}`).value = matchedData.pv || '0';
                            document.getElementById(`amount-${index}`).value = matchedData.amount || '0';
                            document.getElementById(`formatted-date-${index}`).value = matchedData.dateStr || '';

                            if(matchedData.dateStr) {
                                const picker = document.getElementById(`date-${index}`);
                                picker.setAttribute('data-saved-date', matchedData.dateStr);
                                convertAndSetInputDate(picker);
                            }

                            row.classList.add('bg-emerald-50/80');
                            matchCount++;
                        }
                    }
                    alert(`Success! Auto-filled ${matchCount} matching entries from orders_master. Please review and click 'OK' to save.`);
                } else {
                    alert(result.msg || "No match data found in database.");
                }
            } catch (err) {
                console.error(err);
                alert("Database matching process failed.");
            } finally {
                this.innerHTML = `<i class="fa-solid fa-bolt text-amber-300"></i> Run Matches`;
                this.disabled = false;
            }
        });
    </script>
</body>
</html>
