<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>System Settings - Avira Control Hub</title>
    <style>
        .slide-down-anim {
            animation: slideDown 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-800 w-full overflow-x-hidden block selection:bg-emerald-500 selection:text-white">

    <%- include('../partials/admin_navbar') %>

    <div class="w-full lg:pl-64 min-h-screen flex flex-col justify-between box-border min-w-0">
        
        <header class="glass-panel-header px-4 sm:px-8 py-3 flex justify-between items-center sticky top-0 z-40 shadow-xs w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-gears text-emerald-500 flex-shrink-0 text-sm"></i>
                <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider truncate">Settings / System Parameters</span>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-black text-slate-800 dark:text-slate-200">Avira Root</p>
                    <p class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest font-mono-code">Config Engine</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 dark:bg-emerald-950/60 rounded-xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800 font-black text-xs shadow-xs">
                    <i class="fa-solid fa-sliders text-xs"></i>
                </div>
            </div>
        </header>

        <main class="flex-grow w-full max-w-4xl mx-auto px-4 sm:px-8 py-6 sm:py-8 space-y-6 box-border">
            
            <div class="space-y-1.5 text-center max-w-xl mx-auto mb-6">
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white font-outfit">Control Center Settings</h1>
                <p class="text-slate-500 dark:text-slate-400 text-xs md:text-sm font-medium">Configure global parcel packaging presets and system automation parameters.</p>
            </div>

            <!-- Settings Category Selector -->
            <div class="bg-white dark:bg-[#111827] p-5 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2">
                <label class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wider block font-outfit flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-emerald-500"></i> Select Setting Configuration Area
                </label>
                <div class="relative">
                    <select id="mainSettingSelect" class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl text-xs font-bold text-slate-800 dark:text-slate-100 focus:outline-none focus:border-emerald-500 cursor-pointer appearance-none transition-all">
                        <option value="" disabled selected>-- Choose Setting Category --</option>
                        <option value="box_dimensions">Box Dimensions (L x B x H Packaging Shortcuts)</option>
                    </select>
                    <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400 text-xs">
                        <i class="fa-solid fa-chevron-down"></i>
                    </div>
                </div>
            </div>

            <div id="boxDimensionsSection" class="hidden space-y-6 slide-down-anim">
                
                <!-- Add New Box Dimension Shortcut -->
                <div class="glass-emerald-card p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
                    <h2 class="text-xs sm:text-sm font-black text-slate-900 dark:text-white uppercase flex items-center gap-2 font-outfit tracking-wide">
                        <i class="fa-solid fa-plus-circle text-emerald-500"></i> Add New Box Dimension Shortcut
                    </h2>
                    <form id="addPresetForm" class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
                        <div class="sm:col-span-2">
                            <label class="text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase block mb-1 tracking-wider">Box Name / Label</label>
                            <input type="text" id="pName" required placeholder="E.G. COURIER BOX MEDIUM" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold focus:outline-none focus:border-emerald-500 uppercase text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                        <div>
                            <label class="text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase block mb-1 tracking-wider">Length (cm)</label>
                            <input type="number" id="pLength" required placeholder="0" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono-code font-bold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                        <div>
                            <label class="text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase block mb-1 tracking-wider">Breadth (cm)</label>
                            <input type="number" id="pBreadth" required placeholder="0" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono-code font-bold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                        <div>
                            <label class="text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase block mb-1 tracking-wider">Height (cm)</label>
                            <input type="number" id="pHeight" required placeholder="0" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono-code font-bold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                        <div class="sm:col-span-4 flex justify-end pt-2">
                            <button type="submit" class="w-full sm:w-auto btn-emerald-3d text-white font-black text-xs px-6 py-2.5 rounded-xl uppercase tracking-wider shadow-md transition-all cursor-pointer font-outfit flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                <span>Save Preset to Database</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Stored Box Dimensions List -->
                <div class="bg-white dark:bg-[#111827] rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden w-full">
                    <div class="px-6 py-4 bg-slate-50 dark:bg-[#0d1322] border-b border-slate-100 dark:border-slate-800 font-bold text-xs text-slate-900 dark:text-white uppercase flex items-center justify-between flex-wrap gap-2">
                        <span class="font-outfit font-black tracking-wide flex items-center gap-2"><i class="fa-solid fa-boxes-packing text-emerald-500"></i> Stored Box Dimensions</span>
                        <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-mono-code font-black bg-emerald-50 dark:bg-emerald-950/80 px-2.5 py-0.5 rounded-full border border-emerald-100 dark:border-emerald-900"><%= presets.length %> Active Presets</span>
                    </div>
                    <div class="overflow-x-auto w-full">
                        <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[500px]">
                            <thead>
                                <tr class="bg-slate-100/70 dark:bg-slate-900/60 border-b border-slate-100 dark:border-slate-800 text-slate-400 dark:text-slate-500 font-black uppercase text-[10px] tracking-wider">
                                    <th class="p-4">Box Name</th>
                                    <th class="p-4">Dimensions (L x B x H)</th>
                                    <th class="p-4 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-semibold text-slate-700 dark:text-slate-300">
                                <% if(presets.length === 0) { %>
                                    <tr><td colspan="3" class="p-8 text-center text-slate-400 dark:text-slate-500 font-normal">No presets found in database. Add your first box dimension above.</td></tr>
                                <% } else { %>
                                    <% presets.forEach(p => { %>
                                        <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                                            <td class="p-4 font-black text-slate-900 dark:text-white uppercase tracking-wide"><%= p.name %></td>
                                            <td class="p-4 font-mono-code text-emerald-600 dark:text-emerald-400 font-black"><%= p.length %> x <%= p.breadth %> x <%= p.height %> cm</td>
                                            <td class="p-4 text-center">
                                                <button onclick="deletePreset('<%= p.id %>')" class="text-rose-500 hover:text-rose-600 dark:text-rose-400 font-black cursor-pointer uppercase text-[10px] transition-colors inline-flex items-center gap-1">
                                                    <i class="fa-solid fa-trash-can"></i> Remove
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </main>

        <footer class="bg-white dark:bg-[#0d1322] border-t border-slate-200/80 dark:border-slate-800 py-3.5 text-center text-xs font-medium text-slate-400 dark:text-slate-500 mt-6 w-full overflow-hidden">
            &copy; 2026 Avira LifeCare System. Control Center.
        </footer>

    </div>

    <script>
        document.getElementById('mainSettingSelect').addEventListener('change', function() {
            const boxSection = document.getElementById('boxDimensionsSection');
            if (this.value === 'box_dimensions') {
                boxSection.classList.remove('hidden');
            } else {
                boxSection.classList.add('hidden');
            }
        });

        document.getElementById('addPresetForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const payload = {
                name: document.getElementById('pName').value,
                length: document.getElementById('pLength').value,
                breadth: document.getElementById('pBreadth').value,
                height: document.getElementById('pHeight').value
            };

            try {
                const res = await fetch('/admin/api/add-box-preset', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if(data.success) { 
                    location.reload(); 
                } else {
                    alert(data.msg);
                }
            } catch(err) {
                console.error(err);
            }
        });

        async function deletePreset(id) {
            if(confirm("Are you sure you want to remove this box dimension preset?")) {
                try {
                    const res = await fetch(`/admin/api/delete-box-preset/${id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if(data.success) { location.reload(); }
                } catch(err) {
                    console.error(err);
                }
            }
        }
    </script>
</body>
</html>
