<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Add New Product - Avira Admin Control</title>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased relative w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <%- include('../partials/admin_navbar') %>

    <div class="lg:pl-64 flex-grow flex flex-col justify-between min-h-screen overflow-y-auto box-border w-full min-w-0">

        <header class="glass-panel-header px-4 sm:px-8 py-3 flex justify-between items-center sticky top-0 z-40 shadow-xs w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-box-open text-emerald-500 flex-shrink-0 text-sm"></i>
                <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider truncate">Products / Add New Inventory</span>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-black text-slate-800 dark:text-slate-200">Avira Root</p>
                    <p class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest font-mono-code">Product Catalog</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 dark:bg-emerald-950/60 rounded-xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800 font-black text-xs shadow-xs">
                    <i class="fa-solid fa-plus text-xs"></i>
                </div>
            </div>
        </header>

        <main class="flex-grow max-w-3xl w-full mx-auto px-4 sm:px-8 py-6 sm:py-10 relative z-10 box-border">
            
            <div class="space-y-2 text-center max-w-xl mx-auto mb-6">
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white font-outfit">Create New Product</h1>
                <p class="text-slate-500 dark:text-slate-400 text-xs md:text-sm font-medium">Publish item specifications, Point Value (PV), pricing details, and showcase gallery images.</p>
            </div>

            <div class="glass-emerald-card p-5 sm:p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
                
                <div class="flex items-center gap-3 mb-5 sm:mb-6 border-b border-slate-100 dark:border-slate-800 pb-4">
                    <div class="w-10 h-10 sm:w-11 sm:h-11 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 rounded-2xl flex items-center justify-center text-lg shadow-xs border border-emerald-100 dark:border-emerald-900 flex-shrink-0">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <div>
                        <h2 class="text-sm sm:text-base font-black uppercase text-slate-900 dark:text-white leading-none font-outfit tracking-wide">Item Specifications</h2>
                        <p class="text-slate-400 dark:text-slate-500 text-[11px] mt-1 font-medium">Synced with member product portal and catalog downloads.</p>
                    </div>
                </div>

                <form id="productForm" enctype="multipart/form-data" class="space-y-4 sm:space-y-5 text-xs">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-black uppercase mb-1.5 text-slate-500 dark:text-slate-400 tracking-wider">Product Title / Name</label>
                            <input type="text" id="productName" name="name" required placeholder="E.G. AVIRA HERBAL EXTRACT" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 uppercase transition-all">
                        </div>
                        <div>
                            <label class="block text-[10px] font-black uppercase mb-1.5 text-slate-500 dark:text-slate-400 tracking-wider">Product Showcase Images</label>
                            <input type="file" id="imageInput" accept="image/*" multiple 
                                class="w-full text-[10px] text-slate-500 dark:text-slate-400 file:mr-2 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-[10px] file:font-black file:bg-emerald-50 dark:file:bg-emerald-950 file:text-emerald-700 dark:file:text-emerald-300 hover:file:bg-emerald-100 cursor-pointer">
                        </div>
                    </div>

                    <div id="previewWrapper" class="hidden flex-col gap-2 bg-slate-50/80 dark:bg-slate-900/80 p-3.5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-inner">
                        <span class="text-[10px] font-black uppercase text-slate-400 dark:text-slate-500 tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-images text-emerald-500"></i> Selected Images Preview:
                        </span>
                        <div id="previewContainer" class="flex flex-wrap gap-2.5 sm:gap-3"></div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-black uppercase mb-1.5 text-slate-500 dark:text-slate-400 tracking-wider">Amount (Price ₹)</label>
                            <input type="number" step="0.01" id="productAmount" name="amount" required placeholder="0.00" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono-code font-bold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                        <div>
                            <label class="block text-[10px] font-black uppercase mb-1.5 text-slate-500 dark:text-slate-400 tracking-wider">PV Bound (Point Value)</label>
                            <input type="number" id="productPv" name="pv" required placeholder="0" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono-code font-bold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                        </div>
                    </div>

                    <div>
                        <label class="block text-[10px] font-black uppercase mb-1.5 text-slate-500 dark:text-slate-400 tracking-wider">Product Information (Description)</label>
                        <textarea id="productInfo" name="info" rows="3" required placeholder="Write comprehensive product description..." class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all leading-relaxed"></textarea>
                    </div>

                    <div>
                        <label class="block text-[10px] font-black uppercase mb-1.5 text-slate-500 dark:text-slate-400 tracking-wider">Product Benefits Matrix</label>
                        <textarea id="productBenefits" name="benefits" rows="3" required placeholder="List distinct wellness advantages and features..." class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all leading-relaxed"></textarea>
                    </div>

                    <div>
                        <label class="block text-[10px] font-black uppercase mb-1.5 text-slate-500 dark:text-slate-400 tracking-wider">How To Consume / Apply</label>
                        <textarea id="productHowToUse" name="how_to_use" rows="2" required placeholder="Usage instructions and dosage metrics..." class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all leading-relaxed"></textarea>
                    </div>

                    <button type="submit" class="w-full py-3.5 btn-emerald-3d text-white font-black rounded-xl text-xs uppercase tracking-widest transition-all shadow-md cursor-pointer flex items-center justify-center gap-2 font-outfit">
                        <span>Publish to Store Catalog</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </form>
            </div>
        </main>

        <footer class="bg-white dark:bg-[#0d1322] border-t border-slate-200/80 dark:border-slate-800 py-3.5 text-center text-xs font-medium text-slate-400 dark:text-slate-500 mt-12 w-full overflow-hidden">
            &copy; 2026 Avira Control Center. Secure Admin Workspace.
        </footer>
    </div>

    <script>
        let selectedFiles = [];

        document.getElementById('imageInput').addEventListener('change', function(e) {
            Array.from(this.files).forEach(file => {
                selectedFiles.push(file);
            });
            
            this.value = '';
            renderPreviews();
        });

        function renderPreviews() {
            const wrapper = document.getElementById('previewWrapper');
            const container = document.getElementById('previewContainer');
            container.innerHTML = '';

            if (selectedFiles.length > 0) {
                wrapper.classList.remove('hidden');
                wrapper.classList.add('flex');

                selectedFiles.forEach((file, index) => {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        const div = document.createElement('div');
                        div.className = "h-14 w-14 sm:h-16 sm:w-16 rounded-xl bg-white dark:bg-slate-800 p-1 border border-slate-200 dark:border-slate-700 flex-shrink-0 overflow-hidden shadow-xs flex items-center justify-center relative group";
                        
                        div.innerHTML = `
                            <img src="${escapeHTML(event.target.result)}" class="h-full w-full object-contain">
                            <button type="button" onclick="removeImage(${index})" class="absolute top-0.5 right-0.5 bg-rose-500 hover:bg-rose-600 text-white text-[8px] h-4 w-4 rounded-full flex items-center justify-center transition-all shadow-md focus:outline-none cursor-pointer">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        `;
                        container.appendChild(div);
                    }
                    reader.readAsDataURL(file);
                });
            } else {
                wrapper.classList.add('hidden');
                wrapper.classList.remove('flex');
            }
        }

        window.removeImage = function(index) {
            selectedFiles.splice(index, 1);
            renderPreviews();
        }

        document.getElementById('productForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            if(selectedFiles.length === 0) {
                alert("Please upload at least one image.");
                return;
            }

            const submitBtn = e.target.querySelector('button[type="submit"]');
            submitBtn.innerText = "Publishing to Server...";
            submitBtn.disabled = true;

            const formData = new FormData();
            formData.append('name', sanitizeString(document.getElementById('productName').value));
            formData.append('amount', sanitizeString(document.getElementById('productAmount').value));
            formData.append('pv', sanitizeString(document.getElementById('productPv').value));
            formData.append('info', sanitizeString(document.getElementById('productInfo').value));
            formData.append('benefits', sanitizeString(document.getElementById('productBenefits').value));
            formData.append('how_to_use', sanitizeString(document.getElementById('productHowToUse').value));
            
            selectedFiles.forEach(file => {
                formData.append('productImages', file);
            });
            
            try {
                const response = await fetch('/admin/api/add-product', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                
                if(result.success) {
                    alert(result.msg || "Product published successfully!");
                    e.target.reset();
                    selectedFiles = [];
                    document.getElementById('previewWrapper').classList.add('hidden');
                    document.getElementById('previewContainer').innerHTML = '';
                } else {
                    alert('Error: ' + (result.msg || "Failed to add product"));
                }
            } catch (err) {
                console.error(err);
                alert('Server system error occurred during submission.');
            } finally {
                submitBtn.innerHTML = `<span>Publish to Store Catalog</span><i class="fa-solid fa-arrow-right"></i>`;
                submitBtn.disabled = false;
            }
        });

        function escapeHTML(str) {
            return String(str || '').replace(/[&<>"'/]/g, function (s) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;',
                    '/': '&#x2F;'
                }[s];
            });
        }

        function sanitizeString(str) {
            return String(str || '').trim();
        }
    </script>
</body>
</html>
