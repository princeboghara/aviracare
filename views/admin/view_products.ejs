<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>View & Edit Products - Avira Ultra Admin</title>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col font-sans antialiased text-slate-800 w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <%- include('../partials/admin_navbar') %>

    <div class="lg:pl-64 flex-grow flex flex-col justify-between min-h-screen overflow-y-auto box-border w-full min-w-0">
        
        <header class="glass-panel-header px-4 sm:px-8 py-3 flex justify-between items-center sticky top-0 z-40 shadow-xs w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-basket-shopping text-emerald-500 flex-shrink-0 text-sm"></i>
                <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider truncate">Products / Inventory Grid Showcase</span>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-black text-slate-800 dark:text-slate-200">Avira Root</p>
                    <p class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest font-mono-code">Inventory Registry</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 dark:bg-emerald-950/60 rounded-xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800 font-black text-xs shadow-xs font-mono-code">
                    <%= products.length %>
                </div>
            </div>
        </header>

        <main class="flex-grow w-full max-w-6xl mx-auto px-4 sm:px-8 py-6 sm:py-8 space-y-6 box-border">
            
            <div class="space-y-1.5 text-center max-w-xl mx-auto mb-6 sm:mb-8">
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white font-outfit">Inventory Catalog</h1>
                <p class="text-slate-500 dark:text-slate-400 text-xs md:text-sm font-medium">Manage active product listings, update Point Values (PV), modify pricing, and maintain showcase gallery images.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 w-full">
                <% if(!products || products.length === 0) { %>
                    <div class="col-span-full bg-white dark:bg-[#111827] p-8 sm:p-12 text-center text-slate-400 dark:text-slate-500 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
                        <i class="fa-solid fa-box-open text-4xl block mb-3 text-slate-300 dark:text-slate-700"></i>
                        No inventory assets published yet inside database registry.
                    </div>
                <% } else { %>
                    <% products.forEach((product) => { %>
                        <div id="product-card-<%= product.id %>" class="glass-emerald-card p-4 sm:p-5 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col sm:flex-row gap-4 relative overflow-hidden transition-all hover:shadow-md">
                            
                            <div class="w-full sm:w-28 h-28 bg-white dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-700 rounded-2xl overflow-hidden flex items-center justify-center p-2 flex-shrink-0">
                                <img src="<%= product.image_url %>" alt="Product Image" class="h-full w-full object-contain">
                            </div>

                            <div class="flex-grow flex flex-col justify-between space-y-2 min-w-0">
                                <div>
                                    <div class="flex justify-between items-start gap-2">
                                        <h2 class="text-xs sm:text-sm font-black text-slate-900 dark:text-white uppercase tracking-wide leading-tight truncate font-outfit"><%= product.name %></h2>
                                        <span class="text-[9px] font-black bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 px-2 py-0.5 rounded-lg whitespace-nowrap flex-shrink-0 font-mono-code"><%= product.pv %> PV</span>
                                    </div>
                                    <p class="text-[11px] font-bold text-slate-900 dark:text-slate-100 mt-1">Amount: <span class="text-emerald-600 dark:text-emerald-400 font-mono-code font-black">₹<%= product.amount %></span></p>
                                    <p class="text-slate-400 dark:text-slate-500 text-[11px] line-clamp-2 mt-1.5 font-medium break-words leading-relaxed"><%= product.info %></p>
                                </div>

                                <div class="flex items-center justify-end gap-3 pt-2 border-t border-slate-100 dark:border-slate-800">
                                    <button type="button" 
                                            class="edit-product-btn text-amber-500 hover:text-amber-600 dark:text-amber-400 text-[10px] sm:text-[11px] font-black uppercase tracking-wider flex items-center gap-1 cursor-pointer transition-colors"
                                            data-id="<%= product.id %>"
                                            data-name="<%= product.name %>"
                                            data-amount="<%= product.amount %>"
                                            data-pv="<%= product.pv %>"
                                            data-info="<%= product.info %>"
                                            data-benefits="<%= product.benefits %>"
                                            data-how-to-use="<%= product.how_to_use %>"
                                            data-all-images='<%= JSON.stringify(product.all_images || [product.image_url]) %>'>
                                        <i class="fa-solid fa-pen-to-square"></i> Edit Specs & Pics
                                    </button>
                                    <button type="button" 
                                            class="delete-product-btn text-rose-500 hover:text-rose-600 dark:text-rose-400 text-[10px] sm:text-[11px] font-black uppercase tracking-wider flex items-center gap-1 cursor-pointer transition-colors"
                                            data-id="<%= product.id %>">
                                        <i class="fa-solid fa-trash-can"></i> Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </main>

        <footer class="bg-white dark:bg-[#0d1322] border-t border-slate-200/80 dark:border-slate-800 py-3.5 text-center text-xs font-medium text-slate-400 dark:text-slate-500 mt-8 w-full overflow-hidden">
            &copy; 2026 Avira Control Center. Secure Asset Workspace.
        </footer>
    </div>

    <!-- Edit Product Modal Dialog -->
    <div id="editModal" class="hidden fixed inset-0 bg-slate-950/50 backdrop-blur-sm z-50 flex items-center justify-center p-3 sm:p-4">
        <div class="bg-white dark:bg-[#111827] rounded-3xl w-full max-w-xl max-h-[90vh] overflow-y-auto p-4 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4 sm:space-y-5 box-border">
            <div class="flex justify-between items-center border-b pb-3 border-slate-100 dark:border-slate-800">
                <h3 class="text-xs sm:text-sm font-black uppercase text-slate-900 dark:text-white font-outfit tracking-wide flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-emerald-500"></i> Edit Product Specs
                </h3>
                <button type="button" onclick="closeEditModal()" class="text-slate-400 hover:text-white cursor-pointer"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>

            <form id="editProductForm" enctype="multipart/form-data" class="space-y-4 text-xs font-bold">
                <input type="hidden" id="editProductId" name="id">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                    <div>
                        <label class="block text-[10px] font-black uppercase text-slate-500 dark:text-slate-400 mb-1 tracking-wider">Product Title Name</label>
                        <input type="text" id="editName" name="name" required class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 uppercase font-bold transition-all">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[10px] font-black uppercase text-slate-500 dark:text-slate-400 mb-1 tracking-wider">Price (₹)</label>
                            <input type="number" step="0.01" id="editAmount" name="amount" required class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 font-mono-code font-bold transition-all">
                        </div>
                        <div>
                            <label class="block text-[10px] font-black uppercase text-slate-500 dark:text-slate-400 mb-1 tracking-wider">PV Matrix</label>
                            <input type="number" id="editPv" name="pv" required class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 font-mono-code font-bold transition-all">
                        </div>
                    </div>
                </div>

                <div class="bg-slate-50 dark:bg-slate-900/80 p-3.5 sm:p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 space-y-2">
                    <label class="block text-[10px] font-black uppercase text-slate-400 dark:text-slate-500 tracking-wider">Current Gallery Images (Click ❌ to Delete)</label>
                    <div id="currentImagesContainer" class="flex flex-wrap gap-2.5 sm:gap-3"></div>
                </div>

                <div>
                    <label class="block text-[10px] font-black uppercase mb-1 text-slate-500 dark:text-slate-400 tracking-wider">Add More Showcase Images</label>
                    <input type="file" id="editImageInput" accept="image/*" multiple 
                           class="w-full text-[10px] text-slate-500 dark:text-slate-400 file:mr-2 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-[10px] file:font-black file:bg-emerald-50 dark:file:bg-emerald-950 file:text-emerald-700 dark:file:text-emerald-300 hover:file:bg-emerald-100 cursor-pointer">
                </div>

                <div id="newImagesPreviewWrapper" class="hidden flex-col gap-2 bg-emerald-50/40 dark:bg-emerald-950/20 p-3 rounded-2xl border border-emerald-100/70 dark:border-emerald-900 shadow-inner">
                    <span class="text-[10px] font-black uppercase text-emerald-700 dark:text-emerald-400 tracking-wider flex items-center gap-1.5">
                        <i class="fa-solid fa-images"></i> New Images to Add Preview:
                    </span>
                    <div id="newImagesPreviewContainer" class="flex flex-wrap gap-2.5 sm:gap-3"></div>
                </div>

                <div>
                    <label class="block text-[10px] font-black uppercase text-slate-500 dark:text-slate-400 mb-1 tracking-wider">Product Description</label>
                    <textarea id="editInfo" name="info" rows="2" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-emerald-500 text-slate-700 dark:text-slate-300 font-medium leading-relaxed"></textarea>
                </div>

                <div>
                    <label class="block text-[10px] font-black uppercase text-slate-500 dark:text-slate-400 mb-1 tracking-wider">Product Benefits Matrix</label>
                    <textarea id="editBenefits" name="benefits" rows="2" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-emerald-500 text-slate-700 dark:text-slate-300 font-medium leading-relaxed"></textarea>
                </div>

                <div>
                    <label class="block text-[10px] font-black uppercase text-slate-500 dark:text-slate-400 mb-1 tracking-wider">Usage Instructions</label>
                    <textarea id="editHowToUse" name="how_to_use" rows="2" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-emerald-500 text-slate-700 dark:text-slate-300 font-medium leading-relaxed"></textarea>
                </div>

                <div class="flex justify-end gap-2.5 sm:gap-3 border-t pt-4 border-slate-100 dark:border-slate-800">
                    <button type="button" onclick="closeEditModal()" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-xl text-slate-600 dark:text-slate-300 transition-all uppercase tracking-wider cursor-pointer font-bold">Cancel</button>
                    <button type="submit" id="saveBtn" class="px-5 py-2 btn-emerald-3d text-white rounded-xl transition-all shadow-md uppercase tracking-wider cursor-pointer font-black font-outfit">Save Changes &rarr;</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let newSelectedFiles = [];

        document.querySelectorAll('.edit-product-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('editProductId').value = this.getAttribute('data-id');
                document.getElementById('editName').value = this.getAttribute('data-name') || '';
                document.getElementById('editAmount').value = this.getAttribute('data-amount') || '';
                document.getElementById('editPv').value = this.getAttribute('data-pv') || '';
                document.getElementById('editInfo').value = this.getAttribute('data-info') || '';
                document.getElementById('editBenefits').value = this.getAttribute('data-benefits') || '';
                document.getElementById('editHowToUse').value = this.getAttribute('data-how-to-use') || '';
                
                const currentImgContainer = document.getElementById('currentImagesContainer');
                currentImgContainer.innerHTML = '';
                
                let allImages = [];
                try {
                    const rawImages = this.getAttribute('data-all-images');
                    allImages = JSON.parse(rawImages);
                    if(!Array.isArray(allImages)) allImages = [allImages];
                } catch(e) {
                    allImages = [];
                }

                allImages.forEach(imgUrl => {
                    if(imgUrl) {
                        const div = document.createElement('div');
                        div.className = "h-12 w-12 sm:h-14 sm:w-14 rounded-xl bg-white dark:bg-slate-800 p-1 border border-slate-200 dark:border-slate-700 flex-shrink-0 overflow-hidden shadow-xs flex items-center justify-center relative";
                        div.innerHTML = `
                            <img src="${imgUrl}" class="h-full w-full object-contain">
                            <input type="hidden" name="existingImages[]" value="${imgUrl}">
                            <button type="button" onclick="this.parentElement.remove()" class="absolute -top-1 -right-1 bg-rose-500 hover:bg-rose-600 text-white text-[8px] h-4 w-4 rounded-full flex items-center justify-center transition-all shadow-sm focus:outline-none cursor-pointer">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        `;
                        currentImgContainer.appendChild(div);
                    }
                });

                newSelectedFiles = [];
                renderNewPreviews();
                document.getElementById('editModal').classList.remove('hidden');
            });
        });

        document.getElementById('editImageInput').addEventListener('change', function() {
            Array.from(this.files).forEach(file => {
                newSelectedFiles.push(file);
            });
            this.value = '';
            renderNewPreviews();
        });

        function renderNewPreviews() {
            const wrapper = document.getElementById('newImagesPreviewWrapper');
            const container = document.getElementById('newImagesPreviewContainer');
            container.innerHTML = '';

            if (newSelectedFiles.length > 0) {
                wrapper.classList.remove('hidden');
                wrapper.classList.add('flex');

                newSelectedFiles.forEach((file, index) => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const div = document.createElement('div');
                        div.className = "h-12 w-12 sm:h-14 sm:w-14 rounded-xl bg-white dark:bg-slate-800 p-1 border border-emerald-200 dark:border-emerald-800 flex-shrink-0 overflow-hidden shadow-xs flex items-center justify-center relative";
                        div.innerHTML = `
                            <img src="${e.target.result}" class="h-full w-full object-contain">
                            <button type="button" onclick="removeNewImage(${index})" class="absolute -top-1 -right-1 bg-rose-500 hover:bg-rose-600 text-white text-[8px] h-4 w-4 rounded-full flex items-center justify-center transition-all shadow-sm focus:outline-none cursor-pointer">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        `;
                        container.appendChild(div);
                    }
                    reader.readAsDataURL(file);
                });
            } else {
                wrapper.classList.add('hidden');
            }
        }

        window.removeNewImage = function(index) {
            newSelectedFiles.splice(index, 1);
            renderNewPreviews();
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
            document.getElementById('editProductForm').reset();
            newSelectedFiles = [];
            renderNewPreviews();
        }

        document.getElementById('editProductForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('editProductId').value;
            const submitBtn = document.getElementById('saveBtn');
            
            const formData = new FormData(this);
            
            newSelectedFiles.forEach(file => {
                formData.append('productImages', file);
            });

            submitBtn.innerText = "Updating...";
            submitBtn.disabled = true;

            try {
                const res = await fetch(`/admin/api/update-product/${id}`, {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                
                if(res.ok && data.success) {
                    alert(data.msg || "Product updated successfully!");
                    location.reload();
                } else {
                    alert("Error: " + (data.msg || "Failed to update product"));
                    submitBtn.innerText = "Save Changes →";
                    submitBtn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert("Server connection problem occurred.");
                submitBtn.innerText = "Save Changes →";
                submitBtn.disabled = false;
            }
        });

        document.querySelectorAll('.delete-product-btn').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.getAttribute('data-id');
                if(confirm("Are you sure you want to delete this product from the database permanently?")) {
                    try {
                        const res = await fetch(`/admin/api/delete-product/${id}`, { method: 'DELETE' });
                        const data = await res.json();
                        if(data.success) {
                            alert(data.msg || "Product deleted!");
                            const el = document.getElementById(`product-card-${id}`);
                            if(el) el.remove();
                        } else {
                            alert("Error: " + data.msg);
                        }
                    } catch (err) {
                        console.error(err);
                        alert("Server error occurred while deleting.");
                    }
                }
            });
        });
    </script>
</body>
</html>
