    <!-- 🔔 FLOATING TOAST NOTIFICATION -->
    <div id="toastNotification" class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-300 bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3 border border-slate-800 dark:border-slate-200 text-xs font-black">
        <i class="fa-solid fa-circle-check text-emerald-400 dark:text-emerald-600 text-base" id="toastIcon"></i>
        <span id="toastMessage">Tracking IDs Copied!</span>
    </div>

    <!-- 📦 Raw Consignments Safe Data Carrier (Eliminates IDE Linter Syntax Errors) -->
    <script id="consignmentsDataCarrier" type="application/json"><%- JSON.stringify(consignments || []) %></script>

    <script>
        // 📦 Master State & Pagination Config
        let livePageSize = 50;
        let currentPage = 1;
        let currentLiveSortCol = 'seq';
        let currentLiveSortDir = 'asc';
        let rawConsignments = [];
        try {
            const dataElem = document.getElementById('consignmentsDataCarrier');
            rawConsignments = dataElem ? JSON.parse(dataElem.textContent || '[]') : [];
        } catch(e) {
            console.error('Error parsing consignments JSON:', e);
            rawConsignments = [];
        }

        let allConsignments = [...rawConsignments];
        let currentFilter = 'ALL';
        let searchQuery = '';
        let filteredConsignments = [...allConsignments];

        // 🔢 Page Size Selector (10, 25, 50, 100, ALL)
        function setLivePageSize(size) {
            livePageSize = size;
            currentPage = 1;

            ['10', '25', '50', '100', 'ALL'].forEach(s => {
                const btn = document.getElementById(`livePageSize-${s}`);
                if (btn) {
                    if (s == size) {
                        btn.className = 'live-size-btn px-2.5 py-1 text-[11px] font-black rounded-lg transition-all bg-white dark:bg-slate-800 text-blue-600 dark:text-blue-400 shadow-xs cursor-pointer';
                    } else {
                        btn.className = 'live-size-btn px-2.5 py-1 text-[11px] font-black rounded-lg transition-all text-slate-600 dark:text-slate-400 hover:text-blue-600 cursor-pointer';
                    }
                }
            });

            renderPaginatedTable();
        }

        // 🔀 Column Sorting (seq, name, tracking, destination, status, booked_date, delivery_date)
        function sortLiveTrackingBy(col) {
            if (currentLiveSortCol === col) {
                currentLiveSortDir = currentLiveSortDir === 'asc' ? 'desc' : 'asc';
            } else {
                currentLiveSortCol = col;
                currentLiveSortDir = 'asc';
            }

            ['seq', 'name', 'tracking', 'destination', 'status', 'booked_date', 'delivery_date'].forEach(c => {
                const icon = document.getElementById(`liveSortIcon-${c}`);
                if (icon) {
                    if (c === col) {
                        icon.className = currentLiveSortDir === 'asc'
                            ? 'fa-solid fa-sort-up text-[10px] text-blue-600'
                            : 'fa-solid fa-sort-down text-[10px] text-blue-600';
                    } else {
                        icon.className = 'fa-solid fa-sort text-[10px] text-slate-300';
                    }
                }
            });

            applyFilterAndSearch();
        }

        // 🔍 Search & Filter Engine
        function handleSearch() {
            searchQuery = (document.getElementById('liveSearchInput').value || '').toLowerCase().trim();
            applyFilterAndSearch();
        }

        function setFilter(status) {
            currentFilter = status;

            // Highlight Active Filter Button
            ['ALL', 'Delivered', 'In Transit', 'Item Dispatched'].forEach(s => {
                const btn = document.getElementById(`filter-${s}`);
                if (btn) {
                    if (s === status) {
                        btn.className = 'px-3 py-1.5 rounded-lg transition-all bg-white dark:bg-slate-800 text-blue-600 dark:text-blue-400 shadow-xs cursor-pointer';
                    } else {
                        btn.className = 'px-3 py-1.5 rounded-lg transition-all text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 cursor-pointer';
                    }
                }
            });

            applyFilterAndSearch();
        }

        function applyFilterAndSearch() {
            filteredConsignments = allConsignments.filter(item => {
                // Status Filter
                let matchesStatus = true;
                const itemStatus = (item.delivery_status || 'Pending').toLowerCase();
                if (currentFilter === 'Delivered') matchesStatus = itemStatus.includes('delivered');
                else if (currentFilter === 'In Transit') matchesStatus = itemStatus.includes('transit');
                else if (currentFilter === 'Item Dispatched') matchesStatus = itemStatus.includes('dispatch');

                if (!matchesStatus) return false;

                // Search Filter
                if (!searchQuery) return true;
                const mId = (item.member_id || '').toLowerCase();
                const mName = (item.name || '').toLowerCase();
                const mTrack = (item.tracking || '').toLowerCase();
                const mDest = (item.destination || item.city || '').toLowerCase();

                return mId.includes(searchQuery) || mName.includes(searchQuery) || mTrack.includes(searchQuery) || mDest.includes(searchQuery);
            });

            // Column Sorting
            filteredConsignments.sort((a, b) => {
                let valA, valB;
                if (currentLiveSortCol === 'seq') {
                    valA = a.id || 0;
                    valB = b.id || 0;
                } else if (currentLiveSortCol === 'booked_date') {
                    valA = new Date(a.booked_date || a.order_date || 0).getTime() || 0;
                    valB = new Date(b.booked_date || b.order_date || 0).getTime() || 0;
                } else if (currentLiveSortCol === 'delivery_date') {
                    valA = new Date(a.delivery_date || 0).getTime() || 0;
                    valB = new Date(b.delivery_date || 0).getTime() || 0;
                } else if (currentLiveSortCol === 'status') {
                    valA = (a.delivery_status || '').toLowerCase();
                    valB = (b.delivery_status || '').toLowerCase();
                } else {
                    valA = (a[currentLiveSortCol] || '').toString().toLowerCase();
                    valB = (b[currentLiveSortCol] || '').toString().toLowerCase();
                }

                if (valA < valB) return currentLiveSortDir === 'asc' ? -1 : 1;
                if (valA > valB) return currentLiveSortDir === 'asc' ? 1 : -1;
                return 0;
            });

            currentPage = 1;
            renderPaginatedTable();
        }

        // 🔄 Render Paginated Table (Variable Page Size: 10, 25, 50, 100, ALL)
        function renderPaginatedTable() {
            const tbody = document.getElementById('consignmentsTableBody');
            const total = filteredConsignments.length;
            const effectivePageSize = livePageSize === 'ALL' ? (total || 1) : parseInt(livePageSize, 10);
            const totalPages = Math.ceil(total / effectivePageSize) || 1;

            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const startIndex = (currentPage - 1) * effectivePageSize;
            const endIndex = Math.min(startIndex + effectivePageSize, total);
            const pageItems = filteredConsignments.slice(startIndex, endIndex);

            if (pageItems.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="8" class="text-center py-12 text-slate-400 dark:text-slate-500 font-bold">
                            <i class="fa-solid fa-box-open text-3xl mb-2 block opacity-40"></i>
                            No consignments found matching your filter.
                        </td>
                    </tr>
                `;
            } else {
                tbody.innerHTML = pageItems.map((item, idx) => {
                    const rowNum = startIndex + idx + 1;
                    const trackingNo = item.tracking ? item.tracking.trim() : '-';
                    const memberId = item.member_id ? item.member_id.trim() : '-';
                    const name = item.name ? item.name.trim() : '-';
                    const destination = item.destination ? item.destination.trim() : (item.city || '-');
                    const bookedDate = item.booked_date || item.order_date || '-';
                    const deliveryDate = item.delivery_date || '-';
                    const status = (item.delivery_status || 'Pending').trim();

                    // Status Badge Logic
                    let badgeClass = 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-700';
                    let pulseDot = '';
                    if (status.toLowerCase().includes('delivered')) {
                        badgeClass = 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800';
                        pulseDot = '<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 inline-block mr-1"></span>';
                    } else if (status.toLowerCase().includes('transit')) {
                        badgeClass = 'bg-cyan-50 text-cyan-700 dark:bg-cyan-950/60 dark:text-cyan-300 border-cyan-300 dark:border-cyan-800';
                        pulseDot = '<span class="h-1.5 w-1.5 rounded-full bg-cyan-500 animate-pulse inline-block mr-1"></span>';
                    } else if (status.toLowerCase().includes('dispatch')) {
                        badgeClass = 'bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border-amber-300 dark:border-amber-800';
                        pulseDot = '<span class="h-1.5 w-1.5 rounded-full bg-amber-500 inline-block mr-1"></span>';
                    }

                    return `
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                            <td class="py-3 px-4 text-center font-bold text-slate-400 text-[11px]">${rowNum}</td>
                            <td class="py-3 px-4">
                                <span class="font-extrabold text-slate-900 dark:text-slate-100 block text-xs">${name}</span>
                                <span class="font-bold text-blue-600 dark:text-blue-400 text-[10px] uppercase font-mono">${memberId}</span>
                            </td>
                            <td class="py-3 px-4">
                                <div class="flex items-center gap-1.5 font-mono font-bold text-slate-800 dark:text-slate-200">
                                    <span>${trackingNo}</span>
                                    <button type="button" onclick="copyToClipboard('${trackingNo}')" class="text-slate-400 hover:text-blue-500 transition-colors cursor-pointer" title="Copy Article Number">
                                        <i class="fa-regular fa-copy text-[11px]"></i>
                                    </button>
                                </div>
                            </td>
                            <td class="py-3 px-4 font-bold text-slate-600 dark:text-slate-300">
                                <i class="fa-solid fa-location-dot text-[10px] text-rose-500 mr-1"></i>
                                ${destination}
                            </td>
                            <td class="py-3 px-4">
                                <span class="px-2.5 py-1 rounded-lg text-[10px] font-extrabold border ${badgeClass} inline-flex items-center">
                                    ${pulseDot} ${status}
                                </span>
                            </td>
                            <td class="py-3 px-4 font-bold text-slate-500 dark:text-slate-400 text-[11px]">${bookedDate}</td>
                            <td class="py-3 px-4 font-bold text-emerald-600 dark:text-emerald-400 text-[11px]">${deliveryDate}</td>
                            <td class="py-3 px-4 text-center">
                                <a href="https://app.indiapost.gov.in/customer-selfservice/track" target="_blank" class="p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-blue-950/50 dark:hover:text-blue-400 transition-all inline-block" title="Track on India Post">
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                </a>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            // Update Pagination Numbers & Info Text
            document.getElementById('paginationInfo').innerText = total === 0 
                ? 'Showing 0 to 0 of 0 consignments'
                : `Showing ${startIndex + 1} to ${endIndex} of ${total} consignments (Page ${currentPage} of ${totalPages})`;

            renderPaginationControls(totalPages);
        }

        // 🎛️ Render Pagination Buttons
        function renderPaginationControls(totalPages) {
            const container = document.getElementById('paginationControls');
            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }

            let html = `
                <button type="button" onclick="goToPage(1)" ${currentPage === 1 ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
                    <i class="fa-solid fa-angles-left text-[10px]"></i>
                </button>
                <button type="button" onclick="goToPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
                    <i class="fa-solid fa-chevron-left text-[10px]"></i>
                </button>
            `;

            let startP = Math.max(1, currentPage - 2);
            let endP = Math.min(totalPages, currentPage + 2);

            for (let p = startP; p <= endP; p++) {
                if (p === currentPage) {
                    html += `<button type="button" class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-xs font-black shadow-xs">${p}</button>`;
                } else {
                    html += `<button type="button" onclick="goToPage(${p})" class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 cursor-pointer">${p}</button>`;
                }
            }

            html += `
                <button type="button" onclick="goToPage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
                    <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </button>
                <button type="button" onclick="goToPage(${totalPages})" ${currentPage === totalPages ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
                    <i class="fa-solid fa-angles-right text-[10px]"></i>
                </button>
            `;

            container.innerHTML = html;
        }

        function goToPage(p) {
            currentPage = p;
            renderPaginatedTable();
            window.scrollTo({ top: 300, behavior: 'smooth' });
        }

        // 🔔 Floating Toast Notification Utility
        function showToast(msg, isSuccess = true) {
            const toast = document.getElementById('toastNotification');
            const msgEl = document.getElementById('toastMessage');
            const iconEl = document.getElementById('toastIcon');
            if (!toast || !msgEl) return;

            msgEl.innerText = msg;
            if (isSuccess) {
                iconEl.className = 'fa-solid fa-circle-check text-emerald-400 dark:text-emerald-600 text-base';
            } else {
                iconEl.className = 'fa-solid fa-triangle-exclamation text-amber-400 text-base';
            }

            toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
            }, 2800);
        }

        // 📋 Copy Single Tracking Number Utility
        function copyToClipboard(text) {
            if (!text || text === '-') return;
            navigator.clipboard.writeText(text).then(() => {
                showToast('Copied: ' + text);
            }).catch(() => {});
        }

        // =========================================================================
        // 📋 BULK TRACKING ID COPY MODAL LOGIC
        // =========================================================================
        let copyFilterType = 'active'; // 'active' or 'all'
        let copyFormatType = 'line';   // 'line' or 'comma'

        function getFilteredTrackingList() {
            const list = [];
            allConsignments.forEach(item => {
                const trk = (item.tracking || '').trim().toUpperCase();
                if (!trk || trk === 'PENDING' || trk === 'SHOP PICKUP' || trk === '-') return;

                if (copyFilterType === 'active') {
                    const st = (item.delivery_status || '').toLowerCase();
                    if (!st.includes('delivered') && !st.includes('pickup')) {
                        list.push(trk);
                    }
                } else {
                    list.push(trk);
                }
            });
            return [...new Set(list)];
        }

        function updateCopyPreview() {
            const list = getFilteredTrackingList();
            const textarea = document.getElementById('copyTrackingTextarea');
            const countBadge = document.getElementById('previewCountBadge');

            if (textarea) {
                if (copyFormatType === 'line') {
                    textarea.value = list.join('\n');
                } else {
                    textarea.value = list.join(', ');
                }
            }
            if (countBadge) {
                countBadge.innerText = `${list.length} IDs loaded`;
            }
        }

        function setCopyFilter(type) {
            copyFilterType = type;
            const btnActive = document.getElementById('btnFilterActiveOnly');
            const btnAll = document.getElementById('btnFilterAll');

            if (btnActive && btnAll) {
                if (type === 'active') {
                    btnActive.className = 'flex-1 py-1.5 px-2 rounded-xl font-extrabold text-[11px] transition-all bg-emerald-600 text-white shadow-xs cursor-pointer';
                    btnAll.className = 'flex-1 py-1.5 px-2 rounded-xl font-extrabold text-[11px] transition-all bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer';
                } else {
                    btnAll.className = 'flex-1 py-1.5 px-2 rounded-xl font-extrabold text-[11px] transition-all bg-emerald-600 text-white shadow-xs cursor-pointer';
                    btnActive.className = 'flex-1 py-1.5 px-2 rounded-xl font-extrabold text-[11px] transition-all bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer';
                }
            }
            updateCopyPreview();
        }

        function setCopyFormat(fmt) {
            copyFormatType = fmt;
            const btnLine = document.getElementById('btnFormatLine');
            const btnComma = document.getElementById('btnFormatComma');

            if (btnLine && btnComma) {
                if (fmt === 'line') {
                    btnLine.className = 'flex-1 py-1.5 px-2 rounded-xl font-extrabold text-[11px] transition-all bg-blue-600 text-white shadow-xs cursor-pointer';
                    btnComma.className = 'flex-1 py-1.5 px-2 rounded-xl font-extrabold text-[11px] transition-all bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer';
                } else {
                    btnComma.className = 'flex-1 py-1.5 px-2 rounded-xl font-extrabold text-[11px] transition-all bg-blue-600 text-white shadow-xs cursor-pointer';
                    btnLine.className = 'flex-1 py-1.5 px-2 rounded-xl font-extrabold text-[11px] transition-all bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer';
                }
            }
            updateCopyPreview();
        }

        function openCopyModal() {
            const modal = document.getElementById('copyTrackingModal');
            const content = document.getElementById('copyModalContent');
            updateCopyPreview();
            if (modal && content) {
                modal.classList.remove('opacity-0', 'pointer-events-none');
                content.classList.remove('scale-95');
            }
        }

        function closeCopyModal() {
            const modal = document.getElementById('copyTrackingModal');
            const content = document.getElementById('copyModalContent');
            if (modal && content) {
                content.classList.add('scale-95');
                modal.classList.add('opacity-0', 'pointer-events-none');
            }
        }

        function executeCopyTracking() {
            const textarea = document.getElementById('copyTrackingTextarea');
            const text = textarea ? textarea.value : '';
            if (!text) {
                showToast('No tracking numbers available to copy', false);
                return;
            }

            const count = getFilteredTrackingList().length;
            navigator.clipboard.writeText(text).then(() => {
                const btnText = document.getElementById('modalCopyText');
                const btnIcon = document.getElementById('modalCopyIcon');
                if (btnText && btnIcon) {
                    btnText.innerText = 'Copied to Clipboard!';
                    btnIcon.className = 'fa-solid fa-check text-sm';
                    setTimeout(() => {
                        btnText.innerText = 'Copy to Clipboard';
                        btnIcon.className = 'fa-regular fa-copy text-sm';
                    }, 2000);
                }
                showToast(`Copied ${count} Tracking IDs to clipboard!`);
            }).catch(err => {
                console.error('Clipboard copy error:', err);
                showToast('Failed to copy. Please manually select and copy text.', false);
            });
        }

        function copyInTransitOnlyQuick() {
            copyFilterType = 'active';
            copyFormatType = 'line';
            const list = getFilteredTrackingList();
            if (!list.length) {
                showToast('No active tracking IDs found to copy', false);
                return;
            }
            navigator.clipboard.writeText(list.join('\n')).then(() => {
                showToast(`Copied ${list.length} Active Tracking IDs (Line-by-Line)!`);
            }).catch(() => {
                openCopyModal();
            });
        }

        // =========================================================================
        // 📤 UPLOAD TRACKING EXCEL / CSV LOGIC
        // =========================================================================
        let selectedTrackingFile = null;

        function openUploadModal() {
            const modal = document.getElementById('uploadTrackingModal');
            const content = document.getElementById('uploadModalContent');
            const resultBox = document.getElementById('uploadResultBox');
            if (resultBox) resultBox.classList.add('hidden');
            clearSelectedFile();
            if (modal && content) {
                modal.classList.remove('opacity-0', 'pointer-events-none');
                content.classList.remove('scale-95');
            }
        }

        function closeUploadModal() {
            const modal = document.getElementById('uploadTrackingModal');
            const content = document.getElementById('uploadModalContent');
            if (modal && content) {
                content.classList.add('scale-95');
                modal.classList.add('opacity-0', 'pointer-events-none');
            }
        }

        function handleFileSelected(input) {
            if (input.files && input.files[0]) {
                setSelectedFile(input.files[0]);
            }
        }

        function setSelectedFile(file) {
            selectedTrackingFile = file;
            const nameEl = document.getElementById('selectedFileName');
            const sizeEl = document.getElementById('selectedFileSize');
            const infoCard = document.getElementById('selectedFileInfo');
            const btnSubmit = document.getElementById('btnSubmitUpload');

            if (nameEl) nameEl.innerText = file.name;
            if (sizeEl) sizeEl.innerText = (file.size / 1024).toFixed(1) + ' KB';

            if (infoCard) {
                infoCard.classList.remove('hidden');
                infoCard.classList.add('flex');
            }
            if (btnSubmit) btnSubmit.disabled = false;
        }

        function clearSelectedFile(e) {
            if (e) e.stopPropagation();
            selectedTrackingFile = null;
            const input = document.getElementById('trackingFileInput');
            if (input) input.value = '';
            const infoCard = document.getElementById('selectedFileInfo');
            if (infoCard) {
                infoCard.classList.add('hidden');
                infoCard.classList.remove('flex');
            }
            const btnSubmit = document.getElementById('btnSubmitUpload');
            if (btnSubmit) btnSubmit.disabled = true;
        }

        // Drag & drop support
        document.addEventListener('DOMContentLoaded', () => {
            const dropZone = document.getElementById('trackingDropZone');
            if (dropZone) {
                ['dragenter', 'dragover'].forEach(eventName => {
                    dropZone.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropZone.classList.add('border-blue-500', 'bg-blue-50/50');
                    }, false);
                });
                ['dragleave', 'drop'].forEach(eventName => {
                    dropZone.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropZone.classList.remove('border-blue-500', 'bg-blue-50/50');
                    }, false);
                });
                dropZone.addEventListener('drop', (e) => {
                    const dt = e.dataTransfer;
                    const files = dt.files;
                    if (files && files.length > 0) {
                        setSelectedFile(files[0]);
                    }
                }, false);
            }
        });

        async function handleTrackingFormSubmit(e) {
            e.preventDefault();
            if (!selectedTrackingFile) {
                showToast('Please select an Excel or CSV file first', false);
                return;
            }

            const btnSubmit = document.getElementById('btnSubmitUpload');
            const btnText = document.getElementById('uploadSubmitText');
            const btnIcon = document.getElementById('uploadSubmitIcon');
            const resultBox = document.getElementById('uploadResultBox');

            if (btnSubmit) btnSubmit.disabled = true;
            if (btnText) btnText.innerText = 'Processing...';
            if (btnIcon) btnIcon.className = 'fa-solid fa-spinner fa-spin';
            if (resultBox) resultBox.classList.add('hidden');

            try {
                const formData = new FormData();
                formData.append('trackingFile', selectedTrackingFile);

                const res = await fetch('/admin/api/upload-tracking-excel', {
                    method: 'POST',
                    body: formData
                });

                const data = await res.json();

                if (data.success) {
                    resultBox.className = 'p-4 rounded-2xl border border-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-200 text-xs space-y-2';
                    let samplesHtml = '';
                    if (data.samples && data.samples.length > 0) {
                        samplesHtml = `
                            <div class="mt-2 pt-2 border-t border-emerald-200 dark:border-emerald-800 text-[11px]">
                                <strong>Sample Updates:</strong>
                                <ul class="list-disc pl-4 space-y-0.5 mt-1 font-mono">
                                    ${data.samples.map(s => `<li>${s.tracking}: <span class="font-bold">${s.status || '-'}</span> (${s.deliveryDate || 'No Date'})</li>`).join('')}
                                </ul>
                            </div>
                        `;
                    }
                    resultBox.innerHTML = `
                        <div class="flex items-center gap-2 font-black text-emerald-700 dark:text-emerald-300">
                            <i class="fa-solid fa-circle-check text-base"></i>
                            <span>${data.msg}</span>
                        </div>
                        <div class="grid grid-cols-3 gap-2 text-center pt-1 font-bold text-[11px]">
                            <div class="bg-white/80 dark:bg-slate-900/80 p-2 rounded-xl">Total: ${data.totalProcessed}</div>
                            <div class="bg-emerald-100/80 dark:bg-emerald-900/80 p-2 rounded-xl text-emerald-700 dark:text-emerald-300">Updated: ${data.updatedCount}</div>
                            <div class="bg-slate-100/80 dark:bg-slate-800/80 p-2 rounded-xl text-slate-500">Skipped: ${data.notFoundCount}</div>
                        </div>
                        ${samplesHtml}
                    `;
                    resultBox.classList.remove('hidden');
                    showToast(`Success! ${data.updatedCount} parcels updated in database.`);

                    setTimeout(() => {
                        window.location.reload();
                    }, 2500);
                } else {
                    resultBox.className = 'p-4 rounded-2xl border border-rose-300 bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-200 text-xs';
                    resultBox.innerHTML = `
                        <div class="flex items-center gap-2 font-black">
                            <i class="fa-solid fa-triangle-exclamation text-base"></i>
                            <span>Upload Failed: ${data.msg || 'Error processing file'}</span>
                        </div>
                    `;
                    resultBox.classList.remove('hidden');
                    showToast(data.msg || 'Upload failed', false);
                }
            } catch (err) {
                console.error('Upload Error:', err);
                resultBox.className = 'p-4 rounded-2xl border border-rose-300 bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-200 text-xs';
                resultBox.innerHTML = `<div class="font-bold">Error: ${err.message}</div>`;
                resultBox.classList.remove('hidden');
                showToast('Network error during upload', false);
            } finally {
                if (btnSubmit) btnSubmit.disabled = false;
                if (btnText) btnText.innerText = 'Upload & Update';
                if (btnIcon) btnIcon.className = 'fa-solid fa-upload';
            }
        }

        // 📊 Export to CSV Utility
        function exportTableToCSV() {
            if (!filteredConsignments.length) return alert('No data to export.');
            let csv = 'Sr No,Member ID,Name,Tracking,Destination,Status,Booked Date,Delivery Date\n';
            filteredConsignments.forEach((row, i) => {
                csv += `"${i+1}","${row.member_id || ''}","${(row.name || '').replace(/"/g, '""')}","${row.tracking || ''}","${row.destination || ''}","${row.delivery_status || 'Pending'}","${row.booked_date || row.order_date || ''}","${row.delivery_date || ''}"\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `Avira_IndiaPost_Tracking_${new Date().toISOString().slice(0,10)}.csv`;
            link.click();
        }

        // ⚡ REAL-TIME INDIA POST SYNC LOGIC
        let activeEventSource = null;

        function triggerLiveIndiaPostSync() {
            const modal = document.getElementById('syncProgressModal');
            const content = document.getElementById('syncModalContent');
            const logBox = document.getElementById('syncLogBox');
            const pBar = document.getElementById('syncProgressBar');
            const pText = document.getElementById('syncPercentText');
            const pTitle = document.getElementById('syncStepTitle');
            const btnClose = document.getElementById('btnFinishSync');

            modal.classList.remove('opacity-0', 'pointer-events-none');
            content.classList.remove('scale-95');
            btnClose.disabled = true;

            pBar.style.width = '5%';
            pText.innerText = '5%';
            pTitle.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Initializing Headless Browser...';
            logBox.innerHTML = '<div class="text-blue-400">🚀 [Bot] Initializing India Post connection...</div>';

            if (activeEventSource) {
                activeEventSource.close();
            }

            activeEventSource = new EventSource('/admin/api/indiapost-live-stream');

            activeEventSource.onmessage = function(event) {
                try {
                    const data = JSON.parse(event.data);
                    
                    if (data.percent !== undefined) {
                        pBar.style.width = `${data.percent}%`;
                        pText.innerText = `${data.percent}%`;
                    }

                    if (data.message) {
                        pTitle.innerHTML = `<i class="fa-solid fa-arrows-rotate fa-spin text-blue-500"></i> ${data.message}`;
                        const logLine = document.createElement('div');
                        logLine.className = 'text-slate-300';
                        logLine.innerText = `➤ ${data.message}`;
                        logBox.appendChild(logLine);
                        logBox.scrollTop = logBox.scrollHeight;
                    }

                    if (data.step === 'complete') {
                        activeEventSource.close();
                        pBar.style.width = '100%';
                        pText.innerText = '100%';
                        pTitle.innerHTML = '<i class="fa-solid fa-circle-check text-emerald-500"></i> ' + (data.message || 'Sync Completed!');
                        btnClose.disabled = false;

                        // Refresh Stats and Reload Table
                        setTimeout(() => {
                            window.location.reload();
                        }, 2500);
                    } else if (data.step === 'error') {
                        activeEventSource.close();
                        pTitle.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-rose-500"></i> Error: ' + data.message;
                        btnClose.disabled = false;
                    }
                } catch(e) {
                    console.error('SSE Error:', e);
                }
            };

            activeEventSource.onerror = function() {
                if (activeEventSource) activeEventSource.close();
                btnClose.disabled = false;
            };
        }

        function closeSyncModal() {
            const modal = document.getElementById('syncProgressModal');
            const content = document.getElementById('syncModalContent');
            if (activeEventSource) {
                activeEventSource.close();
                activeEventSource = null;
            }
            content.classList.add('scale-95');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        // ⏸️ Toggle Scheduler
        let isSchedulerPaused = false;
        async function toggleScheduler() {
            const endpoint = isSchedulerPaused 
                ? '/admin/api/indiapost-resume-scheduler' 
                : '/admin/api/indiapost-pause-scheduler';

            try {
                const res = await fetch(endpoint, { method: 'POST' });
                const data = await res.json();
                isSchedulerPaused = data.isPaused;

                const icon = document.getElementById('schedulerIcon');
                const text = document.getElementById('schedulerText');

                if (isSchedulerPaused) {
                    icon.className = 'fa-solid fa-play text-emerald-400';
                    text.innerText = 'Resume Scheduler';
                } else {
                    icon.className = 'fa-solid fa-pause text-amber-400';
                    text.innerText = 'Pause Scheduler';
                }
            } catch(e) {
                console.error('Scheduler toggle error:', e);
            }
        }

        // Initialize Table on Page Load
        window.addEventListener('DOMContentLoaded', () => {
            renderPaginatedTable();
        });
    </script>

</body>
</html>
