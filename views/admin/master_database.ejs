<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Master Database - Avira Care</title>
</head>
<body class="bg-gradient-to-br from-slate-50 to-emerald-50/30 min-h-screen flex flex-col font-sans antialiased text-slate-800">

    <%- include('../partials/admin_navbar') %>

    <div class="lg:pl-64 flex-grow flex flex-col justify-between min-h-screen box-border">
        
        <header class="bg-white/80 backdrop-blur-md border-b border-slate-100 px-8 py-4 flex justify-between items-center sticky top-0 z-40 shadow-sm">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-database text-emerald-500"></i>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Tracking Manager / Live Database Records</span>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <p class="text-xs font-bold text-slate-800">Avira Admin</p>
                    <p class="text-[9px] font-bold text-emerald-500 uppercase tracking-widest">Active Workspace</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-500 border border-emerald-100 font-bold text-xs">A</div>
            </div>
        </header>

        <main class="flex-grow w-full mx-auto px-4 sm:px-8 py-6 space-y-6">
            
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-md flex items-center gap-3">
                <div class="relative flex-grow">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="dbSearchInput" placeholder="Search by Name, Member ID, or Tracking Number..." 
                           class="w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-emerald-500 text-slate-700">
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-100 shadow-lg overflow-hidden">
                <div class="px-6 py-4 bg-slate-50 border-b border-slate-100 flex justify-between items-center flex-wrap gap-3">
                    <div>
                        <h2 class="text-sm font-bold text-slate-900"><i class="fa-solid fa-table text-emerald-500 mr-1"></i> Permanent Master Database History</h2>
                        <p class="text-[10px] text-slate-400 mt-0.5">Click "Order Date" column header to sort ascending or descending.</p>
                    </div>

                    <div class="flex items-center gap-3">
                        <span id="masterCounter" class="bg-emerald-100 text-emerald-800 text-[11px] font-bold px-3 py-0.5 rounded-full"><%= entries.length %> Records Saved</span>
                        <button id="btnBulkDeleteMaster" type="button" class="hidden bg-rose-600 hover:bg-rose-700 text-white font-black text-xs px-4 py-2 rounded-xl transition-all shadow cursor-pointer uppercase tracking-wider items-center gap-1.5">
                            <i class="fa-solid fa-trash"></i> Delete Selected (<span id="selectedMasterCount">0</span>)
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left border-collapse" id="masterDbTable">
                        <thead>
                            <tr class="bg-slate-100/70 border-b border-slate-100 text-slate-400 font-bold uppercase select-none">
                                <th class="p-4 w-10 text-center select-none">
                                    <input type="checkbox" id="selectAllMasterCheckbox" class="rounded text-emerald-600 focus:ring-emerald-500 h-4 w-4 cursor-pointer">
                                </th>
                                <th class="p-4 w-12">SR</th>
                                <th class="p-4">Member ID</th>
                                <th class="p-4">Full Name</th>
                                <th class="p-4 cursor-pointer hover:text-emerald-600 transition-colors" id="colOrderDate">
                                    Order Date <i class="fa-solid fa-sort ml-1 text-slate-300" id="sortIcon"></i>
                                </th>
                                <th class="p-4">PV Status</th>
                                <th class="p-4">Amount</th>
                                <th class="p-4">Tracking Number</th>
                                <th class="p-4 text-center w-36">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50 font-medium text-slate-700" id="masterTableBody">
                            <% if(entries.length === 0) { %>
                                <tr id="no-records-row">
                                    <td colspan="9" class="py-12 text-center text-slate-400 font-normal">
                                        <i class="fa-solid fa-database text-2xl block mb-2 text-slate-200"></i>
                                        Database is empty! No records found in main_database.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% entries.forEach((item, index) => { %>
                                <tr class="hover:bg-slate-50 transition-colors table-row-item" id="row-master-<%= item.srNo %>">
                                    <td class="p-4 text-center">
                                        <input type="checkbox" value="<%= item.srNo %>" class="master-row-checkbox rounded text-emerald-600 focus:ring-emerald-500 h-4 w-4 cursor-pointer">
                                    </td>
                                    <td class="p-4 font-mono text-slate-400 sr-number-cell"><%= index + 1 %></td>
                                    <td class="p-4 font-bold font-mono text-emerald-700 member-id-cell"><%= item.memberId %></td>
                                    <td class="p-4 uppercase text-slate-800 font-semibold name-cell"><%= item.name %></td>
                                    <td class="p-4 text-slate-500 date-cell" data-raw-date="<%= item.orderDate %>"><%= item.orderDate %></td>
                                    <td class="p-4 font-mono text-slate-600 pv-cell"><%= item.pv %> PV</td>
                                    <td class="p-4 font-bold font-mono text-slate-900 amount-cell">₹<%= item.amount %></td>
                                    <td class="p-4 font-mono font-bold tracking-wide text-slate-800 tracking-cell"><%= item.tracking %></td>
                                    <td class="p-4 text-center space-x-2">
                                        <button type="button" 
                                                data-srno="<%= item.srNo %>"
                                                data-memberid="<%= item.memberId %>"
                                                data-name="<%= item.name %>"
                                                data-orderdate="<%= item.orderDate %>"
                                                data-pv="<%= item.pv %>"
                                                data-amount="<%= item.amount %>"
                                                data-tracking="<%= item.tracking %>"
                                                class="edit-btn text-amber-500 hover:text-amber-700 transition-colors cursor-pointer font-bold">
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </button>
                                        <button type="button" data-srno="<%= item.srNo %>" class="delete-btn text-rose-500 hover:text-rose-700 transition-colors cursor-pointer font-bold">
                                            <i class="fa-solid fa-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <footer class="bg-white border-t border-slate-100 py-4 text-center text-xs font-medium text-slate-400">
            &copy; 2026 Avira Control Center. Secure Master Workspace.
        </footer>
    </div>

    <div id="editMasterModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg border border-slate-100 overflow-hidden">
            <div class="bg-slate-900 px-6 py-4 text-white flex justify-between items-center">
                <h3 class="text-sm font-bold uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-amber-400"></i> Edit Master Database Record
                </h3>
                <button type="button" id="btnCloseModal" class="text-slate-400 hover:text-white font-bold text-lg">&times;</button>
            </div>
            
            <form id="editMasterForm" class="p-6 space-y-4">
                <input type="hidden" id="editSrNo">

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Member ID (AV + 5 Digits)</label>
                        <input type="text" id="editMemberId" required maxlength="7" placeholder="AV12345" oninput="formatMemberIdInput(this)" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono uppercase font-bold text-emerald-700 focus:outline-none focus:border-emerald-500">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Tracking Number</label>
                        <input type="text" id="editTracking" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono uppercase font-bold text-slate-800 focus:outline-none focus:border-emerald-500">
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Full Name</label>
                    <input type="text" id="editName" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold uppercase text-slate-900 focus:outline-none focus:border-emerald-500">
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Order Date</label>
                        <input type="text" id="editOrderDate" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold text-slate-700 focus:outline-none focus:border-emerald-500">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">PV</label>
                        <input type="number" id="editPv" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono font-bold text-slate-700 focus:outline-none focus:border-emerald-500">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Amount (₹)</label>
                        <input type="number" id="editAmount" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono font-bold text-slate-900 focus:outline-none focus:border-emerald-500">
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
                    <button type="button" id="btnCancelModal" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-bold cursor-pointer transition-all">Cancel</button>
                    <button type="submit" id="btnSaveEdit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-black uppercase tracking-wider shadow cursor-pointer transition-all">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function formatMemberIdInput(el) {
            let raw = el.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            if (!raw) {
                el.value = '';
                return;
            }
            if (raw === 'A' || raw === 'AV') {
                el.value = raw;
                return;
            }
            if (raw.startsWith('AV')) {
                let num = raw.slice(2).replace(/[^0-9]/g, '').slice(0, 5);
                el.value = 'AV' + num;
            } else {
                let num = raw.replace(/[^0-9]/g, '').slice(0, 5);
                if (num.length > 0) {
                    el.value = 'AV' + num;
                } else {
                    el.value = '';
                }
            }
        }

        const modal = document.getElementById('editMasterModal');

        function reindexTableSrNumbers() {
            const visibleRows = document.querySelectorAll('.table-row-item');
            let count = 1;
            visibleRows.forEach(row => {
                if (row.style.display !== 'none') {
                    const srCell = row.querySelector('.sr-number-cell');
                    if (srCell) srCell.innerText = count++;
                }
            });
        }

        function updateBulkDeleteMasterButton() {
            const selectedCheckboxes = document.querySelectorAll('.master-row-checkbox:checked');
            const bulkBtn = document.getElementById('btnBulkDeleteMaster');
            const counterSpan = document.getElementById('selectedMasterCount');

            if (selectedCheckboxes.length > 0) {
                if (counterSpan) {
                    counterSpan.innerText = selectedCheckboxes.length;
                } else {
                    bulkBtn.innerHTML = `<i class="fa-solid fa-trash"></i> Delete Selected (<span id="selectedMasterCount">${selectedCheckboxes.length}</span>)`;
                }
                bulkBtn.classList.remove('hidden');
                bulkBtn.classList.add('flex');
            } else {
                bulkBtn.classList.add('hidden');
                bulkBtn.classList.remove('flex');
                const selectAll = document.getElementById('selectAllMasterCheckbox');
                if (selectAll) selectAll.checked = false;
            }
        }

        document.getElementById('selectAllMasterCheckbox').addEventListener('change', function() {
            const isChecked = this.checked;
            document.querySelectorAll('.table-row-item').forEach(row => {
                if (row.style.display !== 'none') {
                    const cb = row.querySelector('.master-row-checkbox');
                    if (cb) cb.checked = isChecked;
                }
            });
            updateBulkDeleteMasterButton();
        });

        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('master-row-checkbox')) {
                updateBulkDeleteMasterButton();
            }
        });

        document.getElementById('btnBulkDeleteMaster').addEventListener('click', async function() {
            const selectedCheckboxes = document.querySelectorAll('.master-row-checkbox:checked');
            const selectedSrNos = Array.from(selectedCheckboxes).map(cb => parseInt(cb.value)).filter(n => !isNaN(n));

            if (selectedSrNos.length === 0) return;

            if (confirm(`Warning! Do you really want to delete all ${selectedSrNos.length} selected records permanently from database?`)) {
                this.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Deleting...`;
                this.disabled = true;

                try {
                    const res = await fetch('/admin/api/delete-multiple-master', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ srNos: selectedSrNos })
                    });
                    const result = await res.json();

                    if (result.success) {
                        location.reload();
                    } else {
                        alert("Error: " + (result.msg || "Bulk deletion failed"));
                    }
                } catch (err) {
                    console.error("Bulk delete master error:", err);
                    alert("Server error during bulk delete.");
                } finally {
                    this.disabled = false;
                    this.innerHTML = `<i class="fa-solid fa-trash"></i> Delete Selected (<span id="selectedMasterCount">0</span>)`;
                    updateBulkDeleteMasterButton();
                }
            }
        });

        document.addEventListener('click', function(e) {
            const editBtn = e.target.closest('.edit-btn');
            if (editBtn) {
                document.getElementById('editSrNo').value = editBtn.getAttribute('data-srno');
                document.getElementById('editMemberId').value = editBtn.getAttribute('data-memberid');
                document.getElementById('editName').value = editBtn.getAttribute('data-name');
                document.getElementById('editOrderDate').value = editBtn.getAttribute('data-orderdate');
                document.getElementById('editPv').value = editBtn.getAttribute('data-pv');
                document.getElementById('editAmount').value = editBtn.getAttribute('data-amount');
                document.getElementById('editTracking').value = editBtn.getAttribute('data-tracking');

                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        });

        document.getElementById('btnCloseModal').addEventListener('click', closeModal);
        document.getElementById('btnCancelModal').addEventListener('click', closeModal);

        function closeModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        document.getElementById('editMasterForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const srNo = document.getElementById('editSrNo').value;
            const btn = document.getElementById('btnSaveEdit');
            
            btn.innerText = "SAVING...";
            btn.disabled = true;

            const payload = {
                memberId: document.getElementById('editMemberId').value,
                name: document.getElementById('editName').value,
                orderDate: document.getElementById('editOrderDate').value,
                pv: document.getElementById('editPv').value,
                amount: document.getElementById('editAmount').value,
                tracking: document.getElementById('editTracking').value
            };

            try {
                const res = await fetch(`/admin/api/update-master/${srNo}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert("Error: " + result.msg);
                }
            } catch (err) {
                console.error(err);
                alert("Server error updating record.");
            } finally {
                btn.innerText = "Save Changes";
                btn.disabled = false;
            }
        });

        document.addEventListener('click', function(e) {
            const delBtn = e.target.closest('.delete-btn');
            if (delBtn) {
                const realSrNo = delBtn.getAttribute('data-srno');
                
                if(confirm("Warning! Do you want to delete this permanent record from database?")) {
                    fetch(`/admin/api/delete-master/${realSrNo}`, { method: 'DELETE' })
                    .then(res => res.json())
                    .then(data => { 
                        if(data.success) { 
                            location.reload(); 
                        } else {
                            alert("Error: " + data.msg);
                        }
                    })
                    .catch(err => console.error(err));
                }
            }
        });

        document.getElementById('dbSearchInput').addEventListener('input', function() {
            const query = this.value.toUpperCase().trim();
            const rows = document.querySelectorAll('.table-row-item');
            let visibleCount = 0;

            rows.forEach(row => {
                const name = row.querySelector('.name-cell').innerText.toUpperCase();
                const memberId = row.querySelector('.member-id-cell').innerText.toUpperCase();
                const tracking = row.querySelector('.tracking-cell').innerText.toUpperCase();

                if (name.includes(query) || memberId.includes(query) || tracking.includes(query)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                    const cb = row.querySelector('.master-row-checkbox');
                    if (cb) cb.checked = false;
                }
            });

            updateBulkDeleteMasterButton();

            const existingNoMatchRow = document.getElementById('no-match-row');
            if (visibleCount === 0) {
                if (!existingNoMatchRow) {
                    const tbody = document.getElementById('masterTableBody');
                    const noMatch = document.createElement('tr');
                    noMatch.id = 'no-match-row';
                    noMatch.innerHTML = `
                        <td colspan="9" class="py-12 text-center text-slate-400 font-normal">
                            <i class="fa-solid fa-magnifying-glass-minus text-2xl block mb-2 text-slate-200"></i>
                            No matching records found for "${query}"
                        </td>
                    `;
                    tbody.appendChild(noMatch);
                }
            } else {
                if (existingNoMatchRow) {
                    existingNoMatchRow.remove();
                }
            }

            reindexTableSrNumbers();
        });

        function parseCustomDate(dateStr) {
            if (!dateStr) return new Date(0);
            const cleanStr = dateStr.replace(/(\d+)(st|nd|rd|th)/, "$1");
            const d = new Date(cleanStr);
            return isNaN(d.getTime()) ? new Date(0) : d;
        }

        let isAscending = true;
        document.getElementById('colOrderDate').addEventListener('click', function() {
            const tbody = document.getElementById('masterTableBody');
            const rows = Array.from(document.querySelectorAll('.table-row-item'));
            const sortIcon = document.getElementById('sortIcon');

            rows.sort((a, b) => {
                const dateAStr = a.querySelector('.date-cell').getAttribute('data-raw-date');
                const dateBStr = b.querySelector('.date-cell').getAttribute('data-raw-date');

                const dateA = parseCustomDate(dateAStr);
                const dateB = parseCustomDate(dateBStr);

                return isAscending ? dateA - dateB : dateB - dateA;
            });

            rows.forEach(row => tbody.appendChild(row));

            if (isAscending) {
                sortIcon.className = "fa-solid fa-sort-up ml-1 text-emerald-500";
            } else {
                sortIcon.className = "fa-solid fa-sort-down ml-1 text-emerald-500";
            }

            isAscending = !isAscending;
            reindexTableSrNumbers();
        });
    </script>
</body>
</html>
