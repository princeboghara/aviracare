<%
    const safeCustomers = (typeof customers !== 'undefined' && Array.isArray(customers)) ? customers : [];
%>
<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Customers & Members Directory - Avira Control Center</title>
    <style>
        body {
            background-color: #f8fafc;
            color: #0f172a;
        }

        .ref-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .ref-card:hover {
            border-color: #cbd5e1;
        }

        .ref-input {
            width: 100%;
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 0.75rem;
            padding-top: 0.625rem;
            padding-bottom: 0.625rem;
            padding-left: 0.875rem;
            padding-right: 0.875rem;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #0f172a;
            transition: all 0.15s ease;
            box-sizing: border-box;
        }
        .ref-input:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .ref-input-icon-left {
            padding-left: 2.75rem !important;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-800 w-full overflow-x-hidden">

    <%- include('../partials/admin_navbar') %>

    <div class="lg:pl-64 flex flex-col min-h-screen w-full min-w-0">
        
        <!-- 🧭 Top Navigation Header -->
        <header class="bg-white border-b border-slate-200 px-4 sm:px-8 py-3 flex justify-between items-center sticky top-0 z-30 w-full">
            <div class="flex items-center gap-3">
                <button type="button" onclick="toggleMobileSidebar()" class="text-slate-500 hover:text-slate-800 p-1.5 rounded-lg lg:hidden cursor-pointer">
                    <i class="fa-solid fa-bars text-sm"></i>
                </button>
                <button type="button" onclick="toggleMobileSidebar()" class="text-slate-400 hover:text-slate-700 hidden lg:inline-flex cursor-pointer p-1">
                    <i class="fa-solid fa-bars-staggered text-sm"></i>
                </button>
            </div>

            <!-- Global Search Pill -->
            <div class="relative w-full max-w-sm sm:max-w-md mx-4">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="customerSearchInput" placeholder="Search members by ID, name, mobile, email..." 
                       class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 placeholder:text-slate-400 placeholder:font-normal focus:outline-none focus:border-blue-500 focus:bg-white transition-all">
            </div>

            <!-- Right Profile & Notification Controls -->
            <div class="flex items-center gap-3.5 flex-shrink-0">
                <button type="button" class="relative p-2 rounded-xl text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-all cursor-pointer" title="Notifications">
                    <i class="fa-regular fa-bell text-sm"></i>
                    <span class="absolute top-1.5 right-1.5 h-2 w-2 rounded-full bg-rose-500 ring-2 ring-white"></span>
                </button>
                
                <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
                    <div class="h-8 w-8 rounded-full bg-[#1e293b] text-white flex items-center justify-center font-bold text-xs shadow-xs">
                        A
                    </div>
                    <span class="text-xs font-bold text-slate-800 hidden sm:inline">Admin</span>
                    <i class="fa-solid fa-chevron-down text-[9px] text-slate-400 hidden sm:inline"></i>
                </div>
            </div>
        </header>

        <main class="flex-grow w-full px-4 sm:px-6 lg:px-8 xl:px-10 py-5 space-y-5 box-border">

            <!-- 👥 Page Header & Live Sync Action -->
            <div class="flex items-center justify-between flex-wrap gap-4">
                <div>
                    <div class="flex items-center gap-2.5">
                        <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center text-lg shadow-2xs">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <div>
                            <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">Customers & Members Directory</h1>
                            <p class="text-xs text-slate-500 font-medium">Auto-synchronized every 30 minutes from Avira Global (<span class="text-blue-600 font-mono">AVGControl/members</span>)</p>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2.5 flex-wrap">
                    <!-- Total Count Badge -->
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-50 border border-blue-200 text-blue-800 text-xs font-bold font-mono">
                        <i class="fa-solid fa-address-book text-blue-600"></i>
                        Total Members: <span id="totalMembersCountDisplay"><%= safeCustomers.length %></span>
                    </span>

                    <!-- Auto-Sync Status Badge -->
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-[11px] font-bold">
                        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        Auto-Sync: Every 30m
                    </span>

                    <!-- Sync Members Now Button -->
                    <button type="button" id="btnSyncMembers" onclick="triggerCustomerSyncNow()"
                            class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-black text-xs uppercase tracking-wider flex items-center gap-2 transition-all shadow-xs cursor-pointer">
                        <i class="fa-solid fa-arrows-rotate text-xs" id="syncIcon"></i>
                        <span id="syncBtnText">SYNC MEMBERS NOW</span>
                    </button>
                </div>
            </div>

            <!-- Sync Notification Banner -->
            <div id="syncAlertBanner" class="hidden p-3 rounded-xl border text-xs font-bold flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span id="syncAlertIcon"><i class="fa-solid fa-circle-check"></i></span>
                    <span id="syncAlertText"></span>
                </div>
                <button type="button" onclick="document.getElementById('syncAlertBanner').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- 📋 Customers Table Card -->
            <div class="ref-card overflow-hidden">
                <div class="px-5 py-4 bg-slate-50/80 border-b border-slate-200 flex justify-between items-center flex-wrap gap-3">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-list text-slate-500 text-xs"></i>
                        <span class="text-xs font-extrabold uppercase text-slate-700 tracking-wider">Member Records</span>
                        <span id="matchingCountBadge" class="text-[10px] font-mono text-slate-400 ml-1">Showing <%= safeCustomers.length %> members</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <button type="button" id="btnToggleShowAll" onclick="toggleShowAllCustomers()" 
                                class="px-3.5 py-1.5 rounded-xl border border-blue-200 bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold text-xs flex items-center gap-1.5 shadow-2xs transition-all cursor-pointer">
                            <i class="fa-solid fa-expand text-blue-600" id="toggleShowAllIcon"></i>
                            <span id="toggleShowAllText">Show All (<%= safeCustomers.length %>)</span>
                        </button>
                        <button type="button" onclick="exportCustomersToCSV()" 
                                class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs flex items-center gap-1.5 shadow-2xs transition-all cursor-pointer">
                            <i class="fa-solid fa-file-csv text-emerald-600"></i>
                            <span>Export CSV</span>
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[700px]">
                        <thead>
                            <tr class="bg-slate-100/70 border-b border-slate-200 text-slate-500 font-extrabold uppercase select-none text-[11px]">
                                <th class="py-3 px-4 w-12 text-center">#</th>
                                <th class="py-3 px-4">Member ID</th>
                                <th class="py-3 px-4">Customer Name</th>
                                <th class="py-3 px-4">Mobile Number</th>
                                <th class="py-3 px-4">Email / Gmail</th>
                                <th class="py-3 px-4 text-center">Quick Action</th>
                            </tr>
                        </thead>
                        <tbody id="customersTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                            <!-- Populated dynamically via JS for high performance; first 25 rendered server-side -->
                            <% 
                                const initialLimit = Math.min(safeCustomers.length, 25);
                                if (safeCustomers && safeCustomers.length > 0) { 
                                    for (let idx = 0; idx < initialLimit; idx++) { 
                                        let c = safeCustomers[idx]; 
                            %>
                                    <tr class="hover:bg-slate-50 transition-colors customer-row">
                                        <td class="py-3 px-4 text-center text-slate-400 font-mono text-[11px]"><%= idx + 1 %></td>
                                        <td class="py-3 px-4 font-mono">
                                            <span class="font-black text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-lg">
                                                <%= c.member_id %>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4">
                                            <div class="font-extrabold text-slate-900 uppercase"><%= c.name || '-' %></div>
                                        </td>
                                        <td class="py-3 px-4 font-mono font-bold text-slate-800">
                                            <%= c.mobile ? c.mobile : '<span class="text-slate-300 font-normal">N/A</span>' %>
                                        </td>
                                        <td class="py-3 px-4 text-slate-600 font-mono text-[11px]">
                                            <%= c.email ? c.email : '<span class="text-slate-300 font-normal">N/A</span>' %>
                                        </td>
                                        <td class="py-3 px-4 text-center">
                                            <button type="button" onclick="copyMemberId('<%= c.member_id %>')" 
                                                    class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-700 font-bold text-[10px] transition-all cursor-pointer shadow-2xs"
                                                    title="Copy Member ID">
                                                <i class="fa-regular fa-copy"></i> Copy ID
                                            </button>
                                        </td>
                                    </tr>
                                <% } %>
                            <% } else { %>
                                <tr id="emptyCustomersRow">
                                    <td colspan="6" class="py-12 text-center text-slate-400 font-normal">
                                        <i class="fa-solid fa-users-slash text-3xl mb-2 text-slate-300 block"></i>
                                        No customer members in database yet. Click "SYNC MEMBERS NOW" to pull the latest directory!
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Footer Summary / Quick Load Bar -->
                <div class="px-5 py-3.5 bg-slate-50/90 border-t border-slate-200 flex justify-between items-center flex-wrap gap-2 text-xs">
                    <span class="text-slate-500 font-medium">
                        Showing <strong id="footerCountDisplay" class="text-slate-800"><%= Math.min(safeCustomers.length, 25) %></strong> of <strong class="text-slate-900"><%= safeCustomers.length %></strong> total members
                    </span>
                    <button type="button" onclick="toggleShowAllCustomers()" class="font-bold text-blue-600 hover:text-blue-800 text-xs cursor-pointer flex items-center gap-1">
                        <span id="footerToggleText"><%= safeCustomers.length > 25 ? 'Show all ' + safeCustomers.length + ' members →' : '' %></span>
                    </button>
                </div>
            </div>

        </main>

        <footer class="bg-white border-t border-slate-200 py-3 text-center text-xs font-semibold text-slate-400 mt-6 w-full">
            &copy; 2026 Avira Care. Encrypted Logistics Administration System.
        </footer>
    </div>

    <!-- Raw Data Carrier -->
    <script id="customersCarrier" type="application/json"><%- JSON.stringify(safeCustomers) %></script>

    <script>
        // Global Customers State
        let allCustomers = [];
        try {
            const raw = document.getElementById('customersCarrier')?.textContent;
            allCustomers = raw ? JSON.parse(raw) : [];
        } catch (e) {
            allCustomers = [];
        }

        let isShowingAll = false;
        const INITIAL_LIMIT = 25;

        // Copy Member ID Helper
        function copyMemberId(id) {
            navigator.clipboard.writeText(id).then(() => {
                alert(`Member ID "${id}" copied to clipboard!`);
            });
        }

        // Render Customers to DOM
        function renderCustomersTable(list, maxLimit = null) {
            const tbody = document.getElementById('customersTableBody');
            const footerCount = document.getElementById('footerCountDisplay');
            const matchingBadge = document.getElementById('matchingCountBadge');
            const total = list.length;
            const items = (maxLimit && total > maxLimit) ? list.slice(0, maxLimit) : list;

            if (footerCount) footerCount.innerText = items.length;
            if (matchingBadge) {
                matchingBadge.innerText = items.length === total 
                    ? `Showing all ${total} members`
                    : `Showing first ${items.length} of ${total} members`;
            }

            if (!items.length) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="py-12 text-center text-slate-400 font-normal">
                            <i class="fa-solid fa-users-slash text-3xl mb-2 text-slate-300 block"></i>
                            No matching customer members found.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = items.map((c, idx) => {
                const mob = c.mobile ? c.mobile : '<span class="text-slate-300 font-normal">N/A</span>';
                const eml = c.email ? c.email : '<span class="text-slate-300 font-normal">N/A</span>';
                return `
                    <tr class="hover:bg-slate-50 transition-colors customer-row">
                        <td class="py-3 px-4 text-center text-slate-400 font-mono text-[11px]">${idx + 1}</td>
                        <td class="py-3 px-4 font-mono">
                            <span class="font-black text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-lg">
                                ${c.member_id || ''}
                            </span>
                        </td>
                        <td class="py-3 px-4">
                            <div class="font-extrabold text-slate-900 uppercase">${c.name || '-'}</div>
                        </td>
                        <td class="py-3 px-4 font-mono font-bold text-slate-800">${mob}</td>
                        <td class="py-3 px-4 text-slate-600 font-mono text-[11px]">${eml}</td>
                        <td class="py-3 px-4 text-center">
                            <button type="button" onclick="copyMemberId('${c.member_id}')" 
                                    class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-blue-700 font-bold text-[10px] transition-all cursor-pointer shadow-2xs"
                                    title="Copy Member ID">
                                <i class="fa-regular fa-copy"></i> Copy ID
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Toggle Show All / Show 25
        function toggleShowAllCustomers() {
            isShowingAll = !isShowingAll;
            const btnText = document.getElementById('toggleShowAllText');
            const btnIcon = document.getElementById('toggleShowAllIcon');
            const footerToggle = document.getElementById('footerToggleText');

            if (isShowingAll) {
                renderCustomersTable(allCustomers, null);
                if (btnText) btnText.innerText = 'Show First 25';
                if (btnIcon) btnIcon.className = 'fa-solid fa-compress text-blue-600';
                if (footerToggle) footerToggle.innerText = '← Show first 25 members';
            } else {
                renderCustomersTable(allCustomers, INITIAL_LIMIT);
                if (btnText) btnText.innerText = `Show All (${allCustomers.length})`;
                if (btnIcon) btnIcon.className = 'fa-solid fa-expand text-blue-600';
                if (footerToggle) footerToggle.innerText = `Show all ${allCustomers.length} members →`;
            }
        }

        // Fast Live Search across ALL customers
        const searchInput = document.getElementById('customerSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const q = this.value.toLowerCase().trim();
                if (!q) {
                    if (isShowingAll) {
                        renderCustomersTable(allCustomers, null);
                    } else {
                        renderCustomersTable(allCustomers, INITIAL_LIMIT);
                    }
                    return;
                }

                const filtered = allCustomers.filter(c => {
                    const mid = (c.member_id || '').toLowerCase();
                    const nm = (c.name || '').toLowerCase();
                    const mob = (c.mobile || '').toLowerCase();
                    const eml = (c.email || '').toLowerCase();
                    return mid.includes(q) || nm.includes(q) || mob.includes(q) || eml.includes(q);
                });

                renderCustomersTable(filtered, null);
            });
        }

        // Trigger Manual Sync
        async function triggerCustomerSyncNow() {
            const btn = document.getElementById('btnSyncMembers');
            const icon = document.getElementById('syncIcon');
            const btnText = document.getElementById('syncBtnText');
            const alertBanner = document.getElementById('syncAlertBanner');
            const alertText = document.getElementById('syncAlertText');
            const alertIcon = document.getElementById('syncAlertIcon');

            btn.disabled = true;
            btn.classList.add('opacity-75', 'cursor-not-allowed');
            icon.classList.add('animate-spin');
            btnText.innerText = 'SYNCING DIRECTORY...';

            try {
                const res = await fetch('/admin/api/sync-customers', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                if (data.success) {
                    alertBanner.className = "p-3 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-900 text-xs font-bold flex items-center justify-between gap-3";
                    alertIcon.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600"></i>`;
                    alertText.innerText = `Sync successful! ${data.syncedCount || 0} members updated from AviraGlobal in ${data.duration || '0s'}.`;
                    alertBanner.classList.remove('hidden');

                    setTimeout(() => {
                        window.location.reload();
                    }, 1200);
                } else {
                    alertBanner.className = "p-3 rounded-xl border border-rose-200 bg-rose-50 text-rose-900 text-xs font-bold flex items-center justify-between gap-3";
                    alertIcon.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-rose-600"></i>`;
                    alertText.innerText = `Sync Failed: ${data.msg || 'Unable to communicate with Avira Global.'}`;
                    alertBanner.classList.remove('hidden');
                }
            } catch (err) {
                console.error("Sync error:", err);
                alert("Error connecting to server. Please try again.");
            } finally {
                btn.disabled = false;
                btn.classList.remove('opacity-75', 'cursor-not-allowed');
                icon.classList.remove('animate-spin');
                btnText.innerText = 'SYNC MEMBERS NOW';
            }
        }

        // Quick CSV Export of currently displayed / filtered members
        function exportCustomersToCSV() {
            const listToExport = (searchInput && searchInput.value.trim()) ? 
                allCustomers.filter(c => {
                    const q = searchInput.value.toLowerCase().trim();
                    return (c.member_id || '').toLowerCase().includes(q) ||
                           (c.name || '').toLowerCase().includes(q) ||
                           (c.mobile || '').toLowerCase().includes(q) ||
                           (c.email || '').toLowerCase().includes(q);
                }) : allCustomers;

            if (!listToExport.length) {
                alert("No members to export.");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,SR,Member ID,Name,Mobile,Email\n";
            listToExport.forEach((c, idx) => {
                const mid = (c.member_id || '').trim();
                const name = (c.name || '').trim().replace(/,/g, ' ');
                const mobile = (c.mobile || '').trim();
                const email = (c.email || '').trim();
                csvContent += `${idx + 1},"${mid}","${name}","${mobile}","${email}"\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Avira_Customers_${new Date().toISOString().slice(0, 10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
