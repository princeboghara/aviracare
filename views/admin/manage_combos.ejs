<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Manage Combo Presets - Avira Control Center</title>
</head>
<body class="bg-slate-50 dark:bg-[#0b0f19] min-h-screen font-sans text-slate-800 dark:text-slate-200 antialiased w-full overflow-x-hidden">

    <%- include('../partials/admin_navbar') %>

    <div class="w-full lg:pl-64 min-h-screen flex flex-col justify-between box-border min-w-0">
        
        <header class="bg-white/80 dark:bg-[#0d1322]/80 backdrop-blur-md border-b border-slate-100 dark:border-slate-800 px-4 sm:px-8 py-3.5 flex justify-between items-center sticky top-0 z-40 shadow-sm w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-layer-group text-emerald-500 flex-shrink-0"></i>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider truncate">Billing / Manage Combo Presets</span>
            </div>
            <div class="flex items-center gap-2.5 flex-shrink-0">
                <a href="/admin/bill-uploader" class="bg-slate-900 dark:bg-slate-800 text-white text-xs font-bold px-3.5 py-2 rounded-xl hover:bg-slate-800 dark:hover:bg-slate-700 transition-all shadow-sm flex items-center gap-2">
                    <i class="fa-solid fa-file-invoice-dollar text-emerald-400"></i>
                    <span>Bill Converter</span>
                </a>
                <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1.5 rounded-xl border border-emerald-200 dark:border-emerald-800"><%= combos.length %> Active Combos</span>
            </div>
        </header>

        <main class="flex-grow w-full px-4 sm:px-6 lg:px-8 xl:px-10 py-5 space-y-6">

            <!-- 📝 ADD / EDIT COMBO PRESET CARD -->
            <div class="bg-white dark:bg-[#111827] p-6 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-md space-y-4">
                <div class="flex justify-between items-center">
                    <h3 id="formHeading" class="text-sm font-black text-slate-900 dark:text-slate-100 uppercase flex items-center gap-2">
                        <i class="fa-solid fa-plus-circle text-emerald-500"></i> Add New Combo Breakup Preset
                    </h3>
                    <button type="button" id="btnCancelEdit" onclick="resetForm()" class="hidden bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-600 text-xs font-bold px-3 py-1.5 rounded-lg uppercase transition-all cursor-pointer">
                        <i class="fa-solid fa-xmark mr-1"></i> Cancel Edit
                    </button>
                </div>
                
                <form id="comboForm" class="space-y-4 text-xs" oninput="calculateLivePreview()">
                    <input type="hidden" id="comboId" value="">

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-50 dark:bg-[#0d1322] p-4 rounded-xl border border-slate-200 dark:border-slate-800">
                        <div class="md:col-span-1">
                            <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1 uppercase">Combo Title (Exact Name in Bill)</label>
                            <input type="text" id="comboName" required placeholder="e.g. Offer Combo 2200/-" class="w-full px-3.5 py-2 bg-white dark:bg-[#111827] border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-100 rounded-lg font-bold uppercase focus:outline-none focus:border-emerald-500">
                        </div>
                        <div>
                            <label class="block font-bold text-amber-600 dark:text-amber-400 mb-1 uppercase">Total Offer Discount (₹) [આખા કોમ્બોનું]</label>
                            <input type="number" step="0.01" id="totalOfferDiscount" placeholder="e.g. 95.00" class="w-full px-3.5 py-2 bg-amber-50 dark:bg-amber-950/30 border border-amber-300 dark:border-amber-800 text-amber-900 dark:text-amber-300 rounded-lg font-black focus:outline-none">
                            <span class="text-[9px] text-slate-400 mt-0.5 block">*બધી પ્રોડક્ટ્સમાં સરખા ભાગે કટ થશે</span>
                        </div>
                        <div>
                            <label class="block font-bold text-purple-600 dark:text-purple-400 mb-1 uppercase">Target Total PV (જેમ કે 500 PV)</label>
                            <input type="number" id="totalOfferPv" placeholder="e.g. 500" class="w-full px-3.5 py-2 bg-purple-50 dark:bg-purple-950/30 border border-purple-300 dark:border-purple-800 text-purple-900 dark:text-purple-300 rounded-lg font-black focus:outline-none">
                            <span class="text-[9px] text-slate-400 mt-0.5 block">*તફાવતના PV (Z = Y - X) Offer PV માં ઉમેરાશે</span>
                        </div>
                    </div>

                    <div class="bg-slate-50 dark:bg-[#0d1322] p-4 rounded-xl border border-slate-200 dark:border-slate-800 space-y-3">
                        <div class="flex justify-between items-center pb-2 border-b border-slate-200 dark:border-slate-800">
                            <span class="font-bold uppercase text-slate-700 dark:text-slate-300">Mapped Products List (Breakup)</span>
                            <button type="button" onclick="addProductRow()" class="bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-black px-4 py-2 rounded-xl uppercase transition-all shadow-sm cursor-pointer">
                                <i class="fa-solid fa-plus mr-1"></i> Add Product
                            </button>
                        </div>

                        <div id="productRowsContainer" class="space-y-3">
                            <div class="bg-white dark:bg-[#111827] p-4 rounded-xl border border-slate-200 dark:border-slate-800 prod-row shadow-sm space-y-3">
                                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
                                    <div class="md:col-span-4">
                                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">Product Name</label>
                                        <input type="text" placeholder="Full Product Name" class="p-name w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold uppercase focus:bg-white dark:focus:bg-[#111827] focus:border-emerald-500 focus:outline-none text-slate-800 dark:text-slate-100" required>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">HSN Code</label>
                                        <input type="text" placeholder="e.g. 30045090" class="p-hsn w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-mono focus:bg-white dark:focus:bg-[#111827] focus:border-emerald-500 focus:outline-none text-slate-800 dark:text-slate-100" required>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">Qty</label>
                                        <input type="number" placeholder="1" class="p-qty w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold focus:bg-white dark:focus:bg-[#111827] focus:outline-none text-slate-800 dark:text-slate-100" value="1" required>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">PV (Normal)</label>
                                        <input type="number" placeholder="PV" class="p-pv w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold focus:bg-white dark:focus:bg-[#111827] focus:outline-none text-slate-800 dark:text-slate-100">
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block text-[10px] font-black text-purple-600 dark:text-purple-400 mb-1 uppercase">Offer PV (Auto Diff)</label>
                                        <input type="number" placeholder="Auto Offer PV" class="p-offer-pv w-full px-3 py-2 bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800 text-purple-900 dark:text-purple-300 rounded-lg text-xs font-bold focus:outline-none" readonly>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end pt-1">
                                    <div class="md:col-span-3">
                                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">Normal Disc ₹ (Single)</label>
                                        <input type="number" step="0.01" placeholder="0.00" class="p-discount w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs focus:bg-white dark:focus:bg-[#111827] focus:outline-none text-slate-800 dark:text-slate-100">
                                    </div>
                                    <div class="md:col-span-3">
                                        <label class="block text-[10px] font-black text-amber-600 dark:text-amber-400 mb-1 uppercase">Offer Disc ₹ (Auto Cut)</label>
                                        <input type="number" step="0.01" placeholder="Auto Offer Disc" class="p-offer-discount w-full px-3 py-2 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-900 dark:text-amber-300 rounded-lg text-xs font-bold focus:outline-none" readonly>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">GST %</label>
                                        <input type="number" step="0.01" placeholder="e.g. 18" class="p-gst-pct w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold focus:bg-white dark:focus:bg-[#111827] focus:outline-none text-slate-800 dark:text-slate-100">
                                    </div>
                                    <div class="md:col-span-3">
                                        <label class="block text-[10px] font-black text-emerald-600 dark:text-emerald-400 mb-1 uppercase">Base Amount ₹ (Before Offer Cut)</label>
                                        <input type="number" step="0.01" placeholder="e.g. 499.00" class="p-net w-full px-3 py-2 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-300 rounded-lg text-xs font-black focus:bg-white dark:focus:bg-[#111827] focus:outline-none" required>
                                    </div>
                                    <div class="md:col-span-1 text-right">
                                        <button type="button" onclick="removeProductRow(this)" class="w-full bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 p-2 rounded-lg text-xs font-bold cursor-pointer" title="Remove Product">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 📊 LIVE SUMMARY BAR -->
                    <div class="bg-slate-900 text-white p-4 rounded-xl flex flex-wrap justify-between items-center gap-4 text-xs">
                        <div class="flex items-center gap-4 flex-wrap">
                            <div>
                                <span class="text-slate-400 text-[10px] block uppercase">Normal PV</span>
                                <span id="prevNormalPv" class="font-mono font-bold text-sm">0</span>
                            </div>
                            <div class="text-purple-400">
                                <span class="text-[10px] block uppercase text-purple-300">+ Offer PV</span>
                                <span id="prevOfferPv" class="font-mono font-bold text-sm">0</span>
                            </div>
                            <div class="border-l border-slate-700 pl-4">
                                <span class="text-emerald-400 text-[10px] block uppercase font-bold">= Total Target PV</span>
                                <span id="prevTotalPv" class="font-mono font-black text-base text-emerald-400">0</span>
                            </div>
                            <div class="border-l border-slate-700 pl-4">
                                <span class="text-amber-400 text-[10px] block uppercase">Total Offer Disc</span>
                                <span id="prevOfferDisc" class="font-mono font-bold text-sm text-amber-300">₹0.00</span>
                            </div>
                            <div class="border-l border-slate-700 pl-4">
                                <span class="text-slate-400 text-[10px] block uppercase">Total Base Amt</span>
                                <span id="prevBaseAmt" class="font-mono font-bold text-sm">₹0.00</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-4">
                            <div class="text-right">
                                <span class="text-emerald-400 text-[10px] block uppercase font-bold">Final Combo Net Amt</span>
                                <span id="prevNetAmt" class="font-mono font-black text-lg text-white">₹0.00</span>
                            </div>
                            <button type="submit" id="btnSubmitCombo" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black px-6 py-2.5 rounded-xl uppercase tracking-wider transition-all shadow-md cursor-pointer">
                                Save Combo To System
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- 📋 EXISTING COMBOS LIST -->
            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
                <div class="p-4 bg-slate-50/80 dark:bg-[#0d1322] border-b border-slate-100 dark:border-slate-800 font-bold text-xs uppercase flex justify-between items-center text-slate-800 dark:text-slate-200">
                    <span class="flex items-center gap-2">
                        <i class="fa-solid fa-list-check text-emerald-600"></i> Active Combo Presets Database
                    </span>
                    <span class="bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 px-3 py-1 rounded-full text-[10px] font-black border border-emerald-200 dark:border-emerald-800">
                        <%= combos.length %> Presets Stored
                    </span>
                </div>

                <div class="divide-y divide-slate-100 dark:divide-slate-800">
                    <% if(combos.length === 0) { %>
                        <div class="p-8 text-center text-slate-400 dark:text-slate-500 text-xs">
                            No combo presets added yet. Create one above to automatically break up bills!
                        </div>
                    <% } else { %>
                        <% combos.forEach(item => { 
                            let prods = [];
                            try {
                                prods = typeof item.products === 'string' ? JSON.parse(item.products) : item.products;
                            } catch(e) { prods = []; }

                            let totalNet = 0;
                            let totalPv = 0;
                            prods.forEach(p => {
                                totalNet += (parseFloat(p.net_amt) || 0);
                                totalPv += (parseInt(p.pv) || 0) + (parseInt(p.offer_pv) || 0);
                            });
                        %>
                            <div class="p-4 hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-all flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-black text-slate-900 dark:text-slate-100 uppercase text-sm"><%= item.combo_name %></span>
                                        <span class="bg-purple-100 dark:bg-purple-950/60 text-purple-800 dark:text-purple-300 text-[10px] font-bold px-2 py-0.5 rounded-md border border-purple-200 dark:border-purple-800"><%= prods.length %> Items Breakup</span>
                                    </div>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">
                                        <%= prods.map(p => `${p.product} (x${p.qty})`).join(', ') %>
                                    </p>
                                </div>

                                <div class="flex items-center gap-4 self-end md:self-center">
                                    <div class="text-right font-mono">
                                        <span class="text-[10px] text-slate-400 block uppercase">PV: <b class="text-purple-600 dark:text-purple-400"><%= totalPv %></b></span>
                                        <span class="font-black text-slate-900 dark:text-slate-100 text-sm">₹<%= totalNet.toFixed(2) %></span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <button type="button" data-combo="<%= JSON.stringify(item) %>" onclick="editCombo(this)" class="bg-blue-50 dark:bg-blue-950/40 hover:bg-blue-100 dark:hover:bg-blue-900/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 px-3 py-1.5 rounded-lg text-xs font-bold uppercase transition-all cursor-pointer">
                                            <i class="fa-solid fa-pen-to-square mr-1"></i> Edit
                                        </button>
                                        <button type="button" data-id="<%= item.id %>" onclick="deleteCombo(this.dataset.id)" class="bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 px-3 py-1.5 rounded-lg text-xs font-bold uppercase transition-all cursor-pointer">
                                            <i class="fa-solid fa-trash-can mr-1"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>

        </main>
    </div>

    <script>
        // ➕ ADD PRODUCT ROW TO FORM
        function addProductRow(data = {}) {
            const container = document.getElementById('productRowsContainer');
            const rowDiv = document.createElement('div');
            rowDiv.className = 'bg-white dark:bg-[#111827] p-4 rounded-xl border border-slate-200 dark:border-slate-800 prod-row shadow-sm space-y-3';
            
            // Reconstruct baseAmount if editing existing data
            let baseAmtVal = '';
            if (data.net_amt !== undefined) {
                const net = parseFloat(data.net_amt) || 0;
                const disc = parseFloat(data.discount) || 0;
                const offerDisc = parseFloat(data.offer_discount) || 0;
                baseAmtVal = (net + disc + offerDisc).toFixed(2);
            }

            rowDiv.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
                    <div class="md:col-span-4">
                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">Product Name</label>
                        <input type="text" placeholder="Full Product Name" class="p-name w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold uppercase focus:bg-white dark:focus:bg-[#111827] focus:border-emerald-500 focus:outline-none text-slate-800 dark:text-slate-100" value="${data.product || ''}" required>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">HSN Code</label>
                        <input type="text" placeholder="e.g. 30045090" class="p-hsn w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-mono focus:bg-white dark:focus:bg-[#111827] focus:border-emerald-500 focus:outline-none text-slate-800 dark:text-slate-100" value="${data.hsn || '30045090'}" required>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">Qty</label>
                        <input type="number" placeholder="1" class="p-qty w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold focus:bg-white dark:focus:bg-[#111827] focus:outline-none text-slate-800 dark:text-slate-100" value="${data.qty || 1}" required>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">PV (Normal)</label>
                        <input type="number" placeholder="PV" class="p-pv w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold focus:bg-white dark:focus:bg-[#111827] focus:outline-none text-slate-800 dark:text-slate-100" value="${data.pv !== undefined ? data.pv : ''}">
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-black text-purple-600 dark:text-purple-400 mb-1 uppercase">Offer PV (Auto Diff)</label>
                        <input type="number" placeholder="Auto Offer PV" class="p-offer-pv w-full px-3 py-2 bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800 text-purple-900 dark:text-purple-300 rounded-lg text-xs font-bold focus:outline-none" value="${data.offer_pv || ''}" readonly>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end pt-1">
                    <div class="md:col-span-3">
                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">Normal Disc ₹ (Single)</label>
                        <input type="number" step="0.01" placeholder="0.00" class="p-discount w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs focus:bg-white dark:focus:bg-[#111827] focus:outline-none text-slate-800 dark:text-slate-100" value="${data.discount || ''}">
                    </div>
                    <div class="md:col-span-3">
                        <label class="block text-[10px] font-black text-amber-600 dark:text-amber-400 mb-1 uppercase">Offer Disc ₹ (Auto Cut)</label>
                        <input type="number" step="0.01" placeholder="Auto Offer Disc" class="p-offer-discount w-full px-3 py-2 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-900 dark:text-amber-300 rounded-lg text-xs font-bold focus:outline-none" value="${data.offer_discount || ''}" readonly>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-black text-slate-500 dark:text-slate-400 mb-1 uppercase">GST %</label>
                        <input type="number" step="0.01" placeholder="e.g. 18" class="p-gst-pct w-full px-3 py-2 bg-slate-50 dark:bg-[#0d1322] border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold focus:bg-white dark:focus:bg-[#111827] focus:outline-none text-slate-800 dark:text-slate-100" value="${data.gst_pct || 18}">
                    </div>
                    <div class="md:col-span-3">
                        <label class="block text-[10px] font-black text-emerald-600 dark:text-emerald-400 mb-1 uppercase">Base Amount ₹ (Before Offer Cut)</label>
                        <input type="number" step="0.01" placeholder="e.g. 499.00" class="p-net w-full px-3 py-2 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-300 rounded-lg text-xs font-black focus:bg-white dark:focus:bg-[#111827] focus:outline-none" value="${baseAmtVal}" required>
                    </div>
                    <div class="md:col-span-1 text-right">
                        <button type="button" onclick="removeProductRow(this)" class="w-full bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 p-2 rounded-lg text-xs font-bold cursor-pointer" title="Remove Product">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                </div>
            `;
            container.appendChild(rowDiv);
            calculateLivePreview();
        }

        // ➖ REMOVE PRODUCT ROW
        function removeProductRow(btn) {
            const container = document.getElementById('productRowsContainer');
            if (container.children.length > 1) {
                btn.closest('.prod-row').remove();
                calculateLivePreview();
            } else {
                alert("ઓછામાં ઓછી એક પ્રોડક્ટ રાખવી જરૂરી છે!");
            }
        }

        // 🧮 LIVE CALCULATOR FOR COMBO PREVIEW
        function calculateLivePreview() {
            const totalOfferDiscountInput = parseFloat(document.getElementById('totalOfferDiscount').value) || 0;
            const targetTotalPvInput = parseInt(document.getElementById('totalOfferPv').value) || 0;

            const rows = document.querySelectorAll('.prod-row');
            const totalProductsCount = rows.length;

            let sumNormalPv = 0;
            let sumBaseAmt = 0;
            let sumNormalDisc = 0;

            rows.forEach(r => {
                const pPv = parseInt(r.querySelector('.p-pv').value) || 0;
                const pQty = parseInt(r.querySelector('.p-qty').value) || 1;
                const pNet = parseFloat(r.querySelector('.p-net').value) || 0;
                const pDisc = parseFloat(r.querySelector('.p-discount').value) || 0;

                sumNormalPv += (pPv * pQty);
                sumBaseAmt += pNet;
                sumNormalDisc += pDisc;
            });

            // Target Offer PV logic: Z = Total Target PV - Normal PV (if Target PV > Normal PV)
            let totalOfferPvNeeded = 0;
            if (targetTotalPvInput > sumNormalPv) {
                totalOfferPvNeeded = targetTotalPvInput - sumNormalPv;
            } else if (targetTotalPvInput > 0) {
                totalOfferPvNeeded = targetTotalPvInput;
            }

            const baseOfferPv = totalProductsCount > 0 ? Math.floor(totalOfferPvNeeded / totalProductsCount) : 0;
            let remainderPv = totalProductsCount > 0 ? (totalOfferPvNeeded % totalProductsCount) : 0;
            const baseOfferDisc = totalProductsCount > 0 ? parseFloat((totalOfferDiscountInput / totalProductsCount).toFixed(2)) : 0;

            let runningOfferDiscSum = 0;

            rows.forEach((r, idx) => {
                let rowOfferPv = baseOfferPv + (idx < remainderPv ? 1 : 0);
                r.querySelector('.p-offer-pv').value = rowOfferPv > 0 ? rowOfferPv : (totalOfferPvNeeded > 0 ? 0 : '');

                let rowOfferDisc = baseOfferDisc;
                if (idx === totalProductsCount - 1 && totalProductsCount > 1) {
                    rowOfferDisc = parseFloat((totalOfferDiscountInput - runningOfferDiscSum).toFixed(2));
                } else {
                    runningOfferDiscSum += rowOfferDisc;
                }
                r.querySelector('.p-offer-discount').value = rowOfferDisc > 0 ? rowOfferDisc.toFixed(2) : (totalOfferDiscountInput > 0 ? '0.00' : '');
            });

            const finalTotalPv = targetTotalPvInput > 0 ? targetTotalPvInput : sumNormalPv;
            const finalNetAmt = Math.max(0, sumBaseAmt - sumNormalDisc - totalOfferDiscountInput);

            document.getElementById('prevNormalPv').innerText = sumNormalPv;
            document.getElementById('prevOfferPv').innerText = totalOfferPvNeeded;
            document.getElementById('prevTotalPv').innerText = finalTotalPv;
            document.getElementById('prevOfferDisc').innerText = '₹' + totalOfferDiscountInput.toFixed(2);
            document.getElementById('prevBaseAmt').innerText = '₹' + sumBaseAmt.toFixed(2);
            document.getElementById('prevNetAmt').innerText = '₹' + finalNetAmt.toFixed(2);
        }

        // ✏️ EDIT & VIEW COMBO PRESET
        function editCombo(btn) {
            const comboData = JSON.parse(btn.getAttribute('data-combo'));

            document.getElementById('comboId').value = comboData.id;
            document.getElementById('comboName').value = comboData.combo_name;

            document.getElementById('formHeading').innerHTML = `<i class="fa-solid fa-pen-to-square text-blue-500"></i> Edit Combo Breakup Preset`;
            document.getElementById('btnSubmitCombo').innerText = "Update Combo In System";
            document.getElementById('btnCancelEdit').classList.remove('hidden');

            const container = document.getElementById('productRowsContainer');
            container.innerHTML = '';

            let products = typeof comboData.products === 'string' ? JSON.parse(comboData.products) : comboData.products;

            if (Array.isArray(products) && products.length > 0) {
                let totOfferDisc = 0;
                let totNormalPv = 0;
                let totOfferPv = 0;

                products.forEach(p => {
                    totOfferDisc += parseFloat(p.offer_discount || 0);
                    totNormalPv += (parseInt(p.pv || 0) * (parseInt(p.qty) || 1));
                    totOfferPv += (parseInt(p.offer_pv || 0) * (parseInt(p.qty) || 1));
                });

                document.getElementById('totalOfferDiscount').value = totOfferDisc > 0 ? totOfferDisc : '';
                document.getElementById('totalOfferPv').value = (totNormalPv + totOfferPv) > 0 ? (totNormalPv + totOfferPv) : '';

                products.forEach(p => addProductRow(p));
            } else {
                addProductRow();
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 🔄 RESET FORM (CANCEL EDIT)
        function resetForm() {
            document.getElementById('comboId').value = '';
            document.getElementById('comboName').value = '';
            document.getElementById('totalOfferDiscount').value = '';
            document.getElementById('totalOfferPv').value = '';
            document.getElementById('formHeading').innerHTML = `<i class="fa-solid fa-plus-circle text-emerald-500"></i> Add New Combo Breakup Preset`;
            document.getElementById('btnSubmitCombo').innerText = "Save Combo To System";
            document.getElementById('btnCancelEdit').classList.add('hidden');

            const container = document.getElementById('productRowsContainer');
            container.innerHTML = '';
            addProductRow();
        }

        // 💾 SAVE / UPDATE COMBO FORM SUBMIT
        document.getElementById('comboForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const comboId = document.getElementById('comboId').value;
            const comboName = document.getElementById('comboName').value;
            const totalOfferDiscountInput = parseFloat(document.getElementById('totalOfferDiscount').value) || 0;
            const targetTotalPvInput = parseInt(document.getElementById('totalOfferPv').value) || 0;

            const rows = document.querySelectorAll('.prod-row');
            const totalProductsCount = rows.length;

            let sumNormalPv = 0;
            rows.forEach(r => {
                const pPv = parseInt(r.querySelector('.p-pv').value) || 0;
                const pQty = parseInt(r.querySelector('.p-qty').value) || 1;
                sumNormalPv += (pPv * pQty);
            });

            let totalOfferPvNeeded = 0;
            if (targetTotalPvInput > sumNormalPv) {
                totalOfferPvNeeded = targetTotalPvInput - sumNormalPv;
            } else if (targetTotalPvInput > 0) {
                totalOfferPvNeeded = targetTotalPvInput;
            }

            const baseOfferPv = totalProductsCount > 0 ? Math.floor(totalOfferPvNeeded / totalProductsCount) : 0;
            let remainderPv = totalProductsCount > 0 ? (totalOfferPvNeeded % totalProductsCount) : 0;
            const baseOfferDisc = totalProductsCount > 0 ? parseFloat((totalOfferDiscountInput / totalProductsCount).toFixed(2)) : 0;

            let runningOfferDiscSum = 0;
            let products = [];

            rows.forEach((r, idx) => {
                const baseAmount = parseFloat(r.querySelector('.p-net').value) || 0;
                const gstPct = parseFloat(r.querySelector('.p-gst-pct').value) || 18;
                const discount = parseFloat(r.querySelector('.p-discount').value) || 0;
                const qty = parseInt(r.querySelector('.p-qty').value) || 1;
                const normalPv = parseInt(r.querySelector('.p-pv').value) || 0;

                let rowOfferPv = baseOfferPv + (idx < remainderPv ? 1 : 0);
                let rowOfferDisc = baseOfferDisc;
                if (idx === totalProductsCount - 1 && totalProductsCount > 1) {
                    rowOfferDisc = parseFloat((totalOfferDiscountInput - runningOfferDiscSum).toFixed(2));
                } else {
                    runningOfferDiscSum += rowOfferDisc;
                }

                // GST on base amount
                const taxableVal = parseFloat((baseAmount / (1 + (gstPct / 100))).toFixed(2));
                const gstAmt = parseFloat((baseAmount - taxableVal).toFixed(2));
                const rate = parseFloat((taxableVal / qty).toFixed(2));

                // Net Amount minus normal discount and offer discount
                const finalNetAmt = parseFloat((baseAmount - discount - rowOfferDisc).toFixed(2));

                products.push({
                    sr: idx + 1,
                    product: r.querySelector('.p-name').value.toUpperCase().trim(),
                    hsn: r.querySelector('.p-hsn').value.trim(),
                    qty: qty,
                    rate: rate,
                    pv: normalPv,
                    offer_pv: rowOfferPv,
                    discount: discount,
                    offer_discount: rowOfferDisc,
                    taxable_val: taxableVal,
                    gst_pct: gstPct,
                    gst_amt: gstAmt,
                    net_amt: finalNetAmt
                });
            });

            const payload = {
                id: comboId || null,
                combo_name: comboName,
                products: products
            };

            try {
                const res = await fetch('/admin/api/save-combo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if(data.success) { 
                    alert(comboId ? "કોમ્બો સફળતાપૂર્વક અપડેટ થઈ ગયો છે! 🎉" : "કોમ્બો સફળતાપૂર્વક સેટ થઈ ગયો છે! 🎉");
                    location.reload(); 
                } else { 
                    alert(data.msg); 
                }
            } catch(e) { 
                console.error(e); 
            }
        });

        // 🗑️ DELETE STORED COMBO PRESET
        async function deleteCombo(id) {
            if(confirm("શું તમે ખરેખર આ કોમ્બો પ્રેસેટ ડીલીટ કરવા માંગો છો?")) {
                try {
                    const res = await fetch(`/admin/api/delete-combo/${id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if(data.success) { location.reload(); } else { alert(data.msg); }
                } catch(e) { console.error(e); }
            }
        }

        // Initialize default empty row on load
        if (document.getElementById('productRowsContainer').children.length === 0) {
            addProductRow();
        }
    </script>
</body>
</html>
