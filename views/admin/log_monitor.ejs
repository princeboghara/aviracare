<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Live Log Monitor & Telemetry - Avira Control Center</title>
    <style>
        body {
            background-color: #f8fafc;
            color: #0f172a;
        }

        .ref-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .ref-card:hover {
            border-color: #cbd5e1;
        }

        .ref-input {
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 0.75rem;
            padding: 0.5rem 0.875rem;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #0f172a;
            transition: all 0.15s ease;
        }
        .ref-input:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        /* Custom Scrollbar for Terminal */
        .terminal-scroll::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        .terminal-scroll::-webkit-scrollbar-track {
            background: #0f172a;
        }
        .terminal-scroll::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        .terminal-scroll::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-800 w-full overflow-x-hidden block">

    <%- include('../partials/admin_navbar') %>

    <div class="w-full lg:pl-64 min-h-screen flex flex-col justify-between box-border min-w-0">
        
        <!-- 🧭 Top Navigation Header -->
        <header class="bg-white border-b border-slate-200 px-4 sm:px-8 py-3.5 flex justify-between items-center sticky top-0 z-40 w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-terminal text-blue-600 flex-shrink-0"></i>
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider truncate">Diagnostics / Live Log Monitor</span>
            </div>
            <div class="flex items-center gap-2.5 sm:gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-bold text-slate-800">Avira Admin</p>
                    <p class="text-[9px] font-bold text-blue-600 uppercase tracking-widest">Live Audit Vault</p>
                </div>
                <div class="h-8 w-8 bg-blue-50 rounded-full flex items-center justify-center text-blue-600 border border-blue-200 font-bold text-xs shadow-2xs">A</div>
            </div>
        </header>

        <main class="flex-grow w-full px-4 sm:px-6 lg:px-8 xl:px-10 py-5 sm:py-7 space-y-5 box-border max-w-7xl mx-auto">
            
            <!-- 🏷️ Headline & Auto-Refresh Bar -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                        <i class="fa-solid fa-chart-line text-blue-600"></i> Unified Live Log Monitor
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">
                        Real-time audit telemetry for core software, WhatsApp CRM tracking lookups, and AviraGlobal background bots.
                    </p>
                </div>

                <!-- Live Auto-Refresh & Action Controls -->
                <div class="flex items-center gap-2.5 flex-wrap">
                    <!-- Auto-Refresh Toggle -->
                    <button type="button" id="btnToggleAutoRefresh" 
                            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-800 text-xs font-bold transition-all shadow-2xs cursor-pointer">
                        <span id="autoRefreshDot" class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span id="autoRefreshText">Live Stream: ON (3s)</span>
                    </button>

                    <!-- Manual Refresh -->
                    <button type="button" onclick="fetchLogs()" 
                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs font-bold transition-all shadow-2xs cursor-pointer" title="Manual Refresh">
                        <i class="fa-solid fa-arrows-rotate text-xs" id="refreshIcon"></i>
                    </button>

                    <!-- Export Logs Dropdown -->
                    <div class="relative group">
                        <button type="button" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs font-bold transition-all shadow-2xs cursor-pointer">
                            <i class="fa-solid fa-download text-xs text-blue-600"></i> <span>Export</span> <i class="fa-solid fa-chevron-down text-[10px] text-slate-400"></i>
                        </button>
                        <div class="absolute right-0 top-full mt-1 w-36 bg-white border border-slate-200 rounded-xl shadow-lg p-1 hidden group-hover:block z-30">
                            <a href="#" onclick="exportLogs('txt')" class="block px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50 rounded-lg">Export as .TXT</a>
                            <a href="#" onclick="exportLogs('json')" class="block px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50 rounded-lg">Export as .JSON</a>
                        </div>
                    </div>

                    <!-- Clear Logs Button -->
                    <button type="button" onclick="clearCurrentLogs()" 
                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 text-xs font-bold transition-all shadow-2xs cursor-pointer">
                        <i class="fa-solid fa-trash-can text-xs"></i> <span>Clear</span>
                    </button>
                </div>
            </div>

            <!-- 📊 Telemetry Cards Row -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="ref-card p-4 bg-white border border-slate-200">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Total Logs Captured</span>
                    <p id="statTotalLogs" class="text-xl font-black text-slate-900 font-mono mt-1">0</p>
                    <span class="text-[10px] text-slate-400 font-medium">In active buffer</span>
                </div>
                <div class="ref-card p-4 bg-white border border-slate-200">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 block">Success Events</span>
                    <p id="statSuccessLogs" class="text-xl font-black text-emerald-600 font-mono mt-1">0</p>
                    <span class="text-[10px] text-slate-400 font-medium">Operations OK</span>
                </div>
                <div class="ref-card p-4 bg-white border border-slate-200">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-amber-600 block">Warnings</span>
                    <p id="statWarnLogs" class="text-xl font-black text-amber-600 font-mono mt-1">0</p>
                    <span class="text-[10px] text-slate-400 font-medium">Notice & Misses</span>
                </div>
                <div class="ref-card p-4 bg-white border border-slate-200">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-rose-600 block">Errors / Exceptions</span>
                    <p id="statErrorLogs" class="text-xl font-black text-rose-600 font-mono mt-1">0</p>
                    <span class="text-[10px] text-slate-400 font-medium">Needs Attention</span>
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- 🎛️ 3 SUBMENUS (TABS): SYSTEM / WHATSAPP CRM / AVIRAGLOBAL -->
            <!-- ======================================================== -->
            <div class="bg-white border border-slate-200 rounded-2xl p-1.5 shadow-2xs flex items-center justify-between gap-1 flex-wrap">
                <div class="flex items-center gap-1.5 flex-wrap w-full sm:w-auto">
                    <!-- Tab 1: Software Main Logs -->
                    <button type="button" onclick="switchCategory('system')" id="tab-btn-system" 
                            class="category-tab-btn flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-black transition-all cursor-pointer bg-blue-600 text-white shadow-xs">
                        <i class="fa-solid fa-server"></i>
                        <span>1. Software Main Logs</span>
                    </button>

                    <!-- Tab 2: WhatsApp CRM Bot Logs -->
                    <button type="button" onclick="switchCategory('whatsapp_crm')" id="tab-btn-whatsapp_crm" 
                            class="category-tab-btn flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-blue-600 hover:bg-slate-100">
                        <i class="fa-brands fa-whatsapp text-emerald-600 text-sm"></i>
                        <span>2. WhatsApp CRM Bot (Tracking)</span>
                    </button>

                    <!-- Tab 3: AviraGlobal Bot Logs -->
                    <button type="button" onclick="switchCategory('aviraglobal')" id="tab-btn-aviraglobal" 
                            class="category-tab-btn flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-blue-600 hover:bg-slate-100">
                        <i class="fa-solid fa-robot text-indigo-600"></i>
                        <span>3. AviraGlobal Bot Logs</span>
                    </button>
                </div>

                <!-- View Switcher (Detailed Table vs Dark Terminal) -->
                <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs font-bold ml-auto">
                    <button type="button" onclick="setViewMode('table')" id="viewModeTableBtn" 
                            class="px-3 py-1.5 rounded-lg bg-white text-blue-600 shadow-2xs font-black text-xs cursor-pointer flex items-center gap-1">
                        <i class="fa-solid fa-table-list"></i> Table
                    </button>
                    <button type="button" onclick="setViewMode('terminal')" id="viewModeTerminalBtn" 
                            class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-blue-600 font-bold text-xs cursor-pointer flex items-center gap-1">
                        <i class="fa-solid fa-terminal"></i> Terminal
                    </button>
                </div>
            </div>

            <!-- 🔍 Filter Toolbar (Search, Level Filter, Copy) -->
            <div class="ref-card p-4 border border-slate-200 bg-white flex flex-col md:flex-row justify-between items-stretch md:items-center gap-3">
                
                <!-- Keyword Search -->
                <div class="relative flex-1">
                    <i class="fa-solid fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="logSearchInput" oninput="applyFilters()" 
                           placeholder="Filter logs by keyword, Member ID, Tracking No, IP or status..." 
                           class="ref-input pl-9 w-full text-xs font-medium">
                </div>

                <!-- Level Filters (All, Info, Success, Warn, Error) -->
                <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-[10px] font-extrabold uppercase text-slate-400 mr-1">Level:</span>
                    <button type="button" onclick="filterByLevel('ALL')" id="lvl-ALL" 
                            class="lvl-filter-btn px-2.5 py-1.5 rounded-xl text-[11px] font-black bg-blue-600 text-white cursor-pointer shadow-2xs">ALL</button>
                    <button type="button" onclick="filterByLevel('SUCCESS')" id="lvl-SUCCESS" 
                            class="lvl-filter-btn px-2.5 py-1.5 rounded-xl text-[11px] font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 cursor-pointer">SUCCESS</button>
                    <button type="button" onclick="filterByLevel('INFO')" id="lvl-INFO" 
                            class="lvl-filter-btn px-2.5 py-1.5 rounded-xl text-[11px] font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 cursor-pointer">INFO</button>
                    <button type="button" onclick="filterByLevel('WARN')" id="lvl-WARN" 
                            class="lvl-filter-btn px-2.5 py-1.5 rounded-xl text-[11px] font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 cursor-pointer">WARN</button>
                    <button type="button" onclick="filterByLevel('ERROR')" id="lvl-ERROR" 
                            class="lvl-filter-btn px-2.5 py-1.5 rounded-xl text-[11px] font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 cursor-pointer">ERROR</button>
                    
                    <button type="button" onclick="copyCurrentLogs()" id="btnCopyLogs" 
                            class="ml-2 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all cursor-pointer">
                        <i class="fa-regular fa-copy text-xs"></i> <span>Copy</span>
                    </button>
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- 📋 LOG CONTENT CONTAINER (TABLE VIEW & TERMINAL VIEW)   -->
            <!-- ======================================================== -->

            <!-- 1. Detailed Table View Mode (Default) -->
            <div id="tableViewContainer" class="ref-card border border-slate-200 overflow-hidden bg-white shadow-xs">
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[850px]">
                        <thead>
                            <tr class="bg-slate-100/70 border-b border-slate-200 text-slate-500 font-extrabold uppercase text-[10px] select-none">
                                <th class="py-3 px-4 w-12 text-center">#</th>
                                <th class="py-3 px-4 w-44">Timestamp</th>
                                <th class="py-3 px-4 w-28 text-center">Level</th>
                                <th class="py-3 px-4 w-36">Category</th>
                                <th class="py-3 px-4">Log Message & Details</th>
                                <th class="py-3 px-4 w-32 text-center">Metadata</th>
                            </tr>
                        </thead>
                        <tbody id="logsTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                            <tr>
                                <td colspan="6" class="py-12 text-center text-slate-400">
                                    <i class="fa-solid fa-spinner fa-spin text-xl text-blue-500 block mb-2"></i>
                                    Loading real-time audit logs...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Dark Hacker / DevOps Terminal Console View Mode -->
            <div id="terminalViewContainer" class="hidden ref-card border border-slate-800 bg-slate-950 text-slate-200 overflow-hidden shadow-2xl rounded-2xl">
                <!-- Terminal Titlebar -->
                <div class="px-4 py-3 bg-slate-900 border-b border-slate-800 flex justify-between items-center text-xs">
                    <div class="flex items-center gap-2 font-mono">
                        <span class="h-3 w-3 rounded-full bg-rose-500 inline-block"></span>
                        <span class="h-3 w-3 rounded-full bg-amber-500 inline-block"></span>
                        <span class="h-3 w-3 rounded-full bg-emerald-500 inline-block"></span>
                        <span class="text-slate-400 ml-2 font-bold" id="terminalTitle">aviracare-daemon@localhost:~$ tail -f system.log</span>
                    </div>
                    <div class="flex items-center gap-2 text-slate-400 font-mono text-[11px]">
                        <span>UTF-8</span>
                        <span>•</span>
                        <span class="text-emerald-400">STREAMING</span>
                    </div>
                </div>

                <!-- Terminal Body -->
                <div id="terminalLogBody" class="terminal-scroll p-4 font-mono text-[12px] leading-relaxed h-[520px] overflow-y-auto space-y-1.5 bg-slate-950 text-emerald-400 selection:bg-blue-600 selection:text-white">
                    <!-- Logs injected dynamically -->
                </div>
            </div>

        </main>

        <footer class="bg-white border-t border-slate-200 py-3.5 text-center text-xs font-semibold text-slate-400 mt-8 w-full overflow-hidden">
            &copy; 2026 Avira LifeCare. Live Telemetry & Log Audit System.
        </footer>
    </div>

    <!-- 🔍 Metadata Inspection Modal -->
    <div id="metaModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg border border-slate-200 overflow-hidden">
            <div class="bg-slate-900 px-5 py-3.5 text-white flex justify-between items-center">
                <h3 class="text-xs font-bold uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-code text-blue-400"></i> Log Metadata Inspection
                </h3>
                <button type="button" onclick="closeMetaModal()" class="text-slate-400 hover:text-white font-bold text-lg cursor-pointer">&times;</button>
            </div>
            <div class="p-4 space-y-2">
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">JSON Meta Payload:</div>
                <pre id="metaModalContent" class="bg-slate-900 text-emerald-400 font-mono text-xs p-4 rounded-xl overflow-x-auto max-h-80 leading-relaxed border border-slate-800"></pre>
            </div>
            <div class="px-5 py-3 bg-slate-50 border-t border-slate-200 flex justify-end">
                <button type="button" onclick="closeMetaModal()" class="px-4 py-2 bg-slate-900 hover:bg-slate-950 text-white rounded-xl text-xs font-bold cursor-pointer">
                    Close
                </button>
            </div>
        </div>
    </div>

    <script>
        // 📦 State Management
        let currentCategory = '<%= activeTab || "system" %>';
        let currentLevel = 'ALL';
        let viewMode = 'table'; // 'table' or 'terminal'
        let rawLogs = [];
        let autoRefreshInterval = null;
        let isAutoRefreshActive = true;

        // Category Tab Display Names
        const categoryLabels = {
            system: '1. Software Main Logs',
            whatsapp_crm: '2. WhatsApp CRM Bot (Tracking)',
            aviraglobal: '3. AviraGlobal Bot Logs'
        };

        // 🔄 Switch Category Tabs
        function switchCategory(cat) {
            currentCategory = cat;

            // Update Tab Button Styles
            ['system', 'whatsapp_crm', 'aviraglobal'].forEach(c => {
                const btn = document.getElementById(`tab-btn-${c}`);
                if (btn) {
                    if (c === cat) {
                        btn.className = 'category-tab-btn flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-black transition-all cursor-pointer bg-blue-600 text-white shadow-xs';
                    } else {
                        btn.className = 'category-tab-btn flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-blue-600 hover:bg-slate-100';
                    }
                }
            });

            // Update Terminal Title
            const terminalTitle = document.getElementById('terminalTitle');
            if (terminalTitle) {
                terminalTitle.innerText = `aviracare-daemon@localhost:~$ tail -f ${cat}.log`;
            }

            fetchLogs();
        }

        // 🔀 Switch View Mode (Table vs Terminal)
        function setViewMode(mode) {
            viewMode = mode;
            const tableContainer = document.getElementById('tableViewContainer');
            const termContainer = document.getElementById('terminalViewContainer');
            const tableBtn = document.getElementById('viewModeTableBtn');
            const termBtn = document.getElementById('viewModeTerminalBtn');

            if (mode === 'table') {
                tableContainer.classList.remove('hidden');
                termContainer.classList.add('hidden');
                tableBtn.className = 'px-3 py-1.5 rounded-lg bg-white text-blue-600 shadow-2xs font-black text-xs cursor-pointer flex items-center gap-1';
                termBtn.className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-blue-600 font-bold text-xs cursor-pointer flex items-center gap-1';
            } else {
                tableContainer.classList.add('hidden');
                termContainer.classList.remove('hidden');
                tableBtn.className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-blue-600 font-bold text-xs cursor-pointer flex items-center gap-1';
                termBtn.className = 'px-3 py-1.5 rounded-lg bg-slate-900 text-white shadow-2xs font-black text-xs cursor-pointer flex items-center gap-1';
            }
            renderLogs();
        }

        // 🏷️ Filter by Level
        function filterByLevel(lvl) {
            currentLevel = lvl;
            ['ALL', 'SUCCESS', 'INFO', 'WARN', 'ERROR'].forEach(l => {
                const btn = document.getElementById(`lvl-${l}`);
                if (btn) {
                    if (l === lvl) {
                        btn.className = 'lvl-filter-btn px-2.5 py-1.5 rounded-xl text-[11px] font-black bg-blue-600 text-white cursor-pointer shadow-2xs';
                    } else {
                        btn.className = 'lvl-filter-btn px-2.5 py-1.5 rounded-xl text-[11px] font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 cursor-pointer';
                    }
                }
            });
            renderLogs();
        }

        function applyFilters() {
            renderLogs();
        }

        // 📥 Fetch Logs from Server
        async function fetchLogs() {
            const icon = document.getElementById('refreshIcon');
            if (icon) icon.classList.add('fa-spin');

            try {
                const res = await fetch(`/admin/api/logs?category=${encodeURIComponent(currentCategory)}&limit=150`);
                const data = await res.json();

                if (data.success) {
                    rawLogs = data.logs || [];
                    updateStats(data.stats);
                    renderLogs();
                }
            } catch (err) {
                console.error('Fetch logs error:', err);
            } finally {
                if (icon) icon.classList.remove('fa-spin');
            }
        }

        // 📊 Update Telemetry Stats Tiles
        function updateStats(stats) {
            if (!stats) return;
            const currentCatStats = stats[currentCategory] || { total: 0, errors: 0, warnings: 0, success: 0 };
            document.getElementById('statTotalLogs').innerText = currentCatStats.total || rawLogs.length;
            document.getElementById('statSuccessLogs').innerText = currentCatStats.success || 0;
            document.getElementById('statWarnLogs').innerText = currentCatStats.warnings || 0;
            document.getElementById('statErrorLogs').innerText = currentCatStats.errors || 0;
        }

        // 🔄 Render Logs in either Table or Terminal View
        function renderLogs() {
            const q = (document.getElementById('logSearchInput')?.value || '').toLowerCase().trim();

            const filtered = rawLogs.filter(item => {
                if (currentLevel !== 'ALL' && item.level !== currentLevel) return false;
                if (!q) return true;
                const msg = (item.message || '').toLowerCase();
                const metaStr = JSON.stringify(item.meta || {}).toLowerCase();
                return msg.includes(q) || metaStr.includes(q);
            });

            // 1. Render Table View
            const tbody = document.getElementById('logsTableBody');
            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="py-12 text-center text-slate-400">
                            <i class="fa-solid fa-inbox text-3xl text-slate-300 block mb-2"></i>
                            No logs found matching your filter criteria.
                        </td>
                    </tr>
                `;
            } else {
                tbody.innerHTML = filtered.map((item, idx) => {
                    const time = new Date(item.timestamp).toLocaleTimeString() + '.' + new Date(item.timestamp).getMilliseconds().toString().padStart(3, '0');
                    const fullDate = new Date(item.timestamp).toLocaleDateString();

                    let lvlBadge = '';
                    if (item.level === 'SUCCESS') {
                        lvlBadge = `<span class="px-2 py-0.5 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-black uppercase">SUCCESS</span>`;
                    } else if (item.level === 'ERROR') {
                        lvlBadge = `<span class="px-2 py-0.5 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 text-[10px] font-black uppercase">ERROR</span>`;
                    } else if (item.level === 'WARN') {
                        lvlBadge = `<span class="px-2 py-0.5 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-black uppercase">WARN</span>`;
                    } else {
                        lvlBadge = `<span class="px-2 py-0.5 rounded-lg bg-blue-50 text-blue-700 border border-blue-200 text-[10px] font-black uppercase">INFO</span>`;
                    }

                    // Special formatted metadata indicators for WhatsApp CRM tracking
                    let specialPill = '';
                    if (item.meta && item.meta.tracking) {
                        specialPill = `<span class="ml-2 px-2 py-0.5 bg-blue-50 text-blue-800 border border-blue-200 rounded font-mono text-[10px] font-bold"><i class="fa-solid fa-truck-fast text-[9px]"></i> ${item.meta.tracking}</span>`;
                    } else if (item.meta && item.meta.member_id) {
                        specialPill = `<span class="ml-2 px-2 py-0.5 bg-purple-50 text-purple-800 border border-purple-200 rounded font-mono text-[10px] font-bold"><i class="fa-solid fa-user text-[9px]"></i> ${item.meta.member_id}</span>`;
                    }

                    const hasMeta = item.meta && Object.keys(item.meta).length > 0;
                    const metaBtn = hasMeta 
                        ? `<button type="button" onclick='showMeta(${JSON.stringify(item.meta)})' class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-mono text-[10px] font-bold transition-colors cursor-pointer"><i class="fa-solid fa-eye"></i> View JSON</button>`
                        : `<span class="text-slate-300 text-[10px] font-mono">-</span>`;

                    return `
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="py-2.5 px-4 text-center text-slate-400 font-mono text-[11px]">${idx + 1}</td>
                            <td class="py-2.5 px-4 font-mono text-[11px]">
                                <span class="text-slate-800 font-bold">${time}</span>
                                <span class="text-[9px] text-slate-400 block">${fullDate}</span>
                            </td>
                            <td class="py-2.5 px-4 text-center">${lvlBadge}</td>
                            <td class="py-2.5 px-4 font-mono text-[11px] text-slate-600 font-bold uppercase">${item.category}</td>
                            <td class="py-2.5 px-4 font-mono text-[11px] text-slate-900 leading-relaxed break-words whitespace-normal max-w-xl">
                                <span>${escapeHtml(item.message)}</span>
                                ${specialPill}
                            </td>
                            <td class="py-2.5 px-4 text-center">${metaBtn}</td>
                        </tr>
                    `;
                }).join('');
            }

            // 2. Render Terminal View
            const termBody = document.getElementById('terminalLogBody');
            if (filtered.length === 0) {
                termBody.innerHTML = `<div class="text-slate-500">// No logs match current filter criteria.</div>`;
            } else {
                termBody.innerHTML = filtered.map(item => {
                    const time = new Date(item.timestamp).toLocaleTimeString() + '.' + new Date(item.timestamp).getMilliseconds().toString().padStart(3, '0');
                    
                    let levelColor = 'text-blue-400';
                    if (item.level === 'SUCCESS') levelColor = 'text-emerald-400';
                    if (item.level === 'WARN') levelColor = 'text-amber-400';
                    if (item.level === 'ERROR') levelColor = 'text-rose-400';

                    const metaStr = (item.meta && Object.keys(item.meta).length > 0) 
                        ? ` <span class="text-slate-500">${JSON.stringify(item.meta)}</span>` 
                        : '';

                    return `
                        <div class="flex items-start gap-2 hover:bg-slate-900/60 p-0.5 rounded transition-colors">
                            <span class="text-slate-600 flex-shrink-0 select-none">[${time}]</span>
                            <span class="${levelColor} font-bold flex-shrink-0">[${item.level}]</span>
                            <span class="text-slate-400 font-bold flex-shrink-0">[${item.category}]</span>
                            <span class="text-slate-100 break-all">${escapeHtml(item.message)}${metaStr}</span>
                        </div>
                    `;
                }).join('');
            }
        }

        function escapeHtml(str) {
            return String(str || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        // 🔍 Show Metadata Modal
        function showMeta(metaObj) {
            const modal = document.getElementById('metaModal');
            const pre = document.getElementById('metaModalContent');
            pre.innerText = JSON.stringify(metaObj, null, 2);
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeMetaModal() {
            const modal = document.getElementById('metaModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // 📋 Copy Current Logs
        async function copyCurrentLogs() {
            const textLines = rawLogs.map(l => {
                const time = new Date(l.timestamp).toLocaleString();
                const metaStr = Object.keys(l.meta || {}).length > 0 ? ` | Meta: ${JSON.stringify(l.meta)}` : '';
                return `[${time}] [${l.level}] [${l.category.toUpperCase()}] ${l.message}${metaStr}`;
            });

            if (textLines.length === 0) {
                alert('No logs available to copy.');
                return;
            }

            await navigator.clipboard.writeText(textLines.join('\n'));
            const btn = document.getElementById('btnCopyLogs');
            btn.innerHTML = `<i class="fa-solid fa-check text-emerald-600"></i> Copied!`;
            setTimeout(() => {
                btn.innerHTML = `<i class="fa-regular fa-copy text-xs"></i> <span>Copy</span>`;
            }, 2000);
        }

        // 💾 Export Logs
        function exportLogs(format) {
            window.location.href = `/admin/api/logs/export?category=${encodeURIComponent(currentCategory)}&format=${format}`;
        }

        // 🗑️ Clear Current Category Logs
        async function clearCurrentLogs() {
            const label = categoryLabels[currentCategory] || currentCategory;
            if (confirm(`Are you sure you want to clear all logs for [${label}]?`)) {
                try {
                    const res = await fetch('/admin/api/logs/clear', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ category: currentCategory })
                    });
                    const data = await res.json();
                    if (data.success) {
                        fetchLogs();
                    }
                } catch (e) {
                    console.error('Clear error:', e);
                }
            }
        }

        // 🔄 Toggle Auto-Refresh
        const btnToggleAutoRefresh = document.getElementById('btnToggleAutoRefresh');
        if (btnToggleAutoRefresh) {
            btnToggleAutoRefresh.addEventListener('click', function() {
                isAutoRefreshActive = !isAutoRefreshActive;
                const dot = document.getElementById('autoRefreshDot');
                const text = document.getElementById('autoRefreshText');

                if (isAutoRefreshActive) {
                    dot.className = 'h-2 w-2 rounded-full bg-emerald-500 animate-pulse';
                    text.innerText = 'Live Stream: ON (3s)';
                    this.className = 'inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-800 text-xs font-bold transition-all shadow-2xs cursor-pointer';
                    startAutoRefresh();
                } else {
                    dot.className = 'h-2 w-2 rounded-full bg-slate-400';
                    text.innerText = 'Live Stream: Paused';
                    this.className = 'inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-600 text-xs font-bold transition-all shadow-2xs cursor-pointer';
                    stopAutoRefresh();
                }
            });
        }

        function startAutoRefresh() {
            stopAutoRefresh();
            autoRefreshInterval = setInterval(fetchLogs, 3000);
        }

        function stopAutoRefresh() {
            if (autoRefreshInterval) {
                clearInterval(autoRefreshInterval);
                autoRefreshInterval = null;
            }
        }

        // Initial Load
        fetchLogs();
        startAutoRefresh();
    </script>
</body>
</html>
