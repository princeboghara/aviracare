<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Content Manager - Avira Control</title>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col font-sans antialiased text-slate-800 w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <%- include('../partials/admin_navbar') %>

    <div class="lg:pl-64 flex-grow flex flex-col justify-between min-h-screen overflow-y-auto box-border w-full">
        
        <header class="glass-panel-header px-4 sm:px-8 py-3 flex justify-between items-center sticky top-0 z-40 shadow-xs w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-file-pdf text-emerald-500 flex-shrink-0 text-sm"></i>
                <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider truncate">Dashboard / Content Manager</span>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-black text-slate-800 dark:text-slate-200">Avira Root</p>
                    <p class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest font-mono-code">PDF Repository</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 dark:bg-emerald-950/60 rounded-xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800 font-black text-xs shadow-xs">
                    <i class="fa-solid fa-cloud-arrow-up text-xs"></i>
                </div>
            </div>
        </header>

        <main class="flex-grow w-full max-w-4xl mx-auto px-4 sm:px-8 py-6 sm:py-10 space-y-6 sm:space-y-8 box-border">
            
            <div class="space-y-2 text-center max-w-xl mx-auto mb-2">
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white font-outfit">Content Management</h1>
                <p class="text-slate-500 dark:text-slate-400 text-xs md:text-sm font-medium">Upload business models, product flyers, or catalog resources. All PDF documents automatically sync with the Member Portal.</p>
            </div>

            <div class="max-w-2xl mx-auto w-full">
                <div class="glass-emerald-card p-5 sm:p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
                    <div class="text-center mb-6">
                        <div class="w-12 h-12 sm:w-14 sm:h-14 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 rounded-2xl flex items-center justify-center text-lg sm:text-xl mx-auto mb-3 border border-emerald-100 dark:border-emerald-900 shadow-xs">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </div>
                        <h2 class="text-sm sm:text-base font-black text-slate-900 dark:text-white mb-1 font-outfit uppercase tracking-wide">Upload New PDF Resource</h2>
                        <p class="text-slate-400 dark:text-slate-500 text-xs leading-relaxed font-medium">Enter a document title, choose card category, and select official PDF file.</p>
                    </div>

                    <form id="pdfUploadForm" class="space-y-4 text-xs">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 sm:gap-4">
                            <div>
                                <label class="block font-black uppercase text-[10px] text-slate-500 dark:text-slate-400 mb-1 tracking-wider">Document Title</label>
                                <input type="text" id="pdfTitle" required placeholder="E.G. NEW PLAN 2026" 
                                       class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-700 rounded-xl font-bold uppercase focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                            </div>
                            
                            <div>
                                <label class="block font-black uppercase text-[10px] text-slate-500 dark:text-slate-400 mb-1 tracking-wider">Display Category</label>
                                <select id="pdfCategory" required class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-700 rounded-xl font-bold focus:outline-none focus:border-emerald-500 text-slate-800 dark:text-slate-100 transition-all">
                                    <option value="BUSINESS_PLAN">Business Plan Card</option>
                                    <option value="PRODUCT_CATALOG">Product Catalog Card</option>
                                </select>
                            </div>

                            <div>
                                <label class="block font-black uppercase text-[10px] text-slate-500 dark:text-slate-400 mb-1 tracking-wider">Select PDF File</label>
                                <input type="file" id="pdfFile" accept=".pdf" required 
                                       class="w-full text-[10px] text-slate-500 dark:text-slate-400 file:mr-2 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-[10px] file:font-black file:bg-emerald-50 dark:file:bg-emerald-950 file:text-emerald-700 dark:file:text-emerald-300 hover:file:bg-emerald-100 cursor-pointer">
                            </div>
                        </div>

                        <button type="submit" class="w-full py-3 btn-emerald-3d text-white font-black text-xs rounded-xl transition-all cursor-pointer shadow-md uppercase tracking-wider flex items-center justify-center gap-1.5">
                            <span>Upload Document to Cloud</span>
                            <i class="fa-solid fa-circle-check ml-1"></i>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Active Records Table Container -->
            <div class="w-full bg-white dark:bg-[#111827] p-4 sm:p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm mt-8 space-y-4">
                <div class="flex justify-between items-center border-b border-slate-100 dark:border-slate-800 pb-3 flex-wrap gap-2">
                    <div>
                        <h2 class="text-sm sm:text-base font-black text-slate-900 dark:text-white font-outfit uppercase tracking-wide flex items-center gap-1.5">
                            <i class="fa-solid fa-list-check text-emerald-500"></i> Active PDF Resources
                        </h2>
                        <p class="text-slate-400 dark:text-slate-500 text-[11px] font-medium mt-0.5">Documents synced with database & displayed in member portal downloads.</p>
                    </div>
                    <span class="text-[10px] font-black text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-xl font-mono-code">Total: <%= pdfs.length %> Items</span>
                </div>

                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap sm:whitespace-normal">
                        <thead>
                            <tr class="bg-slate-50 dark:bg-[#0d1322] border-b border-slate-100 dark:border-slate-800 text-slate-400 dark:text-slate-500 font-black uppercase text-[10px] tracking-wider">
                                <th class="py-3 px-3 w-12 text-center">SR</th>
                                <th class="py-3 px-3">Document Title</th>
                                <th class="py-3 px-3">Storage Key</th>
                                <th class="py-3 px-3">Upload Date</th>
                                <th class="py-3 px-3 text-center w-36">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-semibold text-slate-700 dark:text-slate-300">
                            <% if(pdfs.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="py-12 text-center text-slate-400 dark:text-slate-500 font-normal">
                                        <i class="fa-solid fa-file-pdf text-3xl block mb-2 text-slate-300 dark:text-slate-700"></i>
                                        No active documents found in system repository.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% pdfs.forEach((item, index) => { %>
                                <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                                    <td class="py-3 px-3 font-mono-code text-slate-400 text-center font-bold"><%= index + 1 %></td>
                                    <td class="py-3 px-3 font-black text-slate-900 dark:text-white uppercase tracking-wide"><%= item.title %></td>
                                    <td class="py-3 px-3 text-slate-400 font-mono-code text-[10px] max-w-[160px] truncate"><%= item.filename %></td>
                                    <td class="py-3 px-3 text-slate-500 dark:text-slate-400 text-[11px]"><%= item.uploadDate %></td>
                                    <td class="py-3 px-3 text-center">
                                        <div class="flex items-center justify-center gap-3">
                                            <a href="/uploads/<%= item.filename %>" target="_blank" class="text-blue-500 hover:text-blue-600 dark:text-blue-400 font-black transition-colors flex items-center gap-1">
                                                <i class="fa-solid fa-eye text-xs"></i> View
                                            </a>
                                            <button type="button" data-id="<%= item.id %>" class="delete-pdf-btn text-rose-500 hover:text-rose-600 dark:text-rose-400 font-black transition-colors cursor-pointer flex items-center gap-1">
                                                <i class="fa-solid fa-trash text-xs"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <footer class="bg-white dark:bg-[#0d1322] border-t border-slate-200/80 dark:border-slate-800 py-3.5 text-center text-xs font-medium text-slate-400 dark:text-slate-500 mt-12 w-full overflow-hidden">
            &copy; 2026 Avira Control Center. Secure Admin Workspace.
        </footer>
    </div>

    <script>
        document.getElementById('pdfUploadForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const fileInput = document.getElementById('pdfFile');
            const titleInput = document.getElementById('pdfTitle');
            
            if(fileInput.files.length === 0) {
                alert("Please select a valid PDF file first.");
                return;
            }

            const formData = new FormData();
            formData.append('pdfFile', fileInput.files[0]);
            formData.append('pdfTitle', titleInput.value);
            formData.append('pdfCategory', document.getElementById('pdfCategory').value);

            const btn = this.querySelector('button[type="submit"]');
            btn.innerText = "Uploading to Cloud Server...";
            btn.disabled = true;

            try {
                const res = await fetch('/admin/api/upload-pdf', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                
                if(data.success) {
                    alert(data.msg);
                    location.reload();
                } else {
                    alert("Upload Error: " + data.msg);
                    btn.innerHTML = `<span>Upload Document to Cloud</span><i class="fa-solid fa-circle-check ml-1"></i>`;
                    btn.disabled = false;
                }
            } catch(err) {
                console.error(err);
                alert("Server connection failed. Please try again.");
                btn.innerHTML = `<span>Upload Document to Cloud</span><i class="fa-solid fa-circle-check ml-1"></i>`;
                btn.disabled = false;
            }
        });

        document.querySelectorAll('.delete-pdf-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const pdfId = this.getAttribute('data-id');
                if(confirm("Are you sure you want to delete this document permanently?")) {
                    fetch(`/admin/api/delete-pdf/${pdfId}`, { method: 'DELETE' })
                    .then(res => res.json())
                    .then(data => {
                        if(data.success) {
                            alert(data.msg);
                            location.reload();
                        } else {
                            alert("Delete Failed: " + data.msg);
                        }
                    })
                    .catch(err => console.error(err));
                }
            });
        });
    </script>
</body>
</html>
