<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Order Master Repository - Avira Control Center</title>
    <style>
        body {
            background-color: #f8fafc;
            color: #0f172a;
        }

        .ref-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .ref-card:hover {
            border-color: #cbd5e1;
        }

        .ref-input {
            width: 100%;
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 0.75rem;
            padding-top: 0.625rem;
            padding-bottom: 0.625rem;
            padding-left: 0.875rem;
            padding-right: 0.875rem;
            font-size: 0.8125rem;
            font-weight: 600;
            color: #0f172a;
            transition: all 0.15s ease;
            box-sizing: border-box;
        }
        .ref-input:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-800 w-full overflow-x-hidden block">

    <%- include('../partials/admin_navbar') %>

    <div class="w-full lg:pl-64 min-h-screen flex flex-col justify-between box-border min-w-0">

        <!-- 🧭 Top Navigation Header -->
        <header class="bg-white border-b border-slate-200 px-4 sm:px-8 py-3.5 flex justify-between items-center sticky top-0 z-40 w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-file-invoice text-blue-600 flex-shrink-0"></i>
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider truncate">Orders / Order Master Repository</span>
            </div>
            <div class="flex items-center gap-2.5 sm:gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-bold text-slate-800">Avira Admin</p>
                    <p class="text-[9px] font-bold text-blue-600 uppercase tracking-widest">Active Workspace</p>
                </div>
                <div class="h-8 w-8 bg-blue-50 rounded-full flex items-center justify-center text-blue-600 border border-blue-200 font-bold text-xs shadow-2xs">A</div>
            </div>
        </header>

        <main class="flex-grow w-full px-4 sm:px-6 lg:px-8 xl:px-10 py-4 sm:py-6 space-y-4 sm:space-y-6 box-border">

            <!-- 🤖 Avira Admin Live Sync Control Console (Modern Corporate Executive Look) -->
            <div class="ref-card p-5 sm:p-6 border border-slate-200/90 shadow-xs relative overflow-hidden bg-white">
                
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pb-5 border-b border-slate-100">
                    <div class="flex items-center gap-3.5">
                        <div class="h-11 w-11 rounded-xl bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center text-lg font-bold shadow-2xs flex-shrink-0">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-3 flex-wrap">
                                <h1 class="text-base sm:text-lg font-black tracking-tight text-slate-900">Avira Live Order Sync Engine</h1>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span id="autoSyncBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full <%= (syncStatus && syncStatus.isAutoSyncEnabled === false) ? 'bg-amber-50 border border-amber-200 text-amber-700' : 'bg-emerald-50 border border-emerald-200 text-emerald-700' %> text-[11px] font-bold">
                                        <span id="autoSyncDot" class="h-2 w-2 rounded-full <%= (syncStatus && syncStatus.isAutoSyncEnabled === false) ? 'bg-amber-500' : 'bg-emerald-500 animate-pulse' %>"></span>
                                        <span id="autoSyncBadgeText"><%= (syncStatus && syncStatus.isAutoSyncEnabled === false) ? 'Auto-Sync Paused' : 'Auto-Sync Active (5m)' %></span>
                                    </span>
                                    <button type="button" id="btnToggleAutoSync" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 text-[11px] font-bold transition-all cursor-pointer shadow-2xs">
                                        <i id="toggleSyncIcon" class="fa-solid <%= (syncStatus && syncStatus.isAutoSyncEnabled === false) ? 'fa-play text-emerald-600' : 'fa-pause text-amber-600' %> text-[10px]"></i>
                                        <span id="toggleSyncText"><%= (syncStatus && syncStatus.isAutoSyncEnabled === false) ? 'Resume Auto-Sync' : 'Pause Auto-Sync' %></span>
                                    </button>
                                </div>
                            </div>
                            <p class="text-xs text-slate-500 mt-0.5 font-medium">Direct synchronization with <span class="font-mono text-blue-600 font-semibold">https://aviraglobal.in</span> without third-party developer requirements.</p>
                        </div>
                    </div>
                </div>

                <!-- 2 Big Box Corporate Action Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 pt-5">
                    
                    <!-- Option 1: Sync New Orders (Corporate Emerald Accent) -->
                    <div class="bg-gradient-to-br from-white to-slate-50/70 border border-slate-200 hover:border-emerald-500/50 hover:shadow-md p-5 rounded-2xl flex flex-col justify-between transition-all group relative overflow-hidden">
                        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-500"></div>
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center text-xs font-black shadow-2xs">
                                        <i class="fa-solid fa-bolt text-emerald-600"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-sm font-black text-slate-900 group-hover:text-emerald-700 transition-colors">Sync New Orders</h3>
                                        <span class="text-[10px] text-slate-400 font-medium">Incremental Safe Pull</span>
                                    </div>
                                </div>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200">
                                    Fast Incremental
                                </span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed mb-4">
                                Scans newest pages only. Existing saved records are <strong class="text-slate-900 font-bold">retained safely</strong> and only brand-new orders are seamlessly inserted.
                            </p>
                        </div>
                        <button type="button" id="btnSyncNew" class="w-full inline-flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-black text-xs py-2.5 px-4 rounded-xl shadow-xs hover:shadow transition-all cursor-pointer uppercase tracking-wider">
                            <i class="fa-solid fa-bolt text-xs"></i> <span>Sync New Orders</span>
                        </button>
                    </div>

                    <!-- Option 2: Wipe & Sync All (Corporate Amber/Rose Accent) -->
                    <div class="bg-gradient-to-br from-white to-slate-50/70 border border-slate-200 hover:border-rose-400/50 hover:shadow-md p-5 rounded-2xl flex flex-col justify-between transition-all group relative overflow-hidden">
                        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 to-rose-500"></div>
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center text-xs font-black shadow-2xs">
                                        <i class="fa-solid fa-broom text-amber-600"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-sm font-black text-slate-900 group-hover:text-rose-700 transition-colors">Wipe & Sync All</h3>
                                        <span class="text-[10px] text-slate-400 font-medium">Full Fresh Reset</span>
                                    </div>
                                </div>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-rose-700 bg-rose-50 px-2.5 py-1 rounded-lg border border-rose-200">
                                    Full Reset
                                </span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed mb-4">
                                <strong class="text-rose-600 font-bold">Wipes all current records</strong> from Orders Master and pulls a 100% fresh catalog of all orders directly from Avira Website.
                            </p>
                        </div>
                        <button type="button" id="btnWipeAll" class="w-full inline-flex items-center justify-center gap-2 bg-gradient-to-r from-rose-600 to-amber-600 hover:from-rose-700 hover:to-amber-700 text-white font-black text-xs py-2.5 px-4 rounded-xl shadow-xs hover:shadow transition-all cursor-pointer uppercase tracking-wider">
                            <i class="fa-solid fa-broom text-xs"></i> <span>Wipe & Sync All</span>
                        </button>
                    </div>

                </div>

            </div>

            <!-- Orders Table Card -->
            <div class="ref-card overflow-hidden w-full bg-white border border-slate-200">
                <div class="px-4 sm:px-6 py-3.5 bg-slate-50/80 border-b border-slate-200 flex justify-between items-center flex-wrap gap-3">
                    <div class="flex items-center gap-3">
                        <h2 class="text-xs sm:text-sm font-black text-slate-900 flex items-center gap-2">
                            <i class="fa-solid fa-list text-blue-600"></i> Permanent Order Repository
                        </h2>
                        <span id="ordersCounter" class="bg-blue-50 text-blue-800 border border-blue-200 text-[11px] font-bold px-3 py-0.5 rounded-full"><%= orders ? orders.length : 0 %> Records Saved</span>
                    </div>

                    <div class="flex items-center gap-2 flex-wrap">
                        <!-- Search Box -->
                        <div class="relative">
                            <i class="fa-solid fa-search absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                            <input type="text" id="orderSearchInput" oninput="applyFilterAndSort()" placeholder="Filter orders..." class="pl-8 pr-3 py-1.5 bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 focus:outline-none focus:border-blue-500 w-44 sm:w-56">
                        </div>

                        <!-- 🔢 Page Size Selector Buttons (10, 25, 50, 100, ALL) -->
                        <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs font-bold">
                            <span class="text-[10px] uppercase font-black tracking-wider text-slate-400 px-1">Show:</span>
                            <button type="button" onclick="setOrdersPageSize(10)" id="pageSizeBtn-10" class="orders-page-size-btn px-2.5 py-1 text-[11px] font-black rounded-lg transition-all text-slate-600 hover:text-blue-600 cursor-pointer">10</button>
                            <button type="button" onclick="setOrdersPageSize(25)" id="pageSizeBtn-25" class="orders-page-size-btn px-2.5 py-1 text-[11px] font-black rounded-lg transition-all text-slate-600 hover:text-blue-600 cursor-pointer">25</button>
                            <button type="button" onclick="setOrdersPageSize(50)" id="pageSizeBtn-50" class="orders-page-size-btn px-2.5 py-1 text-[11px] font-black rounded-lg transition-all bg-white text-blue-600 shadow-xs cursor-pointer">50</button>
                            <button type="button" onclick="setOrdersPageSize(100)" id="pageSizeBtn-100" class="orders-page-size-btn px-2.5 py-1 text-[11px] font-black rounded-lg transition-all text-slate-600 hover:text-blue-600 cursor-pointer">100</button>
                            <button type="button" onclick="setOrdersPageSize('ALL')" id="pageSizeBtn-ALL" class="orders-page-size-btn px-2.5 py-1 text-[11px] font-black rounded-lg transition-all text-slate-600 hover:text-blue-600 cursor-pointer">ALL</button>
                        </div>

                        <!-- Copy Tracking IDs Button -->
                        <button id="btnCopyAllTrackings" type="button" onclick="copyMasterTrackingNumbers()" 
                                class="inline-flex items-center gap-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 font-bold text-xs px-3.5 py-1.5 rounded-xl transition-all cursor-pointer shadow-2xs" title="Copy tracking numbers for bulk India Post tracking">
                            <i class="fa-regular fa-copy text-emerald-600" id="copyMasterIcon"></i>
                            <span id="copyMasterText">Copy Tracking IDs</span>
                        </button>

                        <!-- Bulk Shoppee Button (Appears on row selection) -->
                        <button id="btnBulkShoppee" type="button" class="hidden bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs px-3.5 py-1.5 rounded-xl transition-all shadow cursor-pointer uppercase tracking-wider items-center gap-1.5">
                            <i class="fa-solid fa-shop"></i> Shoppee (<span id="selectedShoppeeCount">0</span>)
                        </button>

                        <!-- Bulk Delete Button (Appears on row selection) -->
                        <button id="btnBulkDelete" type="button" class="hidden bg-rose-600 hover:bg-rose-700 text-white font-black text-xs px-3.5 py-1.5 rounded-xl transition-all shadow cursor-pointer uppercase tracking-wider items-center gap-1.5">
                            <i class="fa-solid fa-trash"></i> Delete Selected (<span id="selectedCount">0</span>)
                        </button>

                        <!-- Wipe All Button -->
                        <button id="btnDirectWipe" type="button" class="inline-flex items-center gap-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 hover:text-rose-800 border border-rose-200 font-bold text-xs px-3.5 py-1.5 rounded-xl transition-all cursor-pointer shadow-2xs">
                            <i class="fa-solid fa-broom text-rose-500"></i> Wipe All Orders
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[850px]">
                        <thead>
                            <tr class="bg-slate-100/70 border-b border-slate-200 text-slate-500 font-extrabold uppercase text-[10px] select-none">
                                <th class="py-3 px-3 text-center w-10">
                                    <input type="checkbox" id="selectAllCheckbox" class="rounded text-blue-600 focus:ring-blue-500 h-4 w-4 cursor-pointer">
                                </th>
                                <th class="py-3 px-3 w-12 text-center cursor-pointer hover:text-blue-600 transition-colors" onclick="sortOrdersBy('seq')" title="Click to sort by Sequence">
                                    <div class="flex items-center justify-center gap-1">
                                        <span>#</span>
                                        <i class="fa-solid fa-sort text-[10px] text-slate-300" id="sortIcon-seq"></i>
                                    </div>
                                </th>
                                <th class="py-3 px-4 cursor-pointer hover:text-blue-600 transition-colors" onclick="sortOrdersBy('order_no')" title="Click to sort by Order No">
                                    <div class="flex items-center gap-1">
                                        <span>Order No</span>
                                        <i class="fa-solid fa-sort-down text-[10px] text-blue-600" id="sortIcon-order_no"></i>
                                    </div>
                                </th>
                                <th class="py-3 px-4 cursor-pointer hover:text-blue-600 transition-colors" onclick="sortOrdersBy('tracking_no')" title="Click to sort by Tracking Number">
                                    <div class="flex items-center gap-1">
                                        <span>Tracking Number</span>
                                        <i class="fa-solid fa-sort text-[10px] text-slate-300" id="sortIcon-tracking_no"></i>
                                    </div>
                                </th>
                                <th class="py-3 px-4 cursor-pointer hover:text-blue-600 transition-colors" onclick="sortOrdersBy('order_date')" title="Click to sort by Order Date">
                                    <div class="flex items-center gap-1">
                                        <span>Ordered Date</span>
                                        <i class="fa-solid fa-sort text-[10px] text-slate-300" id="sortIcon-order_date"></i>
                                    </div>
                                </th>
                                <th class="py-3 px-4 cursor-pointer hover:text-blue-600 transition-colors" onclick="sortOrdersBy('member_id')" title="Click to sort by Member ID">
                                    <div class="flex items-center gap-1">
                                        <span>Member ID</span>
                                        <i class="fa-solid fa-sort text-[10px] text-slate-300" id="sortIcon-member_id"></i>
                                    </div>
                                </th>
                                <th class="py-3 px-4 cursor-pointer hover:text-blue-600 transition-colors" onclick="sortOrdersBy('name')" title="Click to sort by Customer Name">
                                    <div class="flex items-center gap-1">
                                        <span>Customer Name</span>
                                        <i class="fa-solid fa-sort text-[10px] text-slate-300" id="sortIcon-name"></i>
                                    </div>
                                </th>
                                <th class="py-3 px-4 cursor-pointer hover:text-blue-600 transition-colors" onclick="sortOrdersBy('pv')" title="Click to sort by Total PV">
                                    <div class="flex items-center gap-1">
                                        <span>Total PV</span>
                                        <i class="fa-solid fa-sort text-[10px] text-slate-300" id="sortIcon-pv"></i>
                                    </div>
                                </th>
                                <th class="py-3 px-4 cursor-pointer hover:text-blue-600 transition-colors" onclick="sortOrdersBy('amount')" title="Click to sort by Amount">
                                    <div class="flex items-center gap-1">
                                        <span>Amount</span>
                                        <i class="fa-solid fa-sort text-[10px] text-slate-300" id="sortIcon-amount"></i>
                                    </div>
                                </th>
                                <th class="py-3 px-4 text-center w-36">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="ordersTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                            <!-- Populated dynamically via renderPaginatedTable() -->
                        </tbody>
                    </table>
                </div>

                <!-- 50 Records Per Page / Show All Toolbar -->
                <div id="paginationBar" class="px-4 sm:px-6 py-3.5 bg-slate-50/90 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-3">
                    <div class="text-xs text-slate-500 font-medium flex items-center gap-1.5">
                        Showing <span id="pageStart" class="font-bold text-slate-800">0</span> to <span id="pageEnd" class="font-bold text-slate-800">0</span> of <span id="totalRecordsCount" class="font-bold text-slate-900">0</span> orders
                        <span id="pageModeBadge" class="text-[10px] bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full font-bold ml-1">50 per page</span>
                    </div>

                    <div id="paginationControlsGroup" class="flex items-center gap-1.5 flex-wrap justify-center">
                        <button type="button" id="btnFirstPage" class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-600 text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed shadow-2xs" title="First Page">
                            <i class="fa-solid fa-angles-left"></i>
                        </button>
                        <button type="button" id="btnPrevPage" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1 shadow-2xs">
                            <i class="fa-solid fa-chevron-left text-[10px]"></i> Prev
                        </button>
                        
                        <div id="pagePillsContainer" class="flex items-center gap-1">
                            <!-- Page number buttons injected dynamically -->
                        </div>

                        <button type="button" id="btnNextPage" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1 shadow-2xs">
                            Next <i class="fa-solid fa-chevron-right text-[10px]"></i>
                        </button>
                        <button type="button" id="btnLastPage" class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-600 text-xs font-bold transition-all disabled:opacity-40 disabled:cursor-not-allowed shadow-2xs" title="Last Page">
                            <i class="fa-solid fa-angles-right"></i>
                        </button>
                    </div>

                    <div class="text-xs font-bold text-slate-600">
                        Page <span id="currentPageNum" class="text-blue-600 font-black">1</span> of <span id="totalPagesNum" class="text-slate-800 font-black">1</span>
                    </div>
                </div>

            </div>

        </main>

        <footer class="bg-white border-t border-slate-200 py-3 text-center text-xs font-semibold text-slate-400 mt-6 w-full overflow-hidden">
            &copy; 2026 Avira LifeCare. All rights reserved.
        </footer>
    </div>

    <!-- Edit Order Modal (Corporate Clean Look) -->
    <div id="editOrderModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md border border-slate-200 overflow-hidden">
            <div class="bg-slate-900 px-5 py-3.5 text-white flex justify-between items-center">
                <h3 class="text-xs font-bold uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-amber-400"></i> Edit Order Record
                </h3>
                <button type="button" id="btnCloseOrderModal" class="text-slate-400 hover:text-white font-bold text-lg cursor-pointer">&times;</button>
            </div>
            
            <form id="editOrderForm" class="p-5 space-y-3.5 text-xs">
                <input type="hidden" id="editOrderId">

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Order Date</label>
                        <input type="text" id="editOrderDate" required class="ref-input">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Member ID (AV + Digits)</label>
                        <input type="text" id="editMemberId" required maxlength="8" placeholder="AV12345" oninput="formatMemberIdInput(this)" class="ref-input font-mono uppercase text-blue-700 font-bold">
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Customer Full Name</label>
                    <input type="text" id="editName" required class="ref-input uppercase">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Total PV</label>
                        <input type="text" id="editPv" required class="ref-input font-mono">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Amount (₹)</label>
                        <input type="text" id="editAmount" required class="ref-input font-mono font-bold">
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1 flex items-center justify-between">
                        <span>Tracking Number <span class="text-slate-400 font-normal lowercase">(optional)</span></span>
                        <span class="text-[9px] text-slate-400">Leave blank for Pending Dispatch</span>
                    </label>
                    <div class="relative flex items-center">
                        <input type="text" id="editTrackingNo" placeholder="Enter tracking no or click Shop Pickup / With..." class="ref-input font-mono uppercase font-bold">
                    </div>

                    <!-- Quick Action Buttons for Tracking -->
                    <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                        <button type="button" onclick="setEditTrackingShoppee()" 
                                class="text-[10px] font-extrabold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-2.5 py-1 rounded-lg cursor-pointer transition-colors flex items-center gap-1"
                                title="Set as Shop Pickup (Shoppee)">
                            <i class="fa-solid fa-shop text-[9px]"></i> Shop Pickup
                        </button>
                        <button type="button" id="btnOpenWithSelector" onclick="toggleWithSelector()" 
                                class="text-[10px] font-extrabold text-purple-700 bg-purple-50 hover:bg-purple-100 border border-purple-300 px-2.5 py-1 rounded-lg cursor-pointer transition-colors flex items-center gap-1 shadow-2xs"
                                title="Link with another parcel/order (Shipped Together)">
                            <i class="fa-solid fa-link text-[9px]"></i> With...
                        </button>
                        <button type="button" onclick="clearEditTracking()" 
                                class="text-[10px] font-bold text-slate-500 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 px-2.5 py-1 rounded-lg cursor-pointer transition-colors"
                                title="Clear tracking (Pending Dispatch)">
                            <i class="fa-solid fa-xmark text-[9px]"></i> Clear
                        </button>
                    </div>

                    <!-- 📦 With Parcel / Order Selector Popover -->
                    <div id="withSelectorContainer" class="hidden mt-2.5 p-3 bg-purple-50/70 border border-purple-200 rounded-2xl space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-black uppercase text-purple-900 flex items-center gap-1.5">
                                <i class="fa-solid fa-link text-purple-600"></i> Select Parcel / Order Shipped Together:
                            </span>
                            <button type="button" onclick="toggleWithSelector(false)" class="text-slate-400 hover:text-slate-700 text-xs cursor-pointer font-bold px-1">&times;</button>
                        </div>
                        <div class="relative">
                            <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[10px] pointer-events-none"></i>
                            <input type="text" id="withSearchInput" oninput="filterWithOrders(this.value)" placeholder="Search Order No, Tracking, Member or Name..." 
                                   class="w-full pl-7 pr-3 py-1 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-800 focus:outline-none focus:border-purple-500">
                        </div>
                        <div id="withOrdersList" class="max-h-48 overflow-y-auto divide-y divide-slate-100 bg-white rounded-xl border border-slate-200 text-xs">
                            <!-- Populated dynamically via populateWithOrdersList() -->
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
                    <button type="button" id="btnCancelOrderModal" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold cursor-pointer transition-all">Cancel</button>
                    <button type="submit" id="btnSaveOrderEdit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-black uppercase tracking-wider shadow cursor-pointer transition-all">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 🚀 Live Sync Progress Modal (Real-Time Terminal, Steps & Progress Bar) -->
    <div id="syncProgressModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs hidden transition-opacity">
        <div class="bg-white border border-slate-200 rounded-3xl shadow-2xl w-full max-w-2xl overflow-hidden text-slate-800 flex flex-col animate-in fade-in zoom-in-95 duration-200">
            
            <!-- Modal Header -->
            <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div id="modalIconWrap" class="h-9 w-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-sm border border-blue-200">
                        <i class="fa-solid fa-rotate fa-spin" id="modalSpinner"></i>
                    </div>
                    <div>
                        <h3 id="modalTitle" class="text-sm font-black tracking-wide text-slate-900">Avira Live Sync in Progress</h3>
                        <p id="modalSubtitle" class="text-[11px] text-slate-500 font-medium">Communicating with https://aviraglobal.in/AVGControl</p>
                    </div>
                </div>
                <button type="button" id="btnSyncModalClose" class="h-8 w-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-800 flex items-center justify-center text-xs transition-colors cursor-pointer hidden">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 space-y-4">
                
                <!-- Current Step Headline -->
                <div class="flex items-center justify-between text-xs font-bold text-slate-700">
                    <span id="syncCurrentStep" class="flex items-center gap-2">
                        <span class="h-2 w-2 rounded-full bg-blue-600 animate-pulse"></span>
                        <span id="syncStepText">Initializing connection...</span>
                    </span>
                    <span id="syncPercentText" class="font-mono text-blue-600 font-black">0%</span>
                </div>

                <!-- Animated Progress Bar -->
                <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden p-0.5 border border-slate-200">
                    <div id="syncProgressBar" class="h-full bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full transition-all duration-300 ease-out shadow-xs" style="width: 0%"></div>
                </div>

                <!-- 3 Live Stats Counters -->
                <div class="grid grid-cols-3 gap-3 pt-1">
                    <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-center">
                        <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Page</div>
                        <div id="statPage" class="text-base font-black text-slate-900 font-mono mt-0.5">-</div>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-center">
                        <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Orders Added</div>
                        <div id="statOrders" class="text-base font-black text-emerald-600 font-mono mt-0.5">0</div>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-center">
                        <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Status</div>
                        <div id="statStatus" class="text-xs font-black text-blue-600 font-mono mt-1 uppercase tracking-wide">Connecting</div>
                    </div>
                </div>

                <!-- Dark Live Terminal Console Log -->
                <div class="space-y-1.5 pt-1">
                    <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 uppercase tracking-wider">
                        <span>Live Execution Log:</span>
                        <span class="text-slate-400 font-mono">Stream: active</span>
                    </div>
                    <div id="syncTerminalLog" class="bg-slate-900 text-emerald-400 font-mono text-[11px] p-3 rounded-xl h-44 overflow-y-auto leading-relaxed border border-slate-800 shadow-inner space-y-1 scroll-smooth">
                        <!-- Stream logs dynamically injected here -->
                    </div>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex justify-between items-center">
                <span class="text-[11px] text-slate-500 font-medium">Tracking numbers from Avira are excluded per system protocol.</span>
                <button type="button" id="btnSyncCompleteDone" class="bg-blue-600 hover:bg-blue-700 text-white font-black text-xs px-5 py-2.5 rounded-xl uppercase tracking-wider shadow-xs transition-all cursor-pointer hidden">
                    Done & Refresh
                </button>
            </div>

        </div>
    </div>

    <!-- 📦 Raw Orders Data Carrier -->
    <script id="ordersDataCarrier" type="application/json"><%- JSON.stringify(orders || []) %></script>

    <script>
        // 📦 Master Orders State & Pagination Config
        let pageSize = 50; // 10, 25, 50, 100, or 'ALL'
        let currentPage = 1;
        let currentSortColumn = 'order_no';
        let currentSortDir = 'desc';
        let rawOrdersData = [];
        try {
            const dataElem = document.getElementById('ordersDataCarrier');
            rawOrdersData = dataElem ? JSON.parse(dataElem.textContent || '[]') : [];
        } catch (e) {
            console.error('Error parsing orders JSON:', e);
            rawOrdersData = [];
        }

        let allOrders = [...rawOrdersData];
        let filteredOrders = [...allOrders];

        // 🔢 Change Page Size (10, 25, 50, 100, ALL)
        function setOrdersPageSize(size) {
            pageSize = size;
            currentPage = 1;

            ['10', '25', '50', '100', 'ALL'].forEach(s => {
                const btn = document.getElementById(`pageSizeBtn-${s}`);
                if (btn) {
                    if (String(size) === s) {
                        btn.className = 'orders-page-size-btn px-2.5 py-1 text-[11px] font-black rounded-lg transition-all bg-white text-blue-600 shadow-xs cursor-pointer';
                    } else {
                        btn.className = 'orders-page-size-btn px-2.5 py-1 text-[11px] font-black rounded-lg transition-all text-slate-600 hover:text-blue-600 cursor-pointer';
                    }
                }
            });

            const modeBadge = document.getElementById('pageModeBadge');
            if (modeBadge) {
                modeBadge.innerText = size === 'ALL' ? 'Showing All' : `${size} per page`;
                modeBadge.className = size === 'ALL' 
                    ? 'text-[10px] bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold ml-1'
                    : 'text-[10px] bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full font-bold ml-1';
            }

            renderPaginatedTable();
        }

        // 🔀 Column Sorting (Order No, Tracking, Date, Member ID, Name, PV, Amount)
        function sortOrdersBy(col) {
            if (currentSortColumn === col) {
                currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortColumn = col;
                currentSortDir = 'asc';
            }

            ['seq', 'order_no', 'tracking_no', 'order_date', 'member_id', 'name', 'pv', 'amount'].forEach(c => {
                const icon = document.getElementById(`sortIcon-${c}`);
                if (icon) {
                    if (c === col) {
                        icon.className = currentSortDir === 'asc' 
                            ? 'fa-solid fa-sort-up text-[10px] text-blue-600' 
                            : 'fa-solid fa-sort-down text-[10px] text-blue-600';
                    } else {
                        icon.className = 'fa-solid fa-sort text-[10px] text-slate-300';
                    }
                }
            });

            applyFilterAndSort();
        }

        // 🔍 Filter & Sort Engine
        function applyFilterAndSort() {
            const query = (document.getElementById('orderSearchInput').value || '').toLowerCase().trim();

            filteredOrders = allOrders.filter(item => {
                if (!query) return true;
                const oNo = (item.order_no || '').toLowerCase();
                const mId = (item.member_id || '').toLowerCase();
                const mName = (item.name || '').toLowerCase();
                const trk = (item.tracking_no || '').toLowerCase();
                const oDate = (item.order_date || '').toLowerCase();
                const amt = (item.amount || '').toString();
                const pv = (item.pv || '').toString();
                return oNo.includes(query) || mId.includes(query) || mName.includes(query) || trk.includes(query) || oDate.includes(query) || amt.includes(query) || pv.includes(query);
            });

            filteredOrders.sort((a, b) => {
                let valA, valB;
                if (currentSortColumn === 'order_no') {
                    const matchA = a.order_no ? a.order_no.match(/ORD-(\d+)/i) : null;
                    const matchB = b.order_no ? b.order_no.match(/ORD-(\d+)/i) : null;
                    valA = matchA ? parseInt(matchA[1], 10) : (a.id || 0);
                    valB = matchB ? parseInt(matchB[1], 10) : (b.id || 0);
                } else if (currentSortColumn === 'seq') {
                    valA = a.id || 0;
                    valB = b.id || 0;
                } else if (currentSortColumn === 'amount') {
                    valA = parseFloat(a.amount || 0);
                    valB = parseFloat(b.amount || 0);
                } else if (currentSortColumn === 'pv') {
                    valA = parseFloat(a.pv || 0);
                    valB = parseFloat(b.pv || 0);
                } else if (currentSortColumn === 'order_date') {
                    valA = new Date(a.order_date || 0).getTime() || 0;
                    valB = new Date(b.order_date || 0).getTime() || 0;
                } else {
                    valA = (a[currentSortColumn] || '').toString().toLowerCase();
                    valB = (b[currentSortColumn] || '').toString().toLowerCase();
                }

                if (valA < valB) return currentSortDir === 'asc' ? -1 : 1;
                if (valA > valB) return currentSortDir === 'asc' ? 1 : -1;
                return 0;
            });

            currentPage = 1;
            renderPaginatedTable();
        }

        // Backward compatibility
        function toggleShowAllOrders() {
            setOrdersPageSize(pageSize === 'ALL' ? 50 : 'ALL');
        }

        // 🔄 Render Orders Table (Paginated or Show All)
        function renderPaginatedTable() {
            const total = filteredOrders.length;
            const countSpan = document.getElementById('showAllOrdersCount');
            if (countSpan) countSpan.innerText = total;

            let pageItems = [];
            let startIdx = 0;
            let endIdx = total;
            let totalPages = 1;
            const isAll = (pageSize === 'ALL');

            if (isAll) {
                pageItems = filteredOrders;
                startIdx = 0;
                endIdx = total;
                totalPages = 1;
                currentPage = 1;
            } else {
                const numericSize = parseInt(pageSize, 10) || 50;
                totalPages = Math.max(1, Math.ceil(total / numericSize));
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                startIdx = (currentPage - 1) * numericSize;
                endIdx = Math.min(startIdx + numericSize, total);
                pageItems = filteredOrders.slice(startIdx, endIdx);
            }

            // Update Counter Badges
            document.getElementById('ordersCounter').innerText = `${total} Records Saved`;
            document.getElementById('totalRecordsCount').innerText = total;
            document.getElementById('pageStart').innerText = total === 0 ? 0 : startIdx + 1;
            document.getElementById('pageEnd').innerText = endIdx;
            document.getElementById('currentPageNum').innerText = currentPage;
            document.getElementById('totalPagesNum').innerText = totalPages;

            // Update Button Disabled States
            document.getElementById('btnFirstPage').disabled = (currentPage === 1 || isShowAll);
            document.getElementById('btnPrevPage').disabled = (currentPage === 1 || isShowAll);
            document.getElementById('btnNextPage').disabled = (currentPage >= totalPages || total === 0 || isShowAll);
            document.getElementById('btnLastPage').disabled = (currentPage >= totalPages || total === 0 || isShowAll);

            // Render Page Number Pills
            if (isShowAll) {
                document.getElementById('pagePillsContainer').innerHTML = `<span class="px-2 py-1 text-slate-500 font-bold text-xs bg-slate-100 rounded-lg">All Records Visible</span>`;
            } else {
                renderPaginationPills(totalPages);
            }

            const tbody = document.getElementById('ordersTableBody');
            if (pageItems.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="10" class="py-12 text-center text-slate-400 font-medium">
                            No orders found. Click "Sync New Orders" or "Wipe & Sync All" above to pull live orders!
                        </td>
                    </tr>
                `;
                document.getElementById('selectAllCheckbox').checked = false;
                updateBulkDeleteButton();
                return;
            }

            tbody.innerHTML = pageItems.map((item, idx) => {
                const seq = startIdx + idx + 1;
                const orderBadge = item.order_no 
                    ? `<span class="px-2.5 py-0.5 rounded-lg bg-blue-50 text-blue-700 border border-blue-200 text-[11px] font-mono font-bold">${item.order_no}</span>`
                    : `<span class="text-slate-400 text-[10px]">MANUAL</span>`;
                
                // 🚚 Tracking Number Badge: If present show tracking, or shop pickup, or With..., otherwise show "Pending Dispatch"
                const trkClean = (item.tracking_no || '').trim();
                let trackingBadge = '';
                if (!trkClean) {
                    trackingBadge = `<span class="inline-flex items-center gap-1.5 font-bold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-lg text-[10px] uppercase tracking-wider"><span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse"></span> Pending Dispatch</span>`;
                } else if (trkClean.toUpperCase().includes('SHOP')) {
                    trackingBadge = `<span class="px-2.5 py-0.5 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 font-mono font-bold text-[11px] inline-flex items-center gap-1.5"><i class="fa-solid fa-shop text-[10px] text-emerald-600"></i> ${trkClean.toUpperCase()}</span>`;
                } else if (trkClean.toUpperCase().startsWith('WITH') || trkClean.toUpperCase().includes('WITH')) {
                    trackingBadge = `<span class="px-2.5 py-0.5 rounded-lg bg-purple-50 text-purple-700 border border-purple-200 font-mono font-bold text-[11px] inline-flex items-center gap-1.5 shadow-2xs" title="${trkClean}"><i class="fa-solid fa-link text-[10px] text-purple-600"></i> ${trkClean}</span>`;
                } else {
                    trackingBadge = `<span class="px-2.5 py-0.5 rounded-lg bg-blue-50 text-blue-700 border border-blue-200 font-mono font-bold text-[11px] inline-flex items-center gap-1.5"><i class="fa-solid fa-truck-fast text-[10px] text-blue-600"></i> ${trkClean}</span>`;
                }

                return `
                    <tr class="hover:bg-slate-50 transition-colors" id="order-row-${item.id}">
                        <td class="py-2.5 px-3 text-center">
                            <input type="checkbox" value="${item.id}" class="row-checkbox rounded text-blue-600 focus:ring-blue-500 h-4 w-4 cursor-pointer">
                        </td>
                        <td class="py-2.5 px-3 text-slate-400 font-mono text-[11px] text-center">${seq}</td>
                        <td class="py-2.5 px-4 font-mono">${orderBadge}</td>
                        <td class="py-2.5 px-4">${trackingBadge}</td>
                        <td class="py-2.5 px-4 font-semibold text-slate-800 row-date">${item.order_date || '-'}</td>
                        <td class="py-2.5 px-4 font-mono font-bold text-blue-700 row-memberid">${item.member_id || '-'}</td>
                        <td class="py-2.5 px-4 uppercase font-extrabold text-slate-900 row-name">${item.name || '-'}</td>
                        <td class="py-2.5 px-4 font-mono font-bold text-slate-700 row-pv">${item.pv || '0'}</td>
                        <td class="py-2.5 px-4 font-mono font-bold text-slate-900 row-amount">₹${item.amount || '0'}</td>
                        <td class="py-2.5 px-4 text-center space-x-2">
                            <button type="button" 
                                    data-id="${item.id}"
                                    data-date="${item.order_date || ''}"
                                    data-memberid="${item.member_id || ''}"
                                    data-name="${item.name || ''}"
                                    data-pv="${item.pv || ''}"
                                    data-amount="${item.amount || ''}"
                                    data-tracking="${item.tracking_no || ''}"
                                    class="btn-edit-order text-amber-600 hover:text-amber-800 font-bold cursor-pointer text-xs transition-colors">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </button>
                            <button type="button" data-order-id="${item.id}" class="btn-delete-order text-rose-500 hover:text-rose-700 font-bold cursor-pointer text-xs transition-colors">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

            // Reset select-all checkbox for the current page
            document.getElementById('selectAllCheckbox').checked = false;
            updateBulkDeleteButton();
        }

        // 🏷️ Pagination Number Pills Component
        function renderPaginationPills(totalPages) {
            const container = document.getElementById('pagePillsContainer');
            container.innerHTML = '';
            if (totalPages <= 1) return;

            const pages = [];
            if (totalPages <= 7) {
                for (let i = 1; i <= totalPages; i++) pages.push(i);
            } else {
                pages.push(1);
                if (currentPage > 3) pages.push('...');
                
                const start = Math.max(2, currentPage - 1);
                const end = Math.min(totalPages - 1, currentPage + 1);
                for (let i = start; i <= end; i++) {
                    if (!pages.includes(i)) pages.push(i);
                }

                if (currentPage < totalPages - 2) pages.push('...');
                if (!pages.includes(totalPages)) pages.push(totalPages);
            }

            pages.forEach(p => {
                if (p === '...') {
                    const span = document.createElement('span');
                    span.className = 'px-1.5 text-slate-400 text-xs font-bold';
                    span.innerText = '…';
                    container.appendChild(span);
                } else {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = (p === currentPage)
                        ? 'h-7 w-7 rounded-lg bg-blue-600 text-white font-black text-xs shadow-2xs cursor-default'
                        : 'h-7 w-7 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 font-bold text-xs cursor-pointer transition-all shadow-2xs';
                    btn.innerText = p;
                    if (p !== currentPage) {
                        btn.addEventListener('click', () => {
                            currentPage = p;
                            renderPaginatedTable();
                        });
                    }
                    container.appendChild(btn);
                }
            });
        }

        // Pagination Navigation Event Listeners
        document.getElementById('btnFirstPage').addEventListener('click', () => {
            if (currentPage > 1 && !isShowAll) {
                currentPage = 1;
                renderPaginatedTable();
            }
        });
        document.getElementById('btnPrevPage').addEventListener('click', () => {
            if (currentPage > 1 && !isShowAll) {
                currentPage--;
                renderPaginatedTable();
            }
        });
        document.getElementById('btnNextPage').addEventListener('click', () => {
            const totalPages = Math.ceil(filteredOrders.length / PAGE_SIZE);
            if (currentPage < totalPages && !isShowAll) {
                currentPage++;
                renderPaginatedTable();
            }
        });
        document.getElementById('btnLastPage').addEventListener('click', () => {
            const totalPages = Math.ceil(filteredOrders.length / PAGE_SIZE);
            if (currentPage < totalPages && !isShowAll) {
                currentPage = totalPages;
                renderPaginatedTable();
            }
        });

        // 🔍 Real-Time Order Search Filter
        function applyFilter() {
            const q = (document.getElementById('orderSearchInput').value || '').toLowerCase().trim();
            if (!q) {
                filteredOrders = [...allOrders];
            } else {
                filteredOrders = allOrders.filter(o => {
                    const no = (o.order_no || '').toLowerCase();
                    const trk = (o.tracking_no || '').toLowerCase();
                    const mem = (o.member_id || '').toLowerCase();
                    const nm = (o.name || '').toLowerCase();
                    const dt = (o.order_date || '').toLowerCase();
                    const pv = (o.pv || '').toString().toLowerCase();
                    const amt = (o.amount || '').toString().toLowerCase();
                    return no.includes(q) || trk.includes(q) || mem.includes(q) || nm.includes(q) || dt.includes(q) || pv.includes(q) || amt.includes(q);
                });
            }
            currentPage = 1;
            renderPaginatedTable();
        }

        const searchInput = document.getElementById('orderSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', applyFilter);
        }

        // 🔄 Fetch and Refresh Orders from Server
        async function fetchOrdersListFromServer() {
            try {
                const res = await fetch('/admin/api/orders-list');
                const data = await res.json();
                if (data.success && Array.isArray(data.orders)) {
                    allOrders = sortOrdersLatestFirst(data.orders);
                    applyFilter();
                }
            } catch (err) {
                console.error("Failed to fetch updated orders list:", err);
            }
        }

        // 🗑️ Instant Wipe Helper (Deletes immediately from DB and UI)
        async function executeInstantWipe() {
            try {
                const res = await fetch('/admin/api/wipe-orders', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    allOrders = [];
                    filteredOrders = [];
                    currentPage = 1;
                    renderPaginatedTable();
                    return true;
                } else {
                    alert("Error wiping orders: " + (data.msg || "Unknown error"));
                    return false;
                }
            } catch (err) {
                console.error("Wipe failed:", err);
                alert("Server error wiping orders repository.");
                return false;
            }
        }

        // Direct Wipe Button Handler
        const btnDirectWipe = document.getElementById('btnDirectWipe');
        if (btnDirectWipe) {
            btnDirectWipe.addEventListener('click', async function() {
                const confirmed = confirm("⚠️ WIPE ALL ORDERS CONFIRMATION\n\nAre you sure you want to permanently DELETE ALL records from Orders Master?\n\nThe table will be emptied immediately.");
                if (confirmed) {
                    this.disabled = true;
                    this.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-rose-500"></i> Wiping...`;
                    await executeInstantWipe();
                    this.disabled = false;
                    this.innerHTML = `<i class="fa-solid fa-broom text-rose-500"></i> Wipe All Orders`;
                }
            });
        }

        function formatMemberIdInput(el) {
            let raw = el.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            if (!raw) {
                el.value = '';
                return;
            }
            if (raw === 'A' || raw === 'AV') {
                el.value = raw;
                return;
            }
            if (raw.startsWith('AV')) {
                let num = raw.slice(2).replace(/[^0-9]/g, '').slice(0, 6);
                el.value = 'AV' + num;
            } else {
                let num = raw.replace(/[^0-9]/g, '').slice(0, 6);
                el.value = num.length > 0 ? 'AV' + num : '';
            }
        }

        const editModal = document.getElementById('editOrderModal');

        document.addEventListener('click', function(e) {
            const editBtn = e.target.closest('.btn-edit-order');
            if (editBtn) {
                document.getElementById('editOrderId').value = editBtn.getAttribute('data-id');
                document.getElementById('editOrderDate').value = editBtn.getAttribute('data-date');
                document.getElementById('editMemberId').value = editBtn.getAttribute('data-memberid');
                document.getElementById('editName').value = editBtn.getAttribute('data-name');
                document.getElementById('editPv').value = editBtn.getAttribute('data-pv');
                document.getElementById('editAmount').value = editBtn.getAttribute('data-amount');
                document.getElementById('editTrackingNo').value = editBtn.getAttribute('data-tracking') || '';

                toggleWithSelector(false);
                editModal.classList.remove('hidden');
                editModal.classList.add('flex');
            }
        });

        document.getElementById('btnCloseOrderModal').addEventListener('click', closeEditModal);
        document.getElementById('btnCancelOrderModal').addEventListener('click', closeEditModal);

        function closeEditModal() {
            toggleWithSelector(false);
            editModal.classList.add('hidden');
            editModal.classList.remove('flex');
        }

        // 🔗 With... Parcel Linking Helpers
        function setEditTrackingShoppee() {
            document.getElementById('editTrackingNo').value = 'SHOP PICKUP';
            toggleWithSelector(false);
        }

        function clearEditTracking() {
            document.getElementById('editTrackingNo').value = '';
            toggleWithSelector(false);
        }

        let withOrdersCache = [];

        function toggleWithSelector(forceState) {
            const container = document.getElementById('withSelectorContainer');
            if (!container) return;
            const willShow = forceState !== undefined ? forceState : container.classList.contains('hidden');
            if (willShow) {
                container.classList.remove('hidden');
                populateWithOrdersList();
                setTimeout(() => document.getElementById('withSearchInput')?.focus(), 50);
            } else {
                container.classList.add('hidden');
            }
        }

        function populateWithOrdersList() {
            const searchInput = document.getElementById('withSearchInput');
            if (searchInput) searchInput.value = '';

            const currentId = parseInt(document.getElementById('editOrderId')?.value || '0', 10);
            const currentMemberId = (document.getElementById('editMemberId')?.value || '').trim().toUpperCase();

            // Filter out the order being edited
            withOrdersCache = (allOrders || []).filter(o => o.id !== currentId);
            renderWithOrdersList(withOrdersCache, currentMemberId);
        }

        function renderWithOrdersList(orders, currentMemberId) {
            const listEl = document.getElementById('withOrdersList');
            if (!listEl) return;

            if (orders.length === 0) {
                listEl.innerHTML = `<div class="p-3 text-center text-slate-400 text-xs">No matching orders found.</div>`;
                return;
            }

            // Separate same-member orders and other orders
            const sameMemberOrders = currentMemberId ? orders.filter(o => (o.member_id || '').toUpperCase().trim() === currentMemberId) : [];
            const otherOrders = currentMemberId ? orders.filter(o => (o.member_id || '').toUpperCase().trim() !== currentMemberId) : orders;

            let html = '';

            if (sameMemberOrders.length > 0) {
                html += `
                    <div class="px-2.5 py-1 bg-purple-100 text-purple-900 font-extrabold text-[10px] uppercase tracking-wider flex items-center gap-1 sticky top-0 z-10 shadow-2xs">
                        <i class="fa-solid fa-star text-amber-500 text-[9px]"></i> Same Member Orders (${currentMemberId}):
                    </div>
                `;
                html += sameMemberOrders.map(o => renderWithOrderItem(o, true)).join('');
            }

            if (otherOrders.length > 0) {
                if (sameMemberOrders.length > 0) {
                    html += `
                        <div class="px-2.5 py-1 bg-slate-100 text-slate-600 font-bold text-[10px] uppercase tracking-wider sticky top-0 z-10">
                            Other Recent Orders:
                        </div>
                    `;
                }
                html += otherOrders.slice(0, 50).map(o => renderWithOrderItem(o, false)).join('');
            }

            listEl.innerHTML = html;
        }

        function renderWithOrderItem(o, isSameMember) {
            const trk = (o.tracking_no || '').trim();
            const safeOrderNo = (o.order_no || 'ORD-' + o.id).replace(/'/g, "\\'");
            const safeTracking = trk.replace(/'/g, "\\'");

            return `
                <div onclick="selectWithOrder('${safeOrderNo}', '${safeTracking}')" 
                     class="p-2 hover:bg-purple-50 cursor-pointer transition-colors flex items-center justify-between gap-2 text-xs select-none">
                    <div class="min-w-0">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="font-mono font-bold ${isSameMember ? 'text-purple-700 bg-purple-50 border border-purple-200' : 'text-slate-800 bg-slate-100'} px-1.5 py-0.2 rounded text-[11px]">${o.order_no || '-'}</span>
                            <span class="font-black text-slate-900 uppercase truncate max-w-[150px]">${o.name || '-'}</span>
                            <span class="text-blue-700 font-mono text-[10px]">${o.member_id || ''}</span>
                        </div>
                        <div class="text-[10px] text-slate-400 font-mono mt-0.5">
                            ${o.order_date || ''} ${o.amount ? '• ₹' + o.amount : ''}
                        </div>
                    </div>
                    <div class="text-right flex-shrink-0">
                        ${trk 
                            ? `<span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold ${trk.toUpperCase().includes('SHOP') ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-blue-50 text-blue-700 border border-blue-200'}">${trk}</span>` 
                            : `<span class="text-[10px] text-amber-700 font-medium">No tracking</span>`}
                    </div>
                </div>
            `;
        }

        function selectWithOrder(orderNo, trackingNo) {
            const input = document.getElementById('editTrackingNo');
            if (!input) return;

            let withText = `WITH ${orderNo}`;
            if (trackingNo && !trackingNo.toUpperCase().includes('SHOP') && !trackingNo.toUpperCase().startsWith('WITH')) {
                withText = `WITH ${orderNo} (${trackingNo})`;
            }

            input.value = withText;
            toggleWithSelector(false);
            input.focus();
        }

        function filterWithOrders(q) {
            const query = (q || '').toLowerCase().trim();
            const currentMemberId = (document.getElementById('editMemberId')?.value || '').trim().toUpperCase();

            if (!query) {
                renderWithOrdersList(withOrdersCache, currentMemberId);
                return;
            }

            const filtered = withOrdersCache.filter(o => {
                const no = (o.order_no || '').toLowerCase();
                const trk = (o.tracking_no || '').toLowerCase();
                const mem = (o.member_id || '').toLowerCase();
                const nm = (o.name || '').toLowerCase();
                return no.includes(query) || trk.includes(query) || mem.includes(query) || nm.includes(query);
            });

            renderWithOrdersList(filtered, currentMemberId);
        }

        document.getElementById('editOrderForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('editOrderId').value;
            const btn = document.getElementById('btnSaveOrderEdit');
            
            btn.innerText = "SAVING...";
            btn.disabled = true;

            const payload = {
                orderDate: document.getElementById('editOrderDate').value,
                memberId: document.getElementById('editMemberId').value,
                name: document.getElementById('editName').value,
                pv: document.getElementById('editPv').value,
                amount: document.getElementById('editAmount').value,
                trackingNo: document.getElementById('editTrackingNo').value.trim()
            };

            try {
                const res = await fetch(`/admin/api/update-order/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                if (result.success) {
                    allOrders = sortOrdersLatestFirst(result.orders);
                    applyFilter();
                    closeEditModal();
                } else {
                    alert("Error: " + result.msg);
                }
            } catch (err) {
                console.error(err);
                alert("Server error updating order.");
            } finally {
                btn.innerText = "Save Changes";
                btn.disabled = false;
            }
        });

        document.addEventListener('click', async function(e) {
            const delBtn = e.target.closest('.btn-delete-order');
            if (delBtn) {
                const id = delBtn.getAttribute('data-order-id');
                if (id && confirm("Are you sure you want to delete this order entry?")) {
                    try {
                        const res = await fetch('/admin/api/delete-order/' + id, { method: 'DELETE' });
                        const result = await res.json();
                        if (result.success) {
                            allOrders = sortOrdersLatestFirst(result.orders);
                            applyFilter();
                        }
                    } catch (err) {
                        console.error(err);
                    }
                }
            }
        });

        document.getElementById('selectAllCheckbox').addEventListener('change', function() {
            const isChecked = this.checked;
            document.querySelectorAll('.row-checkbox').forEach(cb => {
                cb.checked = isChecked;
            });
            updateBulkDeleteButton();
        });

        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('row-checkbox')) {
                updateBulkDeleteButton();
            }
        });

        function updateBulkDeleteButton() {
            const selectedCheckboxes = document.querySelectorAll('.row-checkbox:checked');
            const bulkBtn = document.getElementById('btnBulkDelete');
            const bulkShoppeeBtn = document.getElementById('btnBulkShoppee');
            const counterSpan = document.getElementById('selectedCount');
            const shoppeeCounterSpan = document.getElementById('selectedShoppeeCount');

            if (selectedCheckboxes.length > 0) {
                if (counterSpan) {
                    counterSpan.innerText = selectedCheckboxes.length;
                } else if (bulkBtn) {
                    bulkBtn.innerHTML = `<i class="fa-solid fa-trash"></i> Delete Selected (<span id="selectedCount">${selectedCheckboxes.length}</span>)`;
                }

                if (shoppeeCounterSpan) {
                    shoppeeCounterSpan.innerText = selectedCheckboxes.length;
                } else if (bulkShoppeeBtn) {
                    bulkShoppeeBtn.innerHTML = `<i class="fa-solid fa-shop"></i> Shoppee (<span id="selectedShoppeeCount">${selectedCheckboxes.length}</span>)`;
                }

                if (bulkShoppeeBtn) {
                    bulkShoppeeBtn.classList.remove('hidden');
                    bulkShoppeeBtn.classList.add('flex');
                }
                if (bulkBtn) {
                    bulkBtn.classList.remove('hidden');
                    bulkBtn.classList.add('flex');
                }
            } else {
                if (bulkShoppeeBtn) {
                    bulkShoppeeBtn.classList.add('hidden');
                    bulkShoppeeBtn.classList.remove('flex');
                }
                if (bulkBtn) {
                    bulkBtn.classList.add('hidden');
                    bulkBtn.classList.remove('flex');
                }
                const selectAll = document.getElementById('selectAllCheckbox');
                if (selectAll) selectAll.checked = false;
            }
        }

        // 🏬 Bulk Shoppee / Shop Pickup Handler
        document.getElementById('btnBulkShoppee')?.addEventListener('click', async function() {
            const selectedCheckboxes = document.querySelectorAll('.row-checkbox:checked');
            const selectedIds = Array.from(selectedCheckboxes).map(cb => parseInt(cb.value)).filter(id => !isNaN(id));

            if (selectedIds.length === 0) return;

            if (confirm(`Set ${selectedIds.length} selected orders as "SHOP PICKUP" (Shoppee)?`)) {
                const origHtml = this.innerHTML;
                this.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Updating...`;
                this.disabled = true;

                try {
                    const res = await fetch('/admin/api/bulk-shoppee-orders', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids: selectedIds })
                    });
                    const result = await res.json();

                    if (result.success) {
                        allOrders = sortOrdersLatestFirst(result.orders);
                        applyFilter();
                    } else {
                        alert(result.msg || "Bulk Shoppee update failed!");
                    }
                } catch (err) {
                    console.error("Bulk Shoppee error:", err);
                    alert("Server error during bulk Shoppee update.");
                } finally {
                    this.disabled = false;
                    this.innerHTML = origHtml;
                    updateBulkDeleteButton();
                }
            }
        });

        document.getElementById('btnBulkDelete').addEventListener('click', async function() {
            const selectedCheckboxes = document.querySelectorAll('.row-checkbox:checked');
            const selectedIds = Array.from(selectedCheckboxes).map(cb => parseInt(cb.value)).filter(id => !isNaN(id));

            if (selectedIds.length === 0) return;

            if (confirm(`Warning! Do you really want to delete all ${selectedIds.length} selected orders permanently?`)) {
                this.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Deleting...`;
                this.disabled = true;

                try {
                    const res = await fetch('/admin/api/delete-multiple-orders', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids: selectedIds })
                    });
                    const result = await res.json();

                    if (result.success) {
                        allOrders = sortOrdersLatestFirst(result.orders);
                        applyFilter();
                    } else {
                        alert(result.msg || "Deletion failed!");
                    }
                } catch (err) {
                    console.error("Bulk delete error:", err);
                    alert("Server error during bulk delete.");
                } finally {
                    this.disabled = false;
                    this.innerHTML = `<i class="fa-solid fa-trash"></i> Delete Selected (<span id="selectedCount">0</span>)`;
                    updateBulkDeleteButton();
                }
            }
        });

        // 🚀 Real-Time Live Sync Engine Controller
        const syncModal = document.getElementById('syncProgressModal');
        const progressBar = document.getElementById('syncProgressBar');
        const percentText = document.getElementById('syncPercentText');
        const stepText = document.getElementById('syncStepText');
        const statPage = document.getElementById('statPage');
        const statOrders = document.getElementById('statOrders');
        const statStatus = document.getElementById('statStatus');
        const terminalLog = document.getElementById('syncTerminalLog');
        const btnModalDone = document.getElementById('btnSyncCompleteDone');
        const btnModalClose = document.getElementById('btnSyncModalClose');
        const modalSpinner = document.getElementById('modalSpinner');
        const modalIconWrap = document.getElementById('modalIconWrap');

        let activeEventSource = null;

        function appendTerminalLog(msg, isError = false) {
            const time = new Date().toLocaleTimeString();
            const logLine = document.createElement('div');
            logLine.className = 'flex items-start gap-2';
            logLine.innerHTML = `
                <span class="text-slate-500 font-mono text-[10px] flex-shrink-0">[${time}]</span>
                <span class="${isError ? 'text-rose-400 font-bold' : 'text-emerald-300'}">${msg}</span>
            `;
            terminalLog.appendChild(logLine);
            terminalLog.scrollTop = terminalLog.scrollHeight;
        }

        async function startLiveSync(mode) {
            const syncModal = document.getElementById('syncProgressModal');
            const progressBar = document.getElementById('syncProgressBar');
            const percentText = document.getElementById('syncPercentText');
            const stepText = document.getElementById('syncStepText');
            const statPage = document.getElementById('statPage');
            const statOrders = document.getElementById('statOrders');
            const statStatus = document.getElementById('statStatus');
            const terminalLog = document.getElementById('syncTerminalLog');
            const btnModalDone = document.getElementById('btnSyncCompleteDone');
            const btnModalClose = document.getElementById('btnSyncModalClose');
            const modalSpinner = document.getElementById('modalSpinner');
            const modalIconWrap = document.getElementById('modalIconWrap');
            const modalTitle = document.getElementById('modalTitle');

            // Reset modal state
            if (progressBar) {
                progressBar.style.width = '0%';
                progressBar.className = 'h-full bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full transition-all duration-300 ease-out shadow-xs';
            }
            if (percentText) percentText.innerText = '0%';
            if (stepText) stepText.innerText = mode === 'wipe_all' ? 'Initiating full wipe & catalog sync...' : 'Starting sync for new orders...';
            if (statPage) statPage.innerText = '-';
            if (statOrders) statOrders.innerText = '0';
            if (statStatus) {
                statStatus.innerText = 'CONNECTING';
                statStatus.className = 'text-xs font-black text-blue-600 font-mono mt-1 uppercase tracking-wide';
            }
            if (terminalLog) terminalLog.innerHTML = '';
            
            if (modalSpinner) modalSpinner.className = 'fa-solid fa-rotate fa-spin';
            if (modalIconWrap) modalIconWrap.className = 'h-9 w-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-sm border border-blue-200';

            if (btnModalDone) btnModalDone.classList.add('hidden');
            if (btnModalClose) btnModalClose.classList.add('hidden');

            if (modalTitle) modalTitle.innerText = mode === 'wipe_all' ? 'Wipe & Full Re-sync in Progress' : 'Syncing New Orders';
            
            // Show modal immediately
            if (syncModal) {
                syncModal.classList.remove('hidden');
                syncModal.classList.add('flex');
            }

            appendTerminalLog(`🚀 [Sync Engine] Initialized in ${mode.toUpperCase()} mode.`);
            appendTerminalLog(`🌐 Connecting to Avira Admin portal...`);

            if (activeEventSource) {
                activeEventSource.close();
            }

            activeEventSource = new EventSource(`/admin/api/order-sync-stream?mode=${encodeURIComponent(mode)}`);

            activeEventSource.onmessage = async function(event) {
                try {
                    const data = JSON.parse(event.data);

                    if (data.percent !== undefined) {
                        progressBar.style.width = `${data.percent}%`;
                        percentText.innerText = `${data.percent}%`;
                    }

                    if (data.message) {
                        stepText.innerText = data.message;
                        appendTerminalLog(data.message, data.step === 'error');
                    }

                    if (data.page) {
                        statPage.innerText = `${data.page} / ${data.totalPages || data.maxPages || '?'}`;
                    }

                    if (data.totalNewAdded !== undefined) {
                        statOrders.innerText = data.totalNewAdded;
                    }

                    if (data.step) {
                        statStatus.innerText = data.step.toUpperCase();
                    }

                    // On Successful Completion
                    if (data.step === 'done') {
                        activeEventSource.close();
                        progressBar.style.width = '100%';
                        percentText.innerText = '100%';
                        statStatus.innerText = 'COMPLETED';
                        statStatus.className = 'text-xs font-black text-emerald-600 font-mono mt-1 uppercase tracking-wide';
                        
                        modalSpinner.className = 'fa-solid fa-check text-emerald-600';
                        modalIconWrap.className = 'h-9 w-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm border border-emerald-200';

                        btnModalDone.classList.remove('hidden');
                        btnModalClose.classList.remove('hidden');

                        // Automatically fetch and render fresh latest orders
                        await fetchOrdersListFromServer();
                    }

                    // On Error
                    if (data.step === 'error') {
                        activeEventSource.close();
                        statStatus.innerText = 'ERROR';
                        statStatus.className = 'text-xs font-black text-rose-600 font-mono mt-1 uppercase tracking-wide';
                        modalSpinner.className = 'fa-solid fa-triangle-exclamation text-rose-600';
                        modalIconWrap.className = 'h-9 w-9 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-sm border border-rose-200';
                        btnModalClose.classList.remove('hidden');
                    }

                } catch (e) {
                    console.error('Error parsing sync event:', e);
                }
            };

            activeEventSource.onerror = async function() {
                if (activeEventSource.readyState === EventSource.CLOSED) {
                    btnModalClose.classList.remove('hidden');
                    btnModalDone.classList.remove('hidden');
                } else {
                    appendTerminalLog("Stream connection closed or completed.", false);
                    activeEventSource.close();
                    btnModalClose.classList.remove('hidden');
                    btnModalDone.classList.remove('hidden');
                    await fetchOrdersListFromServer();
                }
            };
        }

        // Option 1 Button: Sync New Orders
        const btnSyncNew = document.getElementById('btnSyncNew');
        if (btnSyncNew) {
            btnSyncNew.addEventListener('click', () => startLiveSync('new'));
        }

        // Option 2 Button: Wipe & Sync All
        const btnWipeAll = document.getElementById('btnWipeAll');
        if (btnWipeAll) {
            btnWipeAll.addEventListener('click', async () => {
                const confirmed = confirm("⚠️ WARNING: Wipe & Sync All\n\nThis will completely DELETE all current records from Orders Master immediately and re-download all orders from Avira Website.\n\nAre you sure you want to proceed?");
                if (confirmed) {
                    // Wipe immediately so UI and DB are emptied right away
                    await executeInstantWipe();
                    // Launch full catalog re-sync
                    startLiveSync('wipe_all');
                }
            });
        }

        // ⏸️ Toggle Auto-Sync Button Handler (Pause / Resume)
        const btnToggleAutoSync = document.getElementById('btnToggleAutoSync');
        if (btnToggleAutoSync) {
            btnToggleAutoSync.addEventListener('click', async function() {
                this.disabled = true;
                try {
                    const res = await fetch('/admin/api/toggle-auto-sync', { method: 'POST' });
                    const data = await res.json();
                    if (data.success) {
                        const isEnabled = data.isAutoSyncEnabled;
                        const badge = document.getElementById('autoSyncBadge');
                        const dot = document.getElementById('autoSyncDot');
                        const badgeText = document.getElementById('autoSyncBadgeText');
                        const icon = document.getElementById('toggleSyncIcon');
                        const text = document.getElementById('toggleSyncText');

                        if (isEnabled) {
                            badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-[11px] font-bold';
                            dot.className = 'h-2 w-2 rounded-full bg-emerald-500 animate-pulse';
                            badgeText.innerText = 'Auto-Sync Active (5m)';
                            icon.className = 'fa-solid fa-pause text-amber-600 text-[10px]';
                            text.innerText = 'Pause Auto-Sync';
                        } else {
                            badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-700 text-[11px] font-bold';
                            dot.className = 'h-2 w-2 rounded-full bg-amber-500';
                            badgeText.innerText = 'Auto-Sync Paused';
                            icon.className = 'fa-solid fa-play text-emerald-600 text-[10px]';
                            text.innerText = 'Resume Auto-Sync';
                        }
                    } else {
                        alert(data.msg || 'Unable to toggle auto-sync.');
                    }
                } catch (e) {
                    console.error('Toggle error:', e);
                    alert('Server error toggling auto-sync.');
                } finally {
                    this.disabled = false;
                }
            });
        }

        // Modal Close & Done Button Listeners
        const closeModal = async () => {
            syncModal.classList.add('hidden');
            syncModal.classList.remove('flex');
            await fetchOrdersListFromServer();
        };

        if (btnModalDone) btnModalDone.addEventListener('click', closeModal);
        // 📋 1-Click Copy Master Tracking Numbers for India Post Bulk Tracking
        async function copyMasterTrackingNumbers() {
            const btn = document.getElementById('btnCopyAllTrackings');
            const icon = document.getElementById('copyMasterIcon');
            const text = document.getElementById('copyMasterText');
            
            try {
                if (btn) btn.disabled = true;
                if (text) text.innerText = 'Fetching IDs...';

                const res = await fetch('/admin/api/tracking-numbers-list');
                const data = await res.json();
                
                let list = [];
                if (data.success && data.active && data.active.length > 0) {
                    list = data.active;
                } else if (data.success && data.all && data.all.length > 0) {
                    list = data.all;
                } else {
                    const localList = [];
                    ordersMasterData.forEach(o => {
                        const trk = (o.tracking_no || '').trim().toUpperCase();
                        if (trk && trk !== 'SHOP PICKUP' && trk !== 'PENDING' && trk !== '-') {
                            localList.push(trk);
                        }
                    });
                    list = [...new Set(localList)];
                }

                if (!list.length) {
                    alert('No tracking numbers found to copy.');
                    if (btn) btn.disabled = false;
                    if (text) text.innerText = 'Copy Tracking IDs';
                    return;
                }

                await navigator.clipboard.writeText(list.join('\n'));
                if (icon) icon.className = 'fa-solid fa-check text-emerald-600';
                if (text) text.innerText = `Copied ${list.length} IDs!`;
                
                setTimeout(() => {
                    if (icon) icon.className = 'fa-regular fa-copy text-emerald-600';
                    if (text) text.innerText = 'Copy Tracking IDs';
                    if (btn) btn.disabled = false;
                }, 2500);
            } catch (err) {
                console.error('Copy tracking numbers error:', err);
                alert('Failed to copy tracking numbers: ' + err.message);
                if (btn) btn.disabled = false;
                if (text) text.innerText = 'Copy Tracking IDs';
            }
        }

        // Initial render on page load
        renderPaginatedTable();
    </script>
</body>
</html>
