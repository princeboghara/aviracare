<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Query Manager - Avira Control</title>
</head>
<body class="bg-gradient-to-br from-slate-50 to-amber-50/30 min-h-screen font-sans antialiased text-slate-800 w-full overflow-x-hidden block">

    <%- include('../partials/admin_navbar') %>

    <div class="w-full lg:pl-64 min-h-screen flex flex-col justify-between box-border">
        
        <header class="bg-white/80 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 flex justify-between items-center sticky top-0 z-40 shadow-sm w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-headset text-amber-500 flex-shrink-0"></i>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider truncate">Control Panel / Query Support Workspace</span>
            </div>
            <span class="text-[10px] font-bold text-slate-400 bg-slate-100 px-3 py-1 rounded-xl flex-shrink-0 ml-2">Total Tickets: <%= tickets.length %></span>
        </header>

        <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-8 py-6 space-y-6 box-border">
            <div class="bg-white rounded-2xl border border-slate-100 shadow-md overflow-hidden w-full">
                <div class="px-6 py-4 bg-slate-50 border-b border-slate-100 flex justify-between items-center">
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                            <i class="fa-solid fa-ticket text-emerald-500"></i> Member Support Tickets & Resolutions
                        </h2>
                        <p class="text-[10px] text-slate-400 mt-0.5">Click "Reply" to respond directly to member queries so they can see the solution in their portal.</p>
                    </div>
                </div>

                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap sm:whitespace-normal">
                        <thead>
                            <tr class="bg-slate-100/70 border-b border-slate-100 text-slate-400 font-bold uppercase text-[10px]">
                                <th class="py-3 px-4 w-12">ID</th>
                                <th class="py-3 px-4 w-36">Member Info</th>
                                <th class="py-3 px-4 w-44">Subject / Contact</th>
                                <th class="py-3 px-4 min-w-[220px]">Member Query & Admin Reply</th>
                                <th class="py-3 px-4 w-28 text-center">Status</th>
                                <th class="py-3 px-4 text-center w-48">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50 font-medium text-slate-700">
                            <% if(!tickets || tickets.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="py-12 text-center text-slate-400 font-bold">
                                        <i class="fa-solid fa-circle-check text-2xl block mb-2 text-emerald-300"></i>
                                        ALL QUERIES ARE SOLVED & UP TO DATE
                                    </td>
                                </tr>
                            <% } else { %>
                                <% tickets.forEach((ticket) => { %>
                                    <tr class="hover:bg-slate-50/40 transition-colors" id="ticket-row-<%= ticket.id %>">
                                        <td class="py-3 px-4 font-mono font-bold text-slate-900">#<%= ticket.id %></td>
                                        <td class="py-3 px-4">
                                            <div class="font-bold text-slate-900 uppercase"><%= ticket.name || 'N/A' %></div>
                                            <div class="font-mono text-[10px] font-bold text-emerald-600 uppercase"><%= ticket.member_id %></div>
                                        </td>
                                        <td class="py-3 px-4">
                                            <div class="font-bold text-slate-900 uppercase"><%= ticket.subject %></div>
                                            <div class="text-[10px] text-slate-400 mt-0.5"><i class="fa-solid fa-phone"></i> <%= ticket.contact_no %></div>
                                        </td>
                                        <td class="py-3 px-4 space-y-2">
                                            <div class="text-slate-700 font-normal pr-4 max-w-sm break-words bg-slate-50/80 p-2.5 rounded-xl border border-slate-100">
                                                <span class="text-[9px] font-bold text-slate-400 block uppercase mb-0.5">Query Description:</span>
                                                <%= ticket.description %>
                                            </div>

                                            <% if(ticket.admin_reply) { %>
                                                <div class="bg-emerald-50 border border-emerald-200/80 rounded-xl p-2.5 max-w-sm space-y-0.5">
                                                    <div class="flex items-center justify-between text-[9px] font-bold text-emerald-800 uppercase">
                                                        <span><i class="fa-solid fa-reply text-emerald-600 mr-1"></i> Admin Reply:</span>
                                                    </div>
                                                    <p class="text-[11px] font-semibold text-emerald-950 break-words leading-relaxed"><%= ticket.admin_reply %></p>
                                                </div>
                                            <% } else { %>
                                                <div class="text-[10px] text-amber-600 font-semibold flex items-center gap-1">
                                                    <i class="fa-solid fa-clock text-amber-500"></i> No reply sent yet
                                                </div>
                                            <% } %>
                                        </td>
                                        <td class="py-3 px-4 text-center">
                                            <% if(ticket.status === 'PENDING') { %>
                                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-amber-50 text-amber-700 border border-amber-200">PENDING</span>
                                            <% } else if(ticket.status === 'ACCEPTED') { %>
                                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-blue-50 text-blue-700 border border-blue-200">ACCEPTED</span>
                                            <% } else { %>
                                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-50 text-emerald-700 border border-emerald-200">SOLVED</span>
                                            <% } %>
                                        </td>
                                        <td class="py-3 px-4 text-center">
                                            <div class="flex items-center justify-center gap-1.5 flex-wrap">
                                                <button type="button" 
                                                        onclick="openReplyModal('<%= ticket.id %>', '<%= escape(ticket.name || '') %>', '<%= ticket.member_id %>', '<%= escape(ticket.subject || '') %>', '<%= escape(ticket.description || '') %>', '<%= escape(ticket.admin_reply || '') %>', '<%= ticket.status %>')"
                                                        class="bg-emerald-600 hover:bg-emerald-700 text-white text-[10px] font-black px-3 py-1.5 rounded-lg transition-all uppercase cursor-pointer shadow-xs flex items-center gap-1">
                                                    <i class="fa-solid fa-reply"></i> <%= ticket.admin_reply ? 'Edit Reply' : 'Reply' %>
                                                </button>
                                                <button type="button" onclick="updateStatus('<%= ticket.id %>', 'SOLVED')" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-bold px-2 py-1.5 rounded-lg transition-all uppercase cursor-pointer" title="Mark as Solved">
                                                    <i class="fa-solid fa-check text-emerald-600"></i>
                                                </button>
                                                <button type="button" onclick="deleteTicket('<%= ticket.id %>')" class="bg-rose-50 hover:bg-rose-100 text-rose-600 text-[10px] font-bold px-2 py-1.5 rounded-lg transition-all uppercase cursor-pointer" title="Delete Ticket">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <footer class="bg-white border-t border-slate-100 py-4 text-center text-xs font-medium text-slate-400 mt-8 w-full overflow-hidden">
            &copy; 2026 Avira Control Center. Secure Support Workspace.
        </footer>
    </div>

    <!-- 💬 Reply to Query Modal -->
    <div id="replyModal" class="hidden fixed inset-0 bg-slate-950/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl w-full max-w-lg overflow-hidden border border-slate-200 shadow-2xl space-y-4">
            <div class="bg-slate-900 px-6 py-4 text-white flex justify-between items-center">
                <h3 class="text-sm font-black uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-reply text-emerald-400"></i> Send Query Resolution Reply
                </h3>
                <button type="button" onclick="closeReplyModal()" class="text-slate-400 hover:text-white font-bold text-lg cursor-pointer">&times;</button>
            </div>

            <form id="replyQueryForm" class="p-6 space-y-4 text-xs">
                <input type="hidden" id="replyTicketId">

                <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/70 space-y-1">
                    <div class="flex justify-between items-center">
                        <span id="replyMemberInfo" class="font-bold text-slate-800"></span>
                        <span id="replyTicketNumber" class="font-mono font-bold text-emerald-600"></span>
                    </div>
                    <p id="replySubject" class="font-bold text-slate-700"></p>
                    <p id="replyDesc" class="text-slate-500 text-[11px] pt-1 border-t border-slate-200/50"></p>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Admin Reply / Solution Message <span class="text-rose-500">*</span>
                    </label>
                    <textarea id="replyMessage" rows="4" required placeholder="Type your response/solution to the member here..."
                              class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-emerald-500 focus:bg-white transition-all text-slate-800"></textarea>
                    <p class="text-[10px] text-slate-400 mt-1">This reply will be visible to the member when they check their ticket history.</p>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">Ticket Status</label>
                    <select id="replyStatus" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-xs text-slate-800 focus:outline-none focus:border-emerald-500">
                        <option value="SOLVED" selected>SOLVED (Issue Resolved)</option>
                        <option value="ACCEPTED">ACCEPTED (In Progress)</option>
                        <option value="PENDING">PENDING (Awaiting More Info)</option>
                    </select>
                </div>

                <div class="flex justify-end gap-2.5 pt-2 border-t border-slate-100">
                    <button type="button" onclick="closeReplyModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold cursor-pointer transition-all">Cancel</button>
                    <button type="submit" id="btnSubmitReply" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-black uppercase tracking-wider shadow cursor-pointer transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-paper-plane"></i> Send Reply
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openReplyModal(id, rawName, memberId, rawSubject, rawDesc, rawReply, currentStatus) {
            document.getElementById('replyTicketId').value = id;
            document.getElementById('replyTicketNumber').innerText = '#' + id;
            document.getElementById('replyMemberInfo').innerText = unescape(rawName) + ' (' + memberId + ')';
            document.getElementById('replySubject').innerText = 'Subject: ' + unescape(rawSubject);
            document.getElementById('replyDesc').innerText = 'Query: ' + unescape(rawDesc);
            document.getElementById('replyMessage').value = rawReply ? unescape(rawReply) : '';
            document.getElementById('replyStatus').value = currentStatus || 'SOLVED';

            document.getElementById('replyModal').classList.remove('hidden');
        }

        function closeReplyModal() {
            document.getElementById('replyModal').classList.add('hidden');
            document.getElementById('replyQueryForm').reset();
        }

        document.getElementById('replyQueryForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const ticketId = document.getElementById('replyTicketId').value;
            const reply = document.getElementById('replyMessage').value.trim();
            const status = document.getElementById('replyStatus').value;
            const submitBtn = document.getElementById('btnSubmitReply');

            if (!reply) {
                alert("Please enter a reply message.");
                return;
            }

            submitBtn.innerText = "Sending...";
            submitBtn.disabled = true;

            try {
                const res = await fetch('/admin/api/queries/reply', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketId, reply, status })
                });
                const data = await res.json();

                if (data.success) {
                    alert(data.msg || "Reply sent successfully!");
                    location.reload();
                } else {
                    alert("Error: " + (data.msg || "Failed to send reply"));
                    submitBtn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> Send Reply`;
                    submitBtn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert("Server error occurred while sending reply.");
                submitBtn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> Send Reply`;
                submitBtn.disabled = false;
            }
        });

        async function updateStatus(ticketId, status) {
            try {
                const res = await fetch('/admin/api/queries/update-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketId, status })
                });
                const data = await res.json();
                if(data.success) { location.reload(); }
                else { alert("Error: " + (data.msg || "Failed to update")); }
            } catch(err) { console.error(err); }
        }

        async function deleteTicket(ticketId) {
            if (confirm("Are you sure you want to delete this support query ticket?")) {
                try {
                    const res = await fetch(`/admin/api/queries/delete/${ticketId}`, { method: 'DELETE' });
                    const data = await res.json();
                    if(data.success) { 
                        const row = document.getElementById(`ticket-row-${ticketId}`);
                        if (row) row.remove();
                    } else {
                        alert("Error: " + (data.msg || "Failed to delete"));
                    }
                } catch(err) { console.error(err); }
            }
        }
    </script>
</body>
</html>
