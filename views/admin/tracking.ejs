<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <%- include('../partials/head_meta') %>
    <title>Tracking Operations - Avira Control Hub</title>
    <style>
        .preview-input {
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            padding: 5px 8px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 700;
            width: 100%;
            transition: all 0.2s ease;
        }
        .preview-input:focus {
            outline: none;
            border-color: #10b981;
            background: #ffffff;
            box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
        }
        html.dark .preview-input {
            background: #0b0f19 !important;
            border-color: #334155 !important;
            color: #f8fafc !important;
        }
        html.dark .preview-input:focus {
            background: #0f172a !important;
            border-color: #10b981 !important;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col font-sans antialiased text-slate-800 w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <%- include('../partials/admin_navbar') %>

    <div class="lg:pl-64 flex-grow flex flex-col justify-between min-h-screen box-border w-full min-w-0">
        
        <header class="glass-panel-header px-4 sm:px-8 py-3 flex justify-between items-center sticky top-0 z-40 shadow-xs w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-truck-fast text-emerald-500 flex-shrink-0 text-sm"></i>
                <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider truncate">Dashboard / Tracking Operations</span>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-black text-slate-800 dark:text-slate-200">Avira Root</p>
                    <p class="text-[9px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest font-mono-code">Shipping Pipeline</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 dark:bg-emerald-950/60 rounded-xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800 font-black text-xs shadow-xs">
                    <i class="fa-solid fa-boxes-stacked text-xs"></i>
                </div>
            </div>
        </header>

        <main class="flex-grow w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 space-y-6 box-border">
            
            <div class="space-y-1.5 text-center max-w-xl mx-auto mb-4">
                <h1 class="text-xl sm:text-2xl md:text-3xl font-black tracking-tight text-slate-900 dark:text-white font-outfit">Tracking Operations</h1>
                <p class="text-slate-500 dark:text-slate-400 text-xs md:text-sm font-medium">Select a module below to upload bulk parcel shipment files, manage manual dispatch workflows or inspect live records.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 sm:gap-6 w-full">
                
                <!-- 1. Upload Master Data -->
                <div class="glass-emerald-card p-5 rounded-3xl border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between shadow-xs">
                    <div class="text-center mb-4">
                        <div class="w-12 h-12 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 rounded-2xl flex items-center justify-center text-xl mx-auto mb-3 border border-emerald-100 dark:border-emerald-900 shadow-xs">
                            <i class="fa-solid fa-file-excel"></i>
                        </div>
                        <h2 class="text-sm font-black text-slate-900 dark:text-white mb-1 font-outfit uppercase tracking-wide">Upload Master Data</h2>
                        <p class="text-slate-400 dark:text-slate-500 text-[11px] leading-relaxed font-medium">Upload India Post bulk Excel sheets directly into live staging database.</p>
                    </div>
                    <form id="dashUploadForm" class="space-y-3">
                        <input type="file" id="dashExcel" accept=".xlsx, .xls" required class="w-full text-[10px] text-slate-500 dark:text-slate-400 file:mr-2 file:py-1.5 file:px-2.5 file:rounded-xl file:border-0 file:text-[10px] file:font-black file:bg-emerald-50 dark:file:bg-emerald-950 file:text-emerald-700 dark:file:text-emerald-300 hover:file:bg-emerald-100 cursor-pointer">
                        <button type="submit" class="w-full py-2.5 btn-emerald-3d text-white font-black text-xs rounded-xl transition-all cursor-pointer shadow-md uppercase tracking-wider flex items-center justify-center gap-1.5">
                            <span>Read & Preview</span> <i class="fa-solid fa-cloud-arrow-up text-xs"></i>
                        </button>
                    </form>
                </div>

                <!-- 2. Order Excel Master -->
                <div class="glass-emerald-card p-5 rounded-3xl border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between shadow-xs">
                    <div class="text-center mb-4">
                        <div class="w-12 h-12 bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 rounded-2xl flex items-center justify-center text-xl mx-auto mb-3 border border-teal-100 dark:border-teal-900 shadow-xs">
                            <i class="fa-solid fa-file-invoice"></i>
                        </div>
                        <h2 class="text-sm font-black text-slate-900 dark:text-white mb-1 font-outfit uppercase tracking-wide">Order Excel Master</h2>
                        <p class="text-slate-400 dark:text-slate-500 text-[11px] leading-relaxed font-medium">Upload and manage permanent orders Excel sheet repository.</p>
                    </div>
                    <a href="/admin/orders-master" class="block w-full bg-teal-600 hover:bg-teal-700 text-white text-center font-black text-xs py-2.5 rounded-xl transition-all shadow-md uppercase tracking-wider">
                        Open Orders Page &rarr;
                    </a>
                </div>

                <!-- 3. Manual Entry Portal -->
                <div class="glass-emerald-card p-5 rounded-3xl border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between shadow-xs">
                    <div class="text-center mb-4">
                        <div class="w-12 h-12 bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 rounded-2xl flex items-center justify-center text-xl mx-auto mb-3 border border-amber-100 dark:border-amber-900 shadow-xs">
                            <i class="fa-solid fa-keyboard"></i>
                        </div>
                        <h2 class="text-sm font-black text-slate-900 dark:text-white mb-1 font-outfit uppercase tracking-wide">Manual Dispatch</h2>
                        <p class="text-slate-400 dark:text-slate-500 text-[11px] leading-relaxed font-medium">Add single parcel details, AI scanner, & confirm pending members.</p>
                    </div>
                    <div class="space-y-2">
                        <a href="/admin/manual-entry" class="block w-full bg-slate-900 hover:bg-slate-950 text-white text-center font-black text-xs py-2 rounded-xl transition-all shadow-sm uppercase tracking-wide">
                            Manual Workspace &rarr;
                        </a>
                        <a href="/admin/confirm-member" class="block w-full bg-amber-400 hover:bg-amber-500 text-slate-950 font-black text-xs py-2 rounded-xl transition-all text-center shadow-md uppercase tracking-wider">
                            <i class="fa-solid fa-user-check mr-1"></i> Confirm Members
                        </a>
                    </div>
                </div>

                <!-- 4. Live Master Database -->
                <div class="glass-emerald-card p-5 rounded-3xl border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between shadow-xs">
                    <div class="text-center mb-4">
                        <div class="w-12 h-12 bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 rounded-2xl flex items-center justify-center text-xl mx-auto mb-3 border border-blue-100 dark:border-blue-900 shadow-xs">
                            <i class="fa-solid fa-database"></i>
                        </div>
                        <h2 class="text-sm font-black text-slate-900 dark:text-white mb-1 font-outfit uppercase tracking-wide">Live Master DB</h2>
                        <p class="text-slate-400 dark:text-slate-500 text-[11px] leading-relaxed font-medium">View ultimate history table, track member activities & dispatch status.</p>
                    </div>
                    <a href="/admin/master-database" class="block w-full bg-blue-600 hover:bg-blue-700 text-white text-center font-black text-xs py-2.5 rounded-xl transition-all shadow-md uppercase tracking-wider">
                        <i class="fa-solid fa-database mr-1"></i> View Database
                    </a>
                </div>

            </div>

            <!-- Excel Upload Staging Preview & Live Editor Section -->
            <div id="previewSection" class="hidden w-full bg-white dark:bg-[#111827] p-4 sm:p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-md mt-6 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-slate-100 dark:border-slate-800 pb-3 gap-3">
                    <div>
                        <h3 class="text-sm sm:text-base font-black text-slate-900 dark:text-white font-outfit uppercase tracking-wide flex items-center gap-1.5">
                            <i class="fa-solid fa-eye text-emerald-500"></i> Excel Upload Preview & Live Editor
                        </h3>
                        <p class="text-slate-400 dark:text-slate-500 text-xs mt-0.5 font-medium">Review and modify details directly in the table before clicking "Confirm Bulk Save".</p>
                    </div>
                    <div class="flex gap-2 w-full sm:w-auto">
                        <button id="btnCancelUpload" type="button" class="w-1/2 sm:w-auto bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold px-4 py-2 rounded-xl transition-all cursor-pointer">Cancel</button>
                        <button id="btnConfirmBulkSave" type="button" class="w-1/2 sm:w-auto btn-emerald-3d text-white text-xs font-black px-5 py-2 rounded-xl transition-all shadow-md cursor-pointer uppercase tracking-wider flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-cloud-arrow-up"></i> Confirm Save (<span id="uploadCount">0</span>)
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto max-h-96 w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[650px]">
                        <thead>
                            <tr class="bg-slate-50 dark:bg-[#0d1322] border-b border-slate-100 dark:border-slate-800 text-slate-400 dark:text-slate-500 font-black uppercase text-[10px] tracking-wider">
                                <th class="py-3 px-3 w-32">Date</th>
                                <th class="py-3 px-3 w-32">Member ID</th>
                                <th class="py-3 px-3">Name</th>
                                <th class="py-3 px-3 w-24">PV</th>
                                <th class="py-3 px-3 w-28">Amount</th>
                                <th class="py-3 px-3 w-40">Tracking</th>
                                <th class="py-3 px-3 text-center w-24">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="previewTableBody" class="divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-700 dark:text-slate-300">
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <footer class="bg-white dark:bg-[#0d1322] border-t border-slate-200/80 dark:border-slate-800 py-3.5 text-center text-xs font-medium text-slate-400 dark:text-slate-500 mt-6 w-full overflow-hidden">
            &copy; 2026 Avira Control Center. Secure Admin Workspace.
        </footer>
    </div>

    <script>
        let tempUploadedData = [];

        document.getElementById('dashUploadForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const fileInput = document.getElementById('dashExcel');
            if (fileInput.files.length === 0) {
                alert("Please select an Excel file first.");
                return;
            }

            const formData = new FormData();
            formData.append('excelFile', fileInput.files[0]);

            const uploadBtn = this.querySelector('button[type="submit"]');
            uploadBtn.innerText = "Reading Excel...";
            uploadBtn.disabled = true;

            try {
                const response = await fetch('/admin/api/upload-master-excel', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();

                if (result.success && result.data.length > 0) {
                    tempUploadedData = result.data;
                    renderPreviewTable();
                    document.getElementById('previewSection').scrollIntoView({ behavior: 'smooth' });
                } else {
                    alert(result.msg || "No valid data found in Excel sheets.");
                }
            } catch (err) {
                console.error(err);
                alert("Error uploading file. Please try again.");
            } finally {
                uploadBtn.innerHTML = `<span>Read & Preview</span> <i class="fa-solid fa-cloud-arrow-up text-xs"></i>`;
                uploadBtn.disabled = false;
            }
        });

        function formatMemberIdInput(el) {
            let raw = el.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            if (!raw) {
                el.value = '';
                return;
            }
            if (raw === 'A' || raw === 'AV') {
                el.value = raw;
                return;
            }
            if (raw.startsWith('AV')) {
                let num = raw.slice(2).replace(/[^0-9]/g, '').slice(0, 5);
                el.value = 'AV' + num;
            } else {
                let num = raw.replace(/[^0-9]/g, '').slice(0, 5);
                if (num.length > 0) {
                    el.value = 'AV' + num;
                } else {
                    el.value = '';
                }
            }
        }

        function renderPreviewTable() {
            document.getElementById('uploadCount').innerText = tempUploadedData.length;
            const tbody = document.getElementById('previewTableBody');
            tbody.innerHTML = '';
            
            if (tempUploadedData.length === 0) {
                document.getElementById('previewSection').classList.add('hidden');
                return;
            }

            tempUploadedData.forEach((row, index) => {
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40" id="prev-row-${index}">
                        <td class="py-2 px-2">
                            <input type="text" class="preview-input" value="${row.date}" onchange="updateTempData(${index}, 'date', this.value)">
                        </td>
                        <td class="py-2 px-2">
                            <input type="text" class="preview-input font-mono-code uppercase text-emerald-600 dark:text-emerald-400 font-bold" value="${row.memberId}" maxlength="7" oninput="formatMemberIdInput(this)" onchange="updateTempData(${index}, 'memberId', this.value)">
                        </td>
                        <td class="py-2 px-2">
                            <input type="text" class="preview-input uppercase" value="${row.name}" onchange="updateTempData(${index}, 'name', this.value)">
                        </td>
                        <td class="py-2 px-2">
                            <input type="number" class="preview-input font-mono-code" value="${row.pv}" onchange="updateTempData(${index}, 'pv', this.value)">
                        </td>
                        <td class="py-2 px-2">
                            <input type="number" class="preview-input font-mono-code font-bold" value="${row.amount}" onchange="updateTempData(${index}, 'amount', this.value)">
                        </td>
                        <td class="py-2 px-2">
                            <input type="text" class="preview-input font-mono-code uppercase" value="${row.tracking || ''}" placeholder="N/A" onchange="updateTempData(${index}, 'tracking', this.value)">
                        </td>
                        <td class="py-2 px-2 text-center">
                            <button type="button" onclick="deletePreviewRow(${index})" class="text-rose-500 hover:text-rose-600 dark:text-rose-400 font-black text-[11px] cursor-pointer flex items-center justify-center gap-1 mx-auto">
                                <i class="fa-solid fa-trash text-xs"></i> Delete
                            </button>
                        </td>
                    </tr>
                `;
            });

            document.getElementById('previewSection').classList.remove('hidden');
        }

        function updateTempData(index, field, value) {
            if (tempUploadedData[index]) {
                if (field === 'memberId' || field === 'name' || field === 'tracking') {
                    tempUploadedData[index][field] = value.toUpperCase().trim();
                } else {
                    tempUploadedData[index][field] = value.trim();
                }
            }
        }

        function deletePreviewRow(index) {
            if (confirm("Are you sure you want to remove this row from the preview list?")) {
                tempUploadedData.splice(index, 1);
                renderPreviewTable();
            }
        }

        document.getElementById('btnCancelUpload').addEventListener('click', () => {
            if (confirm("Are you sure you want to cancel the upload process? All preview data will be cleared.")) {
                tempUploadedData = [];
                document.getElementById('previewSection').classList.add('hidden');
                document.getElementById('dashUploadForm').reset();
            }
        });

        document.getElementById('btnConfirmBulkSave').addEventListener('click', async function() {
            if (tempUploadedData.length === 0) return;

            this.innerText = "Saving to Database...";
            this.disabled = true;

            try {
                const response = await fetch('/admin/api/save-bulk-master', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ entries: tempUploadedData })
                });
                const result = await response.json();

                if (result.success) {
                    alert(result.msg);
                    tempUploadedData = [];
                    document.getElementById('previewSection').classList.add('hidden');
                    document.getElementById('dashUploadForm').reset();
                } else {
                    alert("Error: " + result.msg);
                }
            } catch (err) {
                console.error(err);
                alert("Failed to save records. Please try again.");
            } finally {
                this.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> Confirm Save (<span id="uploadCount">0</span>)`;
                this.disabled = false;
            }
        });
    </script>
</body>
</html>
