<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Tracking Manager - Avira Control</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            max-width: 100vw !important;
            overflow-x: hidden !important;
            position: relative;
        }

        .admin-menu-card { 
            background: white; 
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
        }
        .admin-menu-card:hover { 
            transform: translateY(-5px); 
            box-shadow: 0 15px 30px rgba(16, 185, 129, 0.12); 
        }
        .preview-input {
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            width: 100%;
        }
        .preview-input:focus {
            outline: none;
            border-color: #10b981;
            background: #ffffff;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 to-emerald-50/30 min-h-screen flex flex-col font-sans antialiased text-slate-800 w-full overflow-x-hidden">

    <%- include('partials/admin_navbar') %>

    <div class="lg:pl-64 flex-grow flex flex-col justify-between min-h-screen box-border w-full min-w-0">
        
        <header class="bg-white/80 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 flex justify-between items-center sticky top-0 z-40 shadow-sm w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-truck-fast text-emerald-500 flex-shrink-0"></i>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider truncate">Dashboard / Tracking Manager</span>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-bold text-slate-800">Avira Admin</p>
                    <p class="text-[9px] font-bold text-emerald-500 uppercase tracking-widest">Active Workspace</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-500 border border-emerald-100 font-bold text-xs">A</div>
            </div>
        </header>

        <main class="flex-grow w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 space-y-6 box-border">
            
            <div class="space-y-1.5 text-center max-w-xl mx-auto mb-4">
                <h1 class="text-xl sm:text-2xl md:text-3xl font-black tracking-tight text-slate-950">Tracking Operations</h1>
                <p class="text-slate-500 text-xs md:text-sm">Select a module below to upload bulk parcel shipment files, manage manual workflows or run permanent queries.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 sm:gap-6 w-full">
                
                <div class="admin-menu-card p-5 rounded-2xl border border-slate-100 flex flex-col justify-between shadow-sm">
                    <div class="text-center mb-4">
                        <div class="w-11 h-12 bg-emerald-50 text-emerald-500 rounded-2xl flex items-center justify-center text-lg mx-auto mb-3 border border-emerald-100/50">
                            <i class="fa-solid fa-file-excel"></i>
                        </div>
                        <h3 class="text-sm font-bold text-slate-900 mb-1">Upload Master Data</h3>
                        <p class="text-slate-400 text-[11px] leading-relaxed">Upload India Post bulk Excel sheet formats directly into database.</p>
                    </div>
                    <form id="dashUploadForm" class="space-y-3">
                        <input type="file" id="dashExcel" accept=".xlsx, .xls" required class="w-full text-[10px] text-slate-500 file:mr-2 file:py-1 file:px-2.5 file:rounded-xl file:border-0 file:text-[10px] file:font-bold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 cursor-pointer">
                        <button type="submit" class="w-full py-2 bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs rounded-xl transition-all cursor-pointer shadow-sm uppercase tracking-wider">
                            Upload File <i class="fa-solid fa-cloud-arrow-up ml-1"></i>
                        </button>
                    </form>
                </div>

                <div class="admin-menu-card p-5 rounded-2xl border border-slate-100 flex flex-col justify-between shadow-sm">
                    <div class="text-center mb-4">
                        <div class="w-11 h-12 bg-teal-50 text-teal-600 rounded-2xl flex items-center justify-center text-lg mx-auto mb-3 border border-teal-100/50">
                            <i class="fa-solid fa-file-invoice"></i>
                        </div>
                        <h3 class="text-sm font-bold text-slate-900 mb-1">Order Excel Master</h3>
                        <p class="text-slate-400 text-[11px] leading-relaxed">Upload and manage permanent orders Excel sheet repository.</p>
                    </div>
                    <a href="/admin/orders-master" class="block w-full bg-teal-600 hover:bg-teal-700 text-white text-center font-bold text-xs py-2 rounded-xl transition-all shadow-sm uppercase tracking-wide">
                        Open Orders Page &rarr;
                    </a>
                </div>

                <div class="admin-menu-card p-5 rounded-2xl border border-slate-100 flex flex-col justify-between shadow-sm">
                    <div class="text-center mb-4">
                        <div class="w-11 h-12 bg-emerald-50 text-emerald-500 rounded-2xl flex items-center justify-center text-lg mx-auto mb-3 border border-emerald-100/50">
                            <i class="fa-solid fa-keyboard"></i>
                        </div>
                        <h3 class="text-sm font-bold text-slate-900 mb-1">Manual Entry Portal</h3>
                        <p class="text-slate-400 text-[11px] leading-relaxed">Add single parcel details & download customized Excel templates.</p>
                    </div>
                    <div class="space-y-2">
                        <a href="/admin/manual-entry" class="block w-full bg-slate-900 hover:bg-slate-950 text-white text-center font-bold text-xs py-2 rounded-xl transition-all shadow-sm uppercase tracking-wide">
                            Open Workspace &rarr;
                        </a>
                        <a href="/admin/confirm-member" class="block w-full bg-amber-400 hover:bg-amber-500 text-slate-950 font-black text-xs py-2 rounded-xl transition-all text-center shadow-md uppercase tracking-wider">
                            <i class="fa-solid fa-user-check mr-1"></i> Confirm Members
                        </a>
                    </div>
                </div>

                <div class="admin-menu-card p-5 rounded-2xl border border-slate-100 flex flex-col justify-between shadow-sm">
                    <div class="text-center mb-4">
                        <div class="w-11 h-12 bg-emerald-50 text-emerald-500 rounded-2xl flex items-center justify-center text-lg mx-auto mb-3 border border-emerald-100/50">
                            <i class="fa-solid fa-database"></i>
                        </div>
                        <h3 class="text-sm font-bold text-slate-900 mb-1">Live Master Records</h3>
                        <p class="text-slate-400 text-[11px] leading-relaxed">View ultimate history table, track member activities & status.</p>
                    </div>
                    <a href="/admin/master-database" class="block w-full bg-blue-600 hover:bg-blue-700 text-white text-center font-bold text-xs py-2 rounded-xl transition-all shadow-sm uppercase tracking-wide">
                        <i class="fa-solid fa-database mr-1"></i> View Database
                    </a>
                </div>

            </div>

            <div id="previewSection" class="hidden w-full bg-white p-4 sm:p-6 rounded-2xl border border-slate-100 shadow-lg mt-6 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b pb-3 gap-3">
                    <div>
                        <h3 class="text-sm sm:text-base font-bold text-slate-900"><i class="fa-solid fa-eye text-emerald-500 mr-1"></i> Excel Upload Preview & Live Editor</h3>
                        <p class="text-slate-400 text-xs mt-0.5">Review and modify details directly in the table before clicking "Confirm Bulk Save".</p>
                    </div>
                    <div class="flex gap-2 w-full sm:w-auto">
                        <button id="btnCancelUpload" type="button" class="w-1/2 sm:w-auto bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-bold px-3.5 py-2 rounded-xl transition-all cursor-pointer">Cancel</button>
                        <button id="btnConfirmBulkSave" type="button" class="w-1/2 sm:w-auto bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-black px-4 py-2 rounded-xl transition-all shadow-md cursor-pointer uppercase tracking-wider">
                            <i class="fa-solid fa-cloud-arrow-up mr-1"></i> Confirm Save (<span id="uploadCount">0</span>)
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto max-h-96 w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[600px]">
                        <thead>
                            <tr class="bg-slate-50 border-b text-slate-400 font-bold uppercase">
                                <th class="py-3 px-4 w-32">Date</th>
                                <th class="py-3 px-4 w-32">Member ID</th>
                                <th class="py-3 px-4">Name</th>
                                <th class="py-3 px-4 w-24">PV</th>
                                <th class="py-3 px-4 w-28">Amount</th>
                                <th class="py-3 px-4 w-40">Tracking</th>
                                <th class="py-3 px-4 text-center w-24">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="previewTableBody" class="divide-y divide-slate-50 font-medium text-slate-700">
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <footer class="bg-white border-t border-slate-100 py-3.5 text-center text-xs font-medium text-slate-400 mt-6 w-full overflow-hidden">
            &copy; 2026 Avira Control Center. Secure Admin Workspace.
        </footer>
    </div>

    <script>
        let tempUploadedData = [];

        document.getElementById('dashUploadForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const fileInput = document.getElementById('dashExcel');
            if (fileInput.files.length === 0) {
                alert("Please select an Excel file first.");
                return;
            }

            const formData = new FormData();
            formData.append('excelFile', fileInput.files[0]);

            const uploadBtn = this.querySelector('button[type="submit"]');
            uploadBtn.innerText = "Reading Excel...";
            uploadBtn.disabled = true;

            try {
                const response = await fetch('/admin/api/upload-master-excel', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();

                if (result.success && result.data.length > 0) {
                    tempUploadedData = result.data;
                    renderPreviewTable();
                    document.getElementById('previewSection').scrollIntoView({ behavior: 'smooth' });
                } else {
                    alert(result.msg || "No valid data found in Excel sheets.");
                }
            } catch (err) {
                console.error(err);
                alert("Error uploading file. Please try again.");
            } finally {
                uploadBtn.innerHTML = `Upload File <i class="fa-solid fa-cloud-arrow-up ml-1"></i>`;
                uploadBtn.disabled = false;
            }
        });

        function renderPreviewTable() {
            document.getElementById('uploadCount').innerText = tempUploadedData.length;
            const tbody = document.getElementById('previewTableBody');
            tbody.innerHTML = '';
            
            if (tempUploadedData.length === 0) {
                document.getElementById('previewSection').classList.add('hidden');
                return;
            }

            tempUploadedData.forEach((row, index) => {
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/50" id="prev-row-${index}">
                        <td class="py-2 px-2">
                            <input type="text" class="preview-input" value="${row.date}" onchange="updateTempData(${index}, 'date', this.value)">
                        </td>
                        <td class="py-2 px-2">
                            <input type="text" class="preview-input font-mono uppercase text-emerald-600 font-bold" value="${row.memberId}" onchange="updateTempData(${index}, 'memberId', this.value)">
                        </td>
                        <td class="py-2 px-2">
                            <input type="text" class="preview-input uppercase" value="${row.name}" onchange="updateTempData(${index}, 'name', this.value)">
                        </td>
                        <td class="py-2 px-2">
                            <input type="number" class="preview-input font-mono" value="${row.pv}" onchange="updateTempData(${index}, 'pv', this.value)">
                        </td>
                        <td class="py-2 px-2">
                            <input type="number" class="preview-input font-mono font-bold" value="${row.amount}" onchange="updateTempData(${index}, 'amount', this.value)">
                        </td>
                        <td class="py-2 px-2">
                            <input type="text" class="preview-input font-mono uppercase" value="${row.tracking || ''}" placeholder="N/A" onchange="updateTempData(${index}, 'tracking', this.value)">
                        </td>
                        <td class="py-2 px-2 text-center">
                            <button type="button" onclick="deletePreviewRow(${index})" class="text-rose-500 hover:text-rose-700 font-bold text-[11px] cursor-pointer">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                `;
            });

            document.getElementById('previewSection').classList.remove('hidden');
        }

        function updateTempData(index, field, value) {
            if (tempUploadedData[index]) {
                if (field === 'memberId' || field === 'name' || field === 'tracking') {
                    tempUploadedData[index][field] = value.toUpperCase().trim();
                } else {
                    tempUploadedData[index][field] = value.trim();
                }
            }
        }

        function deletePreviewRow(index) {
            if (confirm("Are you sure you want to remove this row from the preview list?")) {
                tempUploadedData.splice(index, 1);
                renderPreviewTable();
            }
        }

        document.getElementById('btnCancelUpload').addEventListener('click', () => {
            if (confirm("Are you sure you want to cancel the upload process? All preview data will be cleared.")) {
                tempUploadedData = [];
                document.getElementById('previewSection').classList.add('hidden');
                document.getElementById('dashUploadForm').reset();
            }
        });

        document.getElementById('btnConfirmBulkSave').addEventListener('click', async function() {
            if (tempUploadedData.length === 0) return;

            this.innerText = "Saving to Database...";
            this.disabled = true;

            try {
                const response = await fetch('/admin/api/save-bulk-master', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ entries: tempUploadedData })
                });
                const result = await response.json();

                if (result.success) {
                    alert(result.msg);
                    tempUploadedData = [];
                    document.getElementById('previewSection').classList.add('hidden');
                    document.getElementById('dashUploadForm').reset();
                } else {
                    alert("Error: " + result.msg);
                }
            } catch (err) {
                console.error(err);
                alert("Failed to save records. Please try again.");
            } finally {
                this.innerHTML = `<i class="fa-solid fa-cloud-arrow-up mr-1"></i> Confirm Bulk Save (<span id="uploadCount">0</span>)`;
                this.disabled = false;
            }
        });
    </script>
</body>
</html>