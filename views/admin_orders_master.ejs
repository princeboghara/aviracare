<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Order Master Repository - Avira Control</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            max-width: 100vw !important;
            overflow-x: hidden !important;
            position: relative;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 to-emerald-50/30 min-h-screen flex font-sans antialiased text-slate-800 w-full overflow-x-hidden">

    <!-- 🌐 Sidebar Partial -->
    <%- include('partials/admin_navbar') %>

    <!-- Main Workspace -->
    <div class="lg:pl-64 flex-grow flex flex-col justify-between min-h-screen w-full box-border min-w-0">
        
        <!-- Header -->
        <header class="bg-white/80 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3.5 flex justify-between items-center sticky top-0 z-40 shadow-sm w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-file-invoice text-emerald-500 flex-shrink-0"></i>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider truncate">Orders / Order Master Repository</span>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-bold text-slate-800">Avira Admin</p>
                    <p class="text-[9px] font-bold text-emerald-500 uppercase tracking-widest">Active Workspace</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-500 border border-emerald-100 font-bold text-xs">A</div>
            </div>
        </header>

        <!-- Main Workspace Body -->
        <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6 box-border">
            
            <!-- UPLOAD ORDER EXCEL CARD -->
            <div class="bg-gradient-to-br from-emerald-600 to-teal-700 p-6 rounded-2xl shadow-lg text-white flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div class="flex items-start gap-4">
                    <div class="h-12 w-12 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center text-xl flex-shrink-0 border border-white/20">
                        <i class="fa-solid fa-file-excel text-amber-300"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black uppercase tracking-wide">Upload Order Excel File</h3>
                        <p class="text-xs text-emerald-100 mt-1">Upload order Excel. Automatically extracts Date, Member ID, Name, PV, & Amount into database while skipping duplicates.</p>
                    </div>
                </div>
                <form id="uploadOrdersForm" class="flex items-center gap-2 bg-white/10 p-2 rounded-xl border border-white/20 w-full md:w-auto">
                    <input type="file" id="orderExcelFile" accept=".xlsx, .xls" required class="text-xs text-white file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-amber-400 file:text-slate-950 hover:file:bg-amber-500 cursor-pointer w-full min-w-0">
                    <button type="submit" id="btnUploadOrders" class="bg-white hover:bg-slate-100 text-slate-900 font-black text-xs px-5 py-2.5 rounded-lg shadow uppercase flex-shrink-0 transition-all cursor-pointer">Upload</button>
                </form>
            </div>

            <!-- PERMANENT ORDERS LIST TABLE -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-md overflow-hidden w-full">
                <div class="px-4 sm:px-6 py-4 bg-slate-50 border-b border-slate-100 flex justify-between items-center flex-wrap gap-2">
                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-list text-emerald-500"></i> Permanent Order Repository
                    </h3>
                    <span id="ordersCounter" class="bg-emerald-100 text-emerald-800 text-[11px] font-bold px-3 py-1 rounded-full"><%= orders.length %> Records Saved</span>
                </div>

                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap">
                        <thead>
                            <tr class="bg-slate-100/70 border-b border-slate-100 text-slate-400 font-bold uppercase text-[10px]">
                                <th class="py-3.5 px-4">#</th>
                                <th class="py-3.5 px-4">Ordered Date</th>
                                <th class="py-3.5 px-4">Member ID</th>
                                <th class="py-3.5 px-4">Customer Name</th>
                                <th class="py-3.5 px-4">Total PV</th>
                                <th class="py-3.5 px-4">Amount</th>
                                <th class="py-3.5 px-4 text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="ordersTableBody" class="divide-y divide-slate-50 font-medium text-slate-700">
                            <% if(!orders || orders.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="py-8 text-center text-slate-400 font-normal">No order excel imported yet. Upload an order file above!</td>
                                </tr>
                            <% } else { %>
                                <% orders.forEach((item, index) => { %>
                                    <tr class="hover:bg-slate-50/50">
                                        <td class="py-3 px-4 text-slate-400 font-mono"><%= index + 1 %></td>
                                        <td class="py-3 px-4 font-semibold text-slate-800"><%= item.order_date %></td>
                                        <td class="py-3 px-4 font-mono font-bold text-emerald-600"><%= item.member_id %></td>
                                        <td class="py-3 px-4 uppercase font-semibold text-slate-900"><%= item.name %></td>
                                        <td class="py-3 px-4 font-mono font-bold text-slate-700"><%= item.pv %></td>
                                        <td class="py-3 px-4 font-mono font-bold text-slate-900">₹<%= item.amount %></td>
                                        <td class="py-3 px-4 text-center">
                                            <button type="button" data-order-id="<%= item.id %>" class="btn-delete-order text-rose-500 hover:text-rose-600 font-bold cursor-pointer text-xs">
                                                <i class="fa-solid fa-trash"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>

        <footer class="bg-white border-t border-slate-100 py-4 text-center text-xs font-medium text-slate-400 mt-8 w-full overflow-hidden">
            &copy; 2026 Avira LifeCare. All rights reserved.
        </footer>
    </div>

    <script>
        document.getElementById('uploadOrdersForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const fileInput = document.getElementById('orderExcelFile');
            if (fileInput.files.length === 0) return;

            const btn = document.getElementById('btnUploadOrders');
            btn.innerText = "IMPORTING...";
            btn.disabled = true;

            const formData = new FormData();
            formData.append('excelFile', fileInput.files[0]);

            try {
                const res = await fetch('/admin/api/upload-orders-excel', {
                    method: 'POST',
                    body: formData
                });
                const result = await res.json();

                if (result.success) {
                    alert(result.msg);
                    renderOrdersTable(result.orders);
                } else {
                    alert(result.msg || "Upload failed");
                }
            } catch (err) {
                console.error(err);
                alert("Server connection error during upload.");
            } finally {
                btn.innerText = "Upload";
                btn.disabled = false;
                fileInput.value = '';
            }
        });

        // 🗑️ Event Listener for Delete Buttons
        document.addEventListener('click', async function(e) {
            const delBtn = e.target.closest('.btn-delete-order');
            if (delBtn) {
                const id = delBtn.getAttribute('data-order-id');
                if (id && confirm("Are you sure you want to delete this order entry?")) {
                    try {
                        const res = await fetch('/admin/api/delete-order/' + id, { method: 'DELETE' });
                        const result = await res.json();
                        if (result.success) {
                            renderOrdersTable(result.orders);
                        }
                    } catch (err) {
                        console.error(err);
                    }
                }
            }
        });

        function renderOrdersTable(orders) {
            const tbody = document.getElementById('ordersTableBody');
            document.getElementById('ordersCounter').innerText = `${orders.length} Records Saved`;

            if (!orders || orders.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-400 font-normal">No order excel imported yet. Upload an order file above!</td></tr>`;
                return;
            }

            tbody.innerHTML = '';
            orders.forEach((item, index) => {
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/50">
                        <td class="py-3 px-4 text-slate-400 font-mono">${index + 1}</td>
                        <td class="py-3 px-4 font-semibold text-slate-800">${item.order_date}</td>
                        <td class="py-3 px-4 font-mono font-bold text-emerald-600">${item.member_id}</td>
                        <td class="py-3 px-4 uppercase font-semibold text-slate-900">${item.name}</td>
                        <td class="py-3 px-4 font-mono font-bold text-slate-700">${item.pv}</td>
                        <td class="py-3 px-4 font-mono font-bold text-slate-900">₹${item.amount}</td>
                        <td class="py-3 px-4 text-center">
                            <button type="button" data-order-id="${item.id}" class="btn-delete-order text-rose-500 hover:text-rose-600 font-bold cursor-pointer text-xs">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                `;
            });
        }
    </script>
</body>
</html>