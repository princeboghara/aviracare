<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Manual Entry Workspace - Avira Control Center</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            max-width: 100vw !important;
            overflow-x: hidden !important;
            position: relative;
        }

        /* 3D Dropdown Popover Menu Styles */
        .custom-preset-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(0.97);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .custom-preset-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-800 w-full overflow-x-hidden">

    <%- include('partials/admin_navbar') %>

    <div class="lg:pl-64 flex flex-col min-h-screen w-full min-w-0">
        
        <header class="bg-white/90 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-3 flex justify-between items-center sticky top-0 z-30 shadow-sm w-full">
            <div class="flex items-center gap-2 min-w-0">
                <i class="fa-solid fa-keyboard text-emerald-500 flex-shrink-0"></i>
                <span class="text-xs sm:text-sm font-bold text-slate-700 uppercase tracking-wider truncate">Manual Entry</span>
            </div>
            
            <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-bold text-slate-800">Avira Admin</p>
                    <p class="text-[9px] font-bold text-emerald-500 uppercase tracking-widest">Active Workspace</p>
                </div>
                <div class="h-8 w-8 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-500 border border-emerald-100 font-bold text-xs shadow-sm">A</div>
            </div>
        </header>

        <main class="flex-grow w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-4 sm:space-y-6 box-border">
            
            <div class="bg-gradient-to-r from-emerald-600 to-teal-700 p-4 sm:p-5 rounded-2xl shadow-md text-white flex flex-col sm:flex-row justify-between items-center gap-4 w-full box-border">
                <div class="flex items-center gap-3 min-w-0 w-full sm:w-auto">
                    <div class="h-10 w-10 sm:h-12 sm:w-12 rounded-xl bg-white/10 backdrop-blur-md flex items-center justify-center text-lg sm:text-xl flex-shrink-0 border border-white/20">
                        <i class="fa-solid fa-bolt text-amber-300"></i>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-xs sm:text-base font-black uppercase tracking-wide truncate">AI Smart Label Scanner</h3>
                        <p class="text-[10px] sm:text-[11px] text-emerald-100 mt-0.5 truncate sm:whitespace-normal">Scan parcel labels to auto-fill Tracking ID, Name, Mobile, and Pincode instantly.</p>
                    </div>
                </div>
                <div class="w-full sm:w-auto flex-shrink-0">
                    <input type="file" id="cameraInput" accept="image/*" capture="environment" class="hidden">
                    <button type="button" onclick="document.getElementById('cameraInput').click()" class="w-full sm:w-auto bg-white hover:bg-slate-100 text-slate-950 font-black text-xs px-4 py-2.5 rounded-xl shadow transition-all uppercase tracking-wider cursor-pointer flex items-center justify-center gap-2 flex-shrink-0 whitespace-nowrap">
                        <i class="fa-solid fa-expand text-emerald-600"></i> Scan with Camera
                    </button>
                </div>
            </div>

            <div id="ocrStatusBox" class="hidden bg-slate-900 text-white p-3 rounded-xl text-xs font-bold flex items-center justify-between shadow-md">
                <span id="ocrStatusText" class="flex items-center gap-2"><i class="fa-solid fa-bolt animate-bounce text-amber-400"></i> AI Scanning Label...</span>
                <span id="ocrProgress" class="font-mono text-emerald-400 text-[10px]"><i class="fa-solid fa-microchip mr-1"></i> Gemini Vision AI</span>
            </div>

            <div class="bg-white p-4 sm:p-6 lg:p-8 rounded-2xl border border-slate-100 shadow-md w-full">
                <div class="border-b border-slate-100 pb-2.5 mb-4">
                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-plus text-emerald-500"></i> Add New Dispatch</h3>
                </div>

                <form id="manualEntryForm" class="space-y-4 text-xs w-full">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                        <div>
                            <label class="block font-semibold text-slate-500 mb-1">Tracking Number</label>
                            <input type="text" id="mTracking" required class="w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 uppercase font-mono font-bold focus:outline-none focus:border-emerald-500">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-500 mb-1">Receiver Name / Order Link</label>
                            <input type="text" id="mReceiverName" required class="w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 uppercase font-semibold focus:outline-none focus:border-emerald-500">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-500 mb-1">Receiver Mobile Number</label>
                            <input type="text" id="mMobile" required maxlength="10" placeholder="10 Digits Only"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').substring(0, 10);" 
                                   class="w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 font-mono focus:outline-none focus:border-emerald-500">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-500 mb-1">Receiver Pincode</label>
                            <input type="text" id="mPincode" maxlength="6" required oninput="this.value = this.value.replace(/[^0-9]/g, '');"
                                   class="w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 font-mono font-bold focus:outline-none focus:border-emerald-500">
                        </div>
                    </div>

                    <div class="bg-slate-50/80 p-3.5 rounded-xl border border-slate-100 space-y-3">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-slate-200/60 pb-2">
                            <label class="font-bold text-slate-700 flex items-center gap-1.5 text-xs">
                                <i class="fa-solid fa-boxes-packing text-emerald-500"></i> Box Dimensions
                            </label>
                            
                            <div class="relative w-full sm:w-64">
                                <button type="button" id="presetBtn" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-bold text-slate-700 hover:border-emerald-400 focus:outline-none shadow-xs flex justify-between items-center cursor-pointer transition-all">
                                    <span id="selectedPresetLabel" class="flex items-center gap-1.5 truncate">
                                        <i class="fa-solid fa-bolt text-amber-400"></i> Select Box Preset...
                                    </span>
                                    <i id="presetChevron" class="fa-solid fa-chevron-down text-[10px] text-slate-400 transition-transform duration-300"></i>
                                </button>

                                <div id="presetMenu" class="custom-preset-menu absolute right-0 left-0 sm:left-auto sm:w-72 top-full mt-1 bg-white border border-slate-200 rounded-xl shadow-xl z-50 p-1.5 space-y-1">
                                    <p class="p-2 text-center text-[10px] text-slate-400 font-semibold">Loading Presets...</p>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
                            <div>
                                <label class="block font-semibold text-slate-400 mb-1">Weight (kg)</label>
                                <input type="number" step="0.001" id="mWeight" required class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-slate-200 focus:outline-none focus:border-emerald-500 font-semibold text-xs">
                            </div>
                            <div>
                                <label class="block font-semibold text-slate-400 mb-1">Length (cm)</label>
                                <input type="number" id="mLength" required class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-slate-200 focus:outline-none focus:border-emerald-500 font-semibold text-xs">
                            </div>
                            <div>
                                <label class="block font-semibold text-slate-400 mb-1">Breadth (cm)</label>
                                <input type="number" id="mBreadth" required class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-slate-200 focus:outline-none focus:border-emerald-500 font-semibold text-xs">
                            </div>
                            <div>
                                <label class="block font-semibold text-slate-400 mb-1">Height (cm)</label>
                                <input type="number" id="mHeight" required class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-slate-200 focus:outline-none focus:border-emerald-500 font-semibold text-xs">
                            </div>
                        </div>
                    </div>

                    <div class="bg-emerald-50/40 p-3.5 rounded-xl border border-emerald-100/70 grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-[10px] font-bold text-emerald-800 mb-1">City</label>
                            <input type="text" id="txtCity" placeholder="MANUAL / AUTO" class="w-full px-3 py-1.5 bg-white border border-emerald-200/80 rounded-lg text-[11px] font-semibold uppercase focus:outline-none focus:border-emerald-500">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-emerald-800 mb-1">State</label>
                            <input type="text" id="txtState" placeholder="MANUAL / AUTO" class="w-full px-3 py-1.5 bg-white border border-emerald-200/80 rounded-lg text-[11px] font-semibold uppercase focus:outline-none focus:border-emerald-500">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-emerald-800 mb-1">Area / Address Line</label>
                            <input type="text" id="txtAddress" placeholder="MANUAL / AUTO" class="w-full px-3 py-1.5 bg-white border border-emerald-200/80 rounded-lg text-[11px] font-semibold uppercase focus:outline-none focus:border-emerald-500">
                        </div>
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="submit" class="w-full sm:w-auto bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-black px-6 py-3 rounded-xl transition-all shadow-md cursor-pointer uppercase tracking-wider flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-circle-check text-sm"></i> SAVE ENTRY
                        </button>
                    </div>
                </form>
            </div>

            <div class="bg-white rounded-2xl border border-slate-100 shadow-md overflow-hidden w-full">
                <div class="px-4 py-3 bg-slate-50 border-b border-slate-100 flex justify-between items-center flex-wrap gap-2">
                    <h3 class="text-xs sm:text-sm font-bold text-slate-900 flex items-center gap-2"><i class="fa-solid fa-list-check text-slate-400"></i> Current Session Entries</h3>
                    
                    <button id="exportExcelBtn" class="bg-slate-900 hover:bg-slate-950 text-white font-black text-[11px] px-3.5 py-2 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer shadow-sm">
                        <i class="fa-solid fa-file-excel text-emerald-400"></i> EXPORT EXCEL
                    </button>
                </div>
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[600px]">
                        <thead>
                            <tr class="bg-slate-100/70 border-b border-slate-100 text-slate-400 font-bold uppercase">
                                <th class="py-3 px-4">Tracking No</th>
                                <th class="py-3 px-4">Receiver Name</th>
                                <th class="py-3 px-4">Mobile</th>
                                <th class="py-3 px-4">Pincode</th>
                                <th class="py-3 px-4">Place / Location</th>
                                <th class="py-3 px-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="sessionTableBody" class="divide-y divide-slate-50 font-medium text-slate-700">
                            <tr>
                                <td colspan="6" class="py-8 text-center text-slate-400 font-normal">No entries added in this session yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>

        <footer class="bg-white border-t border-slate-100 py-3 text-center text-xs font-medium text-slate-400 mt-6 w-full">
            &copy; 2026 Avira LifeCare. All rights reserved.
        </footer>
    </div>

    <script>
        let localEntries = JSON.parse('<%- JSON.stringify(entries || []) %>');

        window.onload = () => { 
            document.getElementById('mTracking').focus(); 
            renderTable(); 
            loadPresetsFromDB();
        };

        async function loadPresetsFromDB() {
            const menu = document.getElementById('presetMenu');
            try {
                const res = await fetch('/admin/api/get-box-presets');
                const data = await res.json();
                
                if (data.success && data.presets && data.presets.length > 0) {
                    menu.innerHTML = '';
                    data.presets.forEach(p => {
                        const firstChar = p.name ? p.name.charAt(0).toUpperCase() : 'B';
                        menu.innerHTML += `
                            <div onclick="applyBoxPreset(${p.length}, ${p.breadth}, ${p.height}, '${p.name}')" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 cursor-pointer transition-all">
                                <div class="h-7 w-7 rounded-md bg-emerald-100 flex items-center justify-center text-emerald-600 font-bold text-xs flex-shrink-0">${firstChar}</div>
                                <div>
                                    <p class="text-xs font-bold uppercase">${p.name}</p>
                                    <p class="text-[9px] text-slate-400 font-medium">${p.length} x ${p.breadth} x ${p.height} cm</p>
                                </div>
                            </div>
                        `;
                    });
                } else {
                    menu.innerHTML = `
                        <div onclick="applyBoxPreset(15, 10, 5, 'Small Box (15x10x5 cm)')" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 cursor-pointer transition-all">
                            <div class="h-7 w-7 rounded-md bg-emerald-100 flex items-center justify-center text-emerald-600 font-bold text-xs flex-shrink-0">S</div>
                            <div>
                                <p class="text-xs font-bold">Small Box</p>
                                <p class="text-[9px] text-slate-400 font-medium">15 x 10 x 5 cm</p>
                            </div>
                        </div>
                        <div onclick="applyBoxPreset(20, 15, 10, 'Medium Box (20x15x10 cm)')" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 cursor-pointer transition-all">
                            <div class="h-7 w-7 rounded-md bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-xs flex-shrink-0">M</div>
                            <div>
                                <p class="text-xs font-bold">Medium Box</p>
                                <p class="text-[9px] text-slate-400 font-medium">20 x 15 x 10 cm</p>
                            </div>
                        </div>
                        <div onclick="applyBoxPreset(30, 20, 15, 'Large Box (30x20x15 cm)')" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 cursor-pointer transition-all">
                            <div class="h-7 w-7 rounded-md bg-amber-100 flex items-center justify-center text-amber-600 font-bold text-xs flex-shrink-0">L</div>
                            <div>
                                <p class="text-xs font-bold">Large Box</p>
                                <p class="text-[9px] text-slate-400 font-medium">30 x 20 x 15 cm</p>
                            </div>
                        </div>
                    `;
                }
            } catch (err) {
                console.error("Fetch Presets Error:", err);
            }
        }

        const presetBtn = document.getElementById('presetBtn');
        const presetMenu = document.getElementById('presetMenu');
        const presetChevron = document.getElementById('presetChevron');

        presetBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const isActive = presetMenu.classList.contains('active');
            if (isActive) {
                closePresetDropdown();
            } else {
                presetMenu.classList.add('active');
                presetChevron.classList.add('rotate-180');
            }
        });

        document.addEventListener('click', function(e) {
            if (!presetBtn.contains(e.target) && !presetMenu.contains(e.target)) {
                closePresetDropdown();
            }
        });

        function closePresetDropdown() {
            presetMenu.classList.remove('active');
            presetChevron.classList.remove('rotate-180');
        }

        function applyBoxPreset(l, b, h, label) {
            document.getElementById('mLength').value = l;
            document.getElementById('mBreadth').value = b;
            document.getElementById('mHeight').value = h;
            
            document.getElementById('selectedPresetLabel').innerHTML = `<i class="fa-solid fa-check text-emerald-500"></i> ${label}`;
            closePresetDropdown();
        }

        document.getElementById('cameraInput').addEventListener('change', async function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const statusBox = document.getElementById('ocrStatusBox');
            const statusText = document.getElementById('ocrStatusText');
            
            statusBox.classList.remove('hidden');
            statusText.innerHTML = `<i class="fa-solid fa-bolt animate-bounce text-amber-400"></i> Compressing & AI Scanning...`;

            try {
                const compressedBlob = await compressImage(file);

                const formData = new FormData();
                formData.append('labelImage', compressedBlob, 'label.jpg');

                const res = await fetch('/admin/api/scan-ai-label', {
                    method: 'POST',
                    body: formData
                });
                const result = await res.json();
                statusBox.classList.add('hidden');

                if (result.success && result.data) {
                    const { tracking, name, mobile, pincode } = result.data;

                    if (tracking) document.getElementById('mTracking').value = tracking.toUpperCase().trim();
                    if (name) document.getElementById('mReceiverName').value = name.toUpperCase().trim();
                    if (mobile) document.getElementById('mMobile').value = mobile.trim();
                    if (pincode) {
                        const cleanPin = pincode.toString().trim();
                        document.getElementById('mPincode').value = cleanPin;
                        await fetchPincodeDetails(cleanPin);
                    }

                    document.getElementById('mWeight').focus();
                } else {
                    alert(result.msg || "AI could not read the label image clearly. Please try again.");
                }
            } catch (err) {
                console.error("AI Scan Error:", err);
                statusText.innerText = "Scanning error! Please try again.";
                setTimeout(() => statusBox.classList.add('hidden'), 3000);
            }

            this.value = '';
        });

        function compressImage(file) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const maxWidth = 800; 
                        let width = img.width;
                        let height = img.height;

                        if (width > maxWidth) {
                            height = Math.round((height * maxWidth) / width);
                            width = maxWidth;
                        }

                        canvas.width = width;
                        canvas.height = height;

                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        canvas.toBlob((blob) => {
                            resolve(blob);
                        }, 'image/jpeg', 0.55);
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        async function fetchPincodeDetails(pincode) {
            try {
                const res = await fetch(`/admin/api/fetch-details?pincode=${pincode}`);
                const data = await res.json();
                if (data.success && (data.city || data.state || data.address)) {
                    document.getElementById('txtCity').value = data.city || '';
                    document.getElementById('txtState').value = data.state || '';
                    document.getElementById('txtAddress').value = data.address || '';
                }
            } catch(err) {
                console.error("Auto-fetch address error:", err);
            }
        }

        document.getElementById('mPincode').addEventListener('input', async function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
            const pincode = this.value.trim();
            
            if (pincode.length === 6) {
                await fetchPincodeDetails(pincode);
            } else {
                document.getElementById('txtCity').value = '';
                document.getElementById('txtState').value = '';
                document.getElementById('txtAddress').value = '';
            }
        });

        document.getElementById('manualEntryForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const payload = {
                tracking: document.getElementById('mTracking').value.toUpperCase().trim(),
                name: document.getElementById('mReceiverName').value.toUpperCase().trim(),
                mobile: document.getElementById('mMobile').value.trim(),
                pincode: document.getElementById('mPincode').value.trim(),
                weight: document.getElementById('mWeight').value,
                length: document.getElementById('mLength').value,
                breadth: document.getElementById('mBreadth').value,
                height: document.getElementById('mHeight').value,
                city: document.getElementById('txtCity').value.toUpperCase().trim() || 'N/A',
                state: document.getElementById('txtState').value.toUpperCase().trim() || 'N/A',
                address: document.getElementById('txtAddress').value.toUpperCase().trim() || 'N/A'
            };

            try {
                const res = await fetch('/admin/api/save-manual', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                
                if(result.success) {
                    localEntries = result.entries;
                    renderTable();
                    
                    document.getElementById('manualEntryForm').reset();
                    document.getElementById('txtCity').value = '';
                    document.getElementById('txtState').value = '';
                    document.getElementById('txtAddress').value = '';
                    document.getElementById('selectedPresetLabel').innerHTML = `<i class="fa-solid fa-bolt text-amber-400"></i> Select Box Preset...`;
                    
                    document.getElementById('mTracking').focus();
                }
            } catch(err) { console.error(err); }
        });

        function renderTable() {
            const tbody = document.getElementById('sessionTableBody');
            if(localEntries.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-400 font-normal">No entries added in this session yet.</td></tr>`;
                return;
            }
            tbody.innerHTML = '';
            localEntries.forEach((item, index) => {
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/50">
                        <td class="py-3 px-4 font-mono font-bold text-slate-900">${item.tracking}</td>
                        <td class="py-3 px-4 uppercase">${item.name}</td>
                        <td class="py-3 px-4 font-mono">${item.mobile}</td>
                        <td class="py-3 px-4 font-mono font-bold text-emerald-600">${item.pincode}</td>
                        <td class="py-3 px-4 text-[10px] uppercase text-slate-400">${item.city}, ${item.state}</td>
                        <td class="py-3 px-4 text-center">
                            <button type="button" onclick="deleteItem(${item.id || index})" class="text-rose-500 hover:text-rose-600 font-bold cursor-pointer"><i class="fa-solid fa-trash"></i> Delete</button>
                        </td>
                    </tr>
                `;
            });
        }

        async function deleteItem(idOrIndex) {
            if(confirm("Are you sure you want to delete this entry?")) {
                try {
                    const res = await fetch(`/admin/api/delete-entry/${idOrIndex}`, { method: 'DELETE' });
                    const result = await res.json();
                    if(result.success) {
                        localEntries = result.entries;
                        renderTable();
                    }
                } catch(err) { console.error(err); }
            }
        }

        document.getElementById('exportExcelBtn').addEventListener('click', function() {
            if(localEntries.length === 0) {
                alert("Please add at least one entry before exporting.");
                return;
            }
            let customName = prompt("Enter file name for Excel export:", "avira_india_post_dispatch");
            if (customName === null) return;
            if (customName.trim() === "") customName = "avira_india_post_dispatch";

            window.location.href = `/admin/api/export-excel?filename=${encodeURIComponent(customName)}`;
        });
    </script>
</body>
</html>