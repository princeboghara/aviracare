<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="referrer" content="no-referrer-when-downgrade">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <title>Query Support Center - Avira Lifecare</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        html, body {
            max-width: 100vw !important;
            overflow-x: hidden !important;
            position: relative;
        }

        /* ULTRA 3D GLASSMORPHISM CARD EFFECT */
        .premium-card { 
            background: rgba(255, 255, 255, 0.88); 
            backdrop-filter: blur(20px) saturate(180%); 
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.8); 
            box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.07);
        }

        /* ANIMATED FLOATING BACKGROUND BLOBS */
        .animated-blob {
            filter: blur(80px);
            opacity: 0.35;
            animation: floatBlob 14s infinite alternate ease-in-out;
            will-change: transform;
        }
        @keyframes floatBlob {
            0% { transform: translate(0px, 0px) scale(1); }
            100% { transform: translate(25px, 35px) scale(1.08); }
        }

        /* 3D ANIMATED INPUTS */
        .cyber-input {
            background: rgba(248, 250, 252, 0.85);
            border: 1.5px solid #e2e8f0;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .cyber-input:focus {
            background: #ffffff;
            border-color: #10b981;
            box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.15), 0 0 0 3px rgba(16, 185, 129, 0.1);
            transform: translateY(-2px);
        }

        /* 3D INTERACTIVE GRADIENT BUTTONS */
        .btn-3d-emerald {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            box-shadow: 0 8px 20px -3px rgba(16, 185, 129, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .btn-3d-emerald:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 12px 25px -2px rgba(16, 185, 129, 0.45);
        }

        .btn-3d-dark {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            box-shadow: 0 8px 20px -3px rgba(15, 23, 42, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        /* CUSTOM 3D DROPDOWN POPOVER MENU */
        .custom-dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-12px) scale(0.96);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .custom-dropdown-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        /* SMOOTH SLIDE-DOWN ANIMATION */
        .slide-down-anim {
            animation: slideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col justify-between font-sans antialiased text-slate-800 relative w-full overflow-x-hidden">

    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute -top-10 -left-10 w-72 h-72 sm:w-96 sm:h-96 bg-emerald-300/20 rounded-full animated-blob"></div>
        <div class="absolute -bottom-10 -right-10 w-72 h-72 sm:w-96 sm:h-96 bg-blue-300/20 rounded-full animated-blob" style="animation-delay: -5s;"></div>
    </div>

    <header class="bg-white/80 backdrop-blur-md border-b border-slate-100 px-4 sm:px-6 py-3.5 sticky top-0 z-50 shadow-sm w-full">
        <div class="max-w-3xl mx-auto flex justify-between items-center w-full">
            <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="h-9 w-9 rounded-xl overflow-hidden bg-white flex items-center justify-center shadow-md border border-slate-100 flex-shrink-0">
                    <img src="/images/logo.jpg" alt="Avira Logo" class="h-full w-full object-cover">
                </div>
                <div class="truncate">
                    <span class="text-xs sm:text-base font-black text-slate-900 block truncate">AVIRA LIFECARE</span>
                    <span class="text-[8px] sm:text-[9px] font-bold text-emerald-600 uppercase tracking-widest block -mt-0.5">Query Center</span>
                </div>
            </div>
            <a href="/" class="btn-3d-dark text-white text-[10px] font-black px-4 py-2 rounded-xl uppercase flex items-center gap-1.5 cursor-pointer flex-shrink-0 ml-2">
                <i class="fa-solid fa-house text-[9px]"></i> <span class="hidden sm:inline">Home</span>
            </a>
        </div>
    </header>

    <main class="flex-grow w-full max-w-2xl mx-auto px-4 py-6 sm:py-8 space-y-6 relative z-10 box-border">
        
        <div id="authSection" class="premium-card p-6 sm:p-8 rounded-3xl text-center space-y-4">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black bg-amber-50 text-amber-700 border border-amber-200/80 uppercase tracking-wider shadow-sm">
                <i class="fa-solid fa-lock text-amber-500"></i> Secure Gateway
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-950 uppercase tracking-tight">Open Your Support Desk</h2>
            <p class="text-slate-400 text-[11px] sm:text-xs max-w-sm mx-auto leading-relaxed">Enter your unique Avira Member ID to view past ticket history or lodge a new complaint.</p>
            <form id="queryAuthForm" class="flex flex-col sm:flex-row gap-2.5 max-w-md mx-auto pt-2">
                <input type="text" id="memberIdInput" placeholder="ENTER YOUR MEMBER ID" required class="cyber-input flex-grow px-4 py-3 rounded-2xl text-xs font-bold tracking-wider focus:outline-none uppercase text-slate-800">
                <button type="submit" class="btn-3d-dark text-white font-black text-xs px-6 py-3 rounded-2xl uppercase cursor-pointer tracking-wider flex-shrink-0">Access Desk</button>
            </form>
        </div>

        <div id="dashboardSection" class="hidden space-y-6">
            
            <div class="premium-card p-4 sm:p-5 rounded-2xl flex justify-between items-center shadow-sm">
                <div>
                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider block">Logged in as:</span>
                    <span id="activeMemberBadge" class="text-sm font-mono font-black text-emerald-600 uppercase tracking-wider">AV12345</span>
                </div>
                <button onclick="toggleForm()" class="btn-3d-emerald text-white text-[10px] sm:text-[11px] font-black px-4 py-2.5 rounded-xl uppercase tracking-wider cursor-pointer flex items-center gap-1.5">
                    <i class="fa-solid fa-plus text-xs"></i> Add New Query
                </button>
            </div>

            <div id="newQueryFormContainer" class="hidden premium-card p-5 sm:p-7 rounded-3xl shadow-xl bg-white/95 space-y-4 border border-slate-100">
                <h3 class="text-xs sm:text-sm font-black text-slate-900 uppercase border-b border-slate-100 pb-3 flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-emerald-500 text-sm"></i> Lodge New Support Ticket
                </h3>
                <form id="newTicketForm" class="space-y-4">
                    
                    <div>
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-wider block mb-1">Full Name</label>
                        <input type="text" id="formName" placeholder="Enter Your Full Name" required class="cyber-input w-full px-4 py-3 rounded-xl text-xs font-bold uppercase focus:outline-none text-slate-800">
                    </div>

                    <div>
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-wider block mb-1">Contact Number</label>
                        <input type="tel" id="formContactNo" placeholder="Enter 10 Digit Mobile Number" required maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '').substring(0, 10);" class="cyber-input w-full px-4 py-3 rounded-xl text-xs font-bold font-mono focus:outline-none text-slate-800">
                    </div>

                    <div class="relative">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-wider block mb-1">Select Subject</label>
                        
                        <button type="button" id="dropdownBtn" class="cyber-input w-full px-4 py-3 rounded-xl text-xs font-bold text-left flex justify-between items-center cursor-pointer text-slate-700">
                            <span id="selectedSubjectText" class="flex items-center gap-2">
                                <i class="fa-solid fa-list-check text-emerald-500"></i> Select Subject...
                            </span>
                            <i id="dropdownChevron" class="fa-solid fa-chevron-down text-slate-400 text-xs transition-transform duration-300"></i>
                        </button>

                        <input type="hidden" id="selectedSubjectValue" value="">

                        <div id="dropdownMenu" class="custom-dropdown-menu absolute left-0 right-0 top-full mt-2 bg-white/95 backdrop-blur-xl border border-slate-200/90 rounded-2xl shadow-2xl z-50 p-2 space-y-1">
                            
                            <div onclick="selectSubjectOption('Order Tracking', 'fa-truck-fast')" class="flex items-center gap-3 p-3 rounded-xl hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 cursor-pointer transition-all">
                                <div class="h-8 w-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0">
                                    <i class="fa-solid fa-truck-fast text-xs"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-extrabold uppercase">1. Order Tracking</p>
                                    <p class="text-[9px] text-slate-400 font-medium">Delivery, Barcode, or Shipping status</p>
                                </div>
                            </div>

                            <div onclick="selectSubjectOption('Product Details', 'fa-basket-shopping')" class="flex items-center gap-3 p-3 rounded-xl hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 cursor-pointer transition-all">
                                <div class="h-8 w-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600 flex-shrink-0">
                                    <i class="fa-solid fa-basket-shopping text-xs"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-extrabold uppercase">2. Product Details</p>
                                    <p class="text-[9px] text-slate-400 font-medium">Inquiries regarding products or stock</p>
                                </div>
                            </div>

                            <div onclick="selectSubjectOption('Other', 'fa-pen-to-square')" class="flex items-center gap-3 p-3 rounded-xl hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 cursor-pointer transition-all border-t border-slate-100 pt-2">
                                <div class="h-8 w-8 rounded-lg bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0">
                                    <i class="fa-solid fa-pen-to-square text-xs"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-extrabold uppercase">3. Other (Custom Topic)</p>
                                    <p class="text-[9px] text-slate-400 font-medium">Type your own custom query topic</p>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div id="customSubjectContainer" class="hidden slide-down-anim">
                        <label class="text-[10px] font-black text-emerald-600 uppercase tracking-wider block mb-1">Specify Custom Subject</label>
                        <input type="text" id="formCustomSubject" placeholder="Enter your query topic..." class="cyber-input w-full px-4 py-3 rounded-xl text-xs font-bold focus:outline-none uppercase border-emerald-300 text-slate-800">
                    </div>

                    <div>
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-wider block mb-1">Description / Ticket Details</label>
                        <textarea id="formDescription" rows="4" placeholder="Write your concern or problem in detail here..." required class="cyber-input w-full px-4 py-3 rounded-xl text-xs font-medium focus:outline-none text-slate-800"></textarea>
                    </div>

                    <div class="flex justify-end gap-2.5 pt-2">
                        <button type="button" onclick="toggleForm()" class="bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold px-5 py-2.5 rounded-xl cursor-pointer transition-all">Cancel</button>
                        <button type="submit" class="btn-3d-emerald text-white text-xs font-black px-7 py-2.5 rounded-xl uppercase cursor-pointer tracking-wider">Submit Ticket</button>
                    </div>
                </form>
            </div>

            <div class="space-y-3.5">
                <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-widest pl-1 flex items-center gap-1.5">
                    <i class="fa-solid fa-clock-rotate-left text-emerald-500"></i> Past Query History
                </h3>
                <div id="historyList" class="space-y-3"></div>
            </div>

        </div>

    </main>

    <footer class="bg-white/60 backdrop-blur-md border-t border-slate-100 py-4 text-center text-[10px] text-slate-400 px-4 relative z-10 w-full overflow-hidden">
        &copy; 2026 Avira Lifecare. Secure Query Support Network.
    </footer>

    <script>
        let loggedMemberId = '';

        const dropdownBtn = document.getElementById('dropdownBtn');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const dropdownChevron = document.getElementById('dropdownChevron');

        dropdownBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const isActive = dropdownMenu.classList.contains('active');
            
            if(isActive) {
                closeCustomDropdown();
            } else {
                dropdownMenu.classList.add('active');
                dropdownChevron.classList.add('rotate-180');
            }
        });

        document.addEventListener('click', function(e) {
            if (!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
                closeCustomDropdown();
            }
        });

        function closeCustomDropdown() {
            dropdownMenu.classList.remove('active');
            dropdownChevron.classList.remove('rotate-180');
        }

        function selectSubjectOption(val, icon) {
            document.getElementById('selectedSubjectValue').value = val;
            document.getElementById('selectedSubjectText').innerHTML = `<i class="fa-solid ${icon} text-emerald-500"></i> ${escapeHTML(val)}`;
            
            const customBox = document.getElementById('customSubjectContainer');
            const customInput = document.getElementById('formCustomSubject');

            if (val === 'Other') {
                customBox.classList.remove('hidden');
                customInput.required = true;
                customInput.focus();
            } else {
                customBox.classList.add('hidden');
                customInput.required = false;
                customInput.value = '';
            }

            closeCustomDropdown();
        }

        document.getElementById('queryAuthForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const mId = escapeHTML(document.getElementById('memberIdInput').value.trim().toUpperCase());
            if(!mId) return;

            loggedMemberId = mId;
            document.getElementById('activeMemberBadge').innerText = mId;
            document.getElementById('authSection').classList.add('hidden');
            document.getElementById('dashboardSection').classList.remove('hidden');

            fetchHistory();
        });

        function toggleForm() {
            const container = document.getElementById('newQueryFormContainer');
            container.classList.toggle('hidden');
        }

        async function fetchHistory() {
            try {
                const response = await fetch(`/api/queries/history?memberId=${encodeURIComponent(loggedMemberId)}`);
                const data = await response.json();
                const list = document.getElementById('historyList');
                list.innerHTML = '';

                if(data && data.length > 0) {
                    data.forEach(ticket => {
                        let statusColor = 'bg-amber-50 text-amber-700 border-amber-200';
                        if(ticket.status === 'ACCEPTED') statusColor = 'bg-blue-50 text-blue-700 border-blue-200';
                        if(ticket.status === 'SOLVED') statusColor = 'bg-emerald-50 text-emerald-700 border-emerald-200';

                        list.innerHTML += `
                            <div class="premium-card p-4 sm:p-5 rounded-2xl bg-white shadow-sm border border-slate-100/70 space-y-3">
                                <div class="flex justify-between items-start gap-3">
                                    <div>
                                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wide block">Ticket ID: #${escapeHTML(String(ticket.id))} | ${escapeHTML(ticket.name || 'MEMBER')}</span>
                                        <h4 class="text-xs font-black text-slate-900 mt-0.5 uppercase">${escapeHTML(ticket.subject || '')}</h4>
                                    </div>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[9px] sm:text-[10px] font-black border uppercase tracking-wide flex-shrink-0 ${statusColor}">${escapeHTML(ticket.status || '')}</span>
                                </div>
                                <p class="text-xs text-slate-600 leading-relaxed font-medium bg-slate-50/70 p-3 rounded-xl border border-slate-100 break-words">${escapeHTML(ticket.description || '')}</p>
                                <div class="flex justify-between items-center text-[10px] text-slate-400 font-bold border-t pt-2 border-slate-100 flex-wrap gap-1">
                                    <span><i class="fa-solid fa-phone text-slate-300 mr-0.5"></i> Call: ${escapeHTML(ticket.contact_no || '')}</span>
                                    <span><i class="fa-solid fa-calendar text-slate-300 mr-0.5"></i> ${escapeHTML(new Date(ticket.created_at).toLocaleString())}</span>
                                </div>
                            </div>
                        `;
                    });
                } else {
                    list.innerHTML = `
                        <div class="premium-card p-8 text-center rounded-2xl bg-white shadow-sm">
                            <i class="fa-solid fa-face-smile text-3xl block mb-2 text-slate-200"></i>
                            <p class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">No tickets raised yet!</p>
                        </div>`;
                }
            } catch (err) { console.error(err); }
        }

        document.getElementById('newTicketForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const name = document.getElementById('formName').value.trim();
            const contactNo = document.getElementById('formContactNo').value.trim();
            const selectValue = document.getElementById('selectedSubjectValue').value;
            const customSubject = document.getElementById('formCustomSubject').value.trim();
            
            const finalSubject = (selectValue === 'Other') ? customSubject : selectValue;
            const description = document.getElementById('formDescription').value.trim();

            if (!finalSubject) {
                alert("Please select a subject from the list!");
                return;
            }

            try {
                const res = await fetch('/api/queries/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        memberId: loggedMemberId, 
                        name: sanitizeString(name), 
                        contactNo: sanitizeString(contactNo), 
                        subject: sanitizeString(finalSubject), 
                        description: sanitizeString(description) 
                    })
                });
                const result = await res.json();
                if(result.success) {
                    alert(result.msg || "Ticket submitted successfully!");
                    document.getElementById('newTicketForm').reset();
                    document.getElementById('selectedSubjectValue').value = '';
                    document.getElementById('selectedSubjectText').innerHTML = `<i class="fa-solid fa-list-check text-emerald-500"></i> Select Subject...`;
                    document.getElementById('customSubjectContainer').classList.add('hidden');
                    toggleForm();
                    fetchHistory();
                } else { alert(result.msg || "Failed to submit ticket."); }
            } catch(err) { console.error(err); }
        });

        function escapeHTML(str) {
            return String(str || '').replace(/[&<>"'/]/g, function (s) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;',
                    '/': '&#x2F;'
                }[s];
            });
        }

        function sanitizeString(str) {
            return String(str || '').trim();
        }
    </script>
</body>
</html>