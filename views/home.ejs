<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="referrer" content="no-referrer-when-downgrade">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <title>Avira Lifecare - Official Member Portal & Digital Workspace</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        html, body {
            max-width: 100vw !important;
            overflow-x: hidden !important;
            position: relative;
        }

        /* ULTRA 3D GLASSMORPHISM CARD ENGINE */
        .glass-card-3d {
            background: rgba(255, 255, 255, 0.82);
            backdrop-filter: blur(25px) saturate(190%);
            -webkit-backdrop-filter: blur(25px) saturate(190%);
            border: 1.5px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.06);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
                        background 0.4s ease, 
                        box-shadow 0.4s ease, 
                        border-color 0.4s ease;
            transform-style: preserve-3d;
            perspective: 1000px;
        }
        .glass-card-3d:hover {
            background: rgba(255, 255, 255, 0.96);
            box-shadow: 0 30px 60px -12px rgba(16, 185, 129, 0.22);
            border-color: rgba(16, 185, 129, 0.4);
        }

        /* ANIMATED FLOATING GLOW BLOBS */
        .animated-blob {
            filter: blur(90px);
            opacity: 0.38;
            animation: floatBlob 16s infinite alternate ease-in-out;
            will-change: transform;
        }
        @keyframes floatBlob {
            0% { transform: translate(0px, 0px) scale(1); }
            50% { transform: translate(30px, -20px) scale(1.08); }
            100% { transform: translate(-20px, 30px) scale(0.92); }
        }

        /* 3D BUTTON GRADIENTS & LIFT EFFECTS */
        .btn-3d-emerald {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            box-shadow: 0 10px 25px -4px rgba(16, 185, 129, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .btn-3d-emerald:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 15px 30px -2px rgba(16, 185, 129, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.5);
        }
        .btn-3d-emerald:active { transform: translateY(0) scale(0.98); }

        .btn-3d-dark {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            box-shadow: 0 10px 25px -4px rgba(15, 23, 42, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .btn-3d-dark:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 15px 30px -2px rgba(15, 23, 42, 0.4);
        }

        .btn-3d-amber {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            box-shadow: 0 10px 25px -4px rgba(245, 158, 11, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .btn-3d-amber:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 15px 30px -2px rgba(245, 158, 11, 0.5);
        }

        /* RADIAL PULSE SHIMMER */
        .pulse-effect { position: relative; }
        .pulse-effect::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6);
            animation: pulseAnim 2.2s infinite;
        }
        @keyframes pulseAnim {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
            70% { box-shadow: 0 0 0 14px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        /* FOOTER LUXURY GLASS CARD */
        .footer-card {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            transition: all 0.35s ease;
        }
        .footer-card:hover {
            background: #ffffff;
            transform: translateY(-4px);
            box-shadow: 0 15px 30px -5px rgba(16, 185, 129, 0.15);
            border-color: rgba(16, 185, 129, 0.4);
        }

        /* INTERACTIVE TILT INNER DEPT */
        .inner-3d { transform: translateZ(25px); }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col justify-between font-sans antialiased text-slate-800 relative w-full overflow-x-hidden">

    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute -top-20 -left-20 w-80 h-80 sm:w-[450px] sm:h-[450px] bg-emerald-400/25 rounded-full animated-blob"></div>
        <div class="absolute top-1/3 -right-20 w-80 h-80 sm:w-[450px] sm:h-[450px] bg-blue-400/20 rounded-full animated-blob" style="animation-delay: -5s;"></div>
        <div class="absolute -bottom-20 left-1/4 w-80 h-80 sm:w-[400px] sm:h-[400px] bg-teal-300/20 rounded-full animated-blob" style="animation-delay: -10s;"></div>
    </div>

    <header class="bg-white/80 backdrop-blur-md border-b border-slate-100/80 px-4 sm:px-8 py-3.5 sticky top-0 z-50 shadow-sm w-full">
        <div class="max-w-5xl mx-auto flex justify-between items-center w-full">
            
            <div class="flex items-center gap-3 min-w-0">
                <div class="h-10 w-10 sm:h-11 sm:w-11 rounded-2xl overflow-hidden bg-white flex items-center justify-center shadow-md border border-slate-200/80 flex-shrink-0 p-0.5">
                    <img src="/images/logo.jpg" alt="Avira Logo" class="h-full w-full object-cover rounded-xl">
                </div>
                <div class="truncate">
                    <span class="text-xs sm:text-base font-black tracking-tight text-slate-900 block truncate">AVIRA LIFECARE GLOBAL</span>
                    <span class="text-[8px] sm:text-[9.5px] font-bold text-emerald-600 uppercase tracking-widest block -mt-0.5">Official Member Portal</span>
                </div>
            </div>

            <a href="#footer" class="btn-3d-dark text-white px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl font-bold text-[10px] sm:text-xs uppercase tracking-wider flex items-center gap-2 cursor-pointer flex-shrink-0 ml-2">
                <i class="fa-solid fa-headset text-amber-400 text-xs"></i>
                <span class="hidden sm:inline">Support Desk</span>
            </a>

        </div>
    </header>

    <main class="flex-grow w-full max-w-5xl mx-auto px-4 py-8 sm:py-14 flex flex-col justify-center gap-8 sm:gap-12 relative z-10 box-border">
        
        <div class="w-full text-center space-y-3.5 max-w-3xl mx-auto">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[10px] font-black bg-emerald-50 text-emerald-700 border border-emerald-200 uppercase tracking-widest shadow-sm">
                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-ping"></span>
                Official Member Network
            </div>
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-950 leading-tight">
                Empowering Health,<br class="hidden sm:inline"> <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-500">Enriching Life.</span>
            </h1>
            <p class="text-slate-500 text-xs sm:text-sm leading-relaxed max-w-2xl mx-auto font-medium">
                Welcome to your Avira Digital Hub. Download corporate business blueprints, browse wellness catalogs, manage member queries, and track real-time dispatches seamlessly.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 w-full">
            
            <div class="glass-card-3d p-5 sm:p-7 rounded-3xl flex flex-col justify-between text-center sm:text-left relative overflow-hidden group tilt-element">
                <div class="mb-5 inner-3d">
                    <div class="w-12 h-12 bg-emerald-500/10 text-emerald-600 rounded-2xl flex items-center justify-center text-xl mx-auto sm:mx-0 mb-4 border border-emerald-200/50 shadow-sm">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>
                    <h3 class="text-base sm:text-lg font-black text-slate-900 mb-1">Business Plan</h3>
                    <p class="text-slate-400 text-xs font-medium leading-relaxed">Download official compensation plan documentation and opportunity guides.</p>
                </div>

                <a href="<%= businessPlan %>" download class="btn-3d-dark w-full text-center text-white font-black text-xs py-3 rounded-2xl uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer inner-3d">
                    Download Plan <i class="fa-solid fa-file-arrow-download text-xs text-emerald-400"></i>
                </a>
            </div>

            <div class="glass-card-3d p-5 sm:p-7 rounded-3xl flex flex-col justify-between text-center sm:text-left relative overflow-hidden group tilt-element">
                <div class="mb-5 inner-3d">
                    <div class="w-12 h-12 bg-blue-500/10 text-blue-600 rounded-2xl flex items-center justify-center text-xl mx-auto sm:mx-0 mb-4 border border-blue-200/50 shadow-sm">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <h3 class="text-base sm:text-lg font-black text-slate-900 mb-1">Product Catalog</h3>
                    <p class="text-slate-400 text-xs font-medium leading-relaxed">Get full digital access to complete health, wellness, and personal care range.</p>
                </div>

                <a href="<%= catalog %>" download class="btn-3d-dark w-full text-center text-white font-black text-xs py-3 rounded-2xl uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer inner-3d">
                    Download PDF <i class="fa-solid fa-file-arrow-download text-xs text-blue-400"></i>
                </a>
            </div>

            <div class="glass-card-3d p-5 sm:p-7 rounded-3xl flex flex-col justify-between text-center sm:text-left relative overflow-hidden group border-emerald-300/80 tilt-element">
                <div class="mb-5 inner-3d">
                    <div class="w-12 h-12 bg-teal-500/10 text-teal-600 rounded-2xl flex items-center justify-center text-xl mx-auto sm:mx-0 mb-4 border border-teal-200/50 shadow-sm">
                        <i class="fa-solid fa-basket-shopping"></i>
                    </div>
                    <h3 class="text-base sm:text-lg font-black text-slate-900 mb-1">Product Showcase</h3>
                    <p class="text-slate-400 text-xs font-medium leading-relaxed">Explore active product store, MRP pricing, PV metrics, and usage benefits.</p>
                </div>

                <a href="/products" class="btn-3d-emerald w-full text-center text-white font-black text-xs py-3 rounded-2xl uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer inner-3d">
                    View Showcase <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>

        </div>

        <div class="w-full">
            <div class="glass-card-3d p-5 sm:p-7 rounded-3xl flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left border-emerald-200/80 tilt-element">
                <div class="flex flex-col sm:flex-row items-center gap-4 inner-3d">
                    <div class="w-12 h-12 sm:w-14 sm:h-14 bg-emerald-500 text-white rounded-2xl flex items-center justify-center text-xl sm:text-2xl shadow-lg shadow-emerald-500/30 flex-shrink-0">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <div>
                        <h4 class="text-sm sm:text-base font-black text-slate-900 uppercase tracking-wide">Live Dispatch & Parcel Tracker</h4>
                        <p class="text-slate-400 text-xs font-medium mt-0.5">Check real-time India Post tracking numbers and consignment status using Member ID.</p>
                    </div>
                </div>
                <a href="/track-parcel" class="btn-3d-emerald pulse-effect w-full sm:w-auto text-white font-black text-xs py-3.5 px-6 rounded-2xl uppercase tracking-wider cursor-pointer text-center flex-shrink-0 inner-3d">
                    Track Consignment &rarr;
                </a>
            </div>
        </div>

        <div class="w-full">
            <div class="glass-card-3d p-5 sm:p-7 rounded-3xl flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left border-amber-200/80 tilt-element">
                <div class="flex flex-col sm:flex-row items-center gap-4 inner-3d">
                    <div class="w-12 h-12 sm:w-14 sm:h-14 bg-amber-500 text-slate-950 rounded-2xl flex items-center justify-center text-xl sm:text-2xl shadow-lg shadow-amber-500/30 flex-shrink-0">
                        <i class="fa-solid fa-headset"></i>
                    </div>
                    <div>
                        <h4 class="text-sm sm:text-base font-black text-slate-900 uppercase tracking-wide">Official Query & Support Center</h4>
                        <p class="text-slate-400 text-xs font-medium mt-0.5">Lodge queries regarding product dispatches, payout inquiries, or technical support.</p>
                    </div>
                </div>
                <a href="/member/queries" class="btn-3d-amber w-full sm:w-auto text-center text-slate-950 font-black text-xs py-3.5 px-6 rounded-2xl uppercase tracking-wider cursor-pointer flex-shrink-0 inner-3d">
                    Open Support Desk &rarr;
                </a>
            </div>
        </div>

    </main>

    <footer id="footer" class="bg-white/80 backdrop-blur-xl border-t border-slate-200/80 pt-10 pb-8 px-4 sm:px-8 mt-12 relative z-10 text-slate-600 w-full overflow-hidden">
        <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-5 text-xs pb-8 border-b border-slate-200/60">
            
            <div class="footer-card p-5 rounded-2xl flex flex-col justify-between space-y-3">
                <div>
                    <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-base mb-3 shadow-xs">
                        <i class="fa-solid fa-building"></i>
                    </div>
                    <p class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Corporate Headquarters</p>
                    <p class="font-bold text-slate-900 uppercase leading-relaxed mt-1 text-[11px]">
                        103, The Galleria Business Hub 2,<br>
                        Surat, Gujarat - 395010, India
                    </p>
                </div>
            </div>

            <div class="footer-card p-5 rounded-2xl flex flex-col justify-between space-y-3">
                <div>
                    <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-base mb-3 shadow-xs">
                        <i class="fa-solid fa-phone"></i>
                    </div>
                    <p class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Helpline Desk</p>
                    <p class="font-mono font-black text-slate-950 text-sm tracking-wide mt-1">+91 97123 26273</p>
                </div>
                <p class="text-[10px] text-emerald-600 font-extrabold uppercase flex items-center gap-1.5">
                    <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span> Mon - Sat: 10:00 AM - 6:00 PM
                </p>
            </div>

            <div class="footer-card p-5 rounded-2xl flex flex-col justify-between space-y-3">
                <div>
                    <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-base mb-3 shadow-xs">
                        <i class="fa-solid fa-globe"></i>
                    </div>
                    <p class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Digital Network</p>
                    <a href="https://www.aviralifecare.com" target="_blank" rel="noopener noreferrer" class="font-mono font-black text-slate-900 hover:text-emerald-600 transition-colors block text-xs underline mt-1">www.aviralifecare.com</a>
                </div>
                <p class="text-[10px] text-slate-400 font-bold"><i class="fa-solid fa-envelope text-slate-400 mr-1"></i> info@aviralifecare.com</p>
            </div>

        </div>

        <div class="pt-6 text-center text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-widest">
            &copy; 2026 Avira Lifecare Global Private Limited. All rights reserved.
        </div>
    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tiltElements = document.querySelectorAll(".tilt-element");

            tiltElements.forEach((card) => {
                card.addEventListener("mousemove", (e) => {
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;

                    const centerX = rect.width / 2;
                    const centerY = rect.height / 2;

                    const rotateX = ((y - centerY) / centerY) * -6;
                    const rotateY = ((x - centerX) / centerX) * 6;

                    card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-8px) scale(1.01)`;
                });

                card.addEventListener("mouseleave", () => {
                    card.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px) scale(1)";
                });
            });
        });
    </script>
</body>
</html>