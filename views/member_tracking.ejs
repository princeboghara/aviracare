<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="referrer" content="no-referrer-when-downgrade">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <title>Track Your Shipment - Avira Lifecare</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            max-width: 100vw !important;
            overflow-x: hidden !important;
            position: relative;
        }

        /* 🟢 PREMIUM EMERALD GLASSMOPHISM CARDS */
        .emerald-glass-card {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(24px) saturate(180%);
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            border: 1px solid rgba(16, 185, 129, 0.25);
            box-shadow: 0 15px 35px -5px rgba(16, 185, 129, 0.12), 0 0 15px rgba(16, 185, 129, 0.05);
            transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .emerald-glass-card:hover {
            transform: translateY(-4px);
            border-color: rgba(16, 185, 129, 0.5);
            box-shadow: 0 20px 45px -5px rgba(16, 185, 129, 0.22);
        }

        /* 🌿 ANIMATED GREEN BACKGROUND BLOBS */
        .green-orb {
            filter: blur(90px);
            opacity: 0.45;
            animation: orbFloat 10s infinite alternate ease-in-out;
        }
        @keyframes orbFloat {
            0% { transform: translate(0px, 0px) scale(1); }
            100% { transform: translate(30px, -25px) scale(1.1); }
        }

        /* ✨ GREEN NEON GLOW */
        .green-neon-btn {
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.35);
        }
        .green-neon-btn:hover {
            box-shadow: 0 0 30px rgba(16, 185, 129, 0.55);
        }

        /* 🌟 ENTRANCE ANIMATION */
        @keyframes cardPop {
            from { opacity: 0; transform: translateY(15px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .animate-pop {
            animation: cardPop 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col justify-between font-sans antialiased text-slate-800 relative w-full overflow-x-hidden selection:bg-emerald-500 selection:text-white">

    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute -top-10 -left-10 w-80 h-80 sm:w-[500px] sm:h-[500px] bg-emerald-300/40 rounded-full green-orb"></div>
        <div class="absolute top-1/2 -right-10 w-80 h-80 sm:w-[450px] sm:h-[450px] bg-teal-300/35 rounded-full green-orb" style="animation-delay: -3s;"></div>
        <div class="absolute -bottom-10 left-1/4 w-80 h-80 sm:w-[500px] sm:h-[500px] bg-emerald-200/40 rounded-full green-orb" style="animation-delay: -6s;"></div>
    </div>

    <header class="bg-white/80 backdrop-blur-xl border-b border-emerald-500/20 px-4 sm:px-8 py-3.5 sticky top-0 z-50 shadow-sm w-full">
        <div class="max-w-5xl mx-auto flex justify-between items-center w-full">
            <div class="flex items-center gap-3 min-w-0">
                <div class="h-10 w-10 rounded-2xl p-0.5 bg-gradient-to-br from-emerald-500 to-teal-600 shadow-md flex-shrink-0">
                    <div class="h-full w-full bg-white rounded-[14px] overflow-hidden flex items-center justify-center">
                        <img src="/images/logo.jpg" alt="Avira Logo" class="h-full w-full object-cover">
                    </div>
                </div>
                <div class="truncate">
                    <span class="text-xs sm:text-base font-black tracking-tight text-slate-900 block truncate uppercase">
                        AVIRA <span class="text-emerald-600">LIFECARE</span>
                    </span>
                    <span class="text-[8px] sm:text-[9px] font-bold text-emerald-600 uppercase tracking-widest block -mt-0.5 flex items-center gap-1">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Member Dispatch Portal
                    </span>
                </div>
            </div>
            
            <a href="/" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-950 text-white font-extrabold text-[10px] sm:text-xs tracking-wider uppercase backdrop-blur-md transition-all duration-300 cursor-pointer flex-shrink-0 shadow-md">
                <i class="fa-solid fa-house text-emerald-400"></i> <span class="hidden sm:inline">Home</span>
            </a>
        </div>
    </header>

    <main class="flex-grow w-full max-w-3xl mx-auto px-4 py-8 sm:py-12 flex flex-col justify-center gap-8 relative z-10 box-border">
        
        <div class="w-full text-center space-y-6">
            <div class="space-y-3">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-[10px] font-black bg-emerald-100/80 text-emerald-800 border border-emerald-300 uppercase tracking-widest backdrop-blur-md shadow-xs">
                    <i class="fa-solid fa-shield-halved text-emerald-600"></i> Realtime Live Tracking Engine
                </div>
                <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-950 uppercase">
                    Track Your <span class="bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-800 bg-clip-text text-transparent">Shipment</span>
                </h1>
                <p class="text-slate-600 text-xs sm:text-sm max-w-md mx-auto font-semibold leading-relaxed">
                    Enter your Member ID below to extract instant live courier status and parcel tracking details.
                </p>
            </div>

            <form id="memberTrackForm" class="emerald-glass-card p-2.5 rounded-3xl shadow-xl flex flex-col sm:flex-row gap-2.5 w-full border border-emerald-200/80 relative">
                <div class="relative flex-grow">
                    <i class="fa-solid fa-user-tag absolute left-4 top-1/2 -translate-y-1/2 text-emerald-600 text-sm"></i>
                    <input type="text" id="memberIdInput" placeholder="ENTER MEMBER ID (e.g., AV12345)" required
                           class="w-full pl-11 pr-4 py-3.5 bg-white rounded-2xl text-xs sm:text-sm font-mono font-bold tracking-widest focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 uppercase text-slate-900 placeholder-slate-400 border border-slate-200 transition-all">
                </div>
                <button type="submit" class="w-full sm:w-44 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-black text-xs py-3.5 px-6 rounded-2xl transition-all green-neon-btn uppercase tracking-wider cursor-pointer flex items-center justify-center gap-2 shadow-lg active:scale-95">
                    <i class="fa-solid fa-magnifying-glass text-sm"></i> Search Now
                </button>
            </form>

            <div id="filterSection" class="hidden flex flex-wrap items-center justify-center gap-2 pt-2 animate-pop">
                <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest mr-1 flex items-center gap-1">
                    <i class="fa-solid fa-sliders text-emerald-600"></i> View Limit:
                </span>
                <button type="button" onclick="setLimit(5)" id="limit-5" class="limit-btn bg-emerald-600 text-white text-[10px] font-black px-4 py-1.5 rounded-xl transition-all cursor-pointer shadow-md">LAST 5</button>
                <button type="button" onclick="setLimit(10)" id="limit-10" class="limit-btn bg-white text-slate-700 text-[10px] font-bold px-4 py-1.5 rounded-xl transition-all border border-emerald-200 hover:border-emerald-400 cursor-pointer">LAST 10</button>
                <button type="button" onclick="setLimit(50)" id="limit-50" class="limit-btn bg-white text-slate-700 text-[10px] font-bold px-4 py-1.5 rounded-xl transition-all border border-emerald-200 hover:border-emerald-400 cursor-pointer">LAST 50</button>
                <button type="button" onclick="setLimit('all')" id="limit-all" class="limit-btn bg-white text-slate-700 text-[10px] font-bold px-4 py-1.5 rounded-xl transition-all border border-emerald-200 hover:border-emerald-400 cursor-pointer">ALL RECORDS</button>
            </div>
        </div>

        <div id="resultsWrapper" class="w-full hidden space-y-6 animate-pop">
            
            <div class="flex items-center justify-between border-b border-emerald-200/80 pb-3">
                <h3 class="text-xs font-black text-emerald-800 uppercase tracking-widest flex items-center gap-2">
                    <i class="fa-solid fa-boxes-packing text-emerald-600"></i> Dispatch History Records
                </h3>
                
                <div class="flex items-center gap-2">
                    <span id="totalParcelBadge" class="text-xs font-black text-white bg-gradient-to-r from-emerald-600 to-teal-700 px-3.5 py-1.5 rounded-xl shadow-md border border-emerald-400/40 flex items-center gap-1.5 uppercase tracking-wide">
                        <i class="fa-solid fa-cubes text-amber-300"></i> Total Parcels: <span id="totalParcelCount" class="font-mono text-sm text-amber-300 font-extrabold">0</span>
                    </span>
                </div>
            </div>

            <div id="resultsList" class="space-y-5"></div>

            <div class="emerald-glass-card p-5 sm:p-6 rounded-3xl border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left relative overflow-hidden">
                <div class="flex items-center gap-4">
                    <div class="h-12 w-12 rounded-2xl bg-amber-100 border border-amber-300 flex items-center justify-center text-amber-600 text-xl flex-shrink-0 shadow-md">
                        <i class="fa-solid fa-headset animate-bounce"></i>
                    </div>
                    <div>
                        <h4 class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">Can't Find Your Shipment?</h4>
                        <p class="text-[11px] text-slate-500 font-medium mt-0.5">If your order is missing or details require correction, raise an instant ticket.</p>
                    </div>
                </div>
                <a href="/member/queries" class="w-full sm:w-auto bg-slate-900 hover:bg-slate-950 text-white font-black text-xs px-6 py-3 rounded-2xl transition-all shadow-lg uppercase tracking-wider text-center flex-shrink-0 flex items-center justify-center gap-2 cursor-pointer active:scale-95">
                    Raise Query Ticket <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>
        </div>

    </main>

    <footer class="bg-white/80 backdrop-blur-xl border-t border-emerald-200/80 py-4 text-center text-[10px] font-black text-slate-500 px-4 relative z-10 w-full uppercase tracking-widest">
        &copy; 2026 Avira Lifecare. Official Live Tracking & Dispatch Network.
    </footer>

    <script>
        let fullTrackData = [];
        let currentLimit = 5;

        document.getElementById('memberTrackForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const rawMemberId = document.getElementById('memberIdInput').value.trim();
            const memberId = sanitizeString(rawMemberId);
            if(!memberId) return;

            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.innerHTML = `<i class="fa-solid fa-circle-notch animate-spin text-sm"></i> SCANNING...`;
            submitBtn.disabled = true;

            try {
                const response = await fetch(`/api/track?memberId=${encodeURIComponent(memberId)}`);
                fullTrackData = await response.json();

                // 📦 UPDATE TOTAL PARCEL COUNT
                const totalCountSpan = document.getElementById('totalParcelCount');
                if (totalCountSpan) {
                    totalCountSpan.innerText = fullTrackData ? fullTrackData.length : 0;
                }

                if (fullTrackData && fullTrackData.length > 0) {
                    document.getElementById('filterSection').classList.remove('hidden');
                } else {
                    document.getElementById('filterSection').classList.add('hidden');
                }

                renderTrackRecords();
            } catch(err) {
                console.error(err);
                alert("Something went wrong. Please try again.");
            } finally {
                submitBtn.innerHTML = `<i class="fa-solid fa-magnifying-glass text-sm"></i> Search Now`;
                submitBtn.disabled = false;
            }
        });

        function setLimit(limit) {
            currentLimit = limit;
            document.querySelectorAll('.limit-btn').forEach(btn => {
                btn.className = "limit-btn bg-white text-slate-700 text-[10px] font-bold px-4 py-1.5 rounded-xl transition-all border border-emerald-200 hover:border-emerald-400 cursor-pointer";
            });
            const activeBtn = document.getElementById(`limit-${limit}`);
            if(activeBtn) {
                activeBtn.className = "limit-btn bg-emerald-600 text-white text-[10px] font-black px-4 py-1.5 rounded-xl transition-all cursor-pointer shadow-md";
            }
            renderTrackRecords();
        }

        function copyToClipboard(text, btnId) {
            navigator.clipboard.writeText(text).then(() => {
                const copyBtn = document.getElementById(btnId);
                copyBtn.innerHTML = `<i class="fa-solid fa-check text-emerald-600"></i> Copied!`;
                setTimeout(() => {
                    copyBtn.innerHTML = `<i class="fa-solid fa-copy"></i> Copy`;
                }, 2000);
            }).catch(err => console.error("Could not copy text: ", err));
        }

        function renderTrackRecords() {
            const wrapper = document.getElementById('resultsWrapper');
            const list = document.getElementById('resultsList');
            list.innerHTML = '';

            if(fullTrackData && fullTrackData.length > 0) {
                let displayData = [...fullTrackData];
                if (currentLimit !== 'all') {
                    displayData = displayData.slice(0, parseInt(currentLimit));
                }

                displayData.forEach((item, index) => {
                    const uniqueBtnId = `copy-btn-${index}`;
                    const safeName = escapeHTML(item.name || '');
                    const safeMemberId = escapeHTML(item.memberId || '');
                    const safeOrderDate = escapeHTML(item.orderDate || 'Processing');
                    const safePv = escapeHTML(String(item.pv || 0));
                    const safeAmount = escapeHTML(String(item.amount || 0));
                    const safeTracking = escapeHTML(item.tracking || '');

                    list.innerHTML += `
                        <div class="emerald-glass-card rounded-3xl p-5 space-y-4 text-left relative overflow-hidden border border-emerald-200/80">
                            
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 border-b border-emerald-100 pb-3">
                                <div>
                                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Customer Name</p>
                                    <h4 class="text-xs sm:text-sm font-bold text-slate-900 uppercase mt-0.5 break-words">${safeName}</h4>
                                </div>
                                <div>
                                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Member ID</p>
                                    <h4 class="text-xs sm:text-sm font-mono font-black text-emerald-600 mt-0.5">${safeMemberId}</h4>
                                </div>
                                <div class="col-span-2 sm:col-span-1 sm:text-right">
                                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Order Date</p>
                                    <p class="text-xs font-bold text-slate-700 mt-0.5">${safeOrderDate}</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-4 bg-emerald-50/60 p-3.5 rounded-2xl border border-emerald-100">
                                <div class="flex flex-col">
                                    <span class="text-[9px] text-slate-500 font-bold uppercase tracking-widest">Business PV</span>
                                    <div>
                                        <span class="inline-flex items-center px-3 py-1 rounded-xl text-[10px] font-black bg-emerald-200/70 text-emerald-800 border border-emerald-300 mt-1 font-mono">${safePv} PV</span>
                                    </div>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-[9px] text-slate-500 font-bold uppercase tracking-widest">Invoice Amount</span>
                                    <span class="text-base sm:text-lg font-black text-slate-900 mt-0.5 font-mono">₹${safeAmount}</span>
                                </div>
                            </div>

                            <div class="space-y-3 pt-1">
                                <div class="flex items-center gap-3">
                                    <div class="h-7 w-7 rounded-xl bg-emerald-100 border border-emerald-300 text-emerald-700 flex items-center justify-center text-xs flex-shrink-0"><i class="fa-solid fa-circle-check"></i></div>
                                    <div>
                                        <h5 class="text-xs font-bold text-slate-900 uppercase">Parcel Dispatched from Hub</h5>
                                        <p class="text-[10px] text-slate-500">Handed over to India Post Courier Services.</p>
                                    </div>
                                </div>

                                <div class="bg-slate-900 text-white p-4 rounded-2xl shadow-md space-y-3">
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                        <div class="flex items-start gap-3 min-w-0">
                                            <div class="h-7 w-7 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-xs flex-shrink-0 mt-0.5"><i class="fa-solid fa-truck-fast"></i></div>
                                            <div class="min-w-0">
                                                <h5 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">India Post Barcode / Tracking Number</h5>
                                                <p class="text-sm sm:text-base font-mono font-black text-emerald-400 tracking-widest mt-0.5 select-all break-all">${safeTracking || 'ALLOCATING'}</p>
                                            </div>
                                        </div>
                                        
                                        ${safeTracking ? `
                                            <button type="button" id="${uniqueBtnId}" onclick="copyToClipboard('${safeTracking}', '${uniqueBtnId}')" class="inline-flex items-center justify-center gap-1.5 bg-white/10 hover:bg-white/20 text-emerald-300 text-[10px] font-bold px-3 py-1.5 rounded-xl border border-emerald-500/30 transition-all cursor-pointer shadow-sm self-start sm:self-center flex-shrink-0">
                                                <i class="fa-solid fa-copy"></i> Copy
                                            </button>
                                        ` : ''}
                                    </div>
                                    
                                    ${safeTracking ? `
                                        <div class="pt-2.5 border-t border-white/10 flex justify-end">
                                            <a href="https://www.indiapost.gov.in/" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-[10px] font-black px-4 py-2 rounded-xl transition-all shadow-md uppercase tracking-wider cursor-pointer text-center">
                                                Track via India Post <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
                                            </a>
                                        </div>
                                    ` : ''}
                                </div>
                            </div>
                        </div>
                    `;
                });

                wrapper.classList.remove('hidden');
            } else {
                list.innerHTML = `
                    <div class="emerald-glass-card p-8 text-center rounded-3xl border border-emerald-200 space-y-2">
                        <i class="fa-solid fa-box-open text-4xl block text-slate-300 mb-2"></i>
                        <h4 class="text-xs font-black text-slate-800 uppercase tracking-wider">No Shipments Found</h4>
                        <p class="text-[11px] text-slate-500">Please verify your Member ID and search again.</p>
                    </div>`;
                wrapper.classList.remove('hidden');
            }
        }

        function escapeHTML(str) {
            return String(str || '').replace(/[&<>"'/]/g, function (s) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;',
                    '/': '&#x2F;'
                }[s];
            });
        }

        function sanitizeString(str) {
            return String(str || '').trim();
        }
    </script>
</body>
</html>